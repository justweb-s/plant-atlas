    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_Test_di_efficienza_del_filtro_di_espulsione ;
    pa:layer "company" ;
    pa:locator "p. 12" ;
    pa:quote "Test di efficienza del filtro di espulsione tramite DOP, dopo la sostituzione." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "dopo la sostituzione" .

pa:company-st-0040 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_cappe_chimiche ;
    pa:layer "company" ;
    pa:locator "p. 13" ;
    pa:quote "Cappe chimiche (riferimento norma EN 14175) Manutenzione semestrale 1." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "P6M"^^xsd:duration .

