    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_injection_or_compression_plastics_moulding_machinery ;
    pa:condition "with manual loading or unloading" ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Injection or compression plastics-moulding machinery with manual loading or unloading." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Injection_or_compression_plastics_moulding_machinery .

