    pa:layer "manufacturer" ;
    pa:locator "p. 51" ;
    pa:quote "PROJECT PLANNING 5 Minimum requirements for the regular thorough check The following thorough checks must be carried out at least once a year: O \"Thorough check of the principal function of the protective device\", page 51 O Test of the detection capability (resolution), see \"Thorough check of the area to be protected\", page 52 Recommendations for further thorough checks In many cases, depending on the application conditions," ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "P1Y"^^xsd:duration .

