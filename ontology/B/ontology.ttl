pa:Provision_Carrier a pa:Provision ;
    rdfs:label "Carrier" ;
    pa:definedAs "a part of the machinery on or in which persons and/or goods are supported",
        "a part of the machinery or related product on or in which persons and/or goods are supported" .

pa:Provision_Circular_saws_single_or_multi_blade a pa:Provision ;
    rdfs:label "Circular saws (single- or multi-blade)" .

pa:Provision_Devices_for_the_lifting_of_persons_or_of_persons_and_goods a pa:Provision ;
    rdfs:label "Devices for the lifting of persons or of persons and goods" .

pa:Provision_Driver a pa:Provision ;
    rdfs:label "Driver" ;
    pa:definedAs "an operator responsible for the movement of a machine",
        "operator responsible for the movement" .

pa:Provision_Dynamic_test a pa:Provision ;
    rdfs:label "Dynamic test" ;
    pa:definedAs "the test during which lifting machinery is operated in all its possible configurations",
        "the test during which the machinery or related product is operated in all its possible configurations" .

pa:Provision_Emergency_stop_devices a pa:Provision ;
    rdfs:label "Emergency stop devices" .

pa:Provision_Guided_load a pa:Provision ;
    rdfs:label "Guided load" ;
    pa:definedAs "a load where the total movement is made along rigid or flexible guides" .

pa:Provision_Injection_or_compression_plastics_moulding_machinery a pa:Provision ;
    rdfs:label "Injection or compression plastics-moulding machinery" .

pa:Provision_Lifting_operation a pa:Provision ;
    rdfs:label "Lifting operation" ;
    pa:definedAs "a movement of unit loads",
        "a movement of unit loads consisting of goods and/or persons" .

pa:Provision_Logic_units_to_ensure_safety_functions a pa:Provision ;
    rdfs:label "Logic units to ensure safety functions" .

pa:Provision_Machinery_or_related_products_presenting_risks_due_to_their_ a pa:Provision ;
    rdfs:label "Machinery or related products presenting risks due to their mobility" ;
    pa:definedAs "operatedwithout being moved",
        "requires either mobility while working" .

pa:Provision_PORTABLE_HAND_HELD_AND_OR_HAND_GUIDED_MACHINERY a pa:Provision ;
    rdfs:label "PORTABLE HAND-HELD AND/OR HAND-GUIDED MACHINERY" .

pa:Provision_Portable_chainsaws_for_woodworking a pa:Provision ;
    rdfs:label "Portable chainsaws for woodworking" .

pa:Provision_Portable_fixing_and_other_impact_machinery a pa:Provision ;
    rdfs:label "Portable fixing and other impact machinery" .

pa:Provision_Power_operated_interlocking_movable_guards a pa:Provision ;
    rdfs:label "Power-operated interlocking movable guards" .

pa:Provision_Presses_including_press_brakes a pa:Provision ;
    rdfs:label "Presses, including press-brakes" .

pa:Provision_Safety_components_with_fully_or_partially_self_evolving_beha a pa:Provision ;
    rdfs:label "Safety components with fully or partially self-evolving behaviour" .

pa:Provision_Static_test a pa:Provision ;
    rdfs:label "Static test" ;
    pa:definedAs "the test during which lifting machinery or a lifting accessory is first inspected",
        "the test during which the machinery or related product or lifting accessory is first inspected" .

pa:Provision_Test_coefficient a pa:Provision ;
    rdfs:label "Test coefficient" ;
    pa:definedAs "the arithmetic ratio between the load used to carry out the static or dynamic tests" .

pa:Provision_Two_hand_control_devices a pa:Provision ;
    rdfs:label "Two-hand control devices" .

pa:Provision_Working_coefficient a pa:Provision ;
    rdfs:label "Working coefficient" ;
    pa:definedAs "the arithmetic ratio between the load guaranteed",
        "the arithmetic ratio between the load guaranteed by the manufacturer" .

pa:Provision_allegato_VII a pa:Provision ;
    rdfs:label "allegato VII" .

pa:Provision_authorised_representative a pa:Provision ;
    rdfs:label "authorised representative" ;
    pa:definedAs "any natural or legal person established within the Union",
        "means any natural or legal person established in the Community" .

pa:Provision_danger_zone a pa:Provision ;
    rdfs:label "danger zone" ;
    pa:definedAs "any zone within and/or around machinery" .

pa:Provision_exposed_person a pa:Provision ;
    rdfs:label "exposed person" ;
    pa:definedAs "any person wholly or partially in a danger zone" .

pa:Provision_guard a pa:Provision ;
    rdfs:label "guard" ;
    pa:definedAs "a part of the machinery used specifically to provide protection by means of a physical barrier",
        "by means of a physical barrier" .

pa:Provision_harmonised_standard a pa:Provision ;
    rdfs:label "harmonised standard" ;
    pa:definedAs "means a harmonised standard as defined in Article 2",
        "means a non-binding technical specification" .

pa:Provision_hazard a pa:Provision ;
    rdfs:label "hazard" ;
    pa:definedAs "a potential source of injury or damage to health" .

pa:Provision_hydraulic_powered_roof_supports a pa:Provision ;
    rdfs:label "hydraulic-powered roof supports" .

pa:Provision_industrial_location_IEC_61000_6_4 a pa:Provision ;
    rdfs:label "industrial location (IEC 61000-6-4)" ;
    pa:definedAs "Locations characterized by a separate power network, supplied from a high- or medium-voltage transformer, dedicated for the supply of the installation" .

pa:Provision_intended_use a pa:Provision ;
    rdfs:label "intended use" ;
    pa:definedAs "in accordance with the information provided in the instructions for use",
        "the use of machinery in accordance with the information provided in the instructions for use" .

pa:Provision_lavoratore_esposto a pa:Provision ;
    rdfs:label "lavoratore esposto" ;
    pa:definedAs "qualsiasi lavoratore che si trovi interamente o in parte in una zona pericolosa" .

pa:Provision_lifting_accessory a pa:Provision ;
    rdfs:label "lifting accessory" ;
    pa:definedAs "a component or equipment, not attached to the lifting machinery",
        "means a component or equipment not attached to the lifting machinery" .

pa:Provision_listed_in_Annex_I a pa:Provision ;
    rdfs:label "listed in Annex I" .

pa:Provision_listed_in_Annex_I_Part_B a pa:Provision ;
    rdfs:label "listed in Annex I, Part B" .

pa:Provision_locomotives_and_brake_vans a pa:Provision ;
    rdfs:label "locomotives and brake-vans" .

pa:Provision_manufacturer a pa:Provision ;
    rdfs:label "manufacturer" ;
    pa:definedAs "any natural or legal person who",
        "means any natural or legal person who designs and/or manufactures machinery" .

pa:Provision_notified_body a pa:Provision ;
    rdfs:label "notified body" ;
    pa:definedAs "Only such a body shall be considered a notified body",
        "conformity assessment body notified in accordance with this Regulation" .

pa:Provision_operator a pa:Provision ;
    rdfs:label "operator" ;
    pa:definedAs "the person or persons installing, operating, adjusting",
        "the person or persons installing, operating, adjusting, maintaining, cleaning, repairing or moving machinery" .

pa:Provision_operatore a pa:Provision ;
    rdfs:label "operatore" ;
    pa:definedAs "il lavoratore incaricato dell'uso di una attrezzatura di lavoro",
        "il lavoratore incaricato dell’uso di un’attrezzatura di lavoro" .

pa:Provision_payload a pa:Provision ;
    rdfs:label "payload" ;
    pa:definedAs "the combined weight of everything attached to the robot tool flange" .

pa:Provision_placing_on_the_market a pa:Provision ;
    rdfs:label "placing on the market" ;
    pa:definedAs "means making available for the first time in the Community",
        "the first making available of a product" .

pa:Provision_protective_device a pa:Provision ;
    rdfs:label "protective device" ;
    pa:definedAs "a device (other than a guard) which reduces the risk" .

pa:Provision_putting_into_service a pa:Provision ;
    rdfs:label "putting into service" ;
    pa:definedAs "means the first use, for its intended purpose, in the Community",
        "the first use, for its intended purpose, in the Union" .

pa:Provision_reasonably_foreseeable_misuse a pa:Provision ;
    rdfs:label "reasonably foreseeable misuse" ;
    pa:definedAs "the use of machinery in a way not intended in the instructions for use",
        "the use of machinery or a related product in a way not intended in the instructions for use" .

pa:Provision_risk a pa:Provision ;
    rdfs:label "risk" ;
    pa:definedAs "a combination of the probability and the degree of an injury",
        "a combination of the probability and the degree of an injury or damage to health" .

pa:Provision_safety_component a pa:Provision ;
    rdfs:label "safety component" ;
    pa:definedAs "means a component",
        "‘safety component’ means a physical or digital component" .

pa:Provision_sawing_machinery_with_movable_blade_s_during_cutting a pa:Provision ;
    rdfs:label "sawing machinery with movable blade(s) during cutting" .

pa:Provision_uso_di_una_attrezzatura_di_lavoro a pa:Provision ;
    rdfs:label "uso di una attrezzatura di lavoro" ;
    pa:definedAs "qualsiasi operazione lavorativa connessa ad una attrezzatura di lavoro" .

pa:Provision_workspace a pa:Provision ;
    rdfs:label "workspace" ;
    pa:definedAs "the range of the fully extended robot arm, horizontally and vertically" .

pa:Provision_zona_pericolosa a pa:Provision ;
    rdfs:label "zona pericolosa" ;
    pa:definedAs "qualsiasi zona all'interno ovvero in prossimità di una attrezzatura di lavoro",
        "qualsiasi zona all'interno ovvero in prossimità di un’attrezzatura di lavoro nella quale la presenza di un lavoratore costituisce un rischio per la salute o la sicurezza dello stesso" .

