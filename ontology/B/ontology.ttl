@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pa: <https://github.com/justweb-s/plant-atlas/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/justweb-s/plant-atlas/ontology> a owl:Ontology ;
    owl:versionInfo "facts in force on 2026-11-14" .

pa:Layer_company a pa:Layer ;
    rdfs:label "company" ;
    pa:order 4 .

pa:Layer_guidance a pa:Layer ;
    rdfs:label "guidance" ;
    pa:order 2 .

pa:Layer_law a pa:Layer ;
    rdfs:label "law" ;
    pa:order 1 .

pa:Layer_manufacturer a pa:Layer ;
    rdfs:label "manufacturer" ;
    pa:order 3 .

pa:Layer_plant a pa:Layer ;
    rdfs:label "plant" ;
    pa:order 5 .

pa:NotifiedBody a owl:Class ;
    rdfs:comment "A conformity assessment body notified to carry out a procedure."@en .

pa:SafetyComponent a owl:Class ;
    rdfs:comment "A component that fulfils a safety function and is placed on the market separately."@en .

pa:company-st-0001 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:layer "company" ;
    pa:locator "p. 1" ;
    pa:quote "(Testo Unico), articolo 71, in virtù del quale il datore di lavoro deve, non solo mettere a disposizione dei lavoratori attrezzature conformi ai requisiti di sicurezza, conformemente alle disposizioni legislative nazionali o di recepimento delle direttive comunitarie e adeguate al lavoro da svolgere ma deve anche provvedere affinché tali attrezzature siano oggetto di idonea manutenzione al fine di garantire nel tempo la rispondenza alle caratteristiche tecniche e di funzionamento" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "provvedere affinché tali attrezzature siano oggetto di idonea manutenzione" .

pa:company-st-0002 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:PeriodicVerification_verifiche_periodiche_delle_attrezzature_dell_Allegato_VII ;
    pa:condition "Per particolari attrezzature, il cui utilizzo comporta pericoli particolari e riportate nell’Allegato VII" ;
    pa:layer "company" ;
    pa:locator "p. 1" ;
    pa:quote "Per particolari attrezzature, il cui utilizzo comporta pericoli particolari e riportate nell’Allegato VII del T.U. e ss.mm.ii., occorre eseguire verifiche periodiche con una periodicità stabilita dal legislatore da parte di personale specializzato dell’ASP di competenza o Organismo privato riconosciuto." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:VerifyingBody_personale_specializzato_dell_ASP_di_competenza_o_Organismo_p .

pa:company-st-0003 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_manutenzione_delle_attrezzature_di_lavoro ;
    pa:layer "company" ;
    pa:locator "p. 1" ;
    pa:quote "Ogni attrezzatura e macchina dovrà essere sottoposta a un regime di verifiche e di manutenzione specifico, essenzialmente sulla base delle prescrizioni del fabbricante e di eventuali leggi specifiche, come ad esempio nel caso delle gru, dei trattori agricoli-forestali, delle piattaforme elevatrici, etc.." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "sulla base delle prescrizioni del fabbricante" .

pa:company-st-0004 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_datore_di_lavoro ;
    pa:layer "company" ;
    pa:locator "p. 1" ;
    pa:quote "La dimostrabilità dell’avvenuta manutenzione avviene attraverso documentazione che attesti gli interventi eseguiti sulle attrezzature (ad intervalli prefissati o al guasto) e l’eventuale sostituzione di parti o dispositivi con ricambi idonei." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_documentazione_che_attesti_gli_interventi_eseguiti_sulle_att .

pa:company-st-0006 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_manutenzione_straordinaria ;
    pa:layer "company" ;
    pa:locator "p. 2" ;
    pa:quote "interventi solitamente eseguiti in seguito al verificarsi di inconvenienti non prevedibili (ad esempio guasti, anomalie, ecc.) e che normalmente sono effettuati da tecnici specializzati. È volta a ripristinare le condizioni di funzionamento iniziali." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "tecnici specializzati" .

pa:company-st-0007 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_manutenzione_straordinaria ;
    pa:layer "company" ;
    pa:locator "p. 2" ;
    pa:quote "interventi solitamente eseguiti in seguito al verificarsi di inconvenienti non prevedibili (ad esempio guasti, anomalie, ecc.) e che normalmente sono effettuati da tecnici specializzati. È volta a ripristinare le condizioni di funzionamento iniziali." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "verificarsi di inconvenienti non prevedibili" .

pa:company-st-0008 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_attivit_di_manutenzione ;
    pa:layer "company" ;
    pa:locator "p. 2" ;
    pa:quote "Tutte le attività di manutenzione, necessarie per garantire nel tempo il permanere delle condizioni di sicurezza dei lavoratori, necessitano della registrazione dei controlli effettuati e dei loro esiti, anche al fine di consentire l’individuazione delle azioni correttive da adottare." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_registrazione_dei_controlli_effettuati_e_dei_loro_esiti .

pa:company-st-0009 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_tutte_le_operazioni_di_manutenzione ;
    pa:layer "company" ;
    pa:locator "p. 2" ;
    pa:quote "Tutte le operazioni devono essere effettuate in condizioni di sicurezza per i lavoratori." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "in condizioni di sicurezza per i lavoratori" .

pa:company-st-0010 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "Le situazioni non conformi devono essere comunicate" ;
    pa:layer "company" ;
    pa:locator "p. 2" ;
    pa:quote "Le situazioni non conformi devono essere comunicate attraverso la scala gerarchica al datore di lavoro affinché possa provvedere al ripristino delle condizioni di sicurezza." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "provvedere al ripristino delle condizioni di sicurezza" .

pa:company-st-0011 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Machine_macchina_non_conforme ;
    pa:condition "Qualora la non conformità sia di pregiudizio per la sicurezza dei lavoratori" ;
    pa:layer "company" ;
    pa:locator "p. 2" ;
    pa:quote "Qualora la non conformità sia di pregiudizio per la sicurezza dei lavoratori, la macchina non potrà essere utilizzata fino all’adozione delle misure necessarie atte ad eliminarla." ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "la macchina non potrà essere utilizzata fino all’adozione delle misure necessarie atte ad eliminarla" .

pa:company-st-0013 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_laboratorio ;
    pa:layer "company" ;
    pa:locator "p. 3" ;
    pa:quote "nome Laboratorio, numero locale, armadio) Incaricato (indicare Cognome e Nome dell'unità di personale tecnico o scientifico incaricato del controllo periodico dell'attrezzatura) L’elenco delle attrezzature, di cui si terrà copia stampata in laboratorio," ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_L_elenco_delle_attrezzature .

pa:company-st-0015 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Provision_Registro_di_manutenzione_e_controllo ;
    pa:layer "company" ;
    pa:locator "p. 5" ;
    pa:quote "Il Registro di manutenzione e controllo è uno strumento che “accompagna l’attrezzatura” e permette di valutare in qualsiasi momento lo stato di conservazione e di usura della stessa." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "è uno strumento che “accompagna l’attrezzatura” e permette di valutare in qualsiasi momento lo stato di conservazione e di usura della stessa" .

pa:company-st-0016 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_Registro_di_manutenzione_e_controllo ;
    pa:condition "le operazioni routinarie di pulizia e controllo vengono escluse da obbligo di registrazione" ;
    pa:layer "company" ;
    pa:locator "p. 5" ;
    pa:quote "A) seguono i Registri di manutenzione e controllo, riferiti alle singole attrezzature/macchine presenti in elenco. Il Registro di manutenzione e controllo è uno strumento che “accompagna l’attrezzatura” e permette di valutare in qualsiasi momento lo stato di conservazione e di usura della stessa. In esso vengono registrate le verifiche da eseguire secondo prestabilite periodicità nonché il tipo di intervento effettuato (manutenzioni ordinarie, verifiche periodiche All." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_Registri_di_manutenzione_e_controllo .

pa:company-st-0017 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_interventi_diversi_dalla_manutenzione_ordinaria ;
    pa:condition "ad esclusione di quelli di manutenzione ordinaria" ;
    pa:layer "company" ;
    pa:locator "p. 5" ;
    pa:quote "Gli interventi, ad esclusione di quelli di manutenzione ordinaria, sono generalmente effettuati da tecnici specializzati, e possono essere anche finalizzati all’adeguamento di attrezzature non conformi." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "sono generalmente effettuati da tecnici specializzati" .

pa:company-st-0018 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_attrezzatura_di_lavoro ;
    pa:layer "company" ;
    pa:locator "p. 6" ;
    pa:quote "FRONTESPIZIO – fac-simile REGISTRO DELLE MANUTENZIONI E DEI CONTROLLI (D.Lgs. 81/08 art. 71) Attrezzatura Costruttore e modello Matricola Anno di fabbricazione Inventario N° Collocazione Manuale d'uso e manutenzione SI NO Collocazione Tecnico incaricato" ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_REGISTRO_DELLE_MANUTENZIONI_E_DEI_CONTROLLI .

