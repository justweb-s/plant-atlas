    pa:condition "Before making machinery or a related product available on the market" ;
    pa:locator "Art. 15(2)" ;
    pa:quote "Before making machinery or a related product available on the market, distributors shall verify that:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "distributors shall verify that" .

pa:st-0178 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_distributors ;
    pa:condition "Before making machinery or a related product available on the market" ;
    pa:locator "Art. 15(2)" ;
    pa:quote "(a) the machinery or related product bears the CE marking;" ;
    pa:relation pa:hasObligation ;
