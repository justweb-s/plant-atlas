    pa:about pa:ProtectiveDevice_nanoScan3 ;
    pa:layer "manufacturer" ;
    pa:locator "p. 30" ;
    pa:quote "S = 1,600 mm/s × T + TZ + ZR + CRO where: O S = minimum distance in millimeters (mm) O T = stopping/run-down time for the entire system in seconds (s) (Response time of the safety laser scanner + machine stopping time, incl." ;
    pa:relation pa:minimumDistanceRule ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "S = 1,600 mm/s × T + TZ + ZR + CRO" .

pa:manufacturer-st-0497 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:ProtectiveDevice_nanoScan3 ;
    pa:condition "If the minimum distance should be as small as possible" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 30" ;
    pa:quote "→ If the minimum distance should be as small as possible, calculate CRO using the following formula: CRO = 1,200 mm – (0.4 × HD) where:" ;
    pa:relation pa:minimumDistanceRule ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "CRO = 1,200 mm – (0.4 × HD)" .

pa:manufacturer-st-0498 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:ProtectiveDevice_nanoScan3 ;
    pa:layer "manufacturer" ;
    pa:locator "p. 30" ;
    pa:quote "S = 1,600 mm/s × T + TZ + ZR + CRO where:" ;
