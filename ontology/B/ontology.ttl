        "Changes to the Safety Configuration settings must comply with the risk assessment conducted by the integrator",
        "Perform a risk assessment and reduce risks",
        "Verify and validate all parameter settings for the robot application",
        "collaborative operation is of the APPLICATION",
        "conduct a risk assessment to guarantee the safety of personnel and equipment around the robot",
        "ensure that all changes to the safety configuration settings comply with the risk assessment",
        "integrator must conduct a risk assessment",
        "most of ISO/TS 15066 is directed towards the integrator",
        "must comply with the risk assessment conducted by the integrator",
        "must prevent unauthorized persons from changing the safety configuration",
        "must use ISO 12100 and ISO 10218-2 to conduct the risk assessment",
        "potential significant hazards listed below",
        "prevent unauthorized persons from changing the safety configuration",
        "safeguarding is required",
        "the completed machine fulfiling all applicable Directives, applying the CE mark and providing the Declaration of Conformity (DOC)",
        "the integrator is responsible for the completed machine fulfiling all applicable Directives",
        "the risk assessment includes the foreseeable risks due to collisions and to reasonably foreseeable misuse" .

pa:ConformityProcedure a owl:Class ;
    rdfs:comment "A conformity assessment procedure or module (A, B, C, G, H; internal checks; type-examination)."@en .

pa:Standard a owl:Class ;
    rdfs:comment "A technical standard a document names (e.g. EN ISO 10218-1, ISO 13855, EN 1493)."@en .

pa:putIntoServiceOnlyWhen a owl:DatatypeProperty ;
    rdfs:comment "the condition under which a machine may be put into service (e.g. only once integrated into a complete machine)"@en ;
    rdfs:domain pa:Machine ;
    rdfs:range xsd:string .

pa:ProtectiveDevice a owl:Class ;
    rdfs:comment "A device that detects people or stops the hazard: safety laser scanner, light curtain, guard."@en .

pa:capacityKg a owl:DatatypeProperty ;
    rdfs:comment "the capacity of a device in kg, as listed"@en ;
    rdfs:domain pa:LiftingDevice ;
    rdfs:range xsd:string .

pa:deviceKind a owl:DatatypeProperty ;
    rdfs:comment "the kind of a device, as the equipment list names it"@en ;
    rdfs:domain pa:LiftingDevice ;
    rdfs:range xsd:string .

pa:retentionPeriod a owl:DatatypeProperty ;
    rdfs:comment "for how long a document or record must be kept, and by whom"@en ;
    rdfs:domain pa:Document ;
    rdfs:range xsd:duration .

pa:yearBuilt a owl:DatatypeProperty ;
    rdfs:comment "the year a device was built, as listed"@en ;
    rdfs:domain pa:LiftingDevice ;
    rdfs:range xsd:string .

pa:Machine_UR5e a pa:Machine ;
    rdfs:label "UR5e" ;
    pa:conformsToStandard pa:Standard_EN_ISO_13849_1 ;
    pa:hasMaxPayload pa:Quantity_5_kg_11_lb,
        pa:Quantity_maximum_payload_of_5kg ;
    pa:hasReach pa:Quantity_850_mm,
        pa:Quantity_850_mm_33_5_in ;
    pa:hasSafetyFunction pa:SafetyFunction_21_configurable_safety_functions,
        pa:SafetyFunction_Emergency_Stop_d_3,
        pa:SafetyFunction_PLd_Category_3,
        pa:SafetyFunction_SF20,
        pa:SafetyFunction_SF21,
        pa:SafetyFunction_SF6,
        pa:SafetyFunction_SF7,
        pa:SafetyFunction_SF8,
        pa:SafetyFunction_SF9,
        pa:SafetyFunction_Safeguard_Stop_d_3 ;
    pa:hasStoppingLimit pa:Quantity_10_W,
        pa:Quantity_25_N,
        pa:Quantity_3_kg_m_s,
        pa:Quantity_50_mm_s,
        pa:Quantity_Force_Limit_25_N,
        pa:Quantity_Power_Limit_10_W,
        pa:Quantity_Speed_Limit_50_mm_s,
        pa:Quantity_Stopping_Distance_Limit_40_mm,
        pa:Quantity_Stopping_Time_Limit_50_ms .

pa:requiresProcedure a owl:ObjectProperty ;
    rdfs:comment "the conformity assessment procedure(s) or module(s) that apply to a category of machinery"@en ;
    rdfs:domain pa:MachineryCategory ;
    rdfs:range pa:ConformityProcedure .

pa:LiftingDevice a owl:Class ;
    rdfs:comment "A lifting device of the plant's equipment list."@en .

pa:VerifyingBody a owl:Class ;
    rdfs:comment "The body that carries out a verification (e.g. INAIL, ASL, an authorised body)."@en .

pa:Machine_UR10e a pa:Machine ;
    rdfs:label "UR10e" ;
    pa:conformsToStandard pa:Standard_EN_ISO_10218_1,
        pa:Standard_EN_ISO_13849_1 ;
    pa:hasMaxPayload pa:Quantity_10_kg_22_lb_or_12_5_kg_27_5_lb,
        pa:Quantity_10kg,
        pa:Quantity_12_5kg,
        pa:Quantity_12_5kg_maximum_payload ;
    pa:hasReach pa:Quantity_1300_mm_51_2_in ;
    pa:hasSafetyFunction pa:SafetyFunction_21_configurable_safety_functions,
        pa:SafetyFunction_Emergency_Stop_d_3,
        pa:SafetyFunction_Joint_Position,
        pa:SafetyFunction_Joint_Position_Limit_5_d_3,
        pa:SafetyFunction_SF18,
        pa:SafetyFunction_SF2,
        pa:SafetyFunction_SF20,
        pa:SafetyFunction_SF21,
        pa:SafetyFunction_Safe_Home_1_7_d_3,
        pa:SafetyFunction_Safeguard_Reset,
        pa:SafetyFunction_Safeguard_Stop_SF2,
        pa:SafetyFunction_Safeguard_Stop_d_3,
        pa:SafetyFunction_Speed_to_exceed_any_limit,
        pa:SafetyFunction_Stop_Category_0,
        pa:SafetyFunction_TCP_Pose_Limit ;
    pa:hasStoppingLimit pa:Quantity_1_15_s,
        pa:Quantity_3,
        pa:Quantity_40_mm,
        pa:Quantity_5,
        pa:Quantity_50_ms .

pa:conformsToStandard a owl:ObjectProperty ;
    rdfs:comment "a standard or directive the machine is declared to conform to"@en ;
    rdfs:domain pa:Machine ;
    rdfs:range pa:Standard .

pa:maintenanceRule a owl:DatatypeProperty ;
    rdfs:comment "who may carry out maintenance, on what basis, or what maintenance must respect"@en ;
    rdfs:domain pa:Check ;
    rdfs:range xsd:string .

pa:verificationInterval a owl:DatatypeProperty ;
    rdfs:comment "how often a category of equipment must be verified, with its conditions"@en ;
    rdfs:domain pa:EquipmentCategory ;
    rdfs:range xsd:duration .

pa:PeriodicVerification a owl:Class ;
    rdfs:comment "A verification or check of work equipment that recurs or has a time limit."@en .

pa:mustAccompany a owl:ObjectProperty ;
    rdfs:comment "what must accompany the machinery or product"@en ;
    rdfs:domain pa:Machinery ;
    rdfs:range pa:Document .

pa:verifiedBy a owl:ObjectProperty ;
    rdfs:comment "who carries out a verification or check"@en ;
    rdfs:domain pa:PeriodicVerification ;
    rdfs:range pa:VerifyingBody .

