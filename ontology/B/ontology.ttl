    pa:quote "(b) the machinery or related product is accompanied by the EU declaration of conformity referred to in Article 10(8);" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_accompanied_by_the_EU_declaration_of_conformity .

