pa:Check_Apparecchi_di_sollevamento_fissi_particolari_settori_di_impi a pa:Check ;
    rdfs:label "Apparecchi di sollevamento fissi, particolari settori di impiego" ;
    pa:requiresPeriodicCheck "P1Y"^^xsd:duration,
        "P2Y"^^xsd:duration .

pa:Check_Apparecchi_di_sollevamento_mobili_o_trasferibili_altri_setto a pa:Check ;
    rdfs:label "Apparecchi di sollevamento mobili o trasferibili, altri settori" ;
    pa:requiresPeriodicCheck "P1Y"^^xsd:duration,
        "P2Y"^^xsd:duration .

pa:Check_Cleaning_of_Teach_Pendant_and_Control_Box a pa:Check ;
    rdfs:label "Cleaning of Teach Pendant and Control Box" ;
    pa:maintenanceRule "Do not use an abrasive material to wipe down the screen",
        "Use a mild, industrial cleaning agent without thinning agents or any aggressive additives" .

pa:Check_Control_Box_cleaning a pa:Check ;
    rdfs:label "Control Box cleaning" ;
    pa:maintenanceRule "Use the cleaning recommendation listed in the user manual",
        "Wipe down the Control box with a damp cloth" .

pa:Check_Verifica_di_integrit_tubazioni_gas_vapori_e_liquidi_surrisca a pa:Check ;
    rdfs:label "Verifica di integrità, tubazioni gas, vapori e liquidi surriscaldati di III categoria" ;
    pa:requiresPeriodicCheck "P10Y"^^xsd:duration,
        "P5Y"^^xsd:duration .

pa:Check_attrezzature_di_lavoro a pa:Check ;
    rdfs:label "attrezzature di lavoro" ;
    pa:requiresCheckAfter "controllo dopo ogni montaggio in un nuovo cantiere o in una nuova località di impianto",
        "dopo l'installazione e prima della messa in esercizio" .

pa:Check_load_nut_s_wear_indicator a pa:Check ;
    rdfs:label "load nut’s wear indicator" ;
    pa:requiresCheckAfter "when the wear limit is reached" ;
    pa:requiresPeriodicCheck "P6M"^^xsd:duration .

pa:Check_manutenzione_ordinaria a pa:Check ;
    rdfs:label "manutenzione ordinaria" ;
    pa:maintenanceRule "mantenere il funzionamento delle attrezzature e delle apparecchiature in perfetta efficienza secondo la normativa vigente",
        "possono essere eseguite anche dall’operatore" .

pa:Check_manutenzione_straordinaria a pa:Check ;
    rdfs:label "manutenzione straordinaria" ;
    pa:maintenanceRule "tecnici specializzati" ;
    pa:requiresCheckAfter "verificarsi di inconvenienti non prevedibili" .

pa:Check_prototipi a pa:Check ;
    rdfs:label "prototipi" ;
    pa:maintenanceRule "deve essere predisposta dal Responsabile dell’attività di ricerca o di didattica in laboratorio (RDRL) in collaborazione con il RSPP e Docente di riferimento del prototipo stesso",
        "è consentita solo al personale specificamente autorizzato dal Responsabile RDRL e debitamente informato e formato" .

pa:Check_safety_function_settings a pa:Check ;
    rdfs:label "safety function settings" ;
    pa:requiresCheckAfter "After troubleshooting, maintenance, and repair work" .

pa:Check_suspended_safeguards a pa:Check ;
    rdfs:label "suspended safeguards" ;
    pa:requiresCheckAfter "before selecting Automatic Mode",
        "returned to full functionality before selecting Automatic Mode" .

