    pa:about pa:Machine_MA_STAR_model_3_5 ;
    pa:layer "manufacturer" ;
    pa:locator "p. 9" ;
    pa:quote "2.3 Technical Data MA STAR model 3.5 A 3.5 S 3.5 A 3.5 A + VZ 971652 + VZ 971653 Rated load capacity [kg] 3500 3000 2500 Overall height HG [mm] 4499 Overall width BG [mm] 3591 4100 3841 4391 Clear height HL [mm] 4452 Full travel HW [mm] 1885 Lifting height max." ;
    pa:relation pa:hasMaxPayload ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Quantity_3500 .

pa:manufacturer-st-0629 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_MA_STAR_model_5_5_6_5 ;
    pa:layer "manufacturer" ;
    pa:locator "p. 10" ;
    pa:quote "MA STAR model 5.5 6.5 Rated load capacity [kg] 5500 6500 Overall height HG [mm] 5193 5193 Overall width BG [mm] 4000 4100 4250 4192 5193 Clear height HL [mm] 5146 5146 Full travel HW [mm] 2000 1950 Lifting height max." ;
    pa:relation pa:hasMaxPayload ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Quantity_5500_6500 .

pa:manufacturer-st-0631 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_lifts ;
    pa:layer "manufacturer" ;
    pa:locator "p. 12" ;
    pa:quote "3.2 Scope of Delivery Lifts with 3.5 t load capacity are shipped ex works in one package as standard, lifts with higher load capacity in two packages." ;
    pa:relation pa:hasMaxPayload ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Quantity_3_5_t .

pa:manufacturer-st-0633 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_visual_and_functional_check ;
    pa:condition "before starting work" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 14" ;
    pa:quote "• Perform a visual and functional check before starting work each day." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "P1D"^^xsd:duration .

pa:manufacturer-st-0634 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_defects ;
    pa:layer "manufacturer" ;
    pa:locator "p. 14" ;
    pa:quote "• Defects must be corrected immediately in a competent manner." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "must be corrected immediately in a competent manner" .

pa:manufacturer-st-0635 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_the_lift ;
    pa:layer "manufacturer" ;
    pa:locator "p. 14" ;
    pa:quote "• Operation of the lift is only permissible with mounted and intact protective covers and safety devices." ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "only permissible with mounted and intact protective covers and safety devices" .

pa:manufacturer-st-0637 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_wheel_engaging_supports ;
    pa:condition "When using the wheel engaging supports" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 21" ;
    pa:quote "When using the wheel engaging supports, it should be noted that the vehicle weight with asymmetrical load distribution is no longer decisive, but the individual load-bearing capacity of 1,000 kg per wheel engaging support:" ;
    pa:relation pa:hasMaxPayload ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Quantity_1_000_kg .

pa:manufacturer-st-0638 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_lift_MA_STAR_5_5_and_6_5 ;
    pa:layer "manufacturer" ;
    pa:locator "p. 21" ;
    pa:quote "The lift is designed according to EN 1493, which specifies a total load capacity and takes into account an asymmetrical load distribution." ;
    pa:relation pa:conformsToStandard ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Standard_EN_1493 .

pa:manufacturer-st-0640 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_special_prism_support ;
    pa:condition "When using the special prism support with or without a tread plate" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 23" ;
    pa:quote "Special prism support Special prism support for MB G-class without tread plate for MB G-class with tread plate WARNING When using the special prism support with or without a tread plate, the rated load capacity is 3,500 kg." ;
    pa:relation pa:hasMaxPayload ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Quantity_3_500_kg .

pa:manufacturer-st-0642 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_visual_and_functional_checks ;
    pa:condition "before starting work or beginning a shift" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 27" ;
    pa:quote "6 Inspection Daily before Starting Work To ensure the safety of the system during operation, the visual and functional checks listed below must be performed daily before starting work or beginning a shift." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "P1D"^^xsd:duration .

pa:manufacturer-st-0643 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_lifting_system ;
    pa:condition "A system with a defective emergency stop" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 27" ;
    pa:quote "A system with a defective emergency stop must not be put into operation." ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "must not be put into operation" .

pa:manufacturer-st-0644 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_lifting_system ;
    pa:condition "with damaged cables or actuating elements" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 27" ;
    pa:quote "A lifting system with damaged cables or actuating elements must not be operated." ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "must not be operated" .

pa:manufacturer-st-0646 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_lubrication_felt ;
    pa:layer "manufacturer" ;
    pa:locator "p. 31" ;
    pa:quote "Also check the lubrication felt for wear and/or contamination and replace at least every 12 months." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "P1Y"^^xsd:duration .

pa:manufacturer-st-0648 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_lubrication_of_the_slide_track_raceways ;
    pa:layer "manufacturer" ;
    pa:locator "p. 32" ;
    pa:quote "7.2.3 Greasing the Slide Tracks Lubricate the raceways of the sliding blocks at least every 6 months." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "P6M"^^xsd:duration .

pa:manufacturer-st-0649 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_upper_spindle_bearing ;
    pa:condition "MA STAR 5.5 / 6.5 only" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 33" ;
    pa:quote "7.2.6 Lubricating the Spindle Bearing (MA STAR 5.5 / 6.5 only) Lubricate the upper spindle bearing at least once a year." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "P1Y"^^xsd:duration .

pa:manufacturer-st-0650 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_load_nut_s_wear_indicator ;
    pa:layer "manufacturer" ;
    pa:locator "p. 34" ;
    pa:quote "7.3 Checking the Load Nut’s Wear Indicator The load nut’s wear indicator must be checked every 6 months, and the pair of nuts must be replaced when the wear limit is reached." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "P6M"^^xsd:duration .

pa:manufacturer-st-0651 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_load_nut_s_wear_indicator ;
    pa:layer "manufacturer" ;
    pa:locator "p. 34" ;
    pa:quote "7.3 Checking the Load Nut’s Wear Indicator The load nut’s wear indicator must be checked every 6 months, and the pair of nuts must be replaced when the wear limit is reached." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "when the wear limit is reached" .

pa:manufacturer-st-0652 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_required_inspection_and_maintenance_work ;
    pa:condition "Compliance is only deemed to have been demonstrated if" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 36" ;
    pa:quote "Compliance is only deemed to have been demonstrated if the required work has been carried out by our factory customer service, one of our dealers or one of our service partners." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "carried out by our factory customer service, one of our dealers or one of our service partners" .

pa:manufacturer-st-0653 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Check_decommissioning_and_dismantling_of_the_device ;
    pa:layer "manufacturer" ;
    pa:locator "p. 36" ;
    pa:quote "9 Decommissioning, Dismantling and Disposal The device may only be taken out of operation and disassembled by specially authorised and trained personnel." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "specially authorised and trained personnel" .

pa:manufacturer-st-0654 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:EconomicOperator_disposal_of_the_device ;
    pa:condition "If the device is to be disposed of" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 36" ;
    pa:quote "If the device is to be disposed of, it must be disposed of in an environmentally responsible manner in accordance with local legislation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "mastar-manual" ;
    pa:value "must be disposed of in an environmentally responsible manner in accordance with local legislation" .

