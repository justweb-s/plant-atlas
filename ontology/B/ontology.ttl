    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_hot_or_very_cold_material_being_ejected .

pa:st-0574 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:locator "Annex III, 1.5.5" ;
    pa:quote "The necessary steps shall also be taken to avoid or protect against the risk of hot or very cold material being ejected." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_avoid_or_protect_against_the_risk .

pa:st-0575 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_6 ;
    pa:condition "presented by the machinery or related product itself or by gases, liquids, dust, vapours or other substances produced or used by the machinery or related product" ;
    pa:locator "Annex III, 1.5.6" ;
    pa:quote "Fire Machinery or related products shall be designed and constructed in such a way as to avoid any risk of fire or overheating presented by the machinery or related product itself or by gases, liquids, dust, vapours or other substances produced or used by the machinery or related product." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_fire_or_overheating .

pa:st-0576 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_Explosion_1_5_7 ;
    pa:locator "Annex III, 1.5.7" ;
    pa:quote "Explosion Machinery or related products shall be designed and constructed in such a way as to avoid any risk of explosion presented by the machinery or related product itself or by gases, liquids, dust, vapours or other substances produced or used by the machinery or related product." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_explosion .

pa:st-0578 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_8_noise ;
    pa:condition "taking account of technical progress and the availability of means of reducing noise, in particular at source" ;
    pa:locator "Annex III, 1.5.8" ;
    pa:quote "Noise Machinery or related products shall be designed and constructed in such a way that risks resulting from the emission of airborne noise are reduced to the lowest level, taking account of technical progress and the availability of means of reducing noise, in particular at source." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risks_resulting_from_the_emission_of_airborne_noise .

pa:st-0580 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_vibrations_essential_requirement ;
    pa:locator "Annex III, 1.5.9" ;
    pa:quote "Vibrations Machinery or related products shall be designed and constructed in such a way that risks resulting from vibrations produced by the machinery or related product are reduced to the lowest level, taking account of technical progress and the availability of means of reducing vibration, in particular at source." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risks_resulting_from_vibrations .

pa:st-0581 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_vibration_design ;
    pa:condition "taking account of technical progress and the availability of means of reducing vibration" ;
    pa:locator "Annex III, 1.5.9" ;
    pa:quote "Vibrations Machinery or related products shall be designed and constructed in such a way that risks resulting from vibrations produced by the machinery or related product are reduced to the lowest level, taking account of technical progress and the availability of means of reducing vibration, in particular at source." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_reducing_vibration_in_particular_at_source .

pa:st-0583 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_undesirable_radiation_emissions ;
    pa:locator "Annex III, 1.5.10" ;
    pa:quote "Radiation Undesirable radiation emissions from machinery or related products shall be eliminated or be reduced to levels that do not have adverse effects on persons." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_adverse_effects_on_persons .

pa:st-0584 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_radiation_risk ;
    pa:condition "Where a risk exists" ;
    pa:locator "Annex III, 1.5.10" ;
    pa:quote "Where a risk exists, the necessary protective measures shall be taken." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_the_necessary_protective_measures_shall_be_taken .

pa:st-0585 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_functional_non_ionising_radiation_emissions ;
    pa:condition "during setting, operation and cleaning" ;
    pa:locator "Annex III, 1.5.10" ;
    pa:quote "Any functional non-ionising radiation emissions during setting, operation and cleaning shall be limited to levels that do not have adverse effects on persons." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_adverse_effects_on_persons .

pa:st-0587 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_11 ;
    pa:locator "Annex III, 1.5.11" ;
    pa:quote "External radiation Machinery or related products shall be designed and constructed in such a way that external radiation does not interfere with its operation." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_External_radiation .

pa:st-0589 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_laser_equipment_on_machinery ;
    pa:condition "Where laser equipment is used" ;
    pa:locator "Annex III, 1.5.12" ;
    pa:quote "(a) laser equipment on machinery or related products shall be designed and constructed in such a way as to prevent any accidental radiation;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_any_acc .

pa:st-0590 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_laser_equipment_on_machinery ;
    pa:condition "Where laser equipment is used" ;
    pa:locator "Annex III, 1.5.12" ;
    pa:quote "(b) laser equipment on machinery or related products shall be protected in such a way that effective radiation, radiation produced by reflection or diffusion and secondary radiation do not damage health;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_protected_in_such_a_way_that_effective_radiation_radiation_p .

pa:st-0591 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_optical_equipment_for_observation_or_adjustment_of_laser_equ ;
    pa:locator "Annex III, 1.5.12" ;
    pa:quote "(c) optical equipment for the observation or adjustment of laser equipment on machinery or related products shall be such that no health risk is created by laser radiation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_no_health_risk_is_created_by_laser_radiation .

pa:st-0592 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_laser_radiation ;
    pa:condition "Where laser equipment is used" ;
    pa:locator "Annex III, 1.5.12" ;
    pa:quote "(b) laser equipment on machinery or related products shall be protected in such a way that effective radiation, radiation produced by reflection or diffusion and secondary radiation do not damage health;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_do_not_damage_health .

pa:st-0593 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_13 ;
    pa:locator "Annex III, 1.5.13" ;
    pa:quote "Emissions of hazardous materials and substances Machinery or related products shall be designed and constructed in such a way that risks of inhalation, ingestion, contact with the skin, eyes and mucous membranes and penetration through the skin of hazardous materials and substances which it produces can be avoided." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risks_of_inhalation_ingestion_contact_with_the_skin .

pa:st-0594 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_13 ;
    pa:condition "Where a hazard cannot be eliminated" ;
    pa:locator "Annex III, 1.5.13" ;
    pa:quote "Where a hazard cannot be eliminated, the machinery or related product shall be so equipped that hazardous materials and substances can be contained, captured, evacuated, precipitated by water spraying, filtered or treated by another equally effective method." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_contained_captured_evacuated .

pa:st-0595 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_devices_for_containment_or_capture_filtration_or_separation_ ;
    pa:condition "Where the process is not totally enclosed during normal operation of the machinery or related product" ;
    pa:locator "Annex III, 1.5.13" ;
    pa:quote "Where the process is not totally enclosed during normal operation of the machinery or related product, the devices for containment or capture, filtration or separation and evacuation shall be situated in such a way as to have the maximum effect." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_devices_for_containment_or_capture_filtration_or_separation_ .

pa:st-0596 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_14 ;
    pa:condition "if that is impossible" ;
    pa:locator "Annex III, 1.5.14" ;
    pa:quote "Risk of being trapped in a machine Machinery or related products shall be designed, constructed or fitted with a means of preventing a person from being enclosed within it or, if that is impossible, with a means of summoning help." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_means_of_summoning_help .

pa:st-0597 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_15 ;
    pa:locator "Annex III, 1.5.15" ;
    pa:quote "Risk of slipping, tripping or falling Parts of the machinery or related product where persons are liable to move about or stand shall be designed and constructed in such a way as to prevent persons slipping, tripping or falling on or off these parts." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risk_of_slipping_tripping_or_falling .

pa:st-0598 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_parts_where_persons_move_about_or_stand ;
    pa:condition "where persons are liable to move about or stand" ;
    pa:locator "Annex III, 1.5.15" ;
    pa:quote "Risk of slipping, tripping or falling Parts of the machinery or related product where persons are liable to move about or stand shall be designed and constructed in such a way as to prevent persons slipping, tripping or falling on or off these parts." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_prevent_persons_slipping_tripping_or_falling .

pa:st-0599 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_parts_where_persons_move_about_or_stand ;
    pa:condition "Where appropriate" ;
    pa:locator "Annex III, 1.5.15" ;
    pa:quote "Where appropriate, these parts shall be fitted with handholds that are fixed relative to the user and that enable them to maintain their stability." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_handholds_that_are_fixed_relative_to_the_user .

pa:st-0600 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_in_need_of_protection_against_lightning ;
    pa:condition "in need of protection against the effects of lightning while being used" ;
    pa:locator "Annex III, 1.5.16" ;
    pa:quote "Lightning Machinery or related products in need of protection against the effects of lightning while being used shall be fitted with a system for conducting the resultant electrical charge to earth." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_system_for_conducting_the_resultant_electrical_charge_to_e .

pa:st-0601 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustment_and_maintenance_points ;
    pa:locator "Annex III, 1.6.1" ;
    pa:quote "Machinery or related product maintenance Adjustment and maintenance points shall be located outside danger zones." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_located_outside_danger_zones .

pa:st-0602 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustment_maintenance_repair_cleaning_and_servicing_operati ;
    pa:condition "while the machinery or related product is at a standstill" ;
    pa:locator "Annex III, 1.6.1" ;
    pa:quote "It shall be possible to carry out adjustment, maintenance, repair, cleaning and servicing operations while the machinery or related product is at a standstill." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_at_a_standstill .

pa:st-0603 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operations_that_cannot_be_done_at_standstill ;
    pa:condition "If one or more of the above conditions cannot be satisfied for technical reasons" ;
    pa:locator "Annex III, 1.6.1" ;
    pa:quote "If one or more of the above conditions cannot be satisfied for technical reasons, measures shall be taken to ensure that these operations can be carried out safely (see section 1.2.5)." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_measures_shall_be_taken .

pa:st-0604 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_diagnostic_fault_finding_equipment ;
    pa:condition "In the case of automated machinery and, where necessary, other machinery or related products" ;
    pa:locator "Annex III, 1.6.1" ;
    pa:quote "In the case of automated machinery and, where necessary, other machinery or related products, a connecting device for mounting diagnostic fault-finding equipment shall be provided." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_connecting_device .

pa:st-0606 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_accesses_for_persons_entering_machinery ;
    pa:condition "In the case of machinery or related products into which persons shall enter for operation, adjustment, maintenance or cleaning" ;
    pa:locator "Annex III, 1.6.2" ;
    pa:quote "In the case of machinery or related products into which persons shall enter for operation, adjustment, maintenance or cleaning, the machinery accesses shall be dimensioned and adapted for the use of rescue equipment in such a way that an emergency rescue of the persons is possible." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_dimensioned_and_adapted_for_the_use_of_rescue_equipment .

pa:st-0608 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_isolation_from_energy_sources ;
    pa:locator "Annex III, 1.6.3" ;
    pa:quote "Isolation of energy sources Machinery or related products shall be fitted with means to isolate it from all energy sources." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_means_to_isolate_it_from_all_energy_sources .

pa:st-0609 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolators ;
    pa:condition "if reconnection could endanger persons" ;
    pa:locator "Annex III, 1.6.3" ;
    pa:quote "They shall be capable of being locked if reconnection could endanger persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_capable_of_being_locked .

pa:st-0610 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolators ;
    pa:condition "where an operator is unable to check that the energy is still cut off" ;
    pa:locator "Annex III, 1.6.3" ;
    pa:quote "Isolators shall also be capable of being locked where an operator is unable, from any of the points to which he or she has access, to check that the energy is still cut off." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_capable_of_being_locked .

pa:st-0611 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_plugged_machinery ;
    pa:condition "if the operator can check that the plug remains removed" ;
    pa:locator "Annex III, 1.6.3" ;
    pa:quote "In the case of machinery or related products capable of being plugged into an electricity supply, removal of the plug is sufficient, if the operator can check from any of the points to which he or she has access that the plug remains removed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_removal_of_the_plug_is_sufficient .

pa:st-0612 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_energy_remaining_or_stored_in_circuits ;
    pa:condition "after the energy is cut off" ;
    pa:locator "Annex III, 1.6.3" ;
    pa:quote "After the energy is cut off, it shall be possible to dissipate normally any energy remaining or stored in the circuits of the machinery or related product without risk to persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_dissipate_normally .

pa:st-0613 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_circuits_kept_connected_to_energy_sources ;
    pa:condition "certain circuits may remain connected to their energy sources" ;
    pa:locator "Annex III, 1.6.3" ;
    pa:quote "As an exception to the requirement laid down in the previous paragraphs, certain circuits may remain connected to their energy sources in order, for example, to hold parts, to protect information, to light interiors, etc. In this case, special steps shall be taken to ensure operator safety." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_special_steps_shall_be_taken_to_ensure_operator_safety .

pa:st-0616 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_cleaning_of_internal_parts ;
    pa:condition "which have contained dangerous substances or mixtures" ;
    pa:locator "Annex III, 1.6.5" ;
    pa:quote "Cleaning of internal parts The machinery or related product shall be designed and constructed in such a way that it is possible to clean internal parts, which have contained dangerous substances or mixtures without entering them;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_possible_to_clean_internal_parts .

pa:st-0617 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_necessary_unblocking_of_internal_parts ;
    pa:locator "Annex III, 1.6.5" ;
    pa:quote "any necessary unblocking shall also be possible from the outside." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_possible_from_the_outside .

pa:st-0618 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_cleaning_where_entering_cannot_be_avoided ;
    pa:condition "If it is impossible to avoid entering the machinery or related product" ;
    pa:locator "Annex III, 1.6.5" ;
    pa:quote "If it is impossible to avoid entering the machinery or related product, it shall be designed and constructed in such a way as to allow cleaning to take place safely." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_allow_cleaning_ .

pa:st-0621 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_warning_devices ;
    pa:condition "Where the health and safety of persons may be endangered by a fault in the operation of unsupervised machinery or a related product" ;
    pa:locator "Annex III, 1.7.1.2" ;
    pa:quote "Warning devices Where the health and safety of persons may be endangered by a fault in the operation of unsupervised machinery or a related product, the machinery or related product shall be equipped in such a way as to give an appropriate acoustic or light signal as a warning." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_appropriate_acoustic_or_light_signal .

pa:st-0622 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_operator ;
    pa:locator "Annex III, 1.7.1.2" ;
    pa:quote "The operator shall have facilities to check the operation of such warning devices at all times." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "have facilities to check the operation of such warning devices at all times" .

pa:st-0624 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_warning_of_residual_risks ;
    pa:condition "Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted" ;
    pa:locator "Annex III, 1.7.2" ;
    pa:quote "Warning of residual risks Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted, the necessary warnings, including warning devices, shall be provided." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_the_necessary_warnings_including_warning_devices .

pa:st-0625 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_7_2 ;
    pa:condition "Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted" ;
    pa:locator "Annex III, 1.7.2" ;
    pa:quote "Warning of residual risks Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted, the necessary warnings, including warning devices, shall be provided." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risks_remain .

pa:st-0627 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_its_authorised_representative ;
    pa:condition "intended for use by specialised personnel mandated by the manufacturer or its authorised representative; by way of exception to Article 10(7)" ;
    pa:locator "Annex III, 1.7.4" ;
    pa:quote "By way of exception to Article 10(7), the maintenance instructions intended for use by specialised personnel mandated by the manufacturer or its authorised representative may be supplied in only one official language of the Union which the specialised personnel understand." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "may be supplied in only one official language of the Union" .

pa:st-0629 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_contents_of_the_instructions_for_use ;
    pa:locator "Annex III, 1.7.4.1" ;
    pa:quote "General principles for the drafting of instructions for use (a) The contents of the instructions for use shall cover not only the intended use of the machinery or related product but also take into account any reasonably foreseeable misuse thereof;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall cover not only the intended use" .

pa:st-0630 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_wording_and_layout_of_the_instructions_for_use ;
    pa:condition "In the case of machinery or related products intended for use by non-professional operators" ;
    pa:locator "Annex III, 1.7.4.1" ;
    pa:quote "(b) In the case of machinery or related products intended for use by non-professional operators, the wording and layout of the instructions for use shall take into account the level of general education and acumen that can reasonably be expected from such operators." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall take into account the level of general education and acumen" .

pa:st-0632 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery ;
    pa:locator "Annex III, 1.7.4.2" ;
    pa:quote "Contents of the instructions for use 1." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_instructions_for_use .

pa:st-0633 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex III, 1.7.4.2" ;
    pa:quote "(a) the business name and full address of the manufacturer and, where applicable, of its authorised representative;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the business name and full address of the manufacturer" .

pa:st-0634 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "or the internet address or machine readable code, where the EU declaration of conformity can be accessed, in accordance with Article 10(8)" ;
    pa:locator "Annex III, 1.7.4.2" ;
    pa:quote "(c) the EU declaration of conformity, or the internet address or machine readable code, where the EU declaration of conformity can be accessed, in accordance with Article 10(8);" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the EU declaration of conformity" .

pa:st-0635 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex III, 1.7.4.2" ;
    pa:quote "(l) information about the residual risks that remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "information about the residual risks that remain despite the inherent safe design measures" .

pa:st-0638 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_and_related_products_for_foodstuffs ;
    pa:locator "Annex III, 2.1" ;
    pa:quote "2.1. Machinery and related products for foodstuffs and machinery and related products for cosmetics or pharmaceutical products" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_2_1 .

pa:st-0639 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_EssentialRequirement_2_1_1 ;
    pa:condition "intended for use with foodstuffs or with cosmetics or pharmaceutical products" ;
    pa:locator "Annex III, 2.1.1" ;
    pa:quote "General Machinery or related products intended for use with foodstuffs or with cosmetics or pharmaceutical products shall be designed and constructed in such a way as to avoid any risk of infection, sickness or contagion." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_infection_sickness_or_contagion .

pa:st-0640 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_materials_in_contact_with_foodstuffs_2_1_1_a ;
    pa:condition "where materials cannot be cleaned before each use" ;
    pa:locator "Annex III, 2.1.1" ;
    pa:quote "the machinery or related product shall be designed and constructed in such a way that these materials can be cleaned before each use and where this is not possible, disposable parts shall be used;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_disposable_parts_shall_be_used .

pa:st-0641 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_surfaces_in_contact_with_foodstuffs_2_1_1_b_iii ;
    pa:condition "where necessary after removing easily dismantled parts" ;
    pa:locator "Annex III, 2.1.1" ;
    pa:quote "(iii) be easily cleaned and disinfected, where necessary after removing easily dismantled parts;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_be_easily_cleaned_and_disinfected .

pa:st-0642 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_liquids_gases_and_aerosols_2_1_1_c ;
    pa:condition "if possible, in a ‘cleaning’ position" ;
    pa:locator "Annex III, 2.1.1" ;
    pa:quote "(c) it shall be possible for liquids, gases and aerosols deriving from foodstuffs, cosmetics or pharmaceutical products as well as from cleaning, disinfecting and rinsing fluids to be completely discharged from the machinery or related product (if possible, in a ‘cleaning’ position);" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_completely_discharged .

pa:st-0643 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_substances_or_living_creatures_2_1_1_d ;
    pa:condition "in areas that cannot be cleaned" ;
    pa:locator "Annex III, 2.1.1" ;
    pa:quote "(d) machinery or related products shall be designed and constructed in such a way as to prevent any substances or living creatures, in particular insects, from entering, or any organic matter from accumulating in, areas that cannot be cleaned;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_prevent_any_substances_or_living_creatures_in_particular_ins .

pa:st-0644 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_ancillary_substances_2_1_1_e ;
    pa:condition "can come into contact with foodstuffs or water intended for human consumption, cosmetics or pharmaceutical products" ;
    pa:locator "Annex III, 2.1.1" ;
    pa:quote "(e) machinery or related products shall be designed and constructed in such a way that no ancillary substances hazardous to health, including the lubricants used, can come into contact with foodstuffs or water intended for human consumption, cosmetics or pharmaceutical products;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_no_ancillary_substances_hazardous_to_health .

pa:st-0647 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_portable_hand_held_or_hand_guided_machinery_or_related_produ ;
    pa:locator "Annex III, 2.2" ;
    pa:quote "2.2. Portable hand-held or hand-guided machinery or related products" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_2_2 .

pa:st-0648 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_machinery_handles ;
    pa:condition "except where technically impossible, or where there is an independent control device, in the case of handles which cannot be released in complete safety" ;
    pa:locator "Annex III, 2.2.1" ;
    pa:quote "(b) except where technically impossible, or where there is an independent control device, in the case of handles which cannot be released in complete safety, be fitted with manual start and stop control devices arranged in such a way that the operator can operate them without releasing the handles;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_manual_start_and_stop_control_devices .

pa:st-0649 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_machinery_point_2_2_1_c ;
    pa:condition "equivalent steps shall be taken if this requirement is not technically feasible" ;
    pa:locator "Annex III, 2.2.1" ;
    pa:quote "(c) present no risks of accidental starting or continued operation after the operator has released the handles; equivalent steps shall be taken if this requirement is not technically feasible;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_accidental_starting_or_continued_operation .

pa:st-0650 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_machinery ;
    pa:condition "this requirement does not apply if it leads to a new hazard or where the main function of the machinery or related product is the application of hazardous substances" ;
    pa:locator "Annex III, 2.2.1" ;
    pa:quote "(e) have a device or a connected exhaust system, with an extraction connection outlet or equivalent system to capture or reduce emissions of hazardous substances; this requirement does not apply if it leads to a new hazard or where the main function of the machinery or related product is the application of hazardous substances and to emissions of internal combustion engines;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_device_or_a_connected_exhaust_system .

pa:st-0651 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_machinery ;
    pa:condition "depending on the type of machinery or related product" ;
    pa:locator "Annex III, 2.2.1" ;
    pa:quote "(a) depending on the type of machinery or related product, have a supporting surface of sufficient size and have a sufficient number of handles and supports of an appropriate size, arranged in such a way as to ensure the stability of the machinery or related product under the intended operating conditions;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_supporting_surface_of_sufficient_size .

pa:st-0652 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_machinery ;
    pa:condition "where necessary" ;
    pa:locator "Annex III, 2.2.1" ;
    pa:quote "(d) permit, where necessary, visual observation of the danger zone and of the action of the tool with the material being processed;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_visual_observation_of_the_danger_zone .

pa:st-0653 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_portable_handheld_or_hand_guided_machinery ;
    pa:condition "transmitted by portable handheld or hand-guided machinery or related products" ;
    pa:locator "Annex III, 2.2.1.1" ;
    pa:quote "Instructions for use The instructions for use shall give the following information concerning vibrations, expressed as acceleration (m/s 2 ), and transmitted by portable handheld or hand-guided machinery or related products:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_The_instructions_for_use .

pa:st-0654 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_portable_fixing_and_other_impact_machinery ;
    pa:locator "Annex III, 2.2.2" ;
    pa:quote "2.2.2. Portable fixing and other impact machinery or related products" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_Portable_fixing_and_other_impact_machinery .

pa:st-0655 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_fixing_and_other_impact_machinery ;
    pa:condition "unless the machinery or related product is positioned correctly with adequate pressure on the base material" ;
    pa:locator "Annex III, 2.2.2.1" ;
    pa:quote "(b) an enabling device prevents impact unless the machinery or related product is positioned correctly with adequate pressure on the base material;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_enabling_device .

pa:st-0656 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_fixing_and_other_impact_machinery ;
    pa:condition "Where necessary" ;
    pa:locator "Annex III, 2.2.2.1" ;
    pa:quote "Where necessary, it shall be possible to fit the device with splinter guard(s) and the appropriate guard(s) shall be provided by the manufacturer of the machinery or related product." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_splinter_guard_s .

pa:st-0657 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_fixing_and_other_impact_machinery ;
    pa:locator "Annex III, 2.2.2.1" ;
    pa:quote "(c) involuntary triggering is prevented;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_involuntary_triggering .

pa:st-0658 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_fixing_and_other_impact_machinery ;
    pa:locator "Annex III, 2.2.2.1" ;
    pa:quote "(d) accidental triggering is prevented during handling or in case of shock;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_accidental_triggering .

pa:st-0659 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_the_machinery_or_related_product ;
    pa:condition "Where necessary" ;
    pa:locator "Annex III, 2.2.2.1" ;
    pa:quote "Where necessary, it shall be possible to fit the device with splinter guard(s) and the appropriate guard(s) shall be provided by the manufacturer of the machinery or related product." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the appropriate guard(s) shall be provided" .

pa:st-0660 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_for_working_wood_tool_run_down ;
    pa:condition "if there is a risk of contact with the tool whilst it runs down" ;
    pa:locator "Annex III, 2.3" ;
    pa:quote "(c) the machinery or related product shall be equipped with an automatic brake that stops the tool in a sufficiently short time if there is a risk of contact with the tool whilst it runs down;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_automatic_brake .

pa:st-0661 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_for_working_wood_ejection_of_work_pieces ;
    pa:condition "where the machinery or related product is likely to be used in conditions involving the risk of ejection of work pieces or parts of them" ;
    pa:locator "Annex III, 2.3" ;
    pa:quote "(b) where the machinery or related product is likely to be used in conditions involving the risk of ejection of work pieces or parts of them, it shall be designed, constructed, or equipped in such a way as to prevent such ejection, or, if this is not possible, so that the ejection does not engender risks for the operator and/or exposed persons;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_ejection_of_work_pieces .

pa:st-0662 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_non_fully_automated_machinery_with_incorporated_tool ;
    pa:condition "where the tool is incorporated into non-fully automated machinery or a related product" ;
    pa:locator "Annex III, 2.3" ;
    pa:quote "(d) where the tool is incorporated into non-fully automated machinery or a related product, that machinery or related product shall be designed and constructed in such a way as to eliminate or reduce the risk of accidental injury." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_accidental_injury .

pa:st-0664 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Machinery_or_related_products_for_plant_protection_products_ ;
    pa:condition "For the purposes of section 2.4" ;
    pa:locator "Annex III, 2.4" ;
    pa:quote "For the purposes of section 2.4., the following definition applies: ‘Machinery or related products for plant protection products application’ means machinery or related products specifically intended for the application of plant protection products within the meaning of Article 2(1), of Regulation (EC) No 1107/2009 of the European Parliament and of the Council ( 1 ) ." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "specifically intended for the application of plant protection products" .

pa:st-0665 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_machinery_for_plant_protection_products_appl ;
    pa:locator "Annex III, 2.4.2" ;
    pa:quote "General The manufacturer of machinery or related products for plant protection products application shall ensure that an assessment is carried out of the risks of unintended exposure of the environment to plant protection products, in accordance with the process of risk assessment and risk reduction referred to in the General Principles, point 1." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that an assessment is carried out" .

pa:st-0666 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_2_leakage ;
    pa:condition "at all times" ;
    pa:locator "Annex III, 2.4.2" ;
    pa:quote "Leakage shall be prevented at all times." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_Leakage_shall_be_prevented .

pa:st-0668 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_controls_and_monitoring ;
    pa:locator "Annex III, 2.4.3" ;
    pa:quote "Controls and monitoring It shall be possible to easily and accurately control, monitor and immediately stop the plant protection products application from the operating positions." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_control_monitor_and_immediately_stop .

pa:st-0669 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_4 ;
    pa:condition "during such operations" ;
    pa:locator "Annex III, 2.4.4" ;
    pa:quote "Filling and emptying The machinery or related product shall be designed and constructed to facilitate precise filling with the necessary quantity of plant protection products and to ensure easy and complete emptying, while preventing spillage of plant protection products and avoiding the contamination of the water source during such operations." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_spillage_of_plant_protection_products .

pa:st-0670 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_4 ;
    pa:condition "during such operations" ;
    pa:locator "Annex III, 2.4.4" ;
    pa:quote "Filling and emptying The machinery or related product shall be designed and constructed to facilitate precise filling with the necessary quantity of plant protection products and to ensure easy and complete emptying, while preventing spillage of plant protection products and avoiding the contamination of the water source during such operations." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_contamination_of_the_water_source .

pa:st-0671 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_or_related_product ;
    pa:locator "Annex III, 2.4.4" ;
    pa:quote "Filling and emptying The machinery or related product shall be designed and constructed to facilitate precise filling with the necessary quantity of plant protection products and to ensure easy and complete emptying, while preventing spillage of plant protection products and avoiding the contamination of the water source during such operations." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_to_facilitate_precise_filling .

pa:st-0672 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_application_rate_point_2_4_5_1 ;
    pa:locator "Annex III, 2.4.5.1" ;
    pa:quote "Application rate The machinery or related product shall be fitted with means of adjusting the application rate easily, accurately and reliably." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_means_of_adjusting_the_application_rate_easily_accurately_an .

pa:st-0673 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_5_2 ;
    pa:condition "\"\"" ;
    pa:locator "Annex III, 2.4.5.2" ;
    pa:quote "Distribution, deposition and drift of plant protection products The machinery or related product shall be designed and constructed to ensure that the plant protection product is deposited on target areas, to minimise losses to other areas and to prevent drift of plant protection products to the environment." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_drift_of_plant_protection_products_to_the_environment .

pa:st-0674 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_5_2 ;
    pa:condition "\"\"" ;
    pa:locator "Annex III, 2.4.5.2" ;
    pa:quote "Distribution, deposition and drift of plant protection products The machinery or related product shall be designed and constructed to ensure that the plant protection product is deposited on target areas, to minimise losses to other areas and to prevent drift of plant protection products to the environment." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_losses_to_other_areas .

pa:st-0676 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "In order to verify that the relevant parts of the machinery or related product comply with the requirements set out in sections 2.4.5.1 and 2.4.5.2, for each type of machinery or related product concerned" ;
    pa:locator "Annex III, 2.4.5.3" ;
    pa:quote "Tests In order to verify that the relevant parts of the machinery or related product comply with the requirements set out in sections 2.4.5.1 and 2.4.5.2, the manufacturer shall, for each type of machinery or related product concerned, perform appropriate tests, or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "perform appropriate tests, or have such tests performed" .

pa:st-0677 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_5_4 ;
    pa:condition "while the plant protection products application function is stopped" ;
    pa:locator "Annex III, 2.4.5.4" ;
    pa:quote "2.4.5.4. Losses during stoppage The machinery or related product shall be designed and constructed to prevent losses while the plant protection products application function is stopped." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Losses_during_stoppage .

pa:st-0680 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_6_2 ;
    pa:condition "without contamination of the environment" ;
    pa:locator "Annex III, 2.4.6.2" ;
    pa:quote "Servicing The machinery or related product shall be designed and constructed to facilitate the changing of worn parts without contamination of the environment." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_to_facilitate_the_changing_of_worn_ .

pa:st-0682 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_nozzles_strainers_and_filters ;
    pa:locator "Annex III, 2.4.8" ;
    pa:quote "Marking of nozzles, strainers and filters Nozzles, strainers and filters shall be marked so that their type and size can be clearly identified." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_shall_be_marked .

pa:st-0684 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_4_9_indication_of_plant_protection_p ;
    pa:condition "Where appropriate" ;
    pa:locator "Annex III, 2.4.9" ;
    pa:quote "Indication of the plant protection product in use Where appropriate, the machinery or related product shall be fitted with a specific mounting on which the operator can place the name of the plant protection product in use." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_specific_mounting .

pa:st-0685 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_regular_inspection_of_machinery_or_related_product ;
    pa:condition "may be subject to national requirements for regular inspection" ;
    pa:locator "Annex III, 2.4.10" ;
    pa:quote "(i) an indication that the machinery or related product may be subject to national requirements for regular inspection by designated bodies, as provided for in Directive 2009/128/EC of the European Parliament and of the Council ( 2 ) ;" ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "REG" ;
    pa:value pa:VerifyingBody_designated_bodies .

pa:st-0687 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Machinery_or_related_products_presenting_risks_due_to_their_ ;
    pa:condition "the operation requires mobility while working, or continuous or semi continuous movement between fixed working locations" ;
    pa:locator "Annex III, 3.1" ;
    pa:quote "(a) ‘Machinery or related products presenting risks due to their mobility’ means: (i) machinery or related products, the operation of which requires either mobility while working, or continuous or semi continuous movement between a succession of fixed working locations;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "requires either mobility while working" .

pa:st-0688 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Machinery_or_related_products_presenting_risks_due_to_their_ ;
    pa:condition "machinery operated without being moved but which may be equipped to be moved more easily" ;
    pa:locator "Annex III, 3.1" ;
    pa:quote "or (ii) machinery or related products which are operatedwithout being moved, but which may be equipped in such a way as to enable it to be moved more easily from one place to another;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "operatedwithout being moved" .

pa:st-0689 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Driver ;
    pa:condition "may be transported by the machinery, on foot, or guide it by remote control" ;
    pa:locator "Annex III, 3.1" ;
    pa:quote "(b) ‘Driver’ means an operator responsible for the movement of machinery or a related product, who may be transported by the machinery or may be on foot, accompanying the machinery, or may guide the machinery by remote control;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "operator responsible for the movement" .

pa:st-0690 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Autonomous_mobile_machinery ;
    pa:condition "all essential safety functions ensured without permanent interaction of an operator" ;
    pa:locator "Annex III, 3.1" ;
    pa:quote "(c) ‘Autonomous mobile machinery’ means mobile machinery which has an autonomous mode, in which all the essential safety functions of the mobile machinery are ensured in its travel and working operations area without permanent interaction of an operator;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "has an autonomous mode" .

pa:st-0691 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Supervisor ;
    pa:locator "Annex III, 3.1" ;
    pa:quote "(d) ‘Supervisor’ means a person responsible for the supervision of autonomous mobile machinery;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a person responsible for the supervision of autonomous mobile machinery" .

pa:st-0692 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Supervisory_function ;
    pa:condition "by a device receiving information or alerts and giving limited orders" ;
    pa:locator "Annex III, 3.1" ;
    pa:quote "(e) ‘Supervisory function’ means remote non permanent surveillance of autonomous mobile machinery by a device allowing to receive information or alerts and to give limited orders to this machinery." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "remote non permanent surveillance" .

pa:st-0693 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_visibility_from_the_driving_position ;
    pa:condition "Where necessary" ;
    pa:locator "Annex III, 3.2.1" ;
    pa:quote "Where necessary, appropriate devices shall be provided to remedy risks due to inadequate direct vision." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_appropriate_devices_shall_be_provided .

pa:st-0694 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_driving_position_wheels_and_tracks ;
    pa:condition "from the driving positions" ;
    pa:locator "Annex III, 3.2.1" ;
    pa:quote "Machinery or a related product on which the driver is transported shall be designed and constructed in such a way that, from the driving positions, there is no risk to the driver from inadvertent contact with the wheels and tracks." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_to_the_driver_from_inadvertent_contact_with_the_wheels_ .

pa:st-0696 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_seating ;
    pa:condition "where there is a risk that operators or other persons transported by the machinery may be crushed between parts of the machinery and the surroundings should the machinery roll or tip over" ;
    pa:locator "Annex III, 3.2.2" ;
    pa:quote "Seating Where there is a risk that operators or other persons transported by the machinery may be crushed between parts of the machinery and the surroundings should the machinery roll or tip over, in particular for machinery equipped with a protective structure referred to in section 3.4.3 or 3.4.4:" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_crushed_between_parts_of_the_machinery_and_the_surroundings .

pa:st-0697 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_seating ;
    pa:condition "such restraint systems or provision shall take ergonomic principles into account and shall not be fitted if they increase the risk" ;
    pa:locator "Annex III, 3.2.2" ;
    pa:quote "(a) the machinery shall be designed or equipped with a restraint system so as to keep the persons in their seats or in the protective structure, without restricting movements necessary for operations or movements relative to the structure caused by the suspension of the seats; where there is a significant risk of roll or tip over and its restraint system is not used it shall not be possible for the machinery to move; such restraint systems or provision shall take ergonomic principles into account and shall not be fitted if they increase the risk;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_restraint_system .

pa:st-0698 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_seating ;
    pa:condition "where there is a significant risk of roll or tip over and its restraint system is not used" ;
    pa:locator "Annex III, 3.2.2" ;
    pa:quote "where there is a significant risk of roll or tip over and its restraint system is not used it shall not be possible for the machinery to move;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_it_shall_not_be_possible_for_the_machinery_to_move .

pa:st-0699 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_seating ;
    pa:condition "when the driver is in the driving position and not using the restraint system" ;
    pa:locator "Annex III, 3.2.2" ;
    pa:quote "(b) a visual and audible signal shall be provided at the driving position alerting the driver when the driver is in the driving position and not using the restraint system." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_visual_and_audible_signal .

pa:st-0700 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_EssentialRequirement_3_2_3_positions_for_other_persons ;
    pa:condition "If the conditions of use provide that persons other than the driver may occasionally or regularly be transported by the machinery or work on it" ;
    pa:locator "Annex III, 3.2.3" ;
    pa:quote "Positions for other persons If the conditions of use provide that persons other than the driver may occasionally or regularly be transported by the machinery or work on it, appropriate positions shall be provided which enable them to be transported or to work on it without risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_appropriate_positions .

pa:st-0702 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_autonomous_mobile_machinery ;
    pa:condition "Where relevant" ;
    pa:locator "Annex III, 3.2.4" ;
    pa:quote "Supervisory function Where relevant, autonomous mobile machinery or related products shall have a supervisory function specific to the autonomous mode." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_supervisory_function_specific_to_the_autonomous_mode .

pa:st-0703 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_supervisory_function ;
    pa:condition "only when the supervisor can see directly or indirectly the machine’s movement and working area and the protective devices are operational" ;
    pa:locator "Annex III, 3.2.4" ;
    pa:quote "The supervisory function shall only allow actions to stop and to start remotely the machinery or related product or move it to a safe position and a safe state to avoid causing other risks. It shall be designed and constructed to allow those actions only when the supervisor can see directly or indirectly the machine’s movement and working area and the protective devices are operational." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_only_allow_actions_to_stop_and_to_start_remotely_the_machine .

pa:st-0704 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_without_active_supervisory_function ;
    pa:condition "If the supervisory function is not active" ;
    pa:locator "Annex III, 3.2.4" ;
    pa:quote "If the supervisory function is not active, the machinery shall not be able to operate." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_shall_not_be_able_to_operate .

pa:st-0706 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_systems ;
    pa:condition "If necessary" ;
    pa:locator "Annex III, 3.3" ;
    pa:quote "Control systems If necessary, steps shall be taken to prevent unauthorised use of controls." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_steps_shall_be_taken_to_prevent_unauthorised_use .

pa:st-0707 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_remote_control_system ;
    pa:condition "In the case of remote controls" ;
    pa:locator "Annex III, 3.3" ;
    pa:quote "The remote control system shall be designed and constructed in such a way as to affect only: (a) the machinery or related product in question; (b) the functions in question." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_affect_only .

pa:st-0708 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_remote_controlled_machinery ;
    pa:locator "Annex III, 3.3" ;
    pa:quote "Remote-controlled machinery or related products shall be designed and constructed in such a way that it will respond only to signals from the intended control units." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_will_respond_only_to_signals_from_the_intended_control_units .

pa:st-0709 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_system ;
    pa:condition "For autonomous mobile machinery or related product; even when actions are ordered by using a remote supervisory function" ;
    pa:locator "Annex III, 3.3" ;
    pa:quote "For autonomous mobile machinery or related product, the control system shall be designed to perform the safety functions by itself as set out in this section, even when actions are ordered by using a remote supervisory function." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_to_perform_the_safety_functions_by_itself .

pa:st-0711 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_except_those_with_pre_set_positions ;
    pa:condition "where their operation can lead to hazards, notably dangerous movements; except those with pre-set positions" ;
    pa:locator "Annex III, 3.3.1" ;
    pa:quote "Where their operation can lead to hazards, notably dangerous movements, the control devices, except for those with pre-set positions, shall return to the neutral position as soon as they are released by the operator." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_return_to_the_neutral_position .

pa:st-0712 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_operation ;
    pa:condition "where their operation can lead to hazards" ;
    pa:locator "Annex III, 3.3.1" ;
    pa:quote "Where their operation can lead to hazards, notably dangerous movements, the control devices, except for those with pre-set positions, shall return to the neutral position as soon as they are released by the operator." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_hazards_notably_dangerous_movements .

pa:st-0713 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_pedals ;
    pa:condition "where there are pedals" ;
    pa:locator "Annex III, 3.3.1" ;
    pa:quote "Where there are pedals, they shall be so designed, constructed and fitted as to allow safe operation by the driver with the minimum risk of incorrect operation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_minimum_risk_of_incorrect_operation .

pa:st-0714 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_pedals ;
    pa:condition "where there are pedals" ;
    pa:locator "Annex III, 3.3.1" ;
    pa:quote "Where there are pedals, they shall be so designed, constructed and fitted as to allow safe operation by the driver with the minimum risk of incorrect operation. They shall have a slip-resistant surface and be easy to clean." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_slip_resistant_surface .

pa:st-0715 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_steering_system_of_wheeled_machinery ;
    pa:condition "in the case of wheeled machinery; movements caused by shocks to the guide wheels" ;
    pa:locator "Annex III, 3.3.1" ;
    pa:quote "In the case of wheeled machinery, the steering system shall be designed and constructed in such a way as to reduce the force of sudden movements of the steering wheel or the steering lever caused by shocks to the guide wheels." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_reduce_the_force_of_sudden_movements .

pa:st-0716 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_locking_the_differential ;
    pa:locator "Annex III, 3.3.1" ;
    pa:quote "Any control that locks the differential shall be so designed and arranged that it allows the differential to be unlocked when the machinery is moving." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_allows_the_differential_to_be_unlocked_when_the_machinery_is .

pa:st-0718 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_with_a_ride_on_driver_travel_moveme ;
    pa:condition "self-propelled machinery with a ride-on driver" ;
    pa:locator "Annex III, 3.3.2" ;
    pa:quote "Starting/moving All travel movements of self-propelled machinery with a ride-on driver shall be possible only if the driver is at the controls." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_only_if_the_driver_is_at_the_controls .

pa:st-0719 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_driver_checking_devices_that_exceed_the_normal_clearance_zon ;
    pa:condition "where machinery is fitted with devices which exceed its normal clearance zone" ;
    pa:locator "Annex III, 3.3.2" ;
    pa:quote "Where, for operating purposes, machinery is fitted with devices which exceed its normal clearance zone (e.g. stabilisers, jib, etc.), the driver shall be provided with the means of checking easily, before moving the machinery, that such devices are in a particular position which allows safe movement." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_the_means_of_checking_easily .

pa:st-0720 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_of_machinery_depending_on_safe_positioning_of_parts ;
    pa:condition "where it does not give rise to other risks" ;
    pa:locator "Annex III, 3.3.2" ;
    pa:quote "Where it does not give rise to other risks, movement of the machinery shall depend on safe positioning of the aforementioned parts." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_movement_of_the_machinery_shall_depend_on_safe_positioning .

pa:st-0721 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_unintentional_movement_while_engine_is_being_started ;
    pa:condition "while the engine is being started" ;
    pa:locator "Annex III, 3.3.2" ;
    pa:quote "It shall not be possible for unintentional movement of the machinery to occur while the engine is being started." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_not_be_possible_for_unintentional_movement .

pa:st-0723 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery ;
    pa:condition "Where safety so requires, in the event of a failure of the main device, or in the absence of the energy supply needed to actuate the main device" ;
    pa:locator "Annex III, 3.3.3" ;
    pa:quote "Where safety so requires, in the event of a failure of the main device, or in the absence of the energy supply needed to actuate the main device, an emergency device with a fully independent and easily accessible control device shall be provided for slowing down and stopping." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_an_emergency_device_with_a_fully_independent_and_easily_acce .

pa:st-0724 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_stationary_machinery ;
    pa:condition "Where safety so requires" ;
    pa:locator "Annex III, 3.3.3" ;
    pa:quote "Where safety so requires, a parking device shall be provided to render stationary machinery immobile." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_parking_device .

pa:st-0725 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_autonomous_mobile_machinery ;
    pa:condition "with one or both where necessary according to the risk assessment" ;
    pa:locator "Annex III, 3.3.3" ;
    pa:quote "Autonomous mobile machinery or related products shall comply, with one or both where necessary according to the risk assessment, of the following conditions: (i) it shall move and operate in an enclosed zone fitted with a peripheral protection system comprising guards or protective devices;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_an_enclosed_zone_fitted_with_a_peripheral_protection_system_ .

pa:st-0726 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_autonomous_mobile_machinery ;
    pa:condition "where those obstacles could give rise to a risk to the health and safety of persons or domestic animals or to the safe operation of the machinery or related product" ;
    pa:locator "Annex III, 3.3.3" ;
    pa:quote "(ii) it shall be equipped with devices intended to detect any human, domestic animal or any other obstacle in its vicinity, where those obstacles could give rise to a risk to the health and safety of persons or domestic animals or to the safe operation of the machinery or related product." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_devices_intended_to_detect_any_human_domestic_animal_or_any_ .

pa:st-0728 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_pedestrian_controlled_self_propelled_machinery_movement ;
    pa:condition "only through sustained action by the driver" ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "Movement of pedestrian-controlled machinery Movement of pedestrian-controlled self-propelled machinery shall be possible only through sustained action on the relevant control device by the driver." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_sustained_action_on_the_relevant_control_device .

pa:st-0729 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_while_engine_is_being_started ;
    pa:condition "while the engine is being started" ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "In particular, it shall not be possible for movement to occur while the engine is being started." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_it_shall_not_be_possible_for_movement_to_occur .

pa:st-0730 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_systems_for_pedestrian_controlled_machinery ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "The control systems for pedestrian-controlled machinery shall be designed in such a way as to minimise the risks arising from inadvertent movement of the machinery towards the driver, in particular:" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_inadvertent_movement_of_the_machinery_towards_the_driver .

pa:st-0731 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_systems_for_pedestrian_controlled_machinery ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "(a) crushing;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_crushing .

pa:st-0732 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_systems_for_pedestrian_controlled_machinery ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "(b) injury from rotating tools." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_injury_from_rotating_tools .

pa:st-0733 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_on_which_a_rotary_tool_may_be_fitted ;
    pa:condition "except where the movement of the machinery results from movement of the tool" ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "In the case of machinery on which a rotary tool may be fitted, it shall not be possible to actuate the tool when the reverse control is engaged, except where the movement of the machinery results from movement of the tool." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_it_shall_not_be_possible_to_actuate_the_tool_when_the_revers .

pa:st-0734 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_reversing_speed_of_machinery_with_rotary_tool ;
    pa:condition "In the latter case" ;
    pa:locator "Annex III, 3.3.4" ;
    pa:quote "In the latter case, the reversing speed shall be such that it does not endanger the driver." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_the_reversing_speed_shall_be_such_that_it_does_not_endanger_ .

pa:st-0737 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_4_1 ;
    pa:condition "when moved" ;
    pa:locator "Annex III, 3.4.1" ;
    pa:quote "Uncontrolled movements Machinery or related products shall be designed, constructed, and where appropriate placed on a mobile support, in such a way as to ensure that, when moved, uncontrolled oscillations of its centre of gravity do not affect its stability or exert excessive strain on its structure." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_uncontrolled_oscillations_of_its_centre_of_gravity .

pa:st-0739 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_roll_over_and_tip_over_requirement ;
    pa:condition "where there is a risk of rolling or tipping over; unless this increases the risk" ;
    pa:locator "Annex III, 3.4.3" ;
    pa:quote "Roll-over and tip-over Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk of rolling or tipping over, the machinery shall be fitted with an appropriate protective structure, unless this increases the risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_an_appropriate_protective_structure .

pa:st-0740 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_roll_over_and_tip_over_requirement ;
    pa:condition "where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk of rolling or tipping over" ;
    pa:locator "Annex III, 3.4.3" ;
    pa:quote "Roll-over and tip-over Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk of rolling or tipping over, the machinery shall be fitted with an appropriate protective structure, unless this increases the risk." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_rolling_or_tipping_over .

pa:st-0741 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "for each type of structure concerned; to verify compliance with the requirement of the second paragraph" ;
    pa:locator "Annex III, 3.4.3" ;
    pa:quote "In order to verify that the structure complies with the requirement laid down in the second paragraph, the manufacturer shall, for each type of structure concerned, perform appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "perform appropriate tests or have such tests performed" .

pa:st-0743 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_3_4_4_falling_objects_requirement ;
    pa:condition "self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk due to falling objects or material" ;
    pa:locator "Annex III, 3.4.4" ;
    pa:quote "Falling objects Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk due to falling objects or material, the machinery shall be designed and constructed in such a way as to take account of this risk and fitted, if its size allows, with an appropriate protective structure." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_falling_objects .

pa:st-0744 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_ride_on_self_propelled_machinery ;
    pa:condition "if its size allows" ;
    pa:locator "Annex III, 3.4.4" ;
    pa:quote "Falling objects Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk due to falling objects or material, the machinery shall be designed and constructed in such a way as to take account of this risk and fitted, if its size allows, with an appropriate protective structure." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_appropriate_protective_structure .

pa:st-0745 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "for each type of structure concerned" ;
    pa:locator "Annex III, 3.4.4" ;
    pa:quote "In order to verify that the structure complies with the requirement laid down in the second paragraph, the manufacturer shall, for each type of structure concerned, perform appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "perform appropriate tests or have such tests performed" .

pa:st-0747 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_means_of_access ;
    pa:locator "Annex III, 3.4.5" ;
    pa:quote "Means of access Handholds and steps shall be designed, constructed and arranged in such a way that the operators use them instinctively and do not use the control devices to assist access." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_Handholds_and_steps .

pa:st-0749 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_used_to_tow_or_be_towed ;
    pa:locator "Annex III, 3.4.6" ;
    pa:quote "Towing devices All machinery used to tow or to be towed shall be fitted with towing or coupling devices designed, constructed and arranged in such a way as to ensure easy and secure connection and disconnection and to prevent accidental disconnection during use." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_towing_or_coupling_devices .

pa:st-0750 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_subject_to_tow_bar_load ;
    pa:condition "Insofar as the tow bar load so requires" ;
    pa:locator "Annex III, 3.4.6" ;
    pa:quote "Insofar as the tow bar load so requires, such machinery shall be equipped with a support with a bearing surface suited to the load and the ground." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_support_with_a_bearing_surface .

pa:st-0751 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_power_take_off_on_self_propelled_machinery_or_tractor ;
    pa:condition "or by any other device offering equivalent protection" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "On the side of the self-propelled machinery (or the tractor), the power take-off to which the removable mechanical transmission device is attached shall be protected either by a guard fixed and linked to the self-propelled machinery (or the tractor) or by any other device offering equivalent protection." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_guard_fixed_and_linked_to_the_self_propelled_machinery .

pa:st-0752 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_removable_mechanical_transmission_device ;
    pa:condition "any part that moves during operation" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "Transmission of power between self-propelled machinery (or a tractor) and recipient machinery Removable mechanical transmission devices linking self-propelled machinery (or a tractor) to the first fixed bearing of recipient machinery shall be designed and constructed in such a way that any part that moves during operation is protected over its whole length." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_protected_over_its_whole_length .

pa:st-0753 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_input_shaft_on_recipient_machinery ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "On the recipient machinery side, the input shaft shall be enclosed in a protective casing fixed to the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_enclosed_in_a_protective_casing_fixed_to_the_machinery .

pa:st-0754 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guard_of_the_power_take_off ;
    pa:condition "for access to the removable transmission device" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "It shall be possible to open this guard for access to the removable transmission device." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_possible_to_open_this_guard .

pa:st-0755 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_recipient_machinery_attaching_system ;
    pa:condition "when the machinery is uncoupled" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "All recipient machinery the operation of which requires a removable mechanical transmission device to connect it to self-propelled machinery (or a tractor) shall have a system for attaching the removable mechanical transmission device so that, when the machinery is uncoupled, the removable mechanical transmission device and its guard are not damaged by contact with the ground or part of the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_system_for_attaching_the_removable_mechanical_transmission .

pa:st-0756 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guard_coverage_simple_universal_joints ;
    pa:condition "in the case of simple universal joints" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "The guard shall cover the transmission to the ends of the inner jaws in the case of simple universal joints and at least to the centre of the outer joint or joints in the case of wide-angle universal joints." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_cover_the_transmission_to_the_ends_of_the_inner_jaws .

pa:st-0757 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guard_coverage_wide_angle_universal_joints ;
    pa:condition "in the case of wide-angle universal joints" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "The guard shall cover the transmission to the ends of the inner jaws in the case of simple universal joints and at least to the centre of the outer joint or joints in the case of wide-angle universal joints." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_at_least_to_the_centre_of_the_outer_joint_or_joints .

pa:st-0758 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guard_clearance_for_drive_shaft ;
    pa:condition "once it is in place" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "Once it is in place, there shall be enough room to prevent the drive shaft damaging the guard when the machinery (or the tractor) is moving." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_enough_room_to_prevent_the_drive_shaft_damaging_the_guard .

pa:st-0759 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_shaft_guards_used_as_access_means ;
    pa:condition "unless designed and constructed for that purpose" ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "If means of access to working positions are provided near to the removable mechanical transmission device, they shall be designed and constructed in such a way that the shaft guards cannot be used as steps, unless designed and constructed for that purpose." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_cannot_be_used_as_steps .

pa:st-0760 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_removable_mechanical_transmission_device ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "The removable mechanical transmission device shall be marked accordingly." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_marked_accordingly .

pa:st-0761 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_outside_parts_of_the_guard ;
    pa:locator "Annex III, 3.4.7" ;
    pa:quote "The outside parts of the guard shall be so designed, constructed and arranged that they cannot turn with the removable mechanical transmission device." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_cannot_turn_with_the_removable_mechanical_transmission_devic .

pa:st-0763 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_battery_housing ;
    pa:condition "in the event of rollover or tip over" ;
    pa:locator "Annex III, 3.5.1" ;
    pa:quote "Batteries The battery housing shall be designed and constructed in such a way as to prevent the electrolyte being ejected on to the operator in the event of rollover or tip over and to avoid the accumulation of vapours in places occupied by operators." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_electrolyte_being_ejected_on_to_the_operator .

pa:st-0764 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_battery_housing ;
    pa:condition "in places occupied by operators" ;
    pa:locator "Annex III, 3.5.1" ;
    pa:quote "Batteries The battery housing shall be designed and constructed in such a way as to prevent the electrolyte being ejected on to the operator in the event of rollover or tip over and to avoid the accumulation of vapours in places occupied by operators." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_accumulation_of_vapours .

pa:st-0765 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_battery_disconnection ;
    pa:locator "Annex III, 3.5.1" ;
    pa:quote "Machinery or related products shall be designed and constructed in such a way that the battery can be disconnected with the aid of an easily accessible device provided for that purpose." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_easily_accessible_device_provided_for_that_purpose .

pa:st-0766 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_automatic_charging_batteries_of_mobile_machinery ;
    pa:condition "when the machinery or related product moves autonomously to the charging station" ;
    pa:locator "Annex III, 3.5.1" ;
    pa:quote "The batteries with automatic charging for mobile machinery or related products, including autonomous mobile machinery or related products, shall be designed to prevent hazards referred to in sections 1.3.8.2 and 1.5.1, including the risks of contact or collision of the machinery or related product with a person or other machinery or related products when the machinery or related product moves autonomously to the charging station." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_hazards_referred_to_in_sections_1_3_8_2_and_1_5_1 .

pa:st-0767 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_fire_protection_easily_accessible_fire_extinguishers ;
    pa:condition "where its size permits" ;
    pa:locator "Annex III, 3.5.2" ;
    pa:quote "Fire Depending on the hazards anticipated by the manufacturer, machinery shall, where its size permits: (a) either allow easily accessible fire extinguishers to be fitted; or (b) be provided with built-in extinguisher systems." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_easily_accessible_fire_extinguishers .

pa:st-0768 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_fire_protection_built_in_extinguisher_systems ;
    pa:condition "where its size permits" ;
    pa:locator "Annex III, 3.5.2" ;
    pa:quote "Fire Depending on the hazards anticipated by the manufacturer, machinery shall, where its size permits: (a) either allow easily accessible fire extinguishers to be fitted; or (b) be provided with built-in extinguisher systems." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_built_in_extinguisher_systems .

pa:st-0770 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_ride_on_mobile_machinery_applying_hazardous_substances ;
    pa:condition "Ride-on mobile machinery having application of hazardous substances as the main function" ;
    pa:locator "Annex III, 3.5.3" ;
    pa:quote "Ride-on mobile machinery having application of hazardous substances as the main function shall be equipped with filtration cabs or equivalent safety measures." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_filtration_cabs_or_equivalent_safety_measures .

pa:st-0772 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_4 ;
    pa:condition "where relevant" ;
    pa:locator "Annex III, 3.5.4" ;
    pa:quote "Risk of contact with live overhead power lines Depending on their height, mobile machinery or related products shall, where relevant, be designed, constructed and equipped, so as to prevent the risk of contact with an energised overhead power line or the risk of creating an electric arc between any part of the machinery or an operator driving the machinery and an energised overhead power line." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risk_of_contact_with_live_overhead_power_lines .

pa:st-0773 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_4 ;
    pa:condition "where relevant" ;
    pa:locator "Annex III, 3.5.4" ;
    pa:quote "Risk of contact with live overhead power lines Depending on their height, mobile machinery or related products shall, where relevant, be designed, constructed and equipped, so as to prevent the risk of contact with an energised overhead power line or the risk of creating an electric arc between any part of the machinery or an operator driving the machinery and an energised overhead power line." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_constructed_and_equipped_so_as_to_prevent_the_risk_ .

pa:st-0774 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_4_mobile_machinery_second_paragrap ;
    pa:condition "When the risk to the persons operating machinery incurred by the contact with an energised overhead power line cannot be fully avoided" ;
    pa:locator "Annex III, 3.5.4" ;
    pa:quote "When the risk to the persons operating machinery incurred by the contact with an energised overhead power line cannot be fully avoided, mobile machinery or related products shall be designed, constructed and equipped so as to prevent any electrical hazards." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_prevent_any_electrical_hazards .

pa:st-0775 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_and_related_products ;
    pa:condition "wherever necessary" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "Signs, signals and warnings All machinery or related products shall have signs and/or instruction plates concerning use, adjustment and maintenance, wherever necessary, so as to ensure the health and safety of persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_signs_and_or_instruction_plates .

pa:st-0776 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_ride_on_driver_machinery ;
    pa:condition "without prejudice to the provisions of road traffic regulations" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "Without prejudice to the provisions of road traffic regulations, machinery or related products with a ride-on driver shall have the following equipment: (a) an acoustic warning device to alert persons;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_an_acoustic_warning_device .

pa:st-0777 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_ride_on_driver_machinery ;
    pa:condition "the latter requirement does not apply to machinery or related products intended solely for underground working and having no electrical power" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "(b) a system of light signals relevant to the intended conditions of use; the latter requirement does not apply to machinery or related products intended solely for underground working and having no electrical power;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_system_of_light_signals .

pa:st-0778 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_connected_to_a_trailer ;
    pa:condition "where necessary" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "(c) where necessary, there shall be an appropriate connection between a trailer and the machinery or a related product for the operation of signals." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_an_appropriate_connection_between_a_trailer_and_the_machiner .

pa:st-0779 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_remote_controlled_machinery ;
    pa:condition "under normal conditions of use, exposes persons to the risk of impact or crushing" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "Remote-controlled machinery or related products which, under normal conditions of use, exposes persons to the risk of impact or crushing shall be fitted with appropriate means to signal its movements or with means to protect persons against such risks. The same shall apply to machinery or related products, which involves, when in use, the constant repetition of a forward and backward movement on a single axis where the area to the rear of the machinery is not directly visible to the driver." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_appropriate_means_to_signal_its_movements .

pa:st-0780 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_constant_forward_and_backward_movement_on_a_s ;
    pa:condition "where the area to the rear of the machinery is not directly visible to the driver" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "Remote-controlled machinery or related products which, under normal conditions of use, exposes persons to the risk of impact or crushing shall be fitted with appropriate means to signal its movements or with means to protect persons against such risks. The same shall apply to machinery or related products, which involves, when in use, the constant repetition of a forward and backward movement on a single axis where the area to the rear of the machinery is not directly visible to the driver." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_appropriate_means_to_signal_its_movements .

pa:st-0781 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_warning_and_signalling_devices ;
    pa:condition "where it is essential for safety" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "Where it is essential for safety, such devices shall be provided with the means to check that they are in good working order and their failure shall be made apparent to the operator." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_the_means_to_check_that_they_are_in_good_working_order .

pa:st-0782 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_hazardous_movement_of_machinery_or_its_tools ;
    pa:condition "where the movement of machinery or its tools is particularly hazardous" ;
    pa:locator "Annex III, 3.6.1" ;
    pa:quote "Where the movement of machinery or its tools is particularly hazardous, signs on the machinery shall be provided to warn against approaching the machinery while it is working; the signs shall be legible at a sufficient distance to ensure the safety of persons who have to be in the vicinity." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_signs_on_the_machinery .

pa:st-0785 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_products ;
    pa:locator "Annex III, 3.6.3.1" ;
    pa:quote "Vibrations The instructions for use shall give the following information concerning vibrations, expressed as acceleration (m/s 2 ), transmitted by the machinery or related products to the hand-arm system or to the whole body:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_The_instructions_for_use .

pa:st-0787 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_instructions_for_use_for_machinery_allowing_several_uses ;
    pa:condition "allowing several uses depending on the equipment used" ;
    pa:locator "Annex III, 3.6.3.2" ;
    pa:quote "Multiple uses The instructions for use for machinery or a related product allowing several uses depending on the equipment used and the instructions for use for the interchangeable equipment shall contain the information necessary for safe assembly and use of the basic machinery or related product and the interchangeable equipment that can be fitted." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_instructions_for_use .

pa:st-0789 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_autonomous_mobile_machinery_or_related_products ;
    pa:locator "Annex III, 3.6.3.3" ;
    pa:quote "Autonomous mobile machinery or related products The instructions for use of autonomous mobile machinery or related products shall specify the characteristics of its intended travel, working areas and danger zones." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_instructions_for_use .

pa:st-0792 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Lifting_operation ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(a) ‘Lifting operation’ means a movement of unit loads consisting of goods and/or persons necessitating, at a given moment, a change of level;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a movement of unit loads" .

pa:st-0793 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Guided_load ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(b) ‘Guided load’ means a load where the total movement is made along rigid or flexible guides whose position is determined by fixed points;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a load where the total movement is made along rigid or flexible guides" .

pa:st-0794 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Working_coefficient ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(c) ‘Working coefficient’ means the arithmetic ratio between the load guaranteed by the manufacturer up to which a component is able to hold it and the maximum working load marked on the component;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the arithmetic ratio between the load guaranteed by the manufacturer" .

pa:st-0795 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Test_coefficient ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(d) ‘Test coefficient’ means the arithmetic ratio between the load used to carry out the static or dynamic tests on the machinery or related product or lifting accessory and the maximum working load marked on the machinery or related product or lifting accessory;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the arithmetic ratio between the load used to carry out the static or dynamic tests" .

pa:st-0796 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Static_test ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(e) ‘Static test’ means the test during which the machinery or related product or lifting accessory is first inspected and subjected to a force corresponding to the maximum working load multiplied by the appropriate static test coefficient and then re-inspected once the said load has been released to ensure that no damage has occurred;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the test during which the machinery or related product or lifting accessory is first inspected" .

pa:st-0797 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Dynamic_test ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(f) ‘Dynamic test’ means the test during which the machinery or related product is operated in all its possible configurations at the maximum working load multiplied by the appropriate dynamic test coefficient with account being taken of the dynamic behaviour of the lifting machinery in order to check that it functions properly;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the test during which the machinery or related product is operated in all its possible configurations" .

pa:st-0798 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Carrier ;
    pa:locator "Annex III, 4.1" ;
    pa:quote "(g) ‘Carrier’ means a part of the machinery or related product on or in which persons and/or goods are supported in order to be lifted." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a part of the machinery or related product on or in which persons and/or goods are supported" .

pa:st-0799 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_1 ;
    pa:locator "Annex III, 4.1.2.1" ;
    pa:quote "Risks due to lack of stability Machinery or related products shall be designed and constructed in such a way that the stability required by section 1.3.1 is maintained both in service and out of service, including all stages of transportation, assembly and dismantling, during foreseeable component failures and also during the tests carried out in accordance with the instructions for use." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risks_due_to_lack_of_stability .

pa:st-0800 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex III, 4.1.2.1" ;
    pa:quote "To that end, the manufacturer shall use the appropriate verification methods." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall use the appropriate verification methods" .

pa:st-0802 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_1_2_2_machinery_running_on_guide_rails ;
    pa:locator "Annex III, 4.1.2.2" ;
    pa:quote "Machinery or related products running on guide rails and rail tracks Machinery or related products shall be provided with devices, which act on the guide rails or tracks to prevent derailment." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_devices_which_act_on_the_guide_rails .

pa:st-0803 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_1_2_2_residual_risk_of_derailment_or_rail_failure ;
    pa:condition "If, despite such devices, there remains a risk of derailment or of failure of a rail or of a running component" ;
    pa:locator "Annex III, 4.1.2.2" ;
    pa:quote "If, despite such devices, there remains a risk of derailment or of failure of a rail or of a running component, devices shall be provided which prevent the equipment, component or load from falling or the machinery from overturning." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_devices_shall_be_provided_which_prevent_the_equipment .

pa:st-0804 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mechanical_strength_fatigue_and_wear ;
    pa:condition "taking due account of their intended use and any reasonably foreseeable misuse" ;
    pa:locator "Annex III, 4.1.2.3" ;
    pa:quote "Machinery or related products, including lifting accessories, shall be designed and constructed in such a way as to prevent failure from fatigue and wear, taking due account of their intended use and any reasonably foreseeable misuse." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_failure_from_fatigue_and_wear .

pa:st-0805 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_material_choice_corrosion_and_abrasion ;
    pa:condition "on the basis of the intended working environments" ;
    pa:locator "Annex III, 4.1.2.3" ;
    pa:quote "The materials used shall be chosen on the basis of the intended working environments, with particular regard to corrosion, abrasion, impacts, extreme temperatures, fatigue, brittleness, radiation and ageing." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_corrosion_abrasion_impacts .

pa:st-0806 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "In order to verify that an adequate working coefficient has been attained" ;
    pa:locator "Annex III, 4.1.2.4" ;
    pa:quote "In order to verify that an adequate working coefficient has been attained, the manufacturer shall, for each type of chain and rope used directly for lifting the load and for the rope ends, perform the appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "perform the appropriate tests or have such tests performed" .

pa:st-0808 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "in order to verify that an adequate working coefficient has been attained" ;
    pa:locator "Annex III, 4.1.2.5" ;
    pa:quote "(f) in order to verify that an adequate working coefficient has been attained, the manufacturer shall, for each type of component referred to in points (a) to (d), perform the appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "perform the appropriate tests or have such tests performed" .

pa:st-0809 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_devices_for_controlling_movements ;
    pa:locator "Annex III, 4.1.2.6" ;
    pa:quote "Control of movements Devices for controlling movements shall act in such a way that the machinery or related product on which they are installed is kept safe." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_Devices_for_controlling_movements .

pa:st-0810 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_amplitude_of_movement_of_components ;
    pa:locator "Annex III, 4.1.2.6" ;
    pa:quote "(a) Machinery or related products shall be designed and constructed or fitted with devices in such a way that the amplitude of movement of its components is kept within the specified limits." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_fitted_with_devices .

pa:st-0811 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operation_of_such_devices ;
    pa:condition "where appropriate" ;
    pa:locator "Annex III, 4.1.2.6" ;
    pa:quote "The operation of such devices shall, where appropriate, be preceded by a warning;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_preceded_by_a_warning .

pa:st-0812 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_simultaneous_manoeuvring_with_collision_risk ;
    pa:condition "Where several fixed or rail-mounted machinery or related products can be manoeuvred simultaneously in the same place, with risks of collision" ;
    pa:locator "Annex III, 4.1.2.6" ;
    pa:quote "(b) Where several fixed or rail-mounted machinery or related products can be manoeuvred simultaneously in the same place, with risks of collision, such machinery shall be designed and constructed in such a way as to make it possible to fit systems enabling these risks to be avoided;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_fit_systems_enabling_these_risks_to_be_avoided .

pa:st-0813 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loads ;
    pa:condition "even in the event of partial or total failure of the power supply or when the operator stops operating the machinery" ;
    pa:locator "Annex III, 4.1.2.6" ;
    pa:quote "(c) Machinery or related products shall be designed and constructed in such a way that the loads cannot creep dangerously or fall freely and unexpectedly, even in the event of partial or total failure of the power supply or when the operator stops operating the machinery;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_creep_dangerously_or_fall_freely_and_unexpectedly .

pa:st-0814 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_holding_devices_and_loads ;
    pa:locator "Annex III, 4.1.2.6" ;
    pa:quote "(e) Holding devices shall be designed and constructed in such a way that inadvertent dropping of the loads is avoided." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_inadvertent_dropping_of_the_loads .

pa:st-0816 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_1_2_7_movements_of_loads_during_handling ;
    pa:condition "which might be manoeuvring at the same time and liable to constitute a hazard" ;
    pa:locator "Annex III, 4.1.2.7" ;
    pa:quote "Movements of loads during handling The operating position of machinery shall be located in such a way as to ensure the widest possible view of trajectories of the moving parts, in order to avoid possible collisions with persons, equipment or other machinery, which might be manoeuvring at the same time and liable to constitute a hazard." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_possible_collisions_with_persons .

pa:st-0817 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_1_2_7_operating_position_of_machinery ;
    pa:locator "Annex III, 4.1.2.7" ;
    pa:quote "Movements of loads during handling The operating position of machinery shall be located in such a way as to ensure the widest possible view of trajectories of the moving parts, in order to avoid possible collisions with persons, equipment or other machinery, which might be manoeuvring at the same time and liable to constitute a hazard." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_widest_possible_view_of_trajectories .

pa:st-0818 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_guided_loads ;
    pa:condition "if any (counterweights)" ;
    pa:locator "Annex III, 4.1.2.7" ;
    pa:quote "Machinery with guided loads shall be designed and constructed in such a way as to prevent persons from being injured by movement of the load, the carrier or the counterweights, if any." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_persons .

pa:st-0819 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_of_the_carrier ;
    pa:condition "serving fixed landings" ;
    pa:locator "Annex III, 4.1.2.8.1" ;
    pa:quote "Movements of the carrier The movement of the carrier of machinery serving fixed landings shall be rigidly guided to and at the landings." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_rigidly_guided .

pa:st-0821 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_on_access_to_carrier ;
    pa:condition "Where persons have access to the carrier" ;
    pa:locator "Annex III, 4.1.2.8.2" ;
    pa:quote "Access to the carrier Where persons have access to the carrier, the machinery shall be designed and constructed in such a way as to ensure that the carrier remains stationary during access, in particular while it is being loaded or unloaded." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_the_carrier_remains_stationary_during_access .

pa:st-0822 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_difference_in_level_between_carrier_and_landing ;
    pa:locator "Annex III, 4.1.2.8.2" ;
    pa:quote "The machinery shall be designed and constructed in such a way as to ensure that the difference in level between the carrier and the landing being served does not create a risk of tripping." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_a_risk_of_tripping .

pa:st-0823 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_travel_zone ;
    pa:condition "Where necessary in order to fulfil the requirement expressed in the second paragraph of section 4.1.2.7" ;
    pa:locator "Annex III, 4.1.2.8.3" ;
    pa:quote "Risks due to contact with the moving carrier Where necessary in order to fulfil the requirement expressed in the second paragraph of section 4.1.2.7, the travel zone shall be rendered inaccessible during normal operation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_rendered_inaccessible_during_normal_operation .

pa:st-0824 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_persons_situated_under_or_above_the_carrier ;
    pa:condition "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed between the carrier and any fixed parts, sufficient free space shall be provided either by means of physical refuges or by means of mechanical devices blocking the movement of the carrier" ;
    pa:locator "Annex III, 4.1.2.8.3" ;
    pa:quote "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed between the carrier and any fixed parts, sufficient free space shall be provided either by means of physical refuges or by means of mechanical devices blocking the movement of the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_sufficient_free_space_shall_be_provided .

pa:st-0825 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_persons_situated_under_or_above_the_carrier ;
    pa:condition "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed between the carrier and any fixed parts" ;
    pa:locator "Annex III, 4.1.2.8.3" ;
    pa:quote "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed between the carrier and any fixed parts, sufficient free space shall be provided either by means of physical refuges or by means of mechanical devices blocking the movement of the carrier." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_crushed_between_the_carrier_and_any_fixed_parts .

pa:st-0826 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_8_4 ;
    pa:condition "Where there is a risk due to the load falling off the carrier" ;
    pa:locator "Annex III, 4.1.2.8.4" ;
    pa:quote "Risk due to the load falling off the carrier Where there is a risk due to the load falling off the carrier, the machinery shall be designed and constructed in such a way as to prevent this risk." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risk_due_to_the_load_falling_off_the_carrier .

pa:st-0827 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_8_4 ;
    pa:condition "Where there is a risk due to the load falling off the carrier" ;
    pa:locator "Annex III, 4.1.2.8.4" ;
    pa:quote "Risk due to the load falling off the carrier Where there is a risk due to the load falling off the carrier, the machinery shall be designed and constructed in such a way as to prevent this risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_this_ri .

pa:st-0828 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_contact_of_persons_at_landings_with_moving_carrier ;
    pa:locator "Annex III, 4.1.2.8.5" ;
    pa:quote "Landings Risks due to contact of persons at landings with the moving carrier or other moving parts shall be prevented." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risks_due_to_contact_of_persons_at_landings .

pa:st-0829 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_persons_falling_into_travel_zone ;
    pa:condition "where the carrier is not present at the landings" ;
    pa:locator "Annex III, 4.1.2.8.5" ;
    pa:quote "Where there is a risk due to persons falling into the travel zone when the carrier is not present at the landings, guards shall be fitted in order to prevent this risk." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_persons_falling_into_the_travel_zone .

pa:st-0830 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_at_landings ;
    pa:condition "where there is a risk due to persons falling into the travel zone when the carrier is not present at the landings" ;
    pa:locator "Annex III, 4.1.2.8.5" ;
    pa:quote "Where there is a risk due to persons falling into the travel zone when the carrier is not present at the landings, guards shall be fitted in order to prevent this risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_guards_shall_be_fitted .

pa:st-0831 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_at_landings ;
    pa:locator "Annex III, 4.1.2.8.5" ;
    pa:quote "Such guards shall not open in the direction of the travel zone." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_Such_guards_shall_not_open_in_the_direction_of_the_travel_zo .

pa:st-0832 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_at_landings ;
    pa:locator "Annex III, 4.1.2.8.5" ;
    pa:quote "They shall be fitted with an interlocking device with guard locking controlled by the position of the carrier that prevents:" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_interlocking_device_with_guard_locking_controlled_by_the_pos .

pa:st-0833 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_the_manufacturer ;
    pa:condition "Where the machinery or related products cannot be assembled in the manufacturer’s premises" ;
    pa:locator "Annex III, 4.1.3" ;
    pa:quote "Where the machinery or related products cannot be assembled in the manufacturer’s premises, the appropriate measures shall be taken at the place of use by the manufacturer." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the appropriate measures shall be taken at the place of use by the manufacturer" .

pa:st-0835 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_of_movements ;
    pa:locator "Annex III, 4.2.1" ;
    pa:quote "Control of movements Hold-to-run control devices shall be used to control the movements of the machinery or related products or their equipment." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_Hold_to_run_control_devices .

pa:st-0837 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loading_control_4_2_2 ;
    pa:condition "with a maximum working load of not less than 1 000 kg or an overturning moment of not less than 40 000 Nm" ;
    pa:locator "Annex III, 4.2.2" ;
    pa:quote "Loading control Machinery or related products with a maximum working load of not less than 1 000 kg or an overturning moment of not less than 40 000 Nm shall be fitted with devices to warn the driver and prevent dangerous movements in the event:" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_devices_to_warn_the_driver_and_prevent_dangerous_movements .

pa:st-0838 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loading_control_4_2_2 ;
    pa:locator "Annex III, 4.2.2" ;
    pa:quote "(a) of overloading, either as a result of the maximum working load or the maximum working moment due to the load being exceeded;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_overloading .

pa:st-0839 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loading_control_4_2_2 ;
    pa:locator "Annex III, 4.2.2" ;
    pa:quote "or (b) of the overturning moment being exceeded." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_overturning_moment_being_exceeded .

pa:st-0840 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_installations_guided_by_ropes_rope_carriers_tractors_tractor ;
    pa:locator "Annex III, 4.2.3" ;
    pa:quote "Installations guided by ropes Rope carriers, tractors or tractor carriers shall be held by counterweights or by a device allowing permanent control of the tension." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_held_by_counterweights_or_by_a_device_allowing_permanent_con .

pa:st-0841 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "where this is not possible" ;
    pa:locator "Annex III, 4.3.1" ;
    pa:quote "Chains, ropes and webbing Each length of lifting chain, rope or webbing not forming part of an assembly shall bear a mark or, where this is not possible, a plate or irremovable ring bearing the name and address of the manufacturer and the identifying reference of the relevant certificate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall bear a mark" .

pa:st-0842 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_3_3_lifting_machinery_maximum_working_load ;
    pa:locator "Annex III, 4.3.3" ;
    pa:quote "Lifting machinery or related products The maximum working load shall be prominently marked on the lifting machinery or related product." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_prominently_marked .

pa:st-0843 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_3_3_machinery_with_configuration_dependent_working_load ;
    pa:condition "Where the maximum working load depends on the configuration of the lifting machinery or related product" ;
    pa:locator "Annex III, 4.3.3" ;
    pa:quote "Where the maximum working load depends on the configuration of the lifting machinery or related product, each operating position shall be provided with a load plate indicating, preferably in diagrammatic form or by means of tables, the working load permitted for each configuration." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_load_plate .

pa:st-0844 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_3_3_lifting_goods_only_machinery_with_carrier_allowing_acc ;
    pa:condition "Machinery or related products intended for lifting goods only, equipped with a carrier, which allows access to persons" ;
    pa:locator "Annex III, 4.3.3" ;
    pa:quote "Machinery or related products intended for lifting goods only, equipped with a carrier, which allows access to persons, shall bear a clear and indelible warning prohibiting the lifting of persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_clear_and_indelible_warning_prohibiting_the_lifting_of_perso .

pa:st-0845 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_accessories ;
    pa:condition "each lifting accessory or each commercially indivisible batch of lifting accessories" ;
    pa:locator "Annex III, 4.4.1" ;
    pa:quote "Lifting accessories Each lifting accessory or each commercially indivisible batch of lifting accessories shall be accompanied by instructions setting out at least the following particulars:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_instructions_setting_out_at_least_the_following_particulars .

pa:st-0846 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery_or_related_products ;
    pa:locator "Annex III, 4.4.2" ;
    pa:quote "Lifting machinery or related products Lifting machinery or related products shall be accompanied by instructions for use containing information on:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_instructions_for_use .

pa:st-0847 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery ;
    pa:condition "if the latter is not supplied with the lifting machinery" ;
    pa:locator "Annex III, 4.4.2" ;
    pa:quote "(b) the contents of the logbook, if the latter is not supplied with the lifting machinery;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_contents_of_the_logbook .

pa:st-0848 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery ;
    pa:condition "where appropriate" ;
    pa:locator "Annex III, 4.4.2" ;
    pa:quote "(i) the maximum working load and, where appropriate, a copy of the load plate or load table described in the second paragraph of section 4.3.3;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_a_copy_of_the_load_plate_or_load_table .

pa:st-0849 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery ;
    pa:condition "where appropriate" ;
    pa:locator "Annex III, 4.4.2" ;
    pa:quote "(d) where appropriate, a test report detailing the static and dynamic tests carried out by or for the manufacturer;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_a_test_report .

pa:st-0850 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery_or_related_products ;
    pa:condition "for lifting machinery or related products, which are not assembled on the premises of the manufacturer in the form in which they are to be used" ;
    pa:locator "Annex III, 4.4.2" ;
    pa:quote "(e) for lifting machinery or related products, which are not assembled on the premises of the manufacturer in the form in which they are to be used, the necessary instructions for performing the measures referred to in section 4.1.3 before they are first put into service." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_necessary_instructions_for_performing_the_measures .

pa:st-0852 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_5_1 ;
    pa:locator "Annex III, 5.1" ;
    pa:quote "Risks due to lack of stability Powered roof supports shall be designed and constructed in such a way as to maintain a given direction when moving and not slip before and while they come under load and after the load has been removed." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_lack_of_stability .

pa:st-0853 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_powered_roof_supports ;
    pa:locator "Annex III, 5.1" ;
    pa:quote "They shall be equipped with anchorages for the top plates of the individual hydraulic props." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_anchorages_for_the_top_plates_of_the_individual_hydraulic_pr .

pa:st-0856 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_accelerator_and_brake_controls_for_movement_of_machinery_run ;
    pa:condition "However, enabling devices may be foot-operated." ;
    pa:locator "Annex III, 5.3" ;
    pa:quote "Control devices The accelerator and brake controls for movement of machinery running on rails shall be hand-operated. However, enabling devices may be foot-operated." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_hand_operated .

pa:st-0857 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_of_powered_roof_supports ;
    pa:condition "during displacement operations" ;
    pa:locator "Annex III, 5.3" ;
    pa:quote "The control devices of powered roof supports shall be designed and positioned in such a way that, during displacement operations, operators are sheltered by a support in place." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_sheltered_by_a_support_in_place .

pa:st-0858 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices ;
    pa:locator "Annex III, 5.3" ;
    pa:quote "The control devices shall be protected against any accidental release." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_protected_against_any_accidental_release .

pa:st-0859 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_running_on_rails_for_use_in_undergr ;
    pa:condition "movement is stopped if the driver is no longer in control of the movement" ;
    pa:locator "Annex III, 5.4" ;
    pa:quote "Stopping Self-propelled machinery running on rails for use in underground work shall be equipped with an enabling device acting on the circuit controlling the movement of the machinery such that movement is stopped if the driver is no longer in control of the movement." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_enabling_device .

pa:st-0860 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_braking_system_of_machinery_for_underground_workings ;
    pa:condition "intended for use in underground workings" ;
    pa:locator "Annex III, 5.5" ;
    pa:quote "The braking system of machinery or related products intended for use in underground workings shall be designed and constructed in such a way that it does not produce sparks or cause fires." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_cause_fires .

pa:st-0861 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_internal_combustion_engines_for_underground_workings ;
    pa:condition "for use in underground workings" ;
    pa:locator "Annex III, 5.5" ;
    pa:quote "Machinery or related products with internal combustion engines for use in underground workings shall be fitted only with engines using fuel with a low vaporising pressure and which exclude any spark of electrical origin." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_engines_using_fuel_with_a_low_vaporising_pressure .

pa:st-0862 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_internal_combustion_engines_for_underground_workings ;
    pa:condition "for use in underground workings" ;
    pa:locator "Annex III, 5.5" ;
    pa:quote "Machinery or related products with internal combustion engines for use in underground workings shall be fitted only with engines using fuel with a low vaporising pressure and which exclude any spark of electrical origin." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_exclude_any_spark_of_electrical_origin .

pa:st-0864 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_exhaust_emissions_from_internal_combustion_engines ;
    pa:locator "Annex III, 5.6" ;
    pa:quote "Exhaust emissions Exhaust emissions from internal combustion engines shall not be discharged upwards." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_shall_not_be_discharged_upwards .

pa:st-0866 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_suspension_or_supporting_system_for_the_carrier ;
    pa:condition "Machinery or related products intended for lifting persons or persons and goods" ;
    pa:locator "Annex III, 6.1.1" ;
    pa:quote "Machinery or related products intended for lifting persons or persons and goods shall be fitted with a suspension or supporting system for the carrier designed and constructed in such a way as to ensure an adequate overall level of safety and to prevent the risk of the carrier falling." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_suspension_or_supporting_system_for_the_carrier .

pa:st-0867 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_suspended_by_ropes_or_chains ;
    pa:condition "If ropes or chains are used to suspend the carrier, as a general rule" ;
    pa:locator "Annex III, 6.1.1" ;
    pa:quote "If ropes or chains are used to suspend the carrier, as a general rule, at least two independent ropes or chains are required, each with its own anchorage." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_at_least_two_independent_ropes_or_chains .

pa:st-0870 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_for_carrier_movements ;
    pa:condition "with the exception of emergency stop devices" ;
    pa:locator "Annex III, 6.2" ;
    pa:quote "In operation, those control devices shall override any other devices controlling the same movement with the exception of emergency stop devices." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_override_any_other_devices .

pa:st-0871 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_for_carrier_movements ;
    pa:condition "except where the carrier is completely enclosed" ;
    pa:locator "Annex III, 6.2" ;
    pa:quote "The control devices for the movements referred to in the first paragraph shall be of the hold-to-run type except where the carrier is completely enclosed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_hold_to_run_type .

pa:st-0872 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_for_carrier_movements ;
    pa:condition "If there is no risk of persons or objects on the carrier colliding or falling and no other risks due to the upward and downward movements of the carrier" ;
    pa:locator "Annex III, 6.2" ;
    pa:quote "If there is no risk of persons or objects on the carrier colliding or falling and no other risks due to the upward and downward movements of the carrier, control devices authorising automatic stops at preselected positions may be used instead of hold-to-run type control devices." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_control_devices_authorising_automatic_stops_at_preselected_p .

pa:st-0873 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_1 ;
    pa:locator "Annex III, 6.3.1" ;
    pa:quote "Risks due to movements of the carrier Machinery or related products for lifting persons shall be designed, constructed or equipped in such a way that the acceleration or deceleration of the carrier does not engender risks for persons." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risks_due_to_movements_of_the_carrier .

pa:st-0874 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_1 ;
    pa:locator "Annex III, 6.3.1" ;
    pa:quote "Risks due to movements of the carrier Machinery or related products for lifting persons shall be designed, constructed or equipped in such a way that the acceleration or deceleration of the carrier does not engender risks for persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_constructed_or_equipped_in_such_a_way .

pa:st-0875 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_EssentialRequirement_6_3_2 ;
    pa:locator "Annex III, 6.3.2" ;
    pa:quote "Risk of persons falling from the carrier The carrier shall not tilt to an extent, which creates a risk of the occupants falling, including when the machinery or related product and carrier are moving." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risk_of_persons_falling_from_the_carrier .

pa:st-0876 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_designed_as_a_workstation ;
    pa:condition "Where the carrier is designed as a workstation" ;
    pa:locator "Annex III, 6.3.2" ;
    pa:quote "Where the carrier is designed as a workstation, provision shall be made to ensure stability and to prevent hazardous movements." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_provision_shall_be_made_to_ensure_stability_and_to_prevent_h .

pa:st-0877 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carriers ;
    pa:condition "If the measures referred to in section 1.5.15 are not adequate" ;
    pa:locator "Annex III, 6.3.2" ;
    pa:quote "If the measures referred to in section 1.5.15 are not adequate, carriers shall be fitted with a sufficient number of suitable anchorage points for the number of persons permitted on the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_sufficient_number_of_suitable_anchorage_points .

pa:st-0878 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_anchorage_points ;
    pa:locator "Annex III, 6.3.2" ;
    pa:quote "The anchorage points shall be strong enough for the use of personal protective equipment against falls from a height." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_strong_enough_for_the_use_of_personal_protective_equipment_a .

pa:st-0879 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_trapdoor_in_floors_or_ceilings_or_side_doors ;
    pa:locator "Annex III, 6.3.2" ;
    pa:quote "Any trapdoor in floors or ceilings or side doors shall be designed and constructed in such a way as to prevent inadvertent opening and shall open in a direction that obviates any risk of falling, should they open unexpectedly." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_inadver .

pa:st-0881 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_3 ;
    pa:locator "Annex III, 6.3.3" ;
    pa:quote "Risk due to objects falling on the carrier Where there is a risk of objects falling on the carrier and endangering persons, the carrier shall be equipped with a protective roof." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_Risk_due_to_objects_falling_on_the_carrier .

pa:st-0882 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_3 ;
    pa:condition "Where there is a risk of objects falling on the carrier and endangering persons" ;
    pa:locator "Annex III, 6.3.3" ;
    pa:quote "Risk due to objects falling on the carrier Where there is a risk of objects falling on the carrier and endangering persons, the carrier shall be equipped with a protective roof." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_protective_roof .

pa:st-0883 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_Machinery_or_related_products_serving_fixed_landings ;
    pa:locator "Annex III, 6.4" ;
    pa:quote "6.4. Machinery or related products serving fixed landings" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_6_4 .

pa:st-0885 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_6_4_1_essential_requirement_risks_to_persons_in_or_on_the_ca ;
    pa:locator "Annex III, 6.4.1" ;
    pa:quote "Risks to persons in or on the carrier The carrier shall be designed and constructed in such a way as to prevent risks due to contact between persons and/or objects in or on the carrier with any fixed or moving elements." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risks_due_to_contact_between_persons_and_or_objects .

pa:st-0886 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_6_4_1_carrier_enclosure ;
    pa:condition "Where necessary in order to fulfil this requirement" ;
    pa:locator "Annex III, 6.4.1" ;
    pa:quote "Where necessary in order to fulfil this requirement, the carrier itself shall be completely enclosed with doors fitted with an interlocking device that prevents hazardous movements of the carrier unless the doors are closed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_completely_enclosed_with_doors_fitted_with_an_interlocking_d .

pa:st-0887 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_6_4_1_doors_while_carrier_stopped ;
    pa:condition "if the carrier stops between landings where there is a risk of falling from the carrier" ;
    pa:locator "Annex III, 6.4.1" ;
    pa:quote "The doors shall remain closed if the carrier stops between landings where there is a risk of falling from the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_The_doors_shall_remain_closed .

pa:st-0888 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_6_4_1_prevention_of_uncontrolled_movement ;
    pa:condition "Where necessary" ;
    pa:locator "Annex III, 6.4.1" ;
    pa:quote "Machinery or related products shall be designed, constructed and, where necessary, equipped with devices in such a way as to prevent uncontrolled upward or downward movement of the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_equipped_with_devices .

pa:st-0889 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_6_4_1_stopping_devices ;
    pa:locator "Annex III, 6.4.1" ;
    pa:quote "These devices shall be able to stop the carrier at its maximum working load and at the foreseeable maximum speed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_able_to_stop_the_carrier_at_its_maximum_working_load .

pa:st-0892 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_Access_to_the_carrier_6_4_3 ;
    pa:condition "taking into consideration the foreseeable range of goods and persons to be lifted" ;
    pa:locator "Annex III, 6.4.3" ;
    pa:quote "Access to the carrier The guards at the landings and on the carrier shall be designed and constructed in such a way as to ensure safe transfer to and from the carrier, taking into consideration the foreseeable range of goods and persons to be lifted." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_guards_at_the_landings_and_on_the_carrier .

pa:st-0894 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "PART A Technical documentation for machinery and related products The technical documentation shall specify the means used by the manufacturer to ensure the conformity of the machinery or related product with the applicable essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall specify the means used by the manufacturer" .

pa:st-0895 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_technical_documentation ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "The technical documentation shall include at least the following elements:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall include at least the following elements" .

pa:st-0896 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_references_of_harmonised_standards_applied ;
    pa:condition "that have been applied for the design and manufacture of the machinery or related product" ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "(e) the references of the harmonised standards referred to in Article 20(1) or common specifications adopted by the Commission in accordance with Article 20(3) that have been applied for the design and manufacture of the machinery or related product." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the references of the harmonised standards" .

pa:st-0897 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_partial_application_of_harmonised_standards ;
    pa:condition "in the event of partial application of harmonised standards or common specifications" ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "In the event of partial application of harmonised standards or common specifications, the documentation shall specify the parts, which have been applied;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the documentation shall specify the parts" .

pa:st-0898 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_residual_risks ;
    pa:condition "when appropriate" ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "(ii) the description of the protective measures implemented to meet each applicable essential health and safety requirement and, when appropriate, the indication of the residual risks associated with the machinery or related product;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the indication of the residual risks" .

pa:st-0899 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_source_code_or_programming_logic_of_safety_related_software ;
    pa:condition "further to a reasoned request from a competent national authority provided that is necessary" ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "(m) the source code or programming logic of the safety related software to demonstrate the conformity of the machinery or related product with this Regulation further to a reasoned request from a competent national authority provided that is necessary in order for those authorities to be able to check compliance with the essential health and safety requirements set out in Annex III;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "source code or programming logic" .

pa:st-0900 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_internal_measures_for_series_production ;
    pa:condition "for machinery or related products produced in series" ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "(l) for machinery or related products produced in series, the internal measures that will be implemented to ensure that the machinery or related product remains in conformity with this Regulation;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the internal measures that will be implemented" .

pa:st-0901 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_copy_of_instructions_for_use ;
    pa:locator "Annex IV, Part A" ;
    pa:quote "(i) a copy of the instructions for use and the information set out in section 1.7.4 of Annex III;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "a copy of the instructions for use" .

pa:st-0902 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex IV, Part B" ;
    pa:quote "PART B Technical documentation for partly completed machinery The technical documentation shall specify the means used by the manufacturer to ensure the conformity of the partly completed machinery with the relevant essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall specify the means used by the manufacturer" .

pa:st-0903 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "In the event of partial application of harmonised standards or common specifications" ;
    pa:locator "Annex IV, Part B" ;
    pa:quote "In the event of partial application of harmonised standards or common specifications, the documentation shall specify the parts, which have been applied;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the documentation shall specify the parts, which have been applied" .

pa:st-0904 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "where harmonised standards or common specifications have not been applied or have been only partially applied" ;
    pa:locator "Annex IV, Part B" ;
    pa:quote "(f) where harmonised standards or common specifications have not been applied or have been only partially applied, descriptions of the other technical specifications that have been applied in order to meet each applicable essential health and safety requirement;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "descriptions of the other technical specifications that have been applied" .

pa:st-0905 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "upon a reasoned request from a competent national authority, provided that is necessary in order for those authorities to be able to check compliance with the essential health and safety requirements set out in Annex III" ;
    pa:locator "Annex IV, Part B" ;
    pa:quote "(k) the source code or programming logic of the safety related software upon a reasoned request from a competent national authority, provided that is necessary in order for those authorities to be able to check compliance with the essential health and safety requirements set out in Annex III;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the source code or programming logic of the safety related software" .

pa:st-0906 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex IV, Part B" ;
    pa:quote "(h) a description of the means used by the manufacturer during the production of the partly completed machinery to ensure the conformity of the partly completed machinery produced with the design specifications;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "a description of the means used by the manufacturer during the production" .

pa:st-0907 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "for partly completed machinery produced in series" ;
    pa:locator "Annex IV, Part B" ;
    pa:quote "(j) for partly completed machinery produced in series, the internal measures that will be implemented to ensure that the partly completed machinery remains in conformity with the essential health and safety requirements applied;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the internal measures that will be implemented" .

pa:st-0911 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_declaration_of_conformity ;
    pa:locator "Annex V, Part A, point 4" ;
    pa:quote "This declaration of conformity is issued under the sole responsibility of the manufacturer." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "issued under the sole responsibility of the manufacturer" .

pa:st-0915 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_or_related_product ;
    pa:condition "Where applicable" ;
    pa:locator "Annex V, Part A, point 9" ;
    pa:quote "Where applicable, the machinery or related product is subject to the conformity assessment procedure based on internal production control (Module A)." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_internal_production_control_Module_A .

pa:st-0917 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex V, Part B, point 3" ;
    pa:quote "This declaration of incorporation is issued under the sole responsibility of the manufacturer." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "under the sole responsibility of the manufacturer" .

pa:st-0921 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_undertaking ;
    pa:condition "in response to a reasoned request by the national authorities" ;
    pa:locator "Annex V, Part B, point 7" ;
    pa:quote "An undertaking to transmit, in response to a reasoned request by the national authorities, relevant information on the partly completed machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "undertaking to transmit" .

pa:st-0925 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_internal_production_control ;
    pa:locator "Annex VI" ;
    pa:quote "Internal production control is the conformity assessment procedure whereby the manufacturer fulfils the obligations laid down in points 2, 3 and 4, and ensures and declares on its sole responsibility that the machinery or related product concerned satisfies the applicable requirements of this Regulation." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the conformity assessment procedure whereby the manufacturer fulfils the obligations" .

pa:st-0926 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VI" ;
    pa:quote "Internal production control is the conformity assessment procedure whereby the manufacturer fulfils the obligations laid down in points 2, 3 and 4, and ensures and declares on its sole responsibility that the machinery or related product concerned satisfies the applicable requirements of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "fulfils the obligations laid down in points 2, 3 and 4" .

pa:st-0928 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VI, 2" ;
    pa:quote "Technical documentation The manufacturer shall draw up the technical documentation described in Annex IV, Part A." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall draw up the technical documentation" .

pa:st-0929 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VI, 3" ;
    pa:quote "Manufacturing The manufacturer shall take all measures necessary so that the manufacturing process and its monitoring ensure compliance of the manufactured machinery or related products with the technical documentation referred to in point 2 and with the applicable requirements of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall take all measures necessary" .

pa:st-0931 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_s_obligations_set_out_in_point_4 ;
    pa:condition "provided that they are specified in the mandate" ;
    pa:locator "Annex VI, 5" ;
    pa:quote "Authorised representative The manufacturer’s obligations set out in point 4 may be fulfilled by its authorised representative, on its behalf and under its responsibility, provided that they are specified in the mandate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "may be fulfilled by its authorised representative" .

pa:st-0932 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_EU_type_examination ;
    pa:locator "Annex VII" ;
    pa:quote "EU type-examination is the part of a conformity assessment procedure in which a notified body examines the technical design of machinery or a related product and verifies and attests that the technical design of the machinery or related product meets the applicable requirements of this Regulation." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the part of a conformity assessment procedure in which a notified body examines the technical design" .

pa:st-0934 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VII, 3" ;
    pa:quote "Application for EU type-examination The manufacturer shall lodge an application for EU type-examination with a single notified body of its choice." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall lodge an application" .

pa:st-0938 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_copy_of_EU_type_examination_certificate_annexes_additions_an ;
    pa:locator "Annex VII, 7" ;
    pa:quote "The notified body shall keep a copy of the EU type-examination certificate, its annexes and additions, as well as the technical file including the documentation submitted by the manufacturer, for a period of five years after the expiry of the validity of that certificate." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P5Y"^^xsd:duration .

pa:st-0939 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_copy_of_EU_type_examination_certificate_annexes_additions_an ;
    pa:condition "after the machinery or related product has been placed on the market or put into service" ;
    pa:locator "Annex VII, 7" ;
    pa:quote "The manufacturer shall keep a copy of the EU type-examination certificate, its annexes and additions, together with the technical documentation at the disposal of the national authorities, for at least 10 years after the machinery or related product has been placed on the market or put into service." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0940 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_s_authorised_representative ;
    pa:condition "provided that they are specified in the mandate" ;
    pa:locator "Annex VII, 7" ;
    pa:quote "The manufacturer’s authorised representative may lodge the application referred to in point 3 and fulfil the obligations set out in points 7.2, 7.4 and 9, provided that they are specified in the mandate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "fulfil the obligations set out in points 7.2, 7.4 and 9" .

pa:st-0942 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_conformity_to_type_based_on_internal_production_control ;
    pa:locator "Annex VIII" ;
    pa:quote "Conformity to type based on internal production control is the part of a conformity assessment procedure whereby the manufacturer fulfils the obligations laid down in points 2 and 3, and ensures and declares under its sole responsibility that the machinery or related product concerned is in conformity with the type described in the EU type-examination certificate and satisfies the applicable requirements of this Regulation." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the part of a conformity assessment procedure" .

pa:st-0943 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VIII" ;
    pa:quote "Conformity to type based on internal production control is the part of a conformity assessment procedure whereby the manufacturer fulfils the obligations laid down in points 2 and 3, and ensures and declares under its sole responsibility that the machinery or related product concerned is in conformity with the type described in the EU type-examination certificate and satisfies the applicable requirements of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "ensures and declares under its sole responsibility" .

pa:st-0944 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VIII, 2" ;
    pa:quote "Manufacturing The manufacturer shall take all measures necessary so that the manufacturing process and its monitoring ensure conformity of the manufactured machinery or related products with the type described in the EU type-examination certificate and with the applicable requirements of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "The manufacturer shall take all measures necessary" .

pa:st-0946 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_s_obligations_set_out_in_point_3 ;
    pa:condition "provided that they are specified in the mandate" ;
    pa:locator "Annex VIII, 4" ;
    pa:quote "Authorised representative The manufacturer’s obligations set out in point 3 may be fulfilled by its authorised representative, on its behalf and under its responsibility, provided that they are specified in the mandate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "may be fulfilled by its authorised representative" .

pa:st-0949 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_safety_component ;
    pa:condition "which is independently placed on the market" ;
    pa:locator "Art. 2" ;
    pa:quote "(c) ‘safety component’ means a component: — which serves to fulfil a safety function, — which is independently placed on the market, — the failure and/or malfunction of which endangers the safety of persons, and — which is not necessary in order for the machinery to function, or for which normal components may be substituted in order for the machinery to function." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means a component" .

pa:st-0950 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_safety_components ;
    pa:locator "Art. 2" ;
    pa:quote "An indicative list of safety components is set out in Annex V, which may be updated in accordance with Article 8(1)(a);" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Annex_V .

pa:st-0951 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_any_natural_or_legal_person_who_places_on_the_market_or_puts ;
    pa:condition "In the absence of a manufacturer as defined above" ;
    pa:locator "Art. 2" ;
    pa:quote "In the absence of a manufacturer as defined above, any natural or legal person who places on the market or puts into service machinery or partly completed machinery covered by this Directive shall be considered a manufacturer;" ;
    pa:relation pa:becomesManufacturer ;
    pa:sourceDocument "DIR" ;
    pa:value "shall be considered a manufacturer" .

pa:st-0952 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_placing_on_the_market ;
    pa:locator "Art. 2" ;
    pa:quote "(h) ‘placing on the market’ means making available for the first time in the Community machinery or partly completed machinery with a view to distribution or use, whether for reward or free of charge;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means making available for the first time in the Community" .

pa:st-0953 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_manufacturer ;
    pa:condition "under his own name or trademark or for his own use" ;
    pa:locator "Art. 2" ;
    pa:quote "(i) ‘manufacturer’ means any natural or legal person who designs and/or manufactures machinery or partly completed machinery covered by this Directive and is responsible for the conformity of the machinery or the partly completed machinery with this Directive with a view to its being placed on the market, under his own name or trademark or for his own use." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means any natural or legal person who designs and/or manufactures machinery" .

pa:st-0954 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_putting_into_service ;
    pa:locator "Art. 2" ;
    pa:quote "(k) ‘putting into service’ means the first use, for its intended purpose, in the Community, of machinery covered by this Directive;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means the first use, for its intended purpose, in the Community" .

pa:st-0955 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_authorised_representative ;
    pa:condition "who has received a written mandate from the manufacturer" ;
    pa:locator "Art. 2" ;
    pa:quote "(j) ‘authorised representative’ means any natural or legal person established in the Community who has received a written mandate from the manufacturer to perform on his behalf all or part of the obligations and formalities connected with this Directive;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means any natural or legal person established in the Community" .

pa:st-0956 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_harmonised_standard ;
    pa:locator "Art. 2" ;
    pa:quote "(l) ‘harmonised standard’ means a non-binding technical specification adopted by a standardisation body, namely the European Committee for Standardisation (CEN), the European Committee for Electrotechnical Standardisation (CENELEC) or the European Telecommunications Standards Institute (ETSI), on the basis of a remit issued by the Commission in accordance with the procedures laid down in Directive 98/34/EC of the European Parliament and of the Council of 22 June 1998 laying down a procedure for the provision of information in the field of technical standards and regulations and of rules on Information Society services ( 16 ) ." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means a non-binding technical specification" .

pa:st-0957 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_lifting_accessory ;
    pa:condition "which is independently placed on the market" ;
    pa:locator "Art. 2" ;
    pa:quote "(d) ‘lifting accessory’ means a component or equipment not attached to the lifting machinery, allowing the load to be held, which is placed between the machinery and the load or on the load itself, or which is intended to constitute an integral part of the load and which is independently placed on the market;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "means a component or equipment not attached to the lifting machinery" .

pa:st-0964 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:condition "Before placing machinery on the market and/or putting it into service" ;
    pa:locator "Art. 5(1)" ;
    pa:quote "Before placing machinery on the market and/or putting it into service, the manufacturer or his authorised representative shall: (a) ensure that it satisfies the relevant essential health and safety requirements set out in Annex I;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "ensure that it satisfies the relevant essential health and safety requirements" .

pa:st-0965 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:condition "Before placing machinery on the market and/or putting it into service" ;
    pa:locator "Art. 5(1)" ;
    pa:quote "Before placing machinery on the market and/or putting it into service, the manufacturer or his authorised representative shall: (a) ensure that it satisfies the relevant essential health and safety requirements set out in Annex I; (b) ensure that the technical file referred to in Annex VII, part A is available;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "ensure that the technical file referred to in Annex VII, part A is available" .

pa:st-0966 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery ;
    pa:locator "Art. 5(1)" ;
    pa:quote "(e) draw up the EC declaration of conformity in accordance with Annex II, part 1, Section A and ensure that it accompanies the machinery;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_EC_declaration_of_conformity .

pa:st-0967 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "before placing partly completed machinery on the market" ;
    pa:locator "Art. 5(2)" ;
    pa:quote "Before placing partly completed machinery on the market, the manufacturer or his authorised representative shall ensure that the procedure referred to in Article 13 has been completed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall ensure that the procedure referred to in Article 13 has been completed" .

pa:st-0968 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "For the purposes of the procedures referred to in Article 12" ;
    pa:locator "Art. 5(3)" ;
    pa:quote "For the purposes of the procedures referred to in Article 12, the manufacturer or his authorised representative shall have, or shall have access to, the necessary means of ensuring that the machinery satisfies the essential health and safety requirements set out in Annex I." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall have, or shall have access to, the necessary means" .

pa:st-0971 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "stating that it is to be incorporated into machinery or assembled with other partly completed machinery to form machinery" ;
    pa:locator "Art. 6(2)" ;
    pa:quote "Member States shall not prohibit, restrict or impede the placing on the market of partly completed machinery where the manufacturer or his authorised representative makes a declaration of incorporation, referred to in Annex II, part 1, Section B, stating that it is to be incorporated into machinery or assembled with other partly completed machinery to form machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "makes a declaration of incorporation" .

pa:st-0974 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_bearing_the_CE_marking ;
    pa:condition "machinery bearing the CE marking and accompanied by the EC declaration of conformity" ;
    pa:locator "Art. 7(1)" ;
    pa:quote "Member States shall regard machinery bearing the CE marking and accompanied by the EC declaration of conformity, the content of which is set out in Annex II, part 1, Section A, as complying with the provisions of this Directive." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_accompanied_by_the_EC_declaration_of_conformity .

pa:st-0979 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_indicative_list_of_safety_components ;
    pa:locator "Art. 8(1)" ;
    pa:quote "(a) updating of the indicative list of safety components in Annex V referred to in point (c) in Article 2;" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Annex_V .

pa:st-0993 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_not_referred_to_in_Annex_IV ;
    pa:condition "Where the machinery is not referred to in Annex IV" ;
    pa:locator "Art. 12(2)" ;
    pa:quote "Where the machinery is not referred to in Annex IV, the manufacturer or his authorised representative shall apply the procedure for assessment of conformity with internal checks on the manufacture of machinery provided for in Annex VIII." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_internal_checks_on_the_manufacture .

pa:st-0994 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "Where the machinery is not referred to in Annex IV" ;
    pa:locator "Art. 12(2)" ;
    pa:quote "Where the machinery is not referred to in Annex IV, the manufacturer or his authorised representative shall apply the procedure for assessment of conformity with internal checks on the manufacture of machinery provided for in Annex VIII." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall apply the procedure" .

pa:st-0995 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "Where the machinery is referred to in Annex IV and manufactured in accordance with the harmonised standards referred to in Article 7(2), and provided that those standards cover all of the relevant essential health and safety requirements" ;
    pa:locator "Art. 12(3)" ;
    pa:quote "Where the machinery is referred to in Annex IV and manufactured in accordance with the harmonised standards referred to in Article 7(2), and provided that those standards cover all of the relevant essential health and safety requirements, the manufacturer or his authorised representative shall apply one of the following procedures:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall apply one of the following procedures" .

pa:st-0996 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_referred_to_in_Annex_IV ;
    pa:condition "provided that those standards cover all of the relevant essential health and safety requirements" ;
    pa:locator "Art. 12(3)" ;
    pa:quote "Where the machinery is referred to in Annex IV and manufactured in accordance with the harmonised standards referred to in Article 7(2), and provided that those standards cover all of the relevant essential health and safety requirements, the manufacturer or his authorised representative shall apply one of the following procedures: (a) the procedure for assessment of conformity with internal checks on the manufacture of machinery, provided for in Annex VIII;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_internal_checks_on_the_manufacture_of_machinery .

pa:st-0997 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_referred_to_in_Annex_IV ;
    pa:condition "provided that those standards cover all of the relevant essential health and safety requirements" ;
    pa:locator "Art. 12(3)" ;
    pa:quote "(b) the EC type-examination procedure provided for in Annex IX, plus the internal checks on the manufacture of machinery provided for in Annex VIII, point 3;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_EC_type_examination_procedure .

pa:st-0998 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_referred_to_in_Annex_IV ;
    pa:condition "provided that those standards cover all of the relevant essential health and safety requirements" ;
    pa:locator "Art. 12(3)" ;
    pa:quote "(c) the full quality assurance procedure provided for in Annex X." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_full_quality_assurance_procedure .

pa:st-0999 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "Where the machinery is referred to in Annex IV and has not been manufactured in accordance with the harmonised standards referred to in Article 7(2)" ;
    pa:locator "Art. 12(4)" ;
    pa:quote "Where the machinery is referred to in Annex IV and has not been manufactured in accordance with the harmonised standards referred to in Article 7(2), or only partly in accordance with such standards, or if the harmonised standards do not cover all the relevant essential health and safety requirements or if no harmonised standards exist for the machinery in question, the manufacturer or his authorised representative shall apply one of the following procedures:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall apply one of the following procedures" .

pa:st-1000 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_referred_to_in_Annex_IV ;
    pa:condition "Where the machinery is referred to in Annex IV and has not been manufactured in accordance with the harmonised standards referred to in Article 7(2)" ;
    pa:locator "Art. 12(4)" ;
    pa:quote "(a) the EC type-examination procedure provided for in Annex IX, plus the internal checks on the manufacture of machinery provided for in Annex VIII, point 3;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_the_EC_type_examination_procedure_provided_for_in_Annex_IX .

pa:st-1001 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_referred_to_in_Annex_IV ;
    pa:condition "Where the machinery is referred to in Annex IV and has not been manufactured in accordance with the harmonised standards referred to in Article 7(2)" ;
    pa:locator "Art. 12(4)" ;
    pa:quote "(b) the full quality assurance procedure provided for in Annex X." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_the_full_quality_assurance_procedure_provided_for_in_Annex_X .

pa:st-1002 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_partly_completed_machinery_or_authorised_rep ;
    pa:condition "before placing it on the market" ;
    pa:locator "Art. 13(1)" ;
    pa:quote "The manufacturer of partly completed machinery or his authorised representative shall, before placing it on the market, ensure that:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall, before placing it on the market, ensure that" .

pa:st-1003 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_partly_completed_machinery ;
    pa:locator "Art. 13(1)" ;
    pa:quote "(a) the relevant technical documentation described in Annex VII, part B is prepared;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the relevant technical documentation described in Annex VII, part B is prepared" .

pa:st-1004 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_partly_completed_machinery ;
    pa:locator "Art. 13(1)" ;
    pa:quote "(b) assembly instructions described in Annex VI are prepared;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "assembly instructions described in Annex VI are prepared" .

pa:st-1005 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_partly_completed_machinery ;
    pa:locator "Art. 13(1)" ;
    pa:quote "(c) a declaration of incorporation described in Annex II, part 1, Section B has been drawn up." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "a declaration of incorporation described in Annex II, part 1, Section B has been drawn up" .

pa:st-1006 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_partly_completed_machinery ;
    pa:condition "until it is incorporated into the final machinery" ;
    pa:locator "Art. 13(2)" ;
    pa:quote "The assembly instructions and the declaration of incorporation shall accompany the partly completed machinery until it is incorporated into the final machinery and shall then form part of the technical file for that machinery." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_assembly_instructions_and_the_declaration_of_incorporation .

pa:st-1009 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_notified_bodies_monitoring ;
    pa:locator "Art. 14(2)" ;
    pa:quote "The Member States shall ensure that the notified bodies are monitored regularly to check that they comply at all times with the criteria set out in Annex XI." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DIR" ;
    pa:value pa:VerifyingBody_Member_States .

pa:st-1022 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "Where a Member State ascertains that marking does not conform to the relevant provisions of this Directive, under conditions fixed by that Member State" ;
    pa:locator "Art. 17(2)" ;
    pa:quote "Where a Member State ascertains that marking does not conform to the relevant provisions of this Directive, the manufacturer or his authorised representative shall be obliged to make the product conform and to put an end to the infringement under conditions fixed by that Member State." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall be obliged to make the product conform and to put an end to the infringement" .

pa:st-1036 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_lift ;
    pa:condition "goods alone if the carrier is accessible" ;
    pa:locator "Art. 24(2)" ;
    pa:quote "‘For the purposes of this Directive, “lift” shall mean a lifting appliance serving specific levels, having a carrier moving along guides which are rigid and inclined at an angle of more than 15 degrees to the horizontal, intended for the transport of: — persons, — persons and goods, — goods alone if the carrier is accessible, that is to say a person may enter it without difficulty, and fitted with controls situated inside the carrier or within reach of a person inside the carrier." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a lifting appliance serving specific levels" .

pa:st-1037 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_carrier ;
    pa:locator "Art. 24(2)" ;
    pa:quote "A “carrier” means a part of the lift by which persons and/or goods are supported in order to be lifted or lowered." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a part of the lift by which persons and/or goods are supported" .

pa:st-1041 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Act_provisions_necessary_to_comply_with_this_Directive ;
    pa:locator "Art. 26(1)" ;
    pa:quote "They shall apply those provisions with effect from 29 December 2009." ;
    pa:relation pa:appliesFrom ;
    pa:sourceDocument "DIR" ;
    pa:value "2009-12-29"^^xsd:date .

pa:st-1044 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_portable_cartridge_operated_fixing_and_other_impact_machiner ;
    pa:condition "which are in conformity with the national provisions in force upon adoption of this Directive" ;
    pa:locator "Art. 27" ;
    pa:quote "Article 27 Derogation Until 29 June 2011 Member States may allow the placing on the market and the putting into service of portable cartridge-operated fixing and other impact machinery which are in conformity with the national provisions in force upon adoption of this Directive." ;
    pa:relation pa:placingAllowedUntil ;
    pa:sourceDocument "DIR" ;
    pa:value "2011-06-29"^^xsd:date .

pa:st-1045 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Act_This_Directive ;
    pa:locator "Art. 28" ;
    pa:quote "Article 28 Entry into force This Directive shall enter into force on the 20th day following its publication in the Official Journal of the European Union." ;
    pa:relation pa:appliesFrom ;
    pa:sourceDocument "DIR" ;
    pa:value "20th day following its publication" .

pa:st-1047 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:locator "Annex I" ;
    pa:quote "By the iterative process of risk assessment and risk reduction referred to above, the manufacturer or his authorised representative shall: — determine the limits of the machinery, which include the intended use and any reasonably foreseeable misuse thereof, — identify the hazards that can be generated by the machinery and the associated hazardous situations, — estimate the risks, taking into account the severity of the possible injury or damage to health and the probability of its occurrence, — evaluate the risks, with a view to determining whether risk reduction is required, in accordance with the objective of this Directive, — eliminate the hazards or reduce the risks associated with these hazards by application of protective measures, in the order of priority established in section 1.1.2(b)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "determine the limits of the machinery" .

pa:st-1048 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:locator "Annex I" ;
    pa:quote "By the iterative process of risk assessment and risk reduction referred to above, the manufacturer or his authorised representative shall: — determine the limits of the machinery, which include the intended use and any reasonably foreseeable misuse thereof, — identify the hazards that can be generated by the machinery and the associated hazardous situations, — estimate the risks, taking into account the severity of the possible injury or damage to health and the probability of its occurrence, — evaluate the risks, with a view to determining whether risk reduction is required, in accordance with the objective of this Directive, — eliminate the hazards or reduce the risks associated with these hazards by application of protective measures, in the order of priority established in section 1.1.2(b)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "identify the hazards that can be generated" .

pa:st-1049 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "in the order of priority established in section 1.1.2(b)" ;
    pa:locator "Annex I" ;
    pa:quote "By the iterative process of risk assessment and risk reduction referred to above, the manufacturer or his authorised representative shall: — determine the limits of the machinery, which include the intended use and any reasonably foreseeable misuse thereof, — identify the hazards that can be generated by the machinery and the associated hazardous situations, — estimate the risks, taking into account the severity of the possible injury or damage to health and the probability of its occurrence, — evaluate the risks, with a view to determining whether risk reduction is required, in accordance with the objective of this Directive, — eliminate the hazards or reduce the risks associated with these hazards by application of protective measures, in the order of priority established in section 1.1.2(b)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "eliminate the hazards or reduce the risks" .

pa:st-1050 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_hazard ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(a) ‘hazard’ means a potential source of injury or damage to health;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a potential source of injury or damage to health" .

pa:st-1051 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_danger_zone ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(b) ‘danger zone’ means any zone within and/or around machinery in which a person is subject to a risk to his health or safety;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "any zone within and/or around machinery" .

pa:st-1052 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_exposed_person ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(c) ‘exposed person’ means any person wholly or partially in a danger zone;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "any person wholly or partially in a danger zone" .

pa:st-1053 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_operator ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(d) ‘operator’ means the person or persons installing, operating, adjusting, maintaining, cleaning, repairing or moving machinery;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the person or persons installing, operating, adjusting, maintaining, cleaning, repairing or moving machinery" .

pa:st-1054 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_risk ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(e) ‘risk’ means a combination of the probability and the degree of an injury or damage to health that can arise in a hazardous situation;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a combination of the probability and the degree of an injury or damage to health" .

pa:st-1055 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_guard ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(f) ‘guard’ means a part of the machinery used specifically to provide protection by means of a physical barrier;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a part of the machinery used specifically to provide protection by means of a physical barrier" .

pa:st-1056 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_protective_device ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(g) ‘protective device’ means a device (other than a guard) which reduces the risk, either alone or in conjunction with a guard;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a device (other than a guard) which reduces the risk" .

pa:st-1057 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_intended_use ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(h) ‘intended use’ means the use of machinery in accordance with the information provided in the instructions for use;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the use of machinery in accordance with the information provided in the instructions for use" .

pa:st-1058 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_reasonably_foreseeable_misuse ;
    pa:condition "but which may result from readily predictable human behaviour" ;
    pa:locator "Annex I, 1.1.1" ;
    pa:quote "(i) ‘reasonably foreseeable misuse’ means the use of machinery in a way not intended in the instructions for use, but which may result from readily predictable human behaviour." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the use of machinery in a way not intended in the instructions for use" .

pa:st-1059 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "The aim of measures taken must be to eliminate any risk throughout the foreseeable lifetime of the machinery including the phases of transport, assembly, dismantling, disabling and scrapping." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "eliminate any risk throughout the foreseeable lifetime" .

pa:st-1060 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:condition "in the order given" ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "(b) In selecting the most appropriate methods, the manufacturer or his authorised representative must apply the following principles, in the order given: — eliminate or reduce risks as far as possible (inherently safe machinery design and construction), — take the necessary protective measures in relation to risks that cannot be eliminated, — inform users of the residual risks due to any shortcomings of the protective measures adopted, indicate whether any particular training is required and specify any need to provide personal protective equipment." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "eliminate or reduce risks as far as possible" .

pa:st-1061 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "(b) In selecting the most appropriate methods, the manufacturer or his authorised representative must apply the following principles, in the order given: — eliminate or reduce risks as far as possible (inherently safe machinery design and construction), — take the necessary protective measures in relation to risks that cannot be eliminated, — inform users of the residual risks due to any shortcomings of the protective measures adopted, indicate whether any particular training is required and specify any need to provide personal protective equipment." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "take the necessary protective measures in relation to risks that cannot be eliminated" .

pa:st-1062 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "(b) In selecting the most appropriate methods, the manufacturer or his authorised representative must apply the following principles, in the order given: — eliminate or reduce risks as far as possible (inherently safe machinery design and construction), — take the necessary protective measures in relation to risks that cannot be eliminated, — inform users of the residual risks due to any shortcomings of the protective measures adopted, indicate whether any particular training is required and specify any need to provide personal protective equipment." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "inform users of the residual risks" .

pa:st-1063 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:condition "when designing and constructing machinery and drafting the instructions" ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "(c) When designing and constructing machinery and when drafting the instructions, the manufacturer or his authorised representative must envisage not only the intended use of the machinery but also any reasonably foreseeable misuse thereof." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "envisage not only the intended use" .

pa:st-1064 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_machinery_design ;
    pa:condition "if such use would engender a risk" ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "The machinery must be designed and constructed in such a way as to prevent abnormal use if such use would engender a risk." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "prevent abnormal use" .

pa:st-1065 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_instructions ;
    pa:condition "where appropriate" ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "Where appropriate, the instructions must draw the user's attention to ways — which experience has shown might occur — in which the machinery should not be used." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "draw the user's attention to ways" .

pa:st-1066 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_machinery_design ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "(d) Machinery must be designed and constructed to take account of the constraints to which the operator is subject as a result of the necessary or foreseeable use of personal protective equipment." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "take account of the constraints to which the operator is subject" .

pa:st-1067 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_machinery_supplier ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "(e) Machinery must be supplied with all the special equipment and accessories essential to enable it to be adjusted, maintained and used safely." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "supplied with all the special equipment and accessories" .

pa:st-1068 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_2_a ;
    pa:condition "when these operations are carried out under the conditions foreseen" ;
    pa:locator "Annex I, 1.1.2" ;
    pa:quote "Principles of safety integration (a) Machinery must be designed and constructed so that it is fitted for its function, and can be operated, adjusted and maintained without putting persons at risk when these operations are carried out under the conditions foreseen but also taking into account any reasonably foreseeable misuse thereof." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_putting_persons_at_risk .

pa:st-1069 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_3_on_materials ;
    pa:locator "Annex I, 1.1.3" ;
    pa:quote "Materials and products The materials used to construct machinery or products used or created during its use must not endanger persons' safety or health." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_endanger_persons_safety_or_health .

pa:st-1070 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_using_fluids ;
    pa:condition "where fluids are used" ;
    pa:locator "Annex I, 1.1.3" ;
    pa:quote "In particular, where fluids are used, machinery must be designed and constructed to prevent risks due to filling, use, recovery or draining." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risks_due_to_filling_use_recovery_or_draining .

pa:st-1072 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_lighting_machinery ;
    pa:condition "where the absence thereof is likely to cause a risk despite ambient lighting of normal intensity" ;
    pa:locator "Annex I, 1.1.4" ;
    pa:quote "Lighting Machinery must be supplied with integral lighting suitable for the operations concerned where the absence thereof is likely to cause a risk despite ambient lighting of normal intensity." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_integral_lighting .

pa:st-1073 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_internal_parts_requiring_frequent_inspection_and_adjustment_ ;
    pa:locator "Annex I, 1.1.4" ;
    pa:quote "Internal parts requiring frequent inspection and adjustment, and maintenance areas must be provided with appropriate lighting." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_lighting .

pa:st-1075 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_machinery_handling ;
    pa:condition "Where the weight, size or shape of machinery or its various component parts prevents them from being moved by hand" ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Where the weight, size or shape of machinery or its various component parts prevents them from being moved by hand, the machinery or each component part must: — either be fitted with attachments for lifting gear, or — be designed so that it can be fitted with such attachments, or — be shaped in such a way that standard lifting gear can easily be attached." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_attachments_for_lifting_gear .

pa:st-1076 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_machinery_handling ;
    pa:condition "Where the weight, size or shape of machinery or its various component parts prevents them from being moved by hand" ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Where the weight, size or shape of machinery or its various component parts prevents them from being moved by hand, the machinery or each component part must: — either be fitted with attachments for lifting gear, or — be designed so that it can be fitted with such attachments, or — be shaped in such a way that standard lifting gear can easily be attached." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_be_designed_so_that_it_can_be_fitted_with_such_attachments .

pa:st-1077 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_machinery_handling ;
    pa:condition "Where the weight, size or shape of machinery or its various component parts prevents them from being moved by hand" ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Where the weight, size or shape of machinery or its various component parts prevents them from being moved by hand, the machinery or each component part must: — either be fitted with attachments for lifting gear, or — be designed so that it can be fitted with such attachments, or — be shaped in such a way that standard lifting gear can easily be attached." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_be_shaped_in_such_a_way_that_standard_lifting_gear_can_easil .

pa:st-1078 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_machinery_moved_by_hand ;
    pa:condition "Where machinery or one of its component parts is to be moved by hand" ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Where machinery or one of its component parts is to be moved by hand, it must: — either be easily moveable, or — be equipped for picking up and moving safely." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_easily_moveable .

pa:st-1079 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_machinery_moved_by_hand ;
    pa:condition "Where machinery or one of its component parts is to be moved by hand" ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Where machinery or one of its component parts is to be moved by hand, it must: — either be easily moveable, or — be equipped for picking up and moving safely." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_equipped_for_picking_up_and_moving_safely .

pa:st-1080 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_storage ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Design of machinery to facilitate its handling Machinery, or each component part thereof, must: — be capable of being handled and transported safely, — be packaged or designed so that it can be stored safely and without damage." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_packaged_or_designed_so_that_it_can_be_stored_safely .

pa:st-1081 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_5_tools_and_machinery_parts ;
    pa:condition "which, even if lightweight, could be hazardous" ;
    pa:locator "Annex I, 1.1.5" ;
    pa:quote "Special arrangements must be made for the handling of tools and/or machinery parts which, even if lightweight, could be hazardous." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Special_arrangements_must_be_made_for_the_handling_of_tools .

pa:st-1084 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operating_position ;
    pa:locator "Annex I, 1.1.7" ;
    pa:quote "Operating positions The operating position must be designed and constructed in such a way as to avoid any risk due to exhaust gases and/or lack of oxygen." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_any_risk_due_to_exhaust_gases_and_or_lack_of_oxygen .

pa:st-1085 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operating_position_in_hazardous_environment ;
    pa:condition "If the machinery is intended to be used in a hazardous environment presenting risks to the health and safety of the operator or if the machinery itself gives rise to a hazardous environment" ;
    pa:locator "Annex I, 1.1.7" ;
    pa:quote "If the machinery is intended to be used in a hazardous environment presenting risks to the health and safety of the operator or if the machinery itself gives rise to a hazardous environment, adequate means must be provided to ensure that the operator has good working conditions and is protected against any foreseeable hazards." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_adequate_means_must_be_provided .

pa:st-1086 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operating_position ;
    pa:condition "Where appropriate" ;
    pa:locator "Annex I, 1.1.7" ;
    pa:quote "Where appropriate, the operating position must be fitted with an adequate cabin designed, constructed and/or equipped to fulfil the above requirements." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_adequate_cabin .

pa:st-1087 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_exit ;
    pa:locator "Annex I, 1.1.7" ;
    pa:quote "The exit must allow rapid evacuation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_The_exit_must_allow_rapid_evacuation .

pa:st-1088 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_emergency_exit ;
    pa:condition "when applicable" ;
    pa:locator "Annex I, 1.1.7" ;
    pa:quote "Moreover, when applicable, an emergency exit must be provided in a direction which is different from the usual exit." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_emergency_exit_must_be_provided_in_a_direction_which_is_d .

pa:st-1089 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_8_seating_footrests ;
    pa:condition "where there is no floor beneath the feet of the operator" ;
    pa:locator "Annex I, 1.1.8" ;
    pa:quote "Where there is no floor beneath the feet of the operator, footrests covered with a slip-resistant material must be provided." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_footrests_covered_with_a_slip_resistant_material .

pa:st-1090 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_8_seating_operator_s_seat ;
    pa:condition "If the operator is intended to sit during operation and the operating position is an integral part of the machinery" ;
    pa:locator "Annex I, 1.1.8" ;
    pa:quote "If the operator is intended to sit during operation and the operating position is an integral part of the machinery, the seat must be provided with the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_seat_must_be_provided_with_the_machinery .

pa:st-1091 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_8_seating_vibration ;
    pa:condition "If the machinery is subject to vibrations" ;
    pa:locator "Annex I, 1.1.8" ;
    pa:quote "If the machinery is subject to vibrations, the seat must be designed and constructed in such a way as to reduce the vibrations transmitted to the operator to the lowest level that is reasonably possible." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_reduce_the_vibrations_transmitted_to_the_operator .

pa:st-1092 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_8_seating_seat_mountings ;
    pa:locator "Annex I, 1.1.8" ;
    pa:quote "The seat mountings must withstand all stresses to which they can be subjected." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_seat_mountings_must_withstand_all_stresses .

pa:st-1093 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_1_8_seating_work_stations ;
    pa:condition "Where appropriate and where the working conditions so permit" ;
    pa:locator "Annex I, 1.1.8" ;
    pa:quote "Seating Where appropriate and where the working conditions so permit, work stations constituting an integral part of the machinery must be designed for the installation of seats." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_be_designed_for_the_installation_of_seats .

pa:st-1094 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_systems_safety_and_reliability ;
    pa:locator "Annex I, 1.2.1" ;
    pa:quote "Safety and reliability of control systems Control systems must be designed and constructed in such a way as to prevent hazardous situations from arising." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_hazardous_situations .

pa:st-1095 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_cable_less_control ;
    pa:condition "when correct control signals are not received, including loss of communication" ;
    pa:locator "Annex I, 1.2.1" ;
    pa:quote "For cable-less control, an automatic stop must be activated when correct control signals are not received, including loss of communication." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_automatic_stop_must_be_activated .

pa:st-1097 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_1_2_2 ;
    pa:condition "liable to be subjected to considerable forces" ;
    pa:locator "Annex I, 1.2.2" ;
    pa:quote "particular attention must be paid to emergency stop devices liable to be subjected to considerable forces." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_emergency_stop_devices .

pa:st-1098 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_1_2_2 ;
    pa:condition "If neither of these possibilities is applicable, before the machinery starts" ;
    pa:locator "Annex I, 1.2.2" ;
    pa:quote "If neither of these possibilities is applicable, before the machinery starts, an acoustic and/or visual warning signal must be given." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_acoustic_and_or_visual_warning_signal .

pa:st-1099 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_1_2_2 ;
    pa:condition "If necessary" ;
    pa:locator "Annex I, 1.2.2" ;
    pa:quote "If necessary, means must be provided to ensure that the machinery can be controlled only from control positions located in one or more predetermined zones or locations." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_means_must_be_provided_to_ensure_that_the_machinery_can_be_c .

pa:st-1100 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_starting_of_machinery ;
    pa:locator "Annex I, 1.2.3" ;
    pa:quote "Starting It must be possible to start machinery only by voluntary actuation of a control device provided for the purpose." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_only_by_voluntary_actuation_of_a_control_device_provided_for .

pa:st-1101 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_restarting_or_change_in_operating_conditions ;
    pa:condition "on condition that this does not lead to a hazardous situation" ;
    pa:locator "Annex I, 1.2.3" ;
    pa:quote "However, the restarting of the machinery or a change in operating conditions may be effected by voluntary actuation of a device other than the control device provided for the purpose, on condition that this does not lead to a hazardous situation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_voluntary_actuation_of_a_device_other_than_the_control_devic .

pa:st-1102 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_several_starting_control_devices ;
    pa:condition "where machinery has several starting control devices and the operators can therefore put each other in danger" ;
    pa:locator "Annex I, 1.2.3" ;
    pa:quote "Where machinery has several starting control devices and the operators can therefore put each other in danger, additional devices must be fitted to rule out such risks." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_additional_devices_must_be_fitted .

pa:st-1103 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_starting_and_or_stopping_in_a_specific_sequence ;
    pa:condition "if safety requires that starting and/or stopping must be performed in a specific sequence" ;
    pa:locator "Annex I, 1.2.3" ;
    pa:quote "If safety requires that starting and/or stopping must be performed in a specific sequence, there must be devices which ensure that these operations are performed in the correct order." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_devices_which_ensure_that_these_operations_are_performed_in_ .

pa:st-1105 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_2_4_1_normal_stop ;
    pa:condition "\"\"" ;
    pa:locator "Annex I, 1.2.4.1" ;
    pa:quote "Normal stop Machinery must be fitted with a control device whereby the machinery can be brought safely to a complete stop." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_control_device .

pa:st-1106 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_2_4_1_workstation_stop ;
    pa:condition "depending on the existing hazards" ;
    pa:locator "Annex I, 1.2.4.1" ;
    pa:quote "Each workstation must be fitted with a control device to stop some or all of the functions of the machinery, depending on the existing hazards, so that the machinery is rendered safe." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_control_device .

pa:st-1107 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_2_4_1_energy_cut_off ;
    pa:condition "once the machinery or its hazardous functions have stopped" ;
    pa:locator "Annex I, 1.2.4.1" ;
    pa:quote "Once the machinery or its hazardous functions have stopped, the energy supply to the actuators concerned must be cut off." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_energy_supply_to_the_actuators .

pa:st-1109 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operational_stop ;
    pa:condition "Where, for operational reasons, a stop control that does not cut off the energy supply to the actuators is required" ;
    pa:locator "Annex I, 1.2.4.2" ;
    pa:quote "Operational stop Where, for operational reasons, a stop control that does not cut off the energy supply to the actuators is required, the stop condition must be monitored and maintained." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_stop_condition_must_be_monitored_and_maintained .

pa:st-1110 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_emergency_stop_numbered_requirement_1_2_4_3 ;
    pa:condition "The following exceptions apply" ;
    pa:locator "Annex I, 1.2.4.3" ;
    pa:quote "Emergency stop Machinery must be fitted with one or more emergency stop devices to enable actual or impending danger to be averted. The following exceptions apply: — machinery in which an emergency stop device would not lessen the risk, either because it would not reduce the stopping time or because it would not enable the special measures required to deal with the risk to be taken, — portable hand-held and/or hand-guided machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_emergency_stop_devices .

pa:st-1111 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_emergency_stop_numbered_requirement_1_2_4_3 ;
    pa:locator "Annex I, 1.2.4.3" ;
    pa:quote "Emergency stop Machinery must be fitted with one or more emergency stop devices to enable actual or impending danger to be averted." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_actual_or_impending_danger .

pa:st-1113 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_2_4_4_assembly_of_machinery ;
    pa:condition "if its continued operation may be dangerous" ;
    pa:locator "Annex I, 1.2.4.4" ;
    pa:quote "Assembly of machinery In the case of machinery or parts of machinery designed to work together, the machinery must be designed and constructed in such a way that the stop controls, including the emergency stop devices, can stop not only the machinery itself but also all related equipment, if its continued operation may be dangerous." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_stop_controls_including_the_emergency_stop_devices .

pa:st-1114 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "If machinery has been designed and constructed to allow its use in several control or operating modes requiring different protective measures and/or work procedures" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "If machinery has been designed and constructed to allow its use in several control or operating modes requiring different protective measures and/or work procedures, it must be fitted with a mode selector which can be locked in each position." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_mode_selector_which_can_be_locked_in_each_position .

pa:st-1115 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "The selector may be replaced" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "The selector may be replaced by another selection method which restricts the use of certain functions of the machinery to certain categories of operator." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_another_selection_method_which_restricts_the_use_of_certain_ .

pa:st-1116 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled, the control or operating mode selector must simultaneously: — disable all other control or operating modes, — permit operation of hazardous functions only by control devices requiring sustained action, — permit the operation of hazardous functions only in reduced risk conditions while preventing hazards from linked sequences, — prevent any operation of hazardous functions by voluntary or involuntary action on the machine's sensors." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_disable_all_other_control_or_operating_modes .

pa:st-1117 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled, the control or operating mode selector must simultaneously: — disable all other control or operating modes, — permit operation of hazardous functions only by control devices requiring sustained action, — permit the operation of hazardous functions only in reduced risk conditions while preventing hazards from linked sequences, — prevent any operation of hazardous functions by voluntary or involuntary action on the machine's sensors." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_permit_operation_of_hazardous_functions_only_by_control_devi .

pa:st-1118 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled, the control or operating mode selector must simultaneously: — disable all other control or operating modes, — permit operation of hazardous functions only by control devices requiring sustained action, — permit the operation of hazardous functions only in reduced risk conditions while preventing hazards from linked sequences, — prevent any operation of hazardous functions by voluntary or involuntary action on the machine's sensors." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_permit_the_operation_of_hazardous_functions_only_in_reduced_ .

pa:st-1119 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "If, for certain operations, the machinery must be able to operate with a guard displaced or removed and/or a protective device disabled, the control or operating mode selector must simultaneously: — disable all other control or operating modes, — permit operation of hazardous functions only by control devices requiring sustained action, — permit the operation of hazardous functions only in reduced risk conditions while preventing hazards from linked sequences, — prevent any operation of hazardous functions by voluntary or involuntary action on the machine's sensors." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_prevent_any_operation_of_hazardous_functions_by_voluntary_or .

pa:st-1120 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_mode_selector ;
    pa:condition "If these four conditions cannot be fulfilled simultaneously" ;
    pa:locator "Annex I, 1.2.5" ;
    pa:quote "If these four conditions cannot be fulfilled simultaneously, the control or operating mode selector must activate other protective measures designed and constructed to ensure a safe intervention zone." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_other_protective_measures_designed_and_constructed_to_ensure .

pa:st-1122 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_failure_of_power_supply ;
    pa:locator "Annex I, 1.2.6" ;
    pa:quote "Failure of the power supply The interruption, the re-establishment after an interruption or the fluctuation in whatever manner of the power supply to the machinery must not lead to dangerous situations." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_dangerous_situations .

pa:st-1124 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_1 ;
    pa:locator "Annex I, 1.3.1" ;
    pa:quote "Risk of loss of stability Machinery and its components and fittings must be stable enough to avoid overturning, falling or uncontrolled movements during transportation, assembly, dismantling and any other action involving the machinery." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risk_of_loss_of_stability .

pa:st-1125 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_stability ;
    pa:condition "If the shape of the machinery itself or its intended installation does not offer sufficient stability" ;
    pa:locator "Annex I, 1.3.1" ;
    pa:quote "If the shape of the machinery itself or its intended installation does not offer sufficient stability, appropriate means of anchorage must be incorporated and indicated in the instructions." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_means_of_anchorage .

pa:st-1127 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_2 ;
    pa:locator "Annex I, 1.3.2" ;
    pa:quote "1.3.2. Risk of break-up during operation The various parts of machinery and their linkages must be able to withstand the stresses to which they are subject when used." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risk_of_break_up_during_operation .

pa:st-1128 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_parts_concerned_where_rupture_or_disintegration_risk_remains ;
    pa:condition "Where a risk of rupture or disintegration remains despite the measures taken" ;
    pa:locator "Annex I, 1.3.2" ;
    pa:quote "Where a risk of rupture or disintegration remains despite the measures taken, the parts concerned must be mounted, positioned and/or guarded in such a way that any fragments will be contained, preventing hazardous situations." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_guarded .

pa:st-1129 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_pipes_carrying_fluids ;
    pa:locator "Annex I, 1.3.2" ;
    pa:quote "Both rigid and flexible pipes carrying fluids, particularly those under high pressure, must be able to withstand the foreseen internal and external stresses and must be firmly attached and/or protected to ensure that no risk is posed by a rupture." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_firmly_attached_and_or_protected .

pa:st-1130 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_automatic_feed_of_material_to_the_tool ;
    pa:condition "Where the material to be processed is fed to the tool automatically" ;
    pa:locator "Annex I, 1.3.2" ;
    pa:quote "Where the material to be processed is fed to the tool automatically, the following conditions must be fulfilled to avoid risks to persons: — when the workpiece comes into contact with the tool, the latter must have attained its normal working condition, — when the tool starts and/or stops (intentionally or accidentally), the feed movement and the tool movement must be coordinated." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_be_coordinated .

pa:st-1132 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_3 ;
    pa:locator "Annex I, 1.3.3" ;
    pa:quote "Risks due to falling or ejected objects Precautions must be taken to prevent risks from falling or ejected objects." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_due_to_falling_or_ejected_objects .

pa:st-1133 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_3 ;
    pa:locator "Annex I, 1.3.3" ;
    pa:quote "Risks due to falling or ejected objects Precautions must be taken to prevent risks from falling or ejected objects." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Precautions_must_be_taken .

pa:st-1134 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_3_4_essential_requirement ;
    pa:condition "Insofar as their purpose allows" ;
    pa:locator "Annex I, 1.3.4" ;
    pa:quote "Risks due to surfaces, edges or angles Insofar as their purpose allows, accessible parts of the machinery must have no sharp edges, no sharp angles and no rough surfaces likely to cause injury." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_due_to_surfaces_edges_or_angles .

pa:st-1135 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_accessible_parts_of_the_machinery ;
    pa:condition "Insofar as their purpose allows" ;
    pa:locator "Annex I, 1.3.4" ;
    pa:quote "Risks due to surfaces, edges or angles Insofar as their purpose allows, accessible parts of the machinery must have no sharp edges, no sharp angles and no rough surfaces likely to cause injury." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_no_sharp_edges_no_sharp_angles_and_no_rough_surfaces .

pa:st-1136 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_3_5 ;
    pa:condition "Where the machinery is intended to carry out several different operations with manual removal of the piece between each operation" ;
    pa:locator "Annex I, 1.3.5" ;
    pa:quote "Risks related to combined machinery Where the machinery is intended to carry out several different operations with manual removal of the piece between each operation (combined machinery), it must be designed and constructed in such a way as to enable each element to be used separately without the other elements constituting a risk for exposed persons." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_related_to_combined_machinery .

pa:st-1137 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_3_5 ;
    pa:condition "For this purpose" ;
    pa:locator "Annex I, 1.3.5" ;
    pa:quote "For this purpose, it must be possible to start and stop separately any elements that are not protected." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_start_and_stop_separately .

pa:st-1138 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_6 ;
    pa:condition "Where the machinery performs operations under different conditions of use" ;
    pa:locator "Annex I, 1.3.6" ;
    pa:quote "1.3.6. Risks related to variations in operating conditions Where the machinery performs operations under different conditions of use, it must be designed and constructed in such a way that selection and adjustment of these conditions can be carried out safely and reliably." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_related_to_variations_in_operating_conditions .

pa:st-1140 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_7 ;
    pa:locator "Annex I, 1.3.7" ;
    pa:quote "Risks related to moving parts The moving parts of machinery must be designed and constructed in such a way as to prevent risks of contact which could lead to accidents or must, where risks persist, be fitted with guards or protective devices." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_related_to_moving_parts .

pa:st-1141 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_moving_parts ;
    pa:condition "where risks persist" ;
    pa:locator "Annex I, 1.3.7" ;
    pa:quote "Risks related to moving parts The moving parts of machinery must be designed and constructed in such a way as to prevent risks of contact which could lead to accidents or must, where risks persist, be fitted with guards or protective devices." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fitted_with_guards_or_protective_devices .

pa:st-1142 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_accidental_blockage_of_moving_parts ;
    pa:locator "Annex I, 1.3.7" ;
    pa:quote "All necessary steps must be taken to prevent accidental blockage of moving parts involved in the work." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_All_necessary_steps_must_be_taken_to_prevent_accidental_bloc .

pa:st-1143 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_unblocking_of_equipment ;
    pa:condition "In cases where, despite the precautions taken, a blockage is likely to occur" ;
    pa:locator "Annex I, 1.3.7" ;
    pa:quote "In cases where, despite the precautions taken, a blockage is likely to occur, the necessary specific protective devices and tools must, when appropriate, be provided to enable the equipment to be safely unblocked." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_necessary_specific_protective_devices_and_tools .

pa:st-1145 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_8 ;
    pa:locator "Annex I, 1.3.8" ;
    pa:quote "Choice of protection against risks arising from moving parts Guards or protective devices designed to protect against risks arising from moving parts must be selected on the basis of the type of risk." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risks_arising_from_moving_parts .

pa:st-1146 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_8 ;
    pa:condition "on the basis of the type of risk" ;
    pa:locator "Annex I, 1.3.8" ;
    pa:quote "Choice of protection against risks arising from moving parts Guards or protective devices designed to protect against risks arising from moving parts must be selected on the basis of the type of risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Guards_or_protective_devices .

pa:st-1148 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_designed_to_protect_persons_against_moving_transmissi ;
    pa:locator "Annex I, 1.3.8.1" ;
    pa:quote "Moving transmission parts Guards designed to protect persons against the hazards generated by moving transmission parts must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fixed_guards .

pa:st-1149 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_designed_to_protect_persons_against_moving_transmissi ;
    pa:locator "Annex I, 1.3.8.1" ;
    pa:quote "Moving transmission parts Guards designed to protect persons against the hazards generated by moving transmission parts must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_interlocking_movable_guards .

pa:st-1150 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_for_moving_transmission_parts_with_frequent_access ;
    pa:condition "where frequent access is envisaged" ;
    pa:locator "Annex I, 1.3.8.1" ;
    pa:quote "Interlocking movable guards should be used where frequent access is envisaged." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Interlocking_movable_guards .

pa:st-1151 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_designed_to_protect_persons ;
    pa:locator "Annex I, 1.3.8.1" ;
    pa:quote "Moving transmission parts Guards designed to protect persons against the hazards generated by moving transmission parts must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_hazards_generated_by_moving_transmission_parts .

pa:st-1152 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_moving_parts_involved_in_the_process ;
    pa:locator "Annex I, 1.3.8.2" ;
    pa:quote "Moving parts involved in the process Guards or protective devices designed to protect persons against the hazards generated by moving parts involved in the process must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2, or — protective devices as referred to in section 1.4.3, or — a combination of the above." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_hazards_generated_by_moving_parts .

pa:st-1153 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_moving_parts_involved_in_the_process ;
    pa:locator "Annex I, 1.3.8.2" ;
    pa:quote "Moving parts involved in the process Guards or protective devices designed to protect persons against the hazards generated by moving parts involved in the process must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2, or — protective devices as referred to in section 1.4.3, or — a combination of the above." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fixed_guards_as_referred_to_in_section_1_4_2_1 .

pa:st-1154 a pa:Statement ;
