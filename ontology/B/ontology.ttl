pa:st-0539 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_and_protective_devices_general_requirements_1_4_1 ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.1" ;
    pa:quote "(d) not be easy to by-pass or render non-operational;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_not_be_easy_to_by_pass_or_render_non_operational .

pa:st-0540 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_and_protective_devices_general_requirements_1_4_1 ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.1" ;
    pa:quote "(e) be located at an adequate distance from the danger zone;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_be_located_at_an_adequate_distance_from_the_danger_zone .

pa:st-0541 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_access_restriction_for_essential_work_and_maintenance ;
    pa:condition "if possible without the guard having to be removed or the protective device having to be disabled" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.1" ;
    pa:quote "(g) enable essential work to be carried out on the installation and/or replacement of tools and for maintenance purposes by restricting access exclusively to the area where the work has to be done, if possible without the guard having to be removed or the protective device having to be disabled." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_restricting_access_exclusively_to_the_area_where_the_work_ha .

pa:st-0542 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_and_protective_devices_final_paragraph_of_1_4_1 ;
    pa:condition "where possible" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.1" ;
    pa:quote "In addition, guards shall, where possible, protect against the ejection or falling of materials or objects and against emissions generated by the machinery or related product." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_protect_against_the_ejection_or_falling_of_materials_or_obje .

pa:st-0543 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_and_protective_devices_final_paragraph_of_1_4_1 ;
    pa:condition "where possible" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.1" ;
    pa:quote "In addition, guards shall, where possible, protect against the ejection or falling of materials or objects and against emissions generated by the machinery or related product." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_against_emissions_generated_by_the_machinery_or_related_prod .

pa:st-0544 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_fixed_guards ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.1" ;
    pa:quote "Fixed guards Fixed guards shall be fixed by systems that can be opened or removed only with tools." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_fixed_by_systems_that_can_be_opened_or_removed_only_with_too .

pa:st-0545 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_fixing_systems_of_guards ;
    pa:condition "when the guards are removed" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.1" ;
    pa:quote "Their fixing systems shall remain attached to the guards or to the machinery or related product when the guards are removed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_remain_attached_to_the_guards .

pa:st-0546 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards ;
    pa:condition "where possible" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.1" ;
    pa:quote "Where possible, guards shall be incapable of remaining in place without their fixings." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_incapable_of_remaining_in_place_without_their_fixings .

pa:st-0547 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_interlocking_movable_guards ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.2" ;
    pa:quote "Interlocking movable guards shall be associated with an interlocking device that:" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_an_interlocking_device .

pa:st-0548 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movable_guards ;
    pa:condition "Where it is possible for an operator to reach the danger zone before the risk due to the hazardous machinery or related product functions has ceased" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.2" ;
    pa:quote "Where it is possible for an operator to reach the danger zone before the risk due to the hazardous machinery or related product functions has ceased, movable guards shall be associated with a guard locking device in addition to an interlocking device that:" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_a_guard_locking_device .

pa:st-0549 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_interlocking_movable_guards ;
    pa:condition "whenever those guards are no longer closed" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.2" ;
    pa:quote "and (b) gives a stop command whenever those guards are no longer closed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_stop_command .

pa:st-0550 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_interlocking_movable_guards ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.2" ;
    pa:quote "and (b) keeps the guard closed and locked until the risk of injury from the hazardous machinery or related product functions has ceased." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_injury .

pa:st-0552 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustable_guards_restricting_access ;
    pa:condition "depending on the type of work involved" ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.3" ;
    pa:quote "(a) adjustable manually or automatically, depending on the type of work involved;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_adjustable_manually_or_automatically .

pa:st-0553 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustable_guards_restricting_access ;
    pa:layer "law" ;
    pa:locator "Annex III, 1.4.2.3" ;
    pa:quote "and (b) readily adjustable without the use of tools." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_readily_adjustable_without_the_use_of_tools .

pa:st-0554 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
