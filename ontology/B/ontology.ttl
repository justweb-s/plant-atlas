pa:law_verification-dm2011-01 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_attrezzature_di_lavoro_soggette_a_verifiche_periodiche ;
    pa:layer "law" ;
    pa:locator "art. 1, c. 1" ;
    pa:quote "Il presente decreto disciplina le modalita' di effettuazione delle verifiche periodiche cui sono sottoposte le attrezzature di lavoro di cui all'allegato VII del decreto legislativo n." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DM2011" ;
    pa:value pa:Provision_allegato_VII .

pa:law_verification-dm2011-02 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_verifiche_periodiche_di_cui_all_articolo_71_comma_11 ;
    pa:condition "condizioni in presenza delle quali l'INAIL e le ASL possono avvalersi" ;
    pa:layer "law" ;
    pa:locator "art. 1, c. 1" ;
    pa:quote "81/2008, nonche' i criteri per l'abilitazione dei soggetti pubblici o privati e individua le condizioni in presenza delle quali l'INAIL e le ASL possono avvalersi del supporto di soggetti pubblici o privati, ai sensi dell'articolo 71, comma 12, del decreto legislativo n. 81/2008, per l'effettuazione delle verifiche periodiche di cui all'articolo 71, comma 11." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DM2011" ;
    pa:value pa:VerifyingBody_soggetti_pubblici_o_privati .

pa:law_verification-dm2011-04 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_first_periodic_verification ;
    pa:condition "della prima delle verifiche periodiche" ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 1" ;
    pa:quote "81/2008, l'INAIL e' titolare della prima delle verifiche periodiche da effettuarsi nel termine di sessanta giorni dalla richiesta, mentre le ASL sono titolari delle verifiche periodiche successive alla prima, da effettuarsi nel termine di trenta giorni dalla richiesta." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DM2011" ;
    pa:value pa:VerifyingBody_INAIL .

pa:law_verification-dm2011-06 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_subsequent_periodic_verifications ;
    pa:condition "successive alla prima" ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 1" ;
    pa:quote "81/2008, l'INAIL e' titolare della prima delle verifiche periodiche da effettuarsi nel termine di sessanta giorni dalla richiesta, mentre le ASL sono titolari delle verifiche periodiche successive alla prima, da effettuarsi nel termine di trenta giorni dalla richiesta." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DM2011" ;
    pa:value pa:VerifyingBody_ASL .

pa:law_verification-dm2011-07 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_subsequent_periodic_verifications ;
    pa:condition "successive alla prima" ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 1" ;
    pa:quote "81/2008, l'INAIL e' titolare della prima delle verifiche periodiche da effettuarsi nel termine di sessanta giorni dalla richiesta, mentre le ASL sono titolari delle verifiche periodiche successive alla prima, da effettuarsi nel termine di trenta giorni dalla richiesta." ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "DM2011" ;
    pa:value "P30D"^^xsd:duration .

pa:law_verification-dm2011-08 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "laddove non sia in grado di provvedere direttamente con la propria struttura" ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 2" ;
    pa:quote "All'atto della richiesta di verifica, il datore di lavoro indica il nominativo del soggetto abilitato, pubblico o privato, del quale il soggetto titolare della funzione si avvale laddove non sia in grado di provvedere direttamente con la propria struttura o a seguito degli accordi di cui al comma 3 nei termini temporali di cui al comma 1." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "il datore di lavoro indica il nominativo" .

pa:law_verification-dm2011-09 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_soggetto_abilitato ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 2" ;
    pa:quote "Con l'iscrizione all'elenco, il soggetto abilitato si impegna al rispetto dei termini temporali di cui al comma l." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "si impegna al rispetto dei termini temporali" .

pa:law_verification-dm2011-10 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_soggetti_abilitati ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 2" ;
    pa:quote "I soggetti abilitati, pubblici o privati, devono essere in possesso dei requisiti riportati nell'allegato I, che e' parte integrante del presente decreto." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "devono essere in possesso dei requisiti" .

pa:law_verification-dm2011-11 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_titolare_della_funzione ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 2" ;
    pa:quote "L'elenco di cui al comma precedente e' messo a disposizione dei datori di lavoro, a cura del titolare della funzione, per l'individuazione del soggetto di cui avvalersi." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "messo a disposizione dei datori di lavoro" .

pa:law_verification-dm2011-12 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "Decorsi i termini temporali di cui al comma l" ;
    pa:layer "law" ;
    pa:locator "art. 2, c. 2" ;
    pa:quote "Decorsi i termini temporali di cui al comma l, il datore di lavoro puo' avvalersi dei soggetti abilitati, pubblici o privati, di cui all'elenco previsto nell'allegato III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "puo' avvalersi dei soggetti abilitati" .

pa:law_verification-dm2011-14 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "Nell'ipotesi di cui all'articolo 2, comma 8" ;
    pa:layer "law" ;
    pa:locator "art. 3" ;
    pa:quote "Nell'ipotesi di cui all'articolo 2, comma 8: a) il datore di lavoro comunica al soggetto titolare della funzione il nominativo del soggetto abilitato, pubblico o privato, incaricato della verifica;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "comunica al soggetto titolare della funzione il nominativo" .

pa:law_verification-dm2011-15 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_soggetto_abilitato_incaricato_dal_datore_di_lavoro ;
    pa:condition "Nell'ipotesi di cui all'articolo 2, comma 8" ;
    pa:layer "law" ;
    pa:locator "art. 3" ;
    pa:quote "c) il soggetto abilitato, pubblico o privato, che e' stato incaricato dal datore di lavoro della verifica, corrisponde all'INAIL." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DM2011" ;
    pa:value "corrisponde all'INAIL" .

