    pa:condition "with manual loading and/or unloading, whose movable working parts may have a travel exceeding 6 mm and a speed exceeding 30 mm/s" ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Presses, including press-brakes, for the cold working of metals, with manual loading and/or unloading, whose movable working parts may have a travel exceeding 6 mm and a speed exceeding 30 mm/s." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Presses_including_press_brakes .

