    pa:locator "Annex V" ;
    pa:quote "2. Protective devices designed to detect the presence of persons." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Protective_devices_designed_to_detect_the_presence_of_person .

pa:st-1502 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_roll_over_protective_structures_ROPS ;
    pa:layer "law" ;
    pa:locator "Annex V" ;
    pa:quote "14. Roll-over protective structures (ROPS)." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
