    pa:about pa:MachineryCategory_portable_chainsaws_for_woodworking ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Portable chainsaws for woodworking." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Portable_chainsaws_for_woodworking .

pa:st-1492 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_manually_loaded_trucks_for_collection_of_household_refuse ;
    pa:condition "incorporating a compression mechanism" ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Manually loaded trucks for the collection of household refuse incorporating a compression mechanism." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Manually_loaded_trucks_for_the_collection_of_household_refus .

pa:st-1493 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_vehicle_servicing_lifts ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Vehicle servicing lifts." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Vehicle_servicing_lifts .

pa:st-1494 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_devices_for_lifting_persons_or_persons_and_goods ;
    pa:condition "involving a hazard of falling from a vertical height of more than three metres" ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Devices for the lifting of persons or of persons and goods involving a hazard of falling from a vertical height of more than three metres." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Devices_for_the_lifting_of_persons_or_of_persons_and_goods .

pa:st-1495 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_protective_devices_designed_to_detect_the_presence_of_person ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Protective devices designed to detect the presence of persons." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Protective_devices_designed_to_detect_the_presence_of_person .

pa:st-1496 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_logic_units_to_ensure_safety_functions ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Logic units to ensure safety functions." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Logic_units_to_ensure_safety_functions .

pa:st-1497 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_roll_over_protective_structures_ROPS ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Roll-over protective structures (ROPS)." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Roll_over_protective_structures_ROPS .

pa:st-1498 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_falling_object_protective_structures_FOPS ;
    pa:layer "law" ;
    pa:locator "Annex IV" ;
    pa:quote "Falling-object protective structures (FOPS)." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Falling_object_protective_structures_FOPS .

pa:st-1499 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_two_hand_control_devices ;
    pa:layer "law" ;
    pa:locator "Annex V" ;
    pa:quote "16. Two-hand control devices." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Two_hand_control_devices .

