    pa:about pa:EconomicOperator_distributors ;
    pa:condition "while machinery or a related product is under their responsibility" ;
    pa:layer "law" ;
    pa:locator "Art. 15(4)" ;
    pa:quote "Distributors shall ensure that, while machinery or a related product is under their responsibility, the storage or transport conditions do not jeopardise conformity with the essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that" .

pa:st-0185 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_distributors ;
    pa:condition "consider or have reason to believe that machinery or a related product" ;
    pa:layer "law" ;
    pa:locator "Art. 15(5)" ;
    pa:quote "Distributors who consider or have reason to believe that machinery or a related product which they have made available on the market is not in conformity with this Regulation shall make sure that the corrective actions necessary to bring that machinery or related product into conformity, to withdraw it or recall it, as appropriate, are taken." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall make sure that the corrective actions" .

