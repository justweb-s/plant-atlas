pa:company-st-0066 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_attrezzature_di_lavoro_soggette_a_deterioramenti ;
    pa:condition "ogni volta che intervengano eventi eccezionali che possano avere conseguenze pregiudizievoli" ;
    pa:layer "company" ;
    pa:locator "p. 18" ;
    pa:quote "a controlli straordinari al fine di garantire il mantenimento di buone condizioni di sicurezza, ogni volta che intervengano eventi eccezionali che possano avere conseguenze pregiudizievoli per la sicurezza delle attrezzature di lavoro, quali riparazioni trasformazioni, incidenti, fenomeni naturali o periodi prolungati di inattività." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "eventi eccezionali" .

