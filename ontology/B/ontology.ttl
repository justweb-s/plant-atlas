    rdfs:label "SICK nanoScan3 protective field overrun" ;
    pa:minimumDistanceParameter pa:Quantity_ZR_350_mm .

pa:ProtectiveDevice_hazardous_area_protection_protective_field a pa:ProtectiveDevice ;
    rdfs:label "hazardous area protection protective field" ;
    pa:minimumDistanceRule "the minimum distance typically defines the protective field size required" .

pa:ProtectiveDevice_nanoScan3_protective_field_lower_edge a pa:ProtectiveDevice ;
    rdfs:label "nanoScan3 protective field lower edge" ;
    pa:protectiveFieldRange pa:Quantity_300_mm .

pa:ProtectiveDevice_nanoScan3_protective_field_overrun a pa:ProtectiveDevice ;
    rdfs:label "nanoScan3 protective field overrun" ;
    pa:minimumDistanceParameter pa:Quantity_ZR_350_mm .

pa:ProtectiveDevice_nanoScan3_response_distance_SAnS a pa:ProtectiveDevice ;
    rdfs:label "nanoScan3 response distance SAnS" ;
    pa:minimumDistanceRule "SAnS = tR × Vmax" .

pa:ProtectiveDevice_nanoScan3_safety_laser_scanner_protective_field_placement a pa:ProtectiveDevice ;
    rdfs:label "nanoScan3 safety laser scanner, protective field placement" ;
    pa:minimumDistanceRule "must be designed to recognize a person, at the latest, when he or she reaches the minimum distance from the hazardous point" .

pa:ProtectiveDevice_nanoScan3_safety_laser_scanner_stationary_applications a pa:ProtectiveDevice ;
    rdfs:label "nanoScan3 safety laser scanner, stationary applications" ;
    pa:minimumDistanceRule "then it depends on the following points" .

pa:ProtectiveDevice_protective_field_length a pa:ProtectiveDevice ;
    rdfs:label "protective field length" ;
    pa:minimumDistanceRule "the minimum distance typically defines the pro- tective field length required" .

pa:ProtectiveDevice_protective_field_overrun_over_the_opening a pa:ProtectiveDevice ;
    rdfs:label "protective field overrun over the opening" ;
    pa:minimumDistanceRule "o ≥ (2 × TZ) – d" .

pa:ProtectiveDevice_safety_laser_scanner_protective_field a pa:ProtectiveDevice ;
    rdfs:label "safety laser scanner protective field" ;
    pa:minimumDistanceRule "A distance of the TZ value is recommended" .

pa:ProtectiveDevice_safety_laser_scanner_supplement_ZR_for_reflection_based_meas a pa:ProtectiveDevice ;
    rdfs:label "safety laser scanner supplement ZR for reflection-based measurement errors" ;
    pa:minimumDistanceParameter pa:Quantity_ZR_350_mm .

pa:ProtectiveDevice_supplement_CRO a pa:ProtectiveDevice ;
    rdfs:label "supplement CRO" ;
    pa:minimumDistanceParameter pa:Quantity_CRO_1200_mm .

pa:ProtectiveDevice_supplement_for_lack_of_ground_clearance a pa:ProtectiveDevice ;
    rdfs:label "supplement for lack of ground clearance" ;
    pa:minimumDistanceParameter pa:Quantity_150_mm .

pa:Provision_Autonomous_mobile_machinery a pa:Provision ;
    rdfs:label "Autonomous mobile machinery" ;
    pa:definedAs "has an autonomous mode" .

pa:Provision_CE_marking a pa:Provision ;
    rdfs:label "CE marking" ;
    pa:definedAs "a marking by which the manufacturer indicates" .

pa:Provision_EC_type_examination a pa:Provision ;
    rdfs:label "EC type-examination" ;
    pa:definedAs "the procedure whereby a notified body ascertains and certifies" .

pa:Provision_EU_type_examination a pa:Provision ;
    rdfs:label "EU type-examination" ;
    pa:definedAs "the part of a conformity assessment procedure in which a notified body examines the technical design" .

pa:Provision_Machinery_or_related_products_for_plant_protection_products_ a pa:Provision ;
    rdfs:label "Machinery or related products for plant protection products application" ;
    pa:definedAs "specifically intended for the application of plant protection products" .

pa:Provision_Machinery_presenting_hazards_due_to_its_mobility a pa:Provision ;
    rdfs:label "Machinery presenting hazards due to its mobility" ;
    pa:definedAs "Machinery presenting hazards due to its mobility" .

pa:Provision_OSSD a pa:Provision ;
    rdfs:label "OSSD" ;
    pa:definedAs "signal output for the protective device, which is used for stopping the dangerous movement." .

pa:Provision_PFH a pa:Provision ;
    rdfs:label "PFH" ;
    pa:definedAs "Average frequency of a dangerous failure per hour." .

pa:Provision_Recovery_Mode a pa:Provision ;
    rdfs:label "Recovery Mode" ;
    pa:definedAs "a type of Manual Mode" .

pa:Provision_Reduced_Active a pa:Provision ;
    rdfs:label "Reduced Active" ;
    pa:definedAs "“Reduced Active” means that all reduced limits are ACTIVE." .

pa:Provision_Registro_di_manutenzione_e_controllo a pa:Provision ;
    rdfs:label "Registro di manutenzione e controllo" ;
    pa:definedAs "è uno strumento che “accompagna l’attrezzatura” e permette di valutare in qualsiasi momento lo stato di conservazione e di usura della stessa" .

pa:Provision_Resolution a pa:Provision ;
    rdfs:label "Resolution" ;
    pa:definedAs "the minimum size of an object for it to be reliably detected" .

pa:Provision_Restart_interlock a pa:Provision ;
    rdfs:label "Restart interlock" ;
    pa:definedAs "prevents the machine from automatically starting up" .

pa:Provision_Safety_function a pa:Provision ;
    rdfs:label "Safety function" ;
