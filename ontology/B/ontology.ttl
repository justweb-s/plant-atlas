pa:listedIn a owl:ObjectProperty ;
    rdfs:comment "a category of machinery or safety component and the annex, part and point that lists it"@en ;
    rdfs:domain pa:MachineryCategory ;
    rdfs:range pa:Provision .

pa:MachineryCategory a owl:Class ;
    rdfs:comment "A category of machinery listed in an annex (e.g. Annex I, Part A)."@en .

pa:definedAs a owl:DatatypeProperty ;
    rdfs:comment "a defined term and its definition"@en ;
    rdfs:domain pa:Provision ;
    rdfs:range xsd:string .

pa:EconomicOperator a owl:Class ;
    rdfs:comment "Manufacturer, authorised representative, importer or distributor."@en .

pa:Risk a owl:Class ;
    rdfs:comment "A risk or hazard that a requirement addresses."@en .

pa:Provision a owl:Class ;
    rdfs:comment "An article, paragraph or annex point of an act."@en .

pa:addressesRisk a owl:ObjectProperty ;
    rdfs:comment "the risk a numbered essential requirement addresses"@en ;
    rdfs:domain pa:EssentialRequirement ;
    rdfs:range pa:Risk .

pa:hasObligation a owl:DatatypeProperty ;
    rdfs:comment "an obligation of a manufacturer, importer, distributor or employer"@en ;
    rdfs:domain pa:EconomicOperator ;
    rdfs:range xsd:string .

pa:ProtectiveMeasure a owl:Class ;
    rdfs:comment "A guard, protective device or other measure a requirement asks for."@en .

pa:EssentialRequirement a owl:Class ;
    rdfs:comment "An essential health and safety requirement of an annex."@en .

pa:requiresMeasure a owl:ObjectProperty ;
    rdfs:comment "the guard, protective device or measure a requirement asks for"@en ;
    rdfs:domain pa:EssentialRequirement ;
    rdfs:range pa:ProtectiveMeasure .

pa:Statement a owl:Class ;
    rdfs:comment "A fact with its quote, its condition, its source and its validity."@en .

