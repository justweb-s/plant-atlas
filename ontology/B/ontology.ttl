pa:st-0201 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer_or_distributor ;
    pa:condition "where that importer or distributor places a product within the scope of this Regulation on the market under its name or trademark or modifies a product already placed on the market in such a way that compliance with the applicable requirements might be affected" ;
    pa:locator "Art. 17" ;
    pa:quote "Article 17 Cases in which obligations of manufacturers apply to importers and distributors An importer or distributor shall be considered to be a manufacturer for the purposes of this Regulation, and shall be subject to the obligations of the manufacturer set out in Articles 10 and 11, where that importer or distributor places a product within the scope of this Regulation on the market under its name or trademark or modifies a product already placed on the market in such a way that compliance with the applicable requirements might be affected." ;
    pa:relation pa:becomesManufacturer ;
    pa:sourceDocument "REG" ;
    pa:value "where that importer or distributor places a product within the scope of this Regulation on the market under its name or trademark or modifies a product already placed on the market in such a way that compliance with the applicable requirements might be affected" .

pa:st-0202 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer_or_distributor ;
    pa:condition "where that importer or distributor places a product within the scope of this Regulation on the market under its name or trademark or modifies a product already placed on the market in such a way that compliance with the applicable requirements might be affected" ;
    pa:locator "Art. 17" ;
    pa:quote "Article 17 Cases in which obligations of manufacturers apply to importers and distributors An importer or distributor shall be considered to be a manufacturer for the purposes of this Regulation, and shall be subject to the obligations of the manufacturer set out in Articles 10 and 11, where that importer or distributor places a product within the scope of this Regulation on the market under its name or trademark or modifies a product already placed on the market in such a way that compliance with the applicable requirements might be affected." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "subject to the obligations of the manufacturer set out in Articles 10 and 11" .

pa:st-0203 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_natural_or_legal_person_carrying_out_substantial_modificatio ;
    pa:condition "if the substantial modification has an impact on the safety of only machinery or a related product that is part of an assembly of machinery" ;
    pa:locator "Art. 18" ;
    pa:quote "Article 18 Other cases in which obligations of manufacturers apply A natural or legal person that carries out a substantial modification of machinery or a related product shall be considered to be a manufacturer for the purposes of this Regulation and shall be subject to the obligations of the manufacturer set out in Article 10 for that machinery or related product or, if the substantial modification has an impact on the safety of only machinery or a related product that is part of an assembly of machinery, for that affected machinery or related product, as demonstrated in the risk assessment." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall be subject to the obligations of the manufacturer set out in Article 10" .

pa:st-0204 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_person_who_carries_out_substantial_modification ;
    pa:locator "Art. 18" ;
    pa:quote "The person who carries out the substantial modification shall in particular, but without prejudice to other obligations set out in Article 10, ensure and declare on its sole responsibility that the machinery or related product concerned is in conformity with the applicable requirements of this Regulation and shall apply the relevant conformity assessment procedure as provided in Article 25 (2), (3) and (4) of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "ensure and declare on its sole responsibility" .

pa:st-0205 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_or_related_product_substantially_modified ;
    pa:locator "Art. 18" ;
    pa:quote "The person who carries out the substantial modification shall in particular, but without prejudice to other obligations set out in Article 10, ensure and declare on its sole responsibility that the machinery or related product concerned is in conformity with the applicable requirements of this Regulation and shall apply the relevant conformity assessment procedure as provided in Article 25 (2), (3) and (4) of this Regulation." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_assessment_procedure_as_provided_in_Article_25_2_ .

pa:st-0206 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_non_professional_user_modifying_machinery_for_own_use ;
    pa:condition "for his or her own use" ;
    pa:locator "Art. 18" ;
    pa:quote "A non-professional user who carries out a substantial modification to his or her machinery or related product, for his or her own use, shall not be considered to be a manufacturer for the purposes of this Regulation and shall not be subject to the obligations on the manufacturer set out in Article 10." ;
    pa:relation pa:becomesManufacturer ;
    pa:sourceDocument "REG" ;
    pa:value "shall not be considered to be a manufacturer" .

pa:st-0207 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_non_professional_user_modifying_machinery_for_own_use ;
    pa:condition "for his or her own use" ;
    pa:locator "Art. 18" ;
    pa:quote "A non-professional user who carries out a substantial modification to his or her machinery or related product, for his or her own use, shall not be considered to be a manufacturer for the purposes of this Regulation and shall not be subject to the obligations on the manufacturer set out in Article 10." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall not be subject to the obligations on the manufacturer set out in Article 10" .

pa:st-0208 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_economic_operators ;
    pa:condition "on request" ;
    pa:locator "Art. 19(1)" ;
    pa:quote "Economic operators shall, on request, identify the following to the market surveillance authorities: (a) any economic operator who has supplied them with a product within the scope of this Regulation; (b) any economic operator to whom they have supplied a product within the scope of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall, on request, identify the following to the market surveillance authorities" .

pa:st-0209 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_economic_operators_information_referred_to_in_paragraph_1 ;
    pa:locator "Art. 19(2)" ;
    pa:quote "In order to be able to comply with the obligation in paragraph 1, economic operators shall retain the information referred to in that paragraph for at least 10 years after they supplied or were supplied with the products within the scope of this Regulation." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0222 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "By drawing up the EU declaration of conformity" ;
    pa:locator "Art. 21(4)" ;
    pa:quote "By drawing up the EU declaration of conformity, the manufacturer shall assume responsibility for the compliance of the machinery or related product with the requirements laid down in this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall assume responsibility for the compliance" .

pa:st-0225 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EU_declaration_of_incorporation ;
    pa:condition "Where partly completed machinery is subject to more than one Union legal act requiring an EU declaration of conformity" ;
    pa:locator "Art. 22(3)" ;
    pa:quote "Where partly completed machinery is subject to more than one Union legal act requiring an EU declaration of conformity, the EU declaration of incorporation shall include a sentence declaring the conformity with such acts." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall include a sentence declaring the conformity with such acts" .

pa:st-0226 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EU_declaration_of_incorporation ;
    pa:condition "Where partly completed machinery is subject to more than one Union legal act requiring an EU declaration of conformity" ;
    pa:locator "Art. 22(3)" ;
    pa:quote "Where partly completed machinery is subject to more than one Union legal act requiring an EU declaration of conformity, the EU declaration of incorporation shall include a sentence declaring the conformity with such acts. That declaration shall contain the identification of the Union legal acts concerned, including their publication references." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall contain the identification of the Union legal acts concerned" .

pa:st-0228 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "By drawing up the EU declaration of incorporation" ;
    pa:locator "Art. 22(4)" ;
    pa:quote "By drawing up the EU declaration of incorporation, the manufacturer shall assume responsibility for the compliance of the partly completed machinery with the requirements laid down in this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall assume responsibility for the compliance" .

pa:st-0232 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body_identification_number_affixing ;
    pa:condition "Where the conformity of machinery or a related product is assessed" ;
    pa:locator "Art. 24(3)" ;
    pa:quote "The identification number of that notified body shall be affixed by the body itself or, under its instructions, by the manufacturer or the manufacturer’s authorised representative." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall be affixed by the body itself or, under its instructions, by the manufacturer" .

pa:st-0236 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_the_natural_or_legal_person_referred_to_in_A ;
    pa:locator "Art. 25(1)" ;
    pa:quote "The manufacturer or the natural or legal person referred to in Article 18 shall apply one of the conformity assessment procedures referred to in paragraphs 2, 3 and 4." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall apply one of the conformity assessment procedures" .

pa:st-0237 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part A" ;
    pa:locator "Art. 25(2)" ;
    pa:quote "Where the category of machinery or related product is listed in Annex I, Part A, the manufacturer or the natural or legal person referred to in Article 18 shall apply one of the following procedures: (a) EU type-examination (module B) set out in Annex VII, followed by conformity to type based on internal production control (module C) set out in Annex VIII;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_EU_type_examination_module_B .

pa:st-0238 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product ;
    pa:condition "followed by EU type-examination (module B), under option (a)" ;
    pa:locator "Art. 25(2)" ;
    pa:quote "(a) EU type-examination (module B) set out in Annex VII, followed by conformity to type based on internal production control (module C) set out in Annex VIII;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_to_type_based_on_internal_production_control_modu .

pa:st-0239 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part A" ;
    pa:locator "Art. 25(2)" ;
    pa:quote "(b) conformity based on full quality assurance (module H) set out in Annex IX;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_based_on_full_quality_assurance_module_H .

pa:st-0240 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part A" ;
    pa:locator "Art. 25(2)" ;
    pa:quote "(c) conformity based on unit verification (module G) set out in Annex X." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_based_on_unit_verification_module_G .

pa:st-0241 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part A" ;
    pa:locator "Art. 25(2)" ;
    pa:quote "Where the category of machinery or related product is listed in Annex I, Part A, the manufacturer or the natural or legal person referred to in Article 18 shall apply one of the following procedures:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall apply one of the following procedures" .

pa:st-0242 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product ;
    pa:locator "Art. 25(2)" ;
    pa:quote "Where the category of machinery or related product is listed in Annex I, Part A, the manufacturer or the natural or legal person referred to in Article 18 shall apply one of the following procedures:" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_Annex_I_Part_A .

pa:st-0243 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_category_listed_in_Annex_I_Part_B ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part B" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "(a) internal production control (module A) set out in Annex VI;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_internal_production_control_module_A .

pa:st-0244 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_category_listed_in_Annex_I_Part_B ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part B" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "(b) EU type-examination (module B) set out in Annex VII, followed by conformity to type based on internal production control (module C) set out in Annex VIII;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_EU_type_examination_module_B .

pa:st-0245 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_category_listed_in_Annex_I_Part_B ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part B" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "(b) EU type-examination (module B) set out in Annex VII, followed by conformity to type based on internal production control (module C) set out in Annex VIII;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_to_type_based_on_internal_production_control_modu .

pa:st-0246 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_category_listed_in_Annex_I_Part_B ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part B" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "(c) conformity based on full quality assurance (module H) set out in Annex IX;" ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_based_on_full_quality_assurance_module_H .

pa:st-0247 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_category_listed_in_Annex_I_Part_B ;
    pa:condition "Where the category of machinery or related product is listed in Annex I, Part B" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "(d) conformity based on unit verification (module G) set out in Annex X." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_conformity_based_on_unit_verification_module_G .

pa:st-0248 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_or_related_product_category ;
    pa:locator "Art. 25(3)" ;
    pa:quote "Where the category of machinery or related product is listed in Annex I, Part B, the manufacturer or the natural or legal person referred to in Article 18 shall apply one of the following procedures:" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_listed_in_Annex_I_Part_B .

pa:st-0249 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_applying_internal_production_control ;
    pa:condition "if a manufacturer applies the internal production control procedure referred to in point (a)" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "If a manufacturer applies the internal production control procedure referred to in point (a), it shall design and construct the machinery or related product in accordance with the harmonised standards or common specifications specific to that category of machinery or related product covering all the relevant essential health and safety requirements." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "it shall design and construct the machinery or related product" .

pa:st-0250 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_category_not_designed_per_harmonised_standards ;
    pa:condition "the machinery or related product was not designed and constructed in accordance with the harmonised standards" ;
    pa:locator "Art. 25(3)" ;
    pa:quote "Where the category of machinery or related product is listed in Annex I, Part B, and the machinery or related product was not designed and constructed in accordance with the harmonised standards or common specifications specific to that category of machinery or related product covering all the relevant essential health and safety requirements for that category of machinery or related product, the manufacturer, including a natural or legal person referred to in Article 18, shall apply one of the procedures referred to in points (b), (c) or (d) of this paragraph." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_shall_apply_one_of_the_procedures_referred_to_in_points_b_c_ .

pa:st-0251 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product_not_listed_in_Annex ;
    pa:condition "Where the category of machinery or related product is not listed in Annex I" ;
    pa:locator "Art. 25(4)" ;
    pa:quote "Where the category of machinery or related product is not listed in Annex I, the manufacturer, including a natural or legal person referred to in Article 18, shall apply the internal production control procedure (module A) set out in Annex VI." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_internal_production_control_procedure_module_A .

pa:st-0252 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_including_a_natural_or_legal_person_referred_to ;
    pa:condition "Where the category of machinery or related product is not listed in Annex I" ;
    pa:locator "Art. 25(4)" ;
    pa:quote "Where the category of machinery or related product is not listed in Annex I, the manufacturer, including a natural or legal person referred to in Article 18, shall apply the internal production control procedure (module A) set out in Annex VI." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall apply the internal production control procedure" .

pa:st-0269 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body ;
    pa:condition "of machinery or related products that they assess; This shall not preclude the use of assessed machinery" ;
    pa:locator "Art. 30(4)" ;
    pa:quote "A conformity assessment body, its top-level management and the personnel responsible for carrying out the conformity assessment tasks shall not be the designer, manufacturer, supplier, importer, distributor, installer, purchaser, owner, user or maintainer of machinery or related products that they assess, nor shall it fulfil any of those roles in relation to partly completed machinery that has been incorporated into the assessed product or be the representative of any of those parties. This shall not preclude the use of assessed machinery or related products that are necessary for the operations of the conformity assessment body or the use of machinery or related products for personal purposes." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall not be the designer, manufacturer, supplier" .

pa:st-0270 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body ;
    pa:locator "Art. 30(4)" ;
    pa:quote "A conformity assessment body, its top-level management and the personnel responsible for carrying out the conformity assessment tasks shall not be directly involved in the design, import, distribution, manufacture, marketing, installation, use or maintenance of the machinery or related products, or represent the parties engaged in those activities." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall not be directly involved in the design" .

pa:st-0271 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body_its_top_level_management_and_pers ;
    pa:condition "in relation to conformity assessment activities for which they are notified" ;
    pa:locator "Art. 30(4)" ;
    pa:quote "They shall not engage in any activity that may conflict with their independence of judgement or integrity in relation to conformity assessment activities for which they are notified." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall not engage in any activity that may conflict with their independence of judgement" .

pa:st-0272 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body ;
    pa:locator "Art. 30(4)" ;
    pa:quote "A conformity assessment body shall ensure that the activities of its subsidiaries or subcontractors do not affect the confidentiality, objectivity or impartiality of its conformity assessment activities." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that the activities of its subsidiaries" .

pa:st-0276 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body ;
    pa:condition "unless liability is assumed by the Member State in accordance with national law, or the Member State itself is directly responsible for the conformity assessment" ;
    pa:locator "Art. 30(9)" ;
    pa:quote "A conformity assessment body shall take out liability insurance unless liability is assumed by the Member State in accordance with national law, or the Member State itself is directly responsible for the conformity assessment." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall take out liability insurance" .

pa:st-0277 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_personnel_of_a_conformity_assessment_body ;
    pa:condition "except in relation to the competent authorities of the Member State in which its tasks are carried out" ;
    pa:locator "Art. 30(10)" ;
    pa:quote "The personnel of a conformity assessment body shall observe professional secrecy with regard to all information obtained in carrying out the conformity assessment tasks in accordance with Annexes VII, IX and X, except in relation to the competent authorities of the Member State in which its tasks are carried out." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall observe professional secrecy" .

pa:st-0279 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body ;
    pa:locator "Art. 30(11)" ;
    pa:quote "A conformity assessment body shall participate in, or ensure that its personnel responsible for carrying out the conformity assessment tasks are informed of, the relevant standardisation activities and the activities of the notified body coordination group established under Article 42 and shall apply as general guidance the administrative decisions and documents produced as a result of the work of that group." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall participate in, or ensure that its personnel" .

pa:st-0280 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_conformity_assessment_body ;
    pa:locator "Art. 30(11)" ;
    pa:quote "A conformity assessment body shall participate in, or ensure that its personnel responsible for carrying out the conformity assessment tasks are informed of, the relevant standardisation activities and the activities of the notified body coordination group established under Article 42 and shall apply as general guidance the administrative decisions and documents produced as a result of the work of that group." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall apply as general guidance" .

pa:st-0294 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_notified_body ;
    pa:condition "for the purposes of this Regulation" ;
    pa:locator "Art. 34(5)" ;
    pa:quote "Only such a body shall be considered a notified body for the purposes of this Regulation." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "Only such a body shall be considered a notified body" .

pa:st-0307 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "Where a notified body finds that the essential health and safety requirements set out in Annex III, or corresponding harmonised standards or common specifications referred to in Article 20 have not been met by a manufacturer" ;
    pa:locator "Art. 38(3)" ;
    pa:quote "Where a notified body finds that the essential health and safety requirements set out in Annex III, or corresponding harmonised standards or common specifications referred to in Article 20 have not been met by a manufacturer, it shall require the manufacturer to take appropriate corrective actions and shall not issue an EU-type examination certificate, adopt a quality system approval decision or issue a unit verification certificate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "take appropriate corrective actions" .

pa:st-0309 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "where, in the course of the monitoring of conformity, a notified body finds that machinery or a related product no longer complies" ;
    pa:locator "Art. 38(4)" ;
    pa:quote "Where, in the course of the monitoring of conformity, following the adoption of an approval decision, in accordance with Annex IX, a notified body finds that machinery or a related product no longer complies, it shall require the manufacturer to take appropriate corrective actions and shall suspend or withdraw the approval decision, if necessary." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "take appropriate corrective actions" .

pa:st-0311 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body ;
    pa:locator "Art. 39" ;
    pa:quote "Article 39 Appeals against decisions of notified bodies A notified body shall ensure that a transparent and accessible appeals procedure against its decisions is available." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that a transparent and accessible appeals procedure" .

pa:st-0312 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body ;
    pa:locator "Art. 40(1)" ;
    pa:quote "A notified body shall inform the notifying authority of the following:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall inform the notifying authority" .

pa:st-0313 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body ;
    pa:locator "Art. 40(1)" ;
    pa:quote "(a) any refusal, restriction, suspension or withdrawal of an EU type-examination certificate, quality system approval decision or unit verification certificate;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "any refusal, restriction, suspension or withdrawal" .

pa:st-0314 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body ;
    pa:locator "Art. 40(1)" ;
    pa:quote "(b) any circumstances affecting the scope of, or the conditions for, its notification;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "any circumstances affecting the scope of" .

pa:st-0315 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body ;
    pa:locator "Art. 40(1)" ;
    pa:quote "(c) any request for information which it has received from market surveillance authorities regarding its conformity assessment activities;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "any request for information" .

pa:st-0316 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_notified_body ;
    pa:condition "on request" ;
    pa:locator "Art. 40(1)" ;
    pa:quote "(d) on request, any conformity assessment activities performed within the scope of its notification and any other activity performed, including cross-border activities and subcontracting." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "any conformity assessment activities" .

pa:st-0319 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_relevant_economic_operators ;
    pa:condition "for that purpose" ;
    pa:locator "Art. 43(1)" ;
    pa:quote "The relevant economic operators shall cooperate as necessary with the market surveillance authorities for that purpose." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall cooperate as necessary" .

pa:st-0320 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_relevant_economic_operator ;
    pa:condition "the market surveillance authorities find that the product within the scope of this Regulation does not comply with the requirements laid down in this Regulation" ;
    pa:locator "Art. 43(1)" ;
    pa:quote "Where, in the course of the evaluation referred to in the first subparagraph, the market surveillance authorities find that the product within the scope of this Regulation does not comply with the requirements laid down in this Regulation, they shall without delay require the relevant economic operator to take appropriate and proportionate corrective action, as provided for in Article 16(3) of Regulation (EU) 2019/1020, to bring the non-compliance to an end or to eliminate hazards or, if that is not possible, minimise the risk specified by the market surveillance authorities within a reasonable period which is commensurate with the nature of the risk referred to in the first subparagraph." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "take appropriate and proportionate corrective action" .

pa:st-0323 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_economic_operator_products_it_made_available_on_the_market ;
    pa:locator "Art. 43(3)" ;
    pa:quote "The economic operator shall ensure that all appropriate corrective action is taken in respect of the products within the scope of this Regulation concerned that the economic operator has made available on the market, throughout the Union." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that all appropriate corrective action is taken" .

pa:st-0332 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_relevant_economic_operator ;
    pa:condition "Where, having carried out an evaluation under Article 43(1), a Member State finds" ;
    pa:locator "Art. 45(1)" ;
    pa:quote "Where, having carried out an evaluation under Article 43(1), a Member State finds that although a product within the scope of this Regulation is in compliance with the essential health and safety requirements set out in Annex III, it presents a risk to the health and safety of persons and, where appropriate, domestic animals or to property, and, where applicable, to the environment, it shall require the relevant economic operator to take all appropriate measures to ensure that the product concerned, when placed on the market, no longer presents that risk, to withdraw that product or to recall it within a reasonable period, commensurate with the nature of the risk." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "take all appropriate measures" .

pa:st-0333 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
