    pa:about pa:MachineryCategory_Power_operated_interlocking_movable_guards ;
    pa:condition "designed to be used as safeguards in machinery referred to in points 9, 10 and 11 of this Part" ;
    pa:layer "law" ;
    pa:locator "Annex I, Part B, point 16" ;
    pa:quote "16. Power-operated interlocking movable guards designed to be used as safeguards in machinery referred to in points 9, 10 and 11 of this Part." ;
    pa:relation pa:listedIn ;
