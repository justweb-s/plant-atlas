@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pa: <https://github.com/justweb-s/plant-atlas/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/justweb-s/plant-atlas/ontology> a owl:Ontology ;
    owl:versionInfo "facts in force on 2026-11-14" .

pa:Employer a owl:Class ;
    rdfs:comment "The employer who makes work equipment available to workers."@en .

pa:NotifiedBody a owl:Class ;
    rdfs:comment "A conformity assessment body notified to carry out a procedure."@en .

pa:SafetyComponent a owl:Class ;
    rdfs:comment "A component that fulfils a safety function and is placed on the market separately."@en .

pa:st-0002 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_products_within_the_scope_of_this_Regulation ;
    pa:locator "Art. 2(1)" ;
    pa:quote "For the purposes of this Regulation, machinery, the related products listed in the first subparagraph and partly completed machinery shall together be referred to as ‘products within the scope of this Regulation’." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "machinery, the related products listed in the first subparagraph" .

pa:st-0005 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_machinery ;
    pa:locator "Art. 3(1)" ;
    pa:quote "(1) ‘machinery’ means: (a) an assembly, fitted with or intended to be fitted with a drive system other than directly applied human or animal effort, consisting of linked parts or components, at least one of which moves, and which are joined together for a specific application; (b) an assembly referred to in point (a), missing only the components to connect it on site or to sources of energy and motion;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "means:" .

pa:st-0006 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_interchangeable_equipment ;
    pa:condition "provided that the device is not a tool" ;
    pa:locator "Art. 3(2)" ;
    pa:quote "(2) ‘interchangeable equipment’ means a device which, after the putting into service of machinery or an agricultural or forestry tractor, is assembled with that machinery or agricultural or forestry tractor by the operator in order to change its function or to attribute a new function to it, provided that the device is not a tool;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "means a device which" .

pa:st-0007 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_safety_component ;
    pa:condition "but which is not necessary in order for that product to function or for which normal components may be substituted in order for that product to function" ;
    pa:locator "Art. 3(3)" ;
    pa:quote "(3) ‘safety component’ means a physical or digital component, including software, of a product within the scope of this Regulation, which is designed or intended to fulfil a safety function and which is independently placed on the market, the failure or malfunction of which endanger the safety of persons, but which is not necessary in order for that product to function or for which normal components may be substituted in order for that product to function;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "‘safety component’ means a physical or digital component" .

pa:st-0008 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_lifting_accessory ;
    pa:locator "Art. 3(5)" ;
    pa:quote "(5) ‘lifting accessory’ means a component or equipment, not attached to the lifting machinery, which enables the load to be held, which is placed between the machinery and the load or on the load itself, or which is intended to constitute an integral part of the load and which is independently placed on the market, including slings and their components;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a component or equipment, not attached to the lifting machinery" .

pa:st-0009 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_chains ;
    pa:condition "as part of lifting machinery or lifting accessories" ;
    pa:locator "Art. 3(6)" ;
    pa:quote "(6) ‘chains’ means chains designed and constructed for lifting purposes as part of lifting machinery or lifting accessories;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "chains designed and constructed for lifting purposes" .

pa:st-0010 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_ropes ;
    pa:locator "Art. 3(7)" ;
    pa:quote "(7) ‘ropes’ means ropes designed and constructed for lifting purposes as part of lifting machinery or lifting accessories;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "designed and constructed for lifting purposes" .

pa:st-0011 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_webbing ;
    pa:locator "Art. 3(8)" ;
    pa:quote "(8) ‘webbing’ means webbing designed and constructed for lifting purposes as part of lifting machinery or lifting accessories;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "webbing designed and constructed for lifting purposes" .

pa:st-0012 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_removable_mechanical_transmission_device ;
    pa:locator "Art. 3(9)" ;
    pa:quote "(9) ‘removable mechanical transmission device’ means a removable component for transmitting power between self-propelled machinery or a tractor and other machinery or related products by joining them at the first fixed bearing;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "removable component for transmitting power" .

pa:st-0014 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_partly_completed_machinery ;
    pa:locator "Art. 3(10)" ;
    pa:quote "(10) ‘partly completed machinery’ means an assembly which is not yet machinery as it cannot in itself perform a specific application and which is only intended to be incorporated into or assembled with machinery or other partly completed machinery or equipment, thereby forming machinery;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "an assembly which is not yet machinery" .

pa:st-0015 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_making_available_on_the_market ;
    pa:condition "within the scope of this Regulation; in the course of a commercial activity, whether in return for payment or free of charge" ;
    pa:locator "Art. 3(11)" ;
    pa:quote "(11) ‘making available on the market’ means any supply of a product within the scope of this Regulation for distribution or use on the Union market in the course of a commercial activity, whether in return for payment or free of charge;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "means any supply of a product" .

pa:st-0016 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_placing_on_the_market ;
    pa:locator "Art. 3(12)" ;
    pa:quote "(12) ‘placing on the market’ means the first making available of a product within the scope of this Regulation on the Union market;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the first making available of a product" .

pa:st-0017 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_putting_into_service ;
    pa:locator "Art. 3(13)" ;
    pa:quote "(13) ‘putting into service’ means the first use, for its intended purpose, in the Union, of machinery or related products;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the first use, for its intended purpose, in the Union" .

pa:st-0018 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_essential_health_and_safety_requirements ;
    pa:locator "Art. 3(14)" ;
    pa:quote "(14) ‘essential health and safety requirements’ means the mandatory provisions, set out in Annex III, relating to the design and construction of products within the scope of this Regulation to ensure a high level of protection of the health and safety of persons, and, where appropriate, domestic animals and property, and, where applicable, of the environment;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the mandatory provisions, set out in Annex III" .

pa:st-0019 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_substantial_modification ;
    pa:condition "which is not foreseen or planned by the manufacturer" ;
    pa:locator "Art. 3(16)" ;
    pa:quote "(16) ‘substantial modification’ means a modification of machinery or a related product, by physical or digital means after that machinery or related product has been placed on the market or put into service, which is not foreseen or planned by the manufacturer, and which affects the safety of that machinery or related product, by creating a new hazard, or by increasing an existing risk, which requires:" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a modification of machinery or a related product" .

pa:st-0021 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_instructions_for_use ;
    pa:condition "\"\"" ;
    pa:locator "Art. 3(17)" ;
    pa:quote "(17) ‘instructions for use’ means the information, provided by the manufacturer when the machinery or related product is placed on the market or put into service, to inform the user of the machinery or related product, of the intended and proper use of that machinery or related product, as well as information on any precautions to be taken when using or installing the machinery or related product, including information on the safety aspects, and on how to keep that machinery or related product safe, and to ensure that it remains fit for purpose during its entire lifetime;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the information, provided by the manufacturer" .

pa:st-0022 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_manufacturer ;
    pa:locator "Art. 3(18)" ;
    pa:quote "(18) ‘manufacturer’ means any natural or legal person who:" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any natural or legal person who" .

pa:st-0023 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "manufactures products within the scope of this Regulation or who has those products designed or manufactured" ;
    pa:locator "Art. 3(18)" ;
    pa:quote "(a) manufactures products within the scope of this Regulation or who has those products designed or manufactured, and markets those products under its name or trademark;" ;
    pa:relation pa:becomesManufacturer ;
    pa:sourceDocument "REG" ;
    pa:value "markets those products under its name or trademark" .

pa:st-0024 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "manufactures products within the scope of this Regulation" ;
    pa:locator "Art. 3(18)" ;
    pa:quote "or (b) manufactures products within the scope of this Regulation, and puts those products into service for its own use;" ;
    pa:relation pa:becomesManufacturer ;
    pa:sourceDocument "REG" ;
    pa:value "puts those products into service for its own use" .

pa:st-0025 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_authorised_representative ;
    pa:locator "Art. 3(19)" ;
    pa:quote "(19) ‘authorised representative’ means any natural or legal person established within the Union who has received a written mandate from a manufacturer to act on its behalf in relation to specified tasks;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any natural or legal person established within the Union" .

pa:st-0026 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_importer ;
    pa:locator "Art. 3(20)" ;
    pa:quote "(20) ‘importer’ means any natural or legal person established within the Union who places a product within the scope of this Regulation from a third country on the Union market;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any natural or legal person established within the Union" .

pa:st-0027 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_distributor ;
    pa:condition "other than the manufacturer or the importer" ;
    pa:locator "Art. 3(21)" ;
    pa:quote "(21) ‘distributor’ means any natural or legal person in the supply chain, other than the manufacturer or the importer, who makes a product within the scope of this Regulation available on the market;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any natural or legal person in the supply chain" .

pa:st-0028 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_economic_operator ;
    pa:locator "Art. 3(22)" ;
    pa:quote "(22) ‘economic operator’ means the manufacturer, the authorised representative, the importer or the distributor;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "means the manufacturer, the authorised representative" .

pa:st-0029 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_technical_specifications ;
    pa:locator "Art. 3(23)" ;
    pa:quote "(23) ‘technical specifications’ means a document that prescribes technical requirements to be fulfilled by products within the scope of this Regulation;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a document that prescribes technical requirements" .

pa:st-0030 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_harmonised_standard ;
    pa:locator "Art. 3(24)" ;
    pa:quote "(24) ‘harmonised standard’ means a harmonised standard as defined in Article 2, point 1, point (c), of Regulation (EU) No 1025/2012;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "means a harmonised standard as defined in Article 2" .

pa:st-0031 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_CE_marking ;
    pa:locator "Art. 3(25)" ;
    pa:quote "(25) ‘CE marking’ means a marking by which the manufacturer indicates that machinery or a related product is in conformity with the applicable requirements set out in Union harmonisation legislation providing for its affixing;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a marking by which the manufacturer indicates" .

pa:st-0032 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_accreditation ;
    pa:locator "Art. 3(26)" ;
    pa:quote "(26) ‘accreditation’ means accreditation as defined in Article 2, point (10), of Regulation (EC) No 765/2008;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "Article 2, point (10), of Regulation (EC) No 765/2008" .

pa:st-0033 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_national_accreditation_body ;
    pa:locator "Art. 3(27)" ;
    pa:quote "(27) ‘national accreditation body’ means a national accreditation body as defined in Article 2, point (11), of Regulation (EC) No 765/2008;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a national accreditation body as defined in Article 2, point (11)" .

pa:st-0034 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_conformity_assessment ;
    pa:locator "Art. 3(28)" ;
    pa:quote "(28) ‘conformity assessment’ means the process for demonstrating whether the applicable essential health and safety requirements in this Regulation relating to machinery or related products have been fulfilled;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "means the process for demonstrating" .

pa:st-0035 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_conformity_assessment_body ;
    pa:locator "Art. 3(29)" ;
    pa:quote "(29) ‘conformity assessment body’ means a body that performs conformity assessment activities, including calibration, testing, certification and inspection;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a body that performs conformity assessment activities" .

pa:st-0036 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_notified_body ;
    pa:locator "Art. 3(30)" ;
    pa:quote "(30) ‘notified body’ means a conformity assessment body notified in accordance with this Regulation;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "conformity assessment body notified in accordance with this Regulation" .

pa:st-0037 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_market_surveillance_authority ;
    pa:locator "Art. 3(31)" ;
    pa:quote "(31) ‘market surveillance authority’ means a ‘market surveillance authority’ as defined in Article 3, point (4), of Regulation (EU) 2019/1020;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "as defined in Article 3, point (4)" .

pa:st-0038 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_recall ;
    pa:condition "within the scope of this Regulation that has already been made available to a user" ;
    pa:locator "Art. 3(32)" ;
    pa:quote "(32) ‘recall’ means any measure aimed at achieving the return of a product within the scope of this Regulation that has already been made available to a user;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any measure aimed at achieving the return of a product" .

pa:st-0039 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_withdrawal ;
    pa:condition "a product within the scope of this Regulation that is in the supply chain" ;
    pa:locator "Art. 3(33)" ;
    pa:quote "(33) ‘withdrawal’ means, for a product, any measure aimed at preventing a product within the scope of this Regulation that is in the supply chain from being made available on the market;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any measure aimed at preventing a product" .

pa:st-0040 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_lifetime ;
    pa:locator "Art. 3(34)" ;
    pa:quote "(34) ‘lifetime’ means the period from the moment that machinery or a related product is placed on the market or put into service until the moment that it is discarded, including the effective time when the machinery or related product is capable of being used and the phases of transport, assembly, dismantling, disabling, scrapping or other physical or digital modifications foreseen by the manufacturer;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the period from the moment that machinery" .

pa:st-0041 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_source_code ;
    pa:condition "software of a product within the scope of this Regulation" ;
    pa:locator "Art. 3(35)" ;
    pa:quote "(35) ‘source code’ means the currently installed version of the software of a product within the scope of this Regulation, written in a programming language so that it is unambiguous and understandable to humans;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the currently installed version of the software" .

pa:st-0042 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_professional_user ;
    pa:condition "in the course of his or her professional activity or work" ;
    pa:locator "Art. 3(36)" ;
    pa:quote "(36) ‘professional user’ means a natural person who uses or operates machinery or a related product in the course of his or her professional activity or work." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a natural person who uses or operates machinery" .

pa:st-0046 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_and_related_products_in_categories_listed_in_Annex ;
    pa:locator "Art. 6(1)" ;
    pa:quote "Machinery and related products that fall within the categories listed in Annex I, Part A, shall be subject to the specific conformity assessment procedures referred to in Article 25(2), and machinery and related products that fall within the categories listed in Annex I, Part B shall be subject to the specific conformity assessment procedures referred to in Article 25(3)." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_specific_conformity_assessment_procedures_referred_to_in_Art .

pa:st-0047 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_and_related_products_in_categories_listed_in_Annex ;
    pa:locator "Art. 6(1)" ;
    pa:quote "Machinery and related products that fall within the categories listed in Annex I, Part A, shall be subject to the specific conformity assessment procedures referred to in Article 25(2), and machinery and related products that fall within the categories listed in Annex I, Part B shall be subject to the specific conformity assessment procedures referred to in Article 25(3)." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ConformityProcedure_specific_conformity_assessment_procedures_referred_to_in_Art .

pa:st-0050 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_categories_of_machinery_and_related_products ;
    pa:locator "Art. 6(4)" ;
    pa:quote "Article 6 Categories of machinery and related products listed in Annex I subject to relevant conformity assessment procedures." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_listed_in_Annex_I .

pa:st-0054 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product ;
    pa:condition "if, according to the assessment referred to in paragraph 4, and taking into account the available information, it presents a serious inherent potential risk, and one or more of the following conditions is fulfilled" ;
    pa:locator "Art. 6(7)" ;
    pa:quote "A category of machinery or related product shall be included in Annex I, Part A, if, according to the assessment referred to in paragraph 4, and taking into account the available information, including the data referred to in paragraph 5, it presents a serious inherent potential risk, and one or more of the following conditions is fulfilled:" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_Annex_I_Part_A .

pa:st-0055 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_category_of_machinery_or_related_product_not_fulfilling_poin ;
    pa:condition "does not fulfil one or more of the conditions in points (a) to (d)" ;
    pa:locator "Art. 6(7)" ;
    pa:quote "Any other category of machinery or related product that, according to that assessment, presents a serious inherent potential risk but does not fulfil one or more of the conditions in points (a) to (d) shall be included in Annex I, Part B." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_Annex_I_Part_B .

pa:st-0060 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_safety_components ;
    pa:locator "Art. 7(1)" ;
    pa:quote "An indicative list of safety components is set out in Annex II." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_Annex_II .

pa:st-0061 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_indicative_list_of_safety_components ;
    pa:condition "in the light of technical progress and knowledge or new scientific evidence" ;
    pa:locator "Art. 7(2)" ;
    pa:quote "The Commission is empowered to adopt delegated acts in accordance with Article 47 to amend Annex II in the light of technical progress and knowledge or new scientific evidence by including a new safety component in the indicative list of safety components or withdrawing an existing safety component from that list." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_Annex_II .

pa:st-0066 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "When placing machinery or a related product on the market or putting it into service" ;
    pa:locator "Art. 10(1)" ;
    pa:quote "When placing machinery or a related product on the market or putting it into service, manufacturers shall ensure that it has been designed and constructed in accordance with the essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that it has been designed and constructed" .

pa:st-0067 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "Before placing machinery or a related product on the market or putting it into service" ;
    pa:locator "Art. 10(2)" ;
    pa:quote "Before placing machinery or a related product on the market or putting it into service, manufacturers shall draw up the technical documentation set out in Annex IV, Part A and carry out the relevant conformity assessment procedure referred to in Article 25 or have it carried out." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "draw up the technical documentation set out in Annex IV, Part A" .

pa:st-0068 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "Before placing machinery or a related product on the market or putting it into service" ;
    pa:locator "Art. 10(2)" ;
    pa:quote "Before placing machinery or a related product on the market or putting it into service, manufacturers shall draw up the technical documentation set out in Annex IV, Part A and carry out the relevant conformity assessment procedure referred to in Article 25 or have it carried out." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "carry out the relevant conformity assessment procedure referred to in Article 25 or have it carried out" .

pa:st-0069 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "Where compliance of machinery or a related product with the essential health and safety requirements laid down in Annex III has been demonstrated by that conformity assessment procedure" ;
    pa:locator "Art. 10(2)" ;
    pa:quote "Where compliance of machinery or a related product with the essential health and safety requirements laid down in Annex III has been demonstrated by that conformity assessment procedure, manufacturers shall draw up the EU declaration of conformity in accordance with Article 21 and affix the CE marking in accordance with Article 24." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "draw up the EU declaration of conformity in accordance with Article 21" .

pa:st-0070 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "Where compliance of machinery or a related product with the essential health and safety requirements laid down in Annex III has been demonstrated by that conformity assessment procedure" ;
    pa:locator "Art. 10(2)" ;
    pa:quote "Where compliance of machinery or a related product with the essential health and safety requirements laid down in Annex III has been demonstrated by that conformity assessment procedure, manufacturers shall draw up the EU declaration of conformity in accordance with Article 21 and affix the CE marking in accordance with Article 24." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "affix the CE marking in accordance with Article 24" .

pa:st-0071 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_technical_documentation_and_EU_declaration_of_conformity ;
    pa:condition "after the machinery or the related product has been placed on the market or put into service" ;
    pa:locator "Art. 10(3)" ;
    pa:quote "Manufacturers shall keep the technical documentation and the EU declaration of conformity at the disposal of the market surveillance authorities for at least 10 years after the machinery or the related product has been placed on the market or put into service." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0072 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_source_code_or_programming_logic_in_technical_ ;
    pa:condition "Where relevant, upon a reasoned request, if that source code or programming logic is necessary in order for them to be able to check compliance with the essential health and safety requirements set out in Annex III" ;
    pa:locator "Art. 10(3)" ;
    pa:quote "Where relevant, the source code or the programming logic included in the technical documentation shall, upon a reasoned request, be made available to the competent national authorities, if that source code or programming logic is necessary in order for them to be able to check compliance with the essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "be made available to the competent national authorities" .

pa:st-0073 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:locator "Art. 10(4)" ;
    pa:quote "Manufacturers shall ensure that procedures are in place in order that machinery or related products that are part of a series production remain in conformity with this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that procedures are in place" .

pa:st-0074 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:locator "Art. 10(4)" ;
    pa:quote "Adequate account shall be taken of changes in the production process or in the design or characteristics of the machinery or related product, and changes in the harmonised standards, in other technical specifications, or in the common specifications referred to in Article 20 by reference to which the conformity of the machinery or related product is declared." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "Adequate account shall be taken of changes" .

pa:st-0075 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "When deemed appropriate with regard to the risks presented by machinery or related products" ;
    pa:locator "Art. 10(4)" ;
    pa:quote "When deemed appropriate with regard to the risks presented by machinery or related products, manufacturers shall, in order to protect the health and safety of users, carry out sample testing of machinery or related products made available on the market and investigate their results." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "carry out sample testing" .

pa:st-0076 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "If necessary" ;
    pa:locator "Art. 10(4)" ;
    pa:quote "If necessary, manufacturers shall keep a register of complaints, of non-conforming machinery or related products and machinery or related product recalls, and shall keep distributors informed of any such monitoring." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "keep a register of complaints" .

pa:st-0077 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "If necessary" ;
    pa:locator "Art. 10(4)" ;
    pa:quote "If necessary, manufacturers shall keep a register of complaints, of non-conforming machinery or related products and machinery or related product recalls, and shall keep distributors informed of any such monitoring." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "keep distributors informed" .

pa:st-0078 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "\"\"" ;
    pa:locator "Art. 10(5)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related product which they place on the market or put into service bears at least a designation of the machinery or related product model, series or type, the year of construction, namely the year in which the manufacturing process was completed, and any batch or serial number or other element allowing its identification that exists, or, where the size or nature of the machinery or related product does not allow this, that the required information is provided on the packaging or in a document accompanying the machinery or related product." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "bears at least a designation" .

pa:st-0079 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_year_of_construction ;
    pa:condition "\"\"" ;
    pa:locator "Art. 10(5)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related product which they place on the market or put into service bears at least a designation of the machinery or related product model, series or type, the year of construction, namely the year in which the manufacturing process was completed, and any batch or serial number or other element allowing its identification that exists, or, where the size or nature of the machinery or related product does not allow this, that the required information is provided on the packaging or in a document accompanying the machinery or related product." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the year in which the manufacturing process was completed" .

pa:st-0080 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_product ;
    pa:condition "where the size or nature of the machinery or related product does not allow this" ;
    pa:locator "Art. 10(5)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related product which they place on the market or put into service bears at least a designation of the machinery or related product model, series or type, the year of construction, namely the year in which the manufacturing process was completed, and any batch or serial number or other element allowing its identification that exists, or, where the size or nature of the machinery or related product does not allow this, that the required information is provided on the packaging or in a document accompanying the machinery or related product." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_a_document_accompanying_the_machinery .

pa:st-0081 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "where that is not possible, on its packaging or in a document accompanying the machinery or related product" ;
    pa:locator "Art. 10(6)" ;
    pa:quote "Manufacturers shall indicate their name, registered trade name or registered trade mark, and the postal address and website, e-mail address or other digital contact at which they can be contacted, on the machinery or related product or, where that is not possible, on its packaging or in a document accompanying the machinery or related product." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall indicate their name" .

pa:st-0082 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_contact_address ;
    pa:locator "Art. 10(6)" ;
    pa:quote "The address shall indicate a single point at which the manufacturer can be contacted." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "The address shall indicate a single point" .

pa:st-0083 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_contact_details ;
    pa:locator "Art. 10(6)" ;
    pa:quote "The contact details shall be in a language easily understood by users and market surveillance authorities." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall be in a language easily understood" .

pa:st-0084 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_products ;
    pa:locator "Art. 10(7)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related products are accompanied by the instructions for use and the information set out in Annex III." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_the_instructions_for_use_and_the_information_set_out_in_Anne .

pa:st-0085 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Art. 10(7)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related products are accompanied by the instructions for use and the information set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "ensure that the machinery or related products are accompanied by" .

pa:st-0086 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_digital_instructions ;
    pa:locator "Art. 10(7)" ;
    pa:quote "Such instructions and information shall clearly describe the product model to which they correspond." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "clearly describe the product model" .

pa:st-0087 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_digital_instructions ;
    pa:condition "where that is not possible, on its packaging or in an accompanying document" ;
    pa:locator "Art. 10(7)" ;
    pa:quote "(a) mark on the machinery or related product, or, where that is not possible, on its packaging or in an accompanying document, how to access the digital instructions;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "mark on the machinery or related product" .

pa:st-0088 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_digital_instructions ;
    pa:locator "Art. 10(7)" ;
    pa:quote "(b) present them in a format that makes it possible for the user to print and download the instructions for use and save them on an electronic device so that he or she can access them at all times, in particular during a breakdown of the machinery or related product;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "present them in a format that makes it possible for the user to print and download the instructions for use" .

pa:st-0089 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_digital_instructions_manufacturer ;
    pa:condition "after the placing on the market of the machinery or related product" ;
    pa:locator "Art. 10(7)" ;
    pa:quote "(c) make them accessible online during the expected lifetime of the machinery or related product and for at least 10 years after the placing on the market of the machinery or related product." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "make them accessible online during the expected lifetime" .

pa:st-0090 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_paper_instructions ;
    pa:condition "at the request of the user at the time of the purchase" ;
    pa:locator "Art. 10(7)" ;
    pa:quote "However, at the request of the user at the time of the purchase, the manufacturer shall provide the instructions for use in paper format free of charge within one month." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide the instructions for use in paper format free of charge" .

pa:st-0091 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_non_professional_users ;
    pa:condition "in the case of machinery intended for non-professional users or that can be used by non-professional users" ;
    pa:locator "Art. 10(7)" ;
    pa:quote "In the case of machinery or a related product intended for non-professional users or that can, under reasonably foreseeable conditions, be used by non-professional users, even if not intended for them, the manufacturer shall provide, in paper format, the safety information that is essential for putting the machinery or related product into service and for using it in a safe way." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide, in paper format, the safety information that is essential for putting the machinery or related product into service" .

pa:st-0092 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_instructions_safety_information_and_Annex_III_information ;
    pa:condition "as determined by the Member State concerned" ;
    pa:locator "Art. 10(7)" ;
    pa:quote "The instructions for use, the safety information and the information set out in Annex III shall be in a language which can be easily understood by users, as determined by the Member State concerned, and shall be clear, understandable and legible." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "be in a language which can be easily understood by users" .

pa:st-0093 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_product ;
    pa:condition "or alternatively, internet address or machine-readable code where that EU declaration of conformity can be accessed in the instructions for use" ;
    pa:locator "Art. 10(8)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related product is accompanied by the EU declaration of conformity set out in Annex V, Part A or, alternatively, manufacturers shall provide the internet address or machine-readable code where that EU declaration of conformity can be accessed in the instructions for use and the information set out in Annex III." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_EU_declaration_of_conformity_set_out_in_Annex_V_Part_A .

pa:st-0094 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:locator "Art. 10(8)" ;
    pa:quote "Manufacturers shall ensure that the machinery or related product is accompanied by the EU declaration of conformity set out in Annex V, Part A or, alternatively, manufacturers shall provide the internet address or machine-readable code where that EU declaration of conformity can be accessed in the instructions for use and the information set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "Manufacturers shall ensure" .

pa:st-0095 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_digital_EU_declarations_of_conformity ;
    pa:condition "in any event" ;
    pa:locator "Art. 10(8)" ;
    pa:quote "Digital EU declarations of conformity shall be made accessible online for the expected lifetime of the machinery or related product and in any event for at least 10 years after the placing on the market or the putting into service of the machinery or related product." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0096 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_digital_EU_declarations_of_conformity ;
    pa:locator "Art. 10(8)" ;
    pa:quote "Digital EU declarations of conformity shall be made accessible online for the expected lifetime of the machinery or related product and in any event for at least 10 years after the placing on the market or the putting into service of the machinery or related product." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "for the expected lifetime of the machinery or related product" .

pa:st-0097 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "where manufacturers consider or have reason to believe that machinery or a related product is not in conformity with this Regulation" ;
    pa:locator "Art. 10(9)" ;
    pa:quote "Manufacturers who consider or have reason to believe that machinery or a related product, which they have placed on the market or put into service is not in conformity with this Regulation shall immediately take the corrective actions necessary to bring that machinery or related product into conformity, to withdraw it or to recall it, as appropriate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "immediately take the corrective actions necessary" .

pa:st-0098 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "where the machinery or related product presents a risk to the health or safety of persons" ;
    pa:locator "Art. 10(9)" ;
    pa:quote "Furthermore, where the machinery or related product presents a risk to the health or safety of persons, and, where appropriate, domestic animals or to property, and, where applicable, to the environment, manufacturers shall immediately inform the competent national authorities of the Member States in which they made the machinery or related product available on the market, or in which they put it into service, to that effect, giving details, in particular, of the non-conformity and of any corrective actions taken." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "immediately inform the competent national authorities" .

pa:st-0099 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "further to a reasoned request from a competent national authority" ;
    pa:locator "Art. 10(10)" ;
    pa:quote "Manufacturers shall, further to a reasoned request from a competent national authority, provide that authority with all the information and documentation, in paper or digital format, necessary to demonstrate the conformity of the machinery or related products with this Regulation, in a language which can be easily understood by that authority." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide that authority with all the information and documentation" .

pa:st-0100 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "at its request, on any actions taken to eliminate the risks presented by the machinery or related products" ;
    pa:locator "Art. 10(10)" ;
    pa:quote "They shall cooperate with that authority, at its request, on any actions taken to eliminate the risks presented by the machinery or related products, which they have placed on the market or put into service." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "cooperate with that authority" .

pa:st-0101 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "When placing partly completed machinery on the market" ;
    pa:locator "Art. 11(1)" ;
    pa:quote "When placing partly completed machinery on the market, manufacturers shall ensure that it has been designed and constructed in accordance with the relevant essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that it has been designed and constructed" .

pa:st-0102 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "Before placing partly completed machinery on the market" ;
    pa:locator "Art. 11(2)" ;
    pa:quote "Before placing partly completed machinery on the market, manufacturers shall draw up the technical documentation set out in Annex IV, Part B." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall draw up the technical documentation set out in Annex IV, Part B" .

pa:st-0103 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "Where compliance of partly completed machinery with the relevant essential health and safety requirements set out in Annex III has been demonstrated in the technical documentation set out in Annex IV, Part B" ;
    pa:locator "Art. 11(2)" ;
    pa:quote "Where compliance of partly completed machinery with the relevant essential health and safety requirements set out in Annex III has been demonstrated in the technical documentation set out in Annex IV, Part B, manufacturers shall draw up the EU declaration of incorporation in accordance with Article 22." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall draw up the EU declaration of incorporation in accordance with Article 22" .

pa:st-0104 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_technical_documentation_and_EU_declaration_of_incorporation ;
    pa:condition "after the partly completed machinery has been placed on the market" ;
    pa:locator "Art. 11(3)" ;
    pa:quote "Manufacturers shall keep the technical documentation and the EU declaration of incorporation at the disposal of the market surveillance authorities for at least 10 years after the partly completed machinery has been placed on the market." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0105 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:locator "Art. 11(3)" ;
    pa:quote "Manufacturers shall keep the technical documentation and the EU declaration of incorporation at the disposal of the market surveillance authorities for at least 10 years after the partly completed machinery has been placed on the market." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall keep the technical documentation" .

pa:st-0106 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "Where relevant; upon a reasoned request; if that source code or programming logic is necessary in order for them to be able to check compliance" ;
    pa:locator "Art. 11(3)" ;
    pa:quote "Where relevant, the source code or the programming logic included in the technical documentation shall, upon a reasoned request, be made available to the competent national authorities, if that source code or programming logic is necessary in order for them to be able to check compliance with the relevant essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "be made available to the competent national authorities" .

pa:st-0107 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "for partly completed machinery that is part of a series production" ;
    pa:locator "Art. 11(4)" ;
    pa:quote "Manufacturers shall ensure that procedures are in place for partly completed machinery that is part of a series production to remain in conformity with this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "Manufacturers shall ensure that procedures are in place" .

pa:st-0108 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "changes in the harmonised standards or other technical specifications, by reference to which the conformity is declared or verified" ;
    pa:locator "Art. 11(4)" ;
    pa:quote "Adequate account shall be taken of changes in the production process, or in the design or characteristics of the partly completed machinery, and changes in the harmonised standards or other technical specifications, or in the common specifications referred to in Article 20, by reference to which the conformity of the partly completed machinery is declared or verified." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "Adequate account shall be taken of changes in the production process" .

pa:st-0109 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:locator "Art. 11(5)" ;
    pa:quote "Manufacturers shall ensure that the partly completed machinery which they place on the market bears at least the designation of the partly completed machinery, the year of construction, namely the year in which the manufacturing process was completed, model and series or type and any batch or serial number or other element allowing its identification that exists, or, where the size or nature of the partly completed machinery does not allow this, that the required information is provided on the packaging or in a document accompanying the partly completed machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "bears at least the designation of the partly completed machinery" .

pa:st-0110 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_partly_completed_machinery ;
    pa:condition "where the size or nature of the partly completed machinery does not allow this" ;
    pa:locator "Art. 11(5)" ;
    pa:quote "Manufacturers shall ensure that the partly completed machinery which they place on the market bears at least the designation of the partly completed machinery, the year of construction, namely the year in which the manufacturing process was completed, model and series or type and any batch or serial number or other element allowing its identification that exists, or, where the size or nature of the partly completed machinery does not allow this, that the required information is provided on the packaging or in a document accompanying the partly completed machinery." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_a_document_accompanying_the_partly_completed_machinery .

pa:st-0111 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "where that is not possible, on its packaging or in a document accompanying the partly completed machinery" ;
    pa:locator "Art. 11(6)" ;
    pa:quote "Manufacturers shall indicate their name, registered trade name or registered trade mark, and the postal address and website, email address or other digital contact at which they can be contacted, on the partly completed machinery or, where that is not possible, on its packaging or in a document accompanying the partly completed machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "Manufacturers shall indicate their name" .

pa:st-0112 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_contact_address ;
    pa:locator "Art. 11(6)" ;
    pa:quote "The address shall indicate a single point at which the manufacturer can be contacted." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "The address shall indicate a single point" .

pa:st-0113 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_contact_details ;
    pa:locator "Art. 11(6)" ;
    pa:quote "The contact details shall be in a language easily understood by the person who incorporates the partly completed machinery into machinery and by market surveillance authorities." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "The contact details shall be in a language easily understood" .

pa:st-0114 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_partly_completed_machinery ;
    pa:locator "Art. 11(7)" ;
    pa:quote "Manufacturers shall ensure that the partly completed machinery is accompanied by the assembly instructions set out in Annex XI." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_accompanied_by_the_assembly_instructions .

pa:st-0115 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "where that is not possible, on its packaging or in an accompanying document" ;
    pa:locator "Art. 11(7)" ;
    pa:quote "(a) mark on the partly completed machinery, or, where that is not possible, on its packaging or in an accompanying document, how to access the digital assembly instructions;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "mark on the partly completed machinery" .

pa:st-0116 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "When the assembly instructions are provided in digital format" ;
    pa:locator "Art. 11(7)" ;
    pa:quote "When the assembly instructions are provided in digital format, the manufacturer shall: (a) mark on the partly completed machinery, or, where that is not possible, on its packaging or in an accompanying document, how to access the digital assembly instructions; (b) present them in a format that makes it possible for the person who incorporates the partly completed machinery to print and download the assembly instructions and save them on an electronic device so that he or she can access them at all times, in particular during a breakdown of the partly completed machinery;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "present them in a format that makes it possible" .

pa:st-0117 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "where the assembly instructions are embedded in the software of the partly completed machinery" ;
    pa:locator "Art. 11(7)" ;
    pa:quote "this requirement also applies where the assembly instructions are embedded in the software of the partly completed machinery;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "this requirement also applies" .

pa:st-0118 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_digital_assembly_instructions_made_accessible_online ;
    pa:condition "after the placing on the market of the partly completed machinery" ;
    pa:locator "Art. 11(7)" ;
    pa:quote "(c) make them accessible online for at least 10 years after the placing on the market of the partly completed machinery." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0119 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "at the request of the person who incorporates the partly completed machinery at the time of purchase" ;
    pa:locator "Art. 11(7)" ;
    pa:quote "However, at the request of the person who incorporates the partly completed machinery at the time of purchase, the manufacturer shall provide the assembly instructions in paper format free of charge within one month." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide the assembly instructions in paper format free of charge within one month" .

pa:st-0120 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_assembly_instructions_language ;
    pa:condition "as determined by the Member State concerned" ;
    pa:locator "Art. 11(7)" ;
    pa:quote "The assembly instructions shall be in a language which can be easily understood by the person who incorporates the partly completed machinery, as determined by the Member State concerned, and shall be clear, understandable, and legible." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "in a language which can be easily understood" .

pa:st-0121 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_partly_completed_machinery ;
    pa:condition "or, alternatively, manufacturers shall provide the internet address or machine readable code" ;
    pa:locator "Art. 11(8)" ;
    pa:quote "Manufacturers shall ensure that the partly completed machinery is accompanied by the EU declaration of incorporation set out in Annex V, Part B or, alternatively, manufacturers shall provide the internet address or machine readable code where that EU declaration of incorporation can be accessed in the assembly instructions set out in Annex XI." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_EU_declaration_of_incorporation_set_out_in_Annex_V_Part_B .

pa:st-0122 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers ;
    pa:condition "alternatively to accompanying the declaration, where it can be accessed in the assembly instructions set out in Annex XI" ;
    pa:locator "Art. 11(8)" ;
    pa:quote "Manufacturers shall ensure that the partly completed machinery is accompanied by the EU declaration of incorporation set out in Annex V, Part B or, alternatively, manufacturers shall provide the internet address or machine readable code where that EU declaration of incorporation can be accessed in the assembly instructions set out in Annex XI." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall provide the internet address or machine readable code" .

pa:st-0123 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_digital_EU_declarations_of_incorporation ;
    pa:condition "after the placing on the market of the partly completed machinery" ;
    pa:locator "Art. 11(8)" ;
    pa:quote "Digital EU declarations of incorporation shall be made accessible online for at least 10 years after the placing on the market of the partly completed machinery." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0124 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "Manufacturers who consider or have reason to believe that partly completed machinery which they have placed on the market is not in conformity with this Regulation" ;
    pa:locator "Art. 11(9)" ;
    pa:quote "Manufacturers who consider or have reason to believe that partly completed machinery which they have placed on the market is not in conformity with this Regulation shall immediately take the corrective actions necessary to bring that partly completed machinery into conformity, to withdraw it or to recall it, as appropriate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall immediately take the corrective actions necessary" .

pa:st-0125 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "where the partly completed machinery presents a risk as regards the relevant essential health and safety requirements" ;
    pa:locator "Art. 11(9)" ;
    pa:quote "Furthermore, where the partly completed machinery presents a risk as regards the relevant essential health and safety requirements, manufacturers shall immediately inform the competent national authorities of the Member States in which they made the partly completed machinery available on the market to that effect, giving details, in particular, of the non-conformity and of any corrective actions taken." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall immediately inform the competent national authorities" .

pa:st-0126 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "further to a reasoned request from a competent national authority" ;
    pa:locator "Art. 11(10)" ;
    pa:quote "Manufacturers shall, further to a reasoned request from a competent national authority, provide that authority with all the information and documentation, in paper or digital format, necessary to demonstrate the conformity of the partly completed machinery with this Regulation, in a language which can be easily understood by that authority." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide that authority with all the information" .

pa:st-0127 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturers_of_partly_completed_machinery ;
    pa:condition "at its request, on any actions taken to eliminate the risks" ;
    pa:locator "Art. 11(10)" ;
    pa:quote "They shall cooperate with that authority, at its request, on any actions taken to eliminate the risks as regards the relevant essential health and safety requirements presented by the partly completed machinery, which they have placed on the market." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "cooperate with that authority" .

pa:st-0129 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_technical_documentation_and_EU_declaration_of_conformity ;
    pa:condition "after the product has been placed on the market" ;
    pa:locator "Art. 12(2)" ;
    pa:quote "(a) keep the technical documentation and the EU declaration of conformity of machinery and related products or the EU declaration of incorporation of partly completed machinery at the disposal of the national market surveillance authorities for at least 10 years after the product has been placed on the market;" ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0130 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_authorised_representative ;
    pa:locator "Art. 12(2)" ;
    pa:quote "An authorised representative shall perform the tasks specified in the mandate received from the manufacturer." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall perform the tasks specified in the mandate" .

pa:st-0131 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_authorised_representative ;
    pa:condition "further to a reasoned request from a competent national authority" ;
    pa:locator "Art. 12(2)" ;
    pa:quote "(b) further to a reasoned request from a competent national authority, provide that authority with all the information and documentation necessary to demonstrate the conformity of the product within the scope of this Regulation, either in paper or digital format;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide that authority with all the information and documentation" .

pa:st-0132 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_authorised_representative ;
    pa:condition "at their request, on any actions taken to eliminate the risks" ;
    pa:locator "Art. 12(2)" ;
    pa:quote "(c) cooperate with the competent national authorities, at their request, on any actions taken to eliminate the risks presented by a product within the scope of this Regulation covered by the authorised representative’s mandate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "cooperate with the competent national authorities" .

pa:st-0133 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_machinery_and_related_products ;
    pa:locator "Art. 13(1)" ;
    pa:quote "Importers shall place only compliant machinery or related products on the market." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall place only compliant machinery" .

pa:st-0134 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "Before placing machinery or a related product on the market" ;
    pa:locator "Art. 13(2)" ;
    pa:quote "Before placing machinery or a related product on the market, importers shall ensure that the appropriate conformity assessment procedures referred to in Article 25 have been carried out by the manufacturer." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that the appropriate conformity assessment procedures" .

pa:st-0135 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:locator "Art. 13(2)" ;
    pa:quote "They shall ensure that the manufacturer has drawn up the technical documentation set out in Annex IV, Part A, that the machinery or related product bears the CE marking referred to in Article 23 and is accompanied by the required documents, and that the manufacturer has complied with the requirements set out in Article 10(5), (6) and (8)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "has drawn up the technical documentation set out in Annex IV, Part A" .

pa:st-0136 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_product ;
    pa:locator "Art. 13(2)" ;
    pa:quote "They shall ensure that the manufacturer has drawn up the technical documentation set out in Annex IV, Part A, that the machinery or related product bears the CE marking referred to in Article 23 and is accompanied by the required documents, and that the manufacturer has complied with the requirements set out in Article 10(5), (6) and (8)." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_is_accompanied_by_the_required_documents .

pa:st-0137 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer ;
    pa:condition "Where an importer considers or has reason to believe that machinery or a related product is not in conformity with this Regulation" ;
    pa:locator "Art. 13(2)" ;
    pa:quote "Where an importer considers or has reason to believe that machinery or a related product is not in conformity with this Regulation, the importer shall not place it on the market until it has been brought into conformity." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall not place it on the market until it has been brought into conformity" .

pa:st-0138 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer ;
    pa:condition "where the machinery or related product presents a risk to the health and safety of persons" ;
    pa:locator "Art. 13(2)" ;
    pa:quote "Furthermore, where the machinery or related product presents a risk to the health and safety of persons and, where appropriate, domestic animals and property, and, where applicable, to the environment, the importer shall inform the manufacturer and the market surveillance authorities to that effect." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall inform the manufacturer and the market surveillance authorities" .

pa:st-0139 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer ;
    pa:condition "\"\"" ;
    pa:locator "Art. 13(3)" ;
    pa:quote "Importers shall indicate their name, registered trade name or registered trade mark, and the postal address and website, email address or other digital contact at which they can be contacted, on the machinery or related product or, where that is not possible, on its packaging or in a document accompanying the machinery or related product." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "indicate their name, registered trade name or registered trade mark" .

pa:st-0140 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer ;
    pa:condition "where that is not possible, on its packaging or in a document accompanying the machinery or related product" ;
    pa:locator "Art. 13(3)" ;
    pa:quote "Importers shall indicate their name, registered trade name or registered trade mark, and the postal address and website, email address or other digital contact at which they can be contacted, on the machinery or related product or, where that is not possible, on its packaging or in a document accompanying the machinery or related product." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "postal address and website, email address or other digital contact" .

pa:st-0141 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer_contact_details ;
    pa:condition "\"\"" ;
    pa:locator "Art. 13(3)" ;
    pa:quote "The contact details shall be in a language easily understood by users and market surveillance authorities." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "in a language easily understood by users" .

pa:st-0142 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_product ;
    pa:locator "Art. 13(4)" ;
    pa:quote "Importers shall ensure that the machinery or related product is accompanied by the instructions for use and the information referred to in Article 10(7)." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_accompanied_by_the_instructions_for_use .

pa:st-0143 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_or_related_product ;
    pa:locator "Art. 13(4)" ;
    pa:quote "Importers shall ensure that the machinery or related product is accompanied by the instructions for use and the information referred to in Article 10(7)." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_the_information_referred_to_in_Article_10_7 .

pa:st-0144 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:locator "Art. 13(4)" ;
    pa:quote "Importers shall ensure that the machinery or related product is accompanied by the instructions for use and the information referred to in Article 10(7)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that the machinery or related product" .

pa:st-0145 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "while the machinery or related product is under their responsibility" ;
    pa:locator "Art. 13(5)" ;
    pa:quote "Importers shall ensure that, while the machinery or related product is under their responsibility, the storage or transport conditions do not jeopardise conformity with the essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "the storage or transport conditions do not jeopardise conformity" .

pa:st-0146 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "When deemed appropriate with regard to the risks presented by machinery or a related product" ;
    pa:locator "Art. 13(6)" ;
    pa:quote "When deemed appropriate with regard to the risks presented by machinery or a related product, importers shall, in order to protect the health and safety of persons, and where appropriate, domestic animals and property, and, where applicable, the environment carry out sample testing of machinery or related products made available on the market, investigate, and, if necessary, keep a register of complaints, of non-conforming machinery or related products and machinery or related product recalls, and shall keep distributors informed of any such monitoring." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "carry out sample testing" .

pa:st-0147 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "if necessary" ;
    pa:locator "Art. 13(6)" ;
    pa:quote "When deemed appropriate with regard to the risks presented by machinery or a related product, importers shall, in order to protect the health and safety of persons, and where appropriate, domestic animals and property, and, where applicable, the environment carry out sample testing of machinery or related products made available on the market, investigate, and, if necessary, keep a register of complaints, of non-conforming machinery or related products and machinery or related product recalls, and shall keep distributors informed of any such monitoring." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "keep a register of complaints" .

pa:st-0148 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "Importers who consider or have reason to believe that machinery or a related product, which they have placed on the market, is not in conformity with this Regulation" ;
    pa:locator "Art. 13(7)" ;
    pa:quote "Importers who consider or have reason to believe that machinery or a related product, which they have placed on the market, is not in conformity with this Regulation shall immediately take the corrective actions necessary to bring that machinery or related product into conformity, to withdraw it or recall it, as appropriate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall immediately take the corrective actions necessary" .

pa:st-0149 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "where the machinery or related product presents a risk to the health and safety of persons" ;
    pa:locator "Art. 13(7)" ;
    pa:quote "Furthermore, where the machinery or related product presents a risk to the health and safety of persons and, where appropriate, domestic animals and property, and, where applicable, to the environment, importers shall immediately inform the competent national authorities of the Member States in which they made the machinery or related product available on the market to that effect, giving details, in particular, of the non-conformity and of any corrective actions taken." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall immediately inform the competent national authorities" .

pa:st-0150 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_copy_of_the_EU_declaration_of_conformity ;
    pa:condition "after the machinery or related product has been placed on the market" ;
    pa:locator "Art. 13(8)" ;
    pa:quote "Importers shall, for at least 10 years after the machinery or related product has been placed on the market, keep a copy of the EU declaration of conformity at the disposal of the market surveillance authorities and ensure that the technical documentation set out in Annex IV, Part A, can be made available to those authorities upon request." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0151 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:locator "Art. 13(8)" ;
    pa:quote "Importers shall, for at least 10 years after the machinery or related product has been placed on the market, keep a copy of the EU declaration of conformity at the disposal of the market surveillance authorities and ensure that the technical documentation set out in Annex IV, Part A, can be made available to those authorities upon request." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "keep a copy of the EU declaration of conformity at the disposal of the market surveillance authorities" .

pa:st-0152 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:locator "Art. 13(8)" ;
    pa:quote "Importers shall, for at least 10 years after the machinery or related product has been placed on the market, keep a copy of the EU declaration of conformity at the disposal of the market surveillance authorities and ensure that the technical documentation set out in Annex IV, Part A, can be made available to those authorities upon request." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "ensure that the technical documentation set out in Annex IV, Part A, can be made available to those authorities upon request" .

pa:st-0153 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_source_code_or_programming_logic ;
    pa:condition "Where relevant; upon a reasoned request; if that source code or programming logic is necessary in order for them to be able to check compliance with the essential health and safety requirements set out in Annex III" ;
    pa:locator "Art. 13(8)" ;
    pa:quote "Where relevant, the source code or the programming logic included in the technical documentation shall, upon a reasoned request, be made available to the competent national authorities, if that source code or programming logic is necessary in order for them to be able to check compliance with the essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "be made available to the competent national authorities" .

pa:st-0154 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "further to a reasoned request from a competent national authority" ;
    pa:locator "Art. 13(9)" ;
    pa:quote "Importers shall, further to a reasoned request from a competent national authority, provide that authority with all the information and documentation, in paper or digital format, necessary to demonstrate conformity of the machinery or related products with this Regulation in a language that can be easily understood by that authority." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide that authority with all the information and documentation" .

pa:st-0155 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "\"\"" ;
    pa:locator "Art. 13(9)" ;
    pa:quote "Importers shall, further to a reasoned request from a competent national authority, provide that authority with all the information and documentation, in paper or digital format, necessary to demonstrate conformity of the machinery or related products with this Regulation in a language that can be easily understood by that authority." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "in a language that can be easily understood by that authority" .

pa:st-0156 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "at its request, on any action taken to eliminate the risks to the health and safety of persons" ;
    pa:locator "Art. 13(9)" ;
    pa:quote "Importers shall cooperate with that authority, at its request, on any action taken to eliminate the risks to the health and safety of persons and, where appropriate, domestic animals and property, and, where applicable, to the environment presented by machinery or related products which they have placed on the market." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "cooperate with that authority" .

pa:st-0157 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_partly_completed_machinery ;
    pa:locator "Art. 14(1)" ;
    pa:quote "Importers shall place only compliant partly completed machinery on the market." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall place only compliant partly completed machinery" .

pa:st-0158 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer_of_partly_completed_machinery ;
    pa:condition "Before placing partly completed machinery on the market" ;
    pa:locator "Art. 14(2)" ;
    pa:quote "Before placing partly completed machinery on the market, importers shall ensure that the manufacturer has drawn up the technical documentation set out in Annex IV, Part B, that the partly completed machinery is accompanied by the required documents and that the manufacturer has complied with the requirements set out in Article 11(5), (6) and (8)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that the manufacturer has drawn up" .

pa:st-0159 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_partly_completed_machinery ;
    pa:condition "Before placing partly completed machinery on the market" ;
    pa:locator "Art. 14(2)" ;
    pa:quote "Before placing partly completed machinery on the market, importers shall ensure that the manufacturer has drawn up the technical documentation set out in Annex IV, Part B, that the partly completed machinery is accompanied by the required documents and that the manufacturer has complied with the requirements set out in Article 11(5), (6) and (8)." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_accompanied_by_the_required_documents .

pa:st-0160 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer_of_partly_completed_machinery ;
    pa:condition "Where an importer considers or has reason to believe that partly completed machinery is not in conformity with this Regulation" ;
    pa:locator "Art. 14(2)" ;
    pa:quote "Where an importer considers or has reason to believe that partly completed machinery is not in conformity with this Regulation, the importer shall not place it on the market until it has been brought into conformity." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall not place it on the market until it has been brought into conformity" .

pa:st-0161 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importer_of_partly_completed_machinery ;
    pa:condition "where the partly completed machinery presents a risk as regards the relevant essential health and safety requirements" ;
    pa:locator "Art. 14(2)" ;
    pa:quote "Furthermore, where the partly completed machinery presents a risk as regards the relevant essential health and safety requirements, the importer shall inform the manufacturer and the market surveillance authorities to that effect." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall inform the manufacturer and the market surveillance authorities" .

pa:st-0163 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "where that is not possible, on its packaging or in a document accompanying the partly completed machinery" ;
    pa:locator "Art. 14(3)" ;
    pa:quote "Importers shall indicate their name, registered trade name or registered trade mark, and the postal address and website, email address or other digital contact at which they can be contacted, on the partly completed machinery or, where that is not possible, on its packaging or in a document accompanying the partly completed machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall indicate their name" .

pa:st-0164 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_contact_details ;
    pa:locator "Art. 14(3)" ;
    pa:quote "The contact details shall be in a language easily understood by the person who incorporates the partly completed machinery and by the market surveillance authorities." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "in a language easily understood" .

pa:st-0165 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_partly_completed_machinery ;
    pa:locator "Art. 14(4)" ;
    pa:quote "Importers shall ensure that the partly completed machinery is accompanied by the assembly instructions referred to in Article 11(7)." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "REG" ;
    pa:value pa:Document_accompanied_by_the_assembly_instructions .

pa:st-0166 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:locator "Art. 14(4)" ;
    pa:quote "Importers shall ensure that the partly completed machinery is accompanied by the assembly instructions referred to in Article 11(7)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "shall ensure that the partly completed machinery is accompanied by the assembly instructions" .

pa:st-0167 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_partly_completed_machinery ;
    pa:condition "while the partly completed machinery is under their responsibility" ;
    pa:locator "Art. 14(5)" ;
    pa:quote "Importers shall ensure that, while the partly completed machinery is under their responsibility, the storage or transport conditions do not jeopardise the conformity with the relevant essential health and safety requirements set out in Annex III." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "do not jeopardise the conformity" .

pa:st-0168 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_partly_completed_machinery ;
    pa:condition "Importers who consider or have reason to believe that partly completed machinery which they have placed on the market is not in conformity with this Regulation" ;
    pa:locator "Art. 14(6)" ;
    pa:quote "Importers who consider or have reason to believe that partly completed machinery which they have placed on the market is not in conformity with this Regulation shall immediately take the corrective actions necessary to bring that partly completed machinery into conformity, to withdraw it or recall it, as appropriate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "immediately take the corrective actions necessary" .

pa:st-0169 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_partly_completed_machinery ;
    pa:condition "as appropriate" ;
    pa:locator "Art. 14(6)" ;
    pa:quote "Importers who consider or have reason to believe that partly completed machinery which they have placed on the market is not in conformity with this Regulation shall immediately take the corrective actions necessary to bring that partly completed machinery into conformity, to withdraw it or recall it, as appropriate." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "withdraw it or recall it" .

pa:st-0170 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_partly_completed_machinery ;
    pa:condition "where the partly completed machinery presents a risk as regards relevant essential health and safety requirements" ;
    pa:locator "Art. 14(6)" ;
    pa:quote "Furthermore, where the partly completed machinery presents a risk as regards relevant essential health and safety requirements, importers shall immediately inform the competent national authorities of the Member States in which they made the partly completed machinery available on the market to that effect, giving details, in particular, of the non-conformity and of any corrective actions taken." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "immediately inform the competent national authorities" .

pa:st-0171 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers_of_partly_completed_machinery ;
    pa:condition "where the partly completed machinery presents a risk as regards relevant essential health and safety requirements" ;
    pa:locator "Art. 14(6)" ;
    pa:quote "Furthermore, where the partly completed machinery presents a risk as regards relevant essential health and safety requirements, importers shall immediately inform the competent national authorities of the Member States in which they made the partly completed machinery available on the market to that effect, giving details, in particular, of the non-conformity and of any corrective actions taken." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "giving details, in particular, of the non-conformity and of any corrective actions taken" .

pa:st-0172 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_copy_of_EU_declaration_of_incorporation_kept_by_importers ;
    pa:condition "after the partly completed machinery has been placed on the market" ;
    pa:locator "Art. 14(7)" ;
    pa:quote "Importers shall, for at least 10 years after the partly completed machinery has been placed on the market, keep a copy of the EU declaration of incorporation at the disposal of the market surveillance authorities and ensure that the technical documentation set out in Annex IV, Part B can be made available to those authorities upon request." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "REG" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-0173 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "upon request" ;
    pa:locator "Art. 14(7)" ;
    pa:quote "Importers shall, for at least 10 years after the partly completed machinery has been placed on the market, keep a copy of the EU declaration of incorporation at the disposal of the market surveillance authorities and ensure that the technical documentation set out in Annex IV, Part B can be made available to those authorities upon request." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "ensure that the technical documentation" .

pa:st-0174 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "further to a reasoned request from a competent national authority" ;
    pa:locator "Art. 14(8)" ;
    pa:quote "Importers shall, further to a reasoned request from a competent national authority, provide that authority with all the information and documentation, in paper or digital format, necessary to demonstrate the conformity of the partly completed machinery with this Regulation in a language that can be easily understood by that authority." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "provide that authority with all the information and documentation" .

pa:st-0175 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_importers ;
    pa:condition "at its request, on any action taken to eliminate the risks" ;
    pa:locator "Art. 14(8)" ;
    pa:quote "Importers shall cooperate with that authority, at its request, on any action taken to eliminate the risks as regards the relevant essential health and safety requirements presented by a partly completed machinery, which they have placed on the market." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "cooperate with that authority" .

pa:st-0176 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_distributors ;
    pa:condition "When making machinery or a related product available on the market" ;
    pa:locator "Art. 15(1)" ;
    pa:quote "When making machinery or a related product available on the market, distributors shall act with due care in relation to the requirements of this Regulation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "REG" ;
    pa:value "act with due care in relation to the requirements of this Regulation" .

pa:st-0177 a pa:Statement ;
