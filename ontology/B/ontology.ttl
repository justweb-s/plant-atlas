    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_controllo_efficienza_dei_dispositivi_di_sicurezza ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "Trapano a colonna) INTERVENTO FREQUENZA INCARICATO MODALITA’ CONTROLLO EFFICIENZA DEI DISPOSITIVI DI SICUREZZA GIORNALIERA OPERATORE PROCEDURA P1 CONTROLLO DEL CORREDO DELLA MACCHINA UTENSILE GIORNALIERA OPERATORE Ispezione visiva PULIZIA DELLA TAVOLA DELLA MORSA GIORNALIERA OPERATORE PROCEDURA P2 VERIFICA INTEGRITA’" ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "P1D"^^xsd:duration .

