    pa:about pa:EssentialRequirement_moving_parts_involved_in_the_process ;
    pa:locator "Annex I, 1.3.8.2" ;
    pa:quote "Moving parts involved in the process Guards or protective devices designed to protect persons against the hazards generated by moving parts involved in the process must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2, or — protective devices as referred to in section 1.4.3, or — a combination of the above." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_interlocking_movable_guards_as_referred_to_in_section_1_4_2_ .

pa:st-1155 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_moving_parts_involved_in_the_process ;
    pa:locator "Annex I, 1.3.8.2" ;
    pa:quote "Moving parts involved in the process Guards or protective devices designed to protect persons against the hazards generated by moving parts involved in the process must be: — either fixed guards as referred to in section 1.4.2.1, or — interlocking movable guards as referred to in section 1.4.2.2, or — protective devices as referred to in section 1.4.3, or — a combination of the above." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_protective_devices_as_referred_to_in_section_1_4_3 .

pa:st-1156 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_certain_moving_parts_directly_involved_in_the_process ;
    pa:condition "when certain moving parts directly involved in the process cannot be made completely inaccessible during operation owing to operations requiring operator intervention" ;
    pa:locator "Annex I, 1.3.8.2" ;
    pa:quote "However, when certain moving parts directly involved in the process cannot be made completely inaccessible during operation owing to operations requiring operator intervention, such parts must be fitted with: — fixed guards or interlocking movable guards preventing access to those sections of the parts that are not used in the work, and — adjustable guards as referred to in section 1.4.2.3 restricting access to those sections of the moving parts where access is necessary." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fixed_guards_or_interlocking_movable_guards_preventing_acces .

pa:st-1157 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_certain_moving_parts_directly_involved_in_the_process ;
    pa:condition "when certain moving parts directly involved in the process cannot be made completely inaccessible during operation owing to operations requiring operator intervention" ;
    pa:locator "Annex I, 1.3.8.2" ;
    pa:quote "However, when certain moving parts directly involved in the process cannot be made completely inaccessible during operation owing to operations requiring operator intervention, such parts must be fitted with: — fixed guards or interlocking movable guards preventing access to those sections of the parts that are not used in the work, and — adjustable guards as referred to in section 1.4.2.3 restricting access to those sections of the moving parts where access is necessary." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_adjustable_guards_as_referred_to_in_section_1_4_2_3 .

pa:st-1158 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_3_9 ;
    pa:condition "for whatever reason other than action on the control devices" ;
    pa:locator "Annex I, 1.3.9" ;
    pa:quote "Risks of uncontrolled movements When a part of the machinery has been stopped, any drift away from the stopping position, for whatever reason other than action on the control devices, must be prevented or must be such that it does not present a hazard." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_of_uncontrolled_movements .

pa:st-1160 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_4_1_guards ;
    pa:condition "where possible" ;
    pa:locator "Annex I, 1.4.1" ;
    pa:quote "In addition, guards must, where possible, protect against the ejection or falling of materials or objects and against emissions generated by the machinery." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_the_ejection_or_falling_of_materials_or_objects .

pa:st-1161 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_4_1_guards ;
    pa:condition "where possible" ;
    pa:locator "Annex I, 1.4.1" ;
    pa:quote "In addition, guards must, where possible, protect against the ejection or falling of materials or objects and against emissions generated by the machinery." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_emissions_generated_by_the_machinery .

pa:st-1162 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_4_2_1 ;
    pa:condition "\"\"" ;
    pa:locator "Annex I, 1.4.2.1" ;
    pa:quote "Fixed guards Fixed guards must be fixed by systems that can be opened or removed only with tools." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Fixed_guards .

pa:st-1163 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_4_2_1 ;
    pa:condition "Where possible" ;
    pa:locator "Annex I, 1.4.2.1" ;
    pa:quote "Where possible, guards must be incapable of remaining in place without their fixings." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_incapable_of_remaining_in_place .

pa:st-1165 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_interlocking_movable_guards ;
    pa:locator "Annex I, 1.4.2.2" ;
    pa:quote "Interlocking movable guards must be associated with an interlocking device that: — prevents the start of hazardous machinery functions until they are closed and — gives a stop command whenever they are no longer closed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_interlocking_device .

pa:st-1166 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movable_guards ;
    pa:condition "Where it is possible for an operator to reach the danger zone before the risk due to the hazardous machinery functions has ceased" ;
    pa:locator "Annex I, 1.4.2.2" ;
    pa:quote "Where it is possible for an operator to reach the danger zone before the risk due to the hazardous machinery functions has ceased, movable guards must be associated with a guard locking device in addition to an interlocking device that: — prevents the start of hazardous machinery functions until the guard is closed and locked, and — keeps the guard closed and locked until the risk of injury from the hazardous machinery functions has ceased." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_guard_locking_device .

pa:st-1168 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_4_2_3 ;
    pa:condition "to those areas of the moving parts strictly necessary for the work" ;
    pa:locator "Annex I, 1.4.2.3" ;
    pa:quote "Adjustable guards restricting access Adjustable guards restricting access to those areas of the moving parts strictly necessary for the work must be: — adjustable manually or automatically, depending on the type of work involved, and — readily adjustable without the use of tools." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Adjustable_guards_restricting_access .

pa:st-1169 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_4_2_3 ;
    pa:locator "Annex I, 1.4.2.3" ;
    pa:quote "Adjustable guards restricting access Adjustable guards restricting access to those areas of the moving parts strictly necessary for the work must be: — adjustable manually or automatically, depending on the type of work involved, and — readily adjustable without the use of tools." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_readily_adjustable_without_the_use_of_tools .

pa:st-1171 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_protective_devices_control_system_design ;
    pa:condition "in such a way that moving parts cannot start up while within the operator's reach, persons cannot reach moving parts while moving, and absence or failure of a component prevents starting or stops the moving parts" ;
    pa:locator "Annex I, 1.4.3" ;
    pa:quote "Special requirements for protective devices Protective devices must be designed and incorporated into the control system in such a way that: — moving parts cannot start up while they are within the operator's reach, — persons cannot reach moving parts while the parts are moving, and — the absence or failure of one of their components prevents starting or stops the moving parts." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Protective_devices_must_be_designed_and_incorporated_into_th .

pa:st-1172 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_absence_or_failure_of_a_protective_device_component ;
    pa:locator "Annex I, 1.4.3" ;
    pa:quote "Special requirements for protective devices Protective devices must be designed and incorporated into the control system in such a way that: — moving parts cannot start up while they are within the operator's reach, — persons cannot reach moving parts while the parts are moving, and — the absence or failure of one of their components prevents starting or stops the moving parts." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_absence_or_failure_of_one_of_their_components_prevents_s .

pa:st-1173 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustment_of_protective_devices ;
    pa:condition "only by means of an intentional action" ;
    pa:locator "Annex I, 1.4.3" ;
    pa:quote "Protective devices must be adjustable only by means of an intentional action." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_adjustable_only_by_means_of_an_intentional_action .

pa:st-1174 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_1_electricity_supply ;
    pa:condition "Where machinery has an electricity supply" ;
    pa:locator "Annex I, 1.5.1" ;
    pa:quote "Electricity supply Where machinery has an electricity supply, it must be designed, constructed and equipped in such a way that all hazards of an electrical nature are or can be prevented." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_all_hazards_of_an_electrical_nature .

pa:st-1176 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_5_2_static_electricity ;
    pa:locator "Annex I, 1.5.2" ;
    pa:quote "Static electricity Machinery must be designed and constructed to prevent or limit the build-up of potentially dangerous electrostatic charges and/or be fitted with a discharging system." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_build_up_of_potentially_dangerous_electrostatic_charges .

pa:st-1177 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_5_2_static_electricity ;
    pa:locator "Annex I, 1.5.2" ;
    pa:quote "Static electricity Machinery must be designed and constructed to prevent or limit the build-up of potentially dangerous electrostatic charges and/or be fitted with a discharging system." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_discharging_system .

pa:st-1178 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_3_energy_supply_other_than_electri ;
    pa:condition "Where machinery is powered by source of energy other than electricity" ;
    pa:locator "Annex I, 1.5.3" ;
    pa:quote "Energy supply other than electricity Where machinery is powered by source of energy other than electricity, it must be so designed, constructed and equipped as to avoid all potential risks associated with such sources of energy." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_potential_risks_associated_with_such_sources_of_energy .

pa:st-1179 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_errors_of_fitting_or_refitting_certain_parts ;
    pa:condition "failing this, by information given on the parts themselves and/or their housings" ;
    pa:locator "Annex I, 1.5.4" ;
    pa:quote "Errors of fitting Errors likely to be made when fitting or refitting certain parts which could be a source of risk must be made impossible by the design and construction of such parts or, failing this, by information given on the parts themselves and/or their housings." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_be_made_impossible_by_the_design_and_construction_of_su .

pa:st-1180 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_errors_of_fitting_or_refitting_certain_parts ;
    pa:condition "Errors likely to be made when fitting or refitting certain parts which could be a source of risk" ;
    pa:locator "Annex I, 1.5.4" ;
    pa:quote "Errors of fitting Errors likely to be made when fitting or refitting certain parts which could be a source of risk must be made impossible by the design and construction of such parts or, failing this, by information given on the parts themselves and/or their housings." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_could_be_a_source_of_risk .

pa:st-1181 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_moving_parts_and_or_their_housings ;
    pa:condition "where the direction of movement needs to be known in order to avoid a risk" ;
    pa:locator "Annex I, 1.5.4" ;
    pa:quote "The same information must be given on moving parts and/or their housings where the direction of movement needs to be known in order to avoid a risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_be_given_on_moving_parts_and_or_their_housings .

pa:st-1182 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_incorrect_connections ;
    pa:condition "Where a faulty connection can be the source of risk" ;
    pa:locator "Annex I, 1.5.4" ;
    pa:quote "Where a faulty connection can be the source of risk, incorrect connections must be made impossible by design or, failing this, by information given on the elements to be connected and, where appropriate, on the means of connection." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_incorrect_connections_must_be_made_impossible_by_design .

pa:st-1183 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_incorrect_connections ;
    pa:condition "failing this" ;
    pa:locator "Annex I, 1.5.4" ;
    pa:quote "Where a faulty connection can be the source of risk, incorrect connections must be made impossible by design or, failing this, by information given on the elements to be connected and, where appropriate, on the means of connection." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_by_information_given_on_the_elements_to_be_connected .

pa:st-1185 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:condition "at high or very low temperatures" ;
    pa:locator "Annex I, 1.5.5" ;
    pa:quote "Extreme temperatures Steps must be taken to eliminate any risk of injury arising from contact with or proximity to machinery parts or materials at high or very low temperatures." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_any_risk_of_injury_arising_from_contact .

pa:st-1186 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:locator "Annex I, 1.5.5" ;
    pa:quote "Extreme temperatures Steps must be taken to eliminate any risk of injury arising from contact with or proximity to machinery parts or materials at high or very low temperatures." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Steps_must_be_taken_to_eliminate .

pa:st-1187 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:locator "Annex I, 1.5.5" ;
    pa:quote "The necessary steps must also be taken to avoid or protect against the risk of hot or very cold material being ejected." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_hot_or_very_cold_material_being_ejected .

pa:st-1188 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:locator "Annex I, 1.5.5" ;
    pa:quote "The necessary steps must also be taken to avoid or protect against the risk of hot or very cold material being ejected." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_The_necessary_steps_must_also_be_taken_to_avoid_or_protect_a .

pa:st-1189 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_6 ;
    pa:locator "Annex I, 1.5.6" ;
    pa:quote "Fire Machinery must be designed and constructed in such a way as to avoid any risk of fire or overheating posed by the machinery itself or by gases, liquids, dust, vapours or other substances produced or used by the machinery." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_any_risk_of_fire_or_overheating .

pa:st-1190 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_7 ;
    pa:locator "Annex I, 1.5.7" ;
    pa:quote "Explosion Machinery must be designed and constructed in such a way as to avoid any risk of explosion posed by the machinery itself or by gases, liquids, dust, vapours or other substances produced or used by the machinery." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_any_risk_of_explosion .

pa:st-1192 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_8_noise ;
    pa:locator "Annex I, 1.5.8" ;
    pa:quote "Noise Machinery must be designed and constructed in such a way that risks resulting from the emission of airborne noise are reduced to the lowest level, taking account of technical progress and the availability of means of reducing noise, in particular at source." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risks_resulting_from_the_emission_of_airborne_noise .

pa:st-1193 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_noise_machinery_design ;
    pa:condition "taking account of technical progress and the availability of means of reducing noise" ;
    pa:locator "Annex I, 1.5.8" ;
    pa:quote "Noise Machinery must be designed and constructed in such a way that risks resulting from the emission of airborne noise are reduced to the lowest level, taking account of technical progress and the availability of means of reducing noise, in particular at source." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_in_particular_at_source .

pa:st-1195 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_9 ;
    pa:condition "taking account of technical progress and the availability of means of reducing vibration" ;
    pa:locator "Annex I, 1.5.9" ;
    pa:quote "Vibrations Machinery must be designed and constructed in such a way that risks resulting from vibrations produced by the machinery are reduced to the lowest level, taking account of technical progress and the availability of means of reducing vibration, in particular at source." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risks_resulting_from_vibrations .

pa:st-1197 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_10 ;
    pa:locator "Annex I, 1.5.10" ;
    pa:quote "Radiation Undesirable radiation emissions from the machinery must be eliminated or be reduced to levels that do not have adverse effects on persons." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Undesirable_radiation_emissions .

pa:st-1198 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_10 ;
    pa:condition "Where a risk exists" ;
    pa:locator "Annex I, 1.5.10" ;
    pa:quote "Where a risk exists, the necessary protective measures must be taken." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_necessary_protective_measures_must_be_taken .

pa:st-1200 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_11 ;
    pa:locator "Annex I, 1.5.11" ;
    pa:quote "External radiation Machinery must be designed and constructed in such a way that external radiation does not interfere with its operation." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_external_radiation .

pa:st-1202 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_12 ;
    pa:condition "Where laser equipment is used" ;
    pa:locator "Annex I, 1.5.12" ;
    pa:quote "Laser radiation Where laser equipment is used, the following should be taken into account: — laser equipment on machinery must be designed and constructed in such a way as to prevent any accidental radiation, — laser equipment on machinery must be protected in such a way that effective radiation, radiation produced by reflection or diffusion and secondary radiation do not damage health, — optical equipment for the observation or adjustment of laser equipment on machinery must be such that no health risk is created by laser radiation." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Laser_radiation .

pa:st-1203 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_laser_equipment_on_machinery ;
    pa:condition "Where laser equipment is used" ;
    pa:locator "Annex I, 1.5.12" ;
    pa:quote "Laser radiation Where laser equipment is used, the following should be taken into account: — laser equipment on machinery must be designed and constructed in such a way as to prevent any accidental radiation, — laser equipment on machinery must be protected in such a way that effective radiation, radiation produced by reflection or diffusion and secondary radiation do not damage health, — optical equipment for the observation or adjustment of laser equipment on machinery must be such that no health risk is created by laser radiation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_any_acc .

pa:st-1204 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_laser_equipment_on_machinery ;
    pa:condition "Where laser equipment is used; radiation must not damage health" ;
    pa:locator "Annex I, 1.5.12" ;
    pa:quote "Laser radiation Where laser equipment is used, the following should be taken into account: — laser equipment on machinery must be designed and constructed in such a way as to prevent any accidental radiation, — laser equipment on machinery must be protected in such a way that effective radiation, radiation produced by reflection or diffusion and secondary radiation do not damage health, — optical equipment for the observation or adjustment of laser equipment on machinery must be such that no health risk is created by laser radiation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_protected_in_such_a_way_that .

pa:st-1205 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_optical_equipment_for_observation_or_adjustment_of_laser_equ ;
    pa:condition "Where laser equipment is used" ;
    pa:locator "Annex I, 1.5.12" ;
    pa:quote "Laser radiation Where laser equipment is used, the following should be taken into account: — laser equipment on machinery must be designed and constructed in such a way as to prevent any accidental radiation, — laser equipment on machinery must be protected in such a way that effective radiation, radiation produced by reflection or diffusion and secondary radiation do not damage health, — optical equipment for the observation or adjustment of laser equipment on machinery must be such that no health risk is created by laser radiation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_such_that_no_health_risk_is_created_by_laser_radiation .

pa:st-1207 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_requirement_1_5_13_emissions_of_hazardous_materials_and_subs ;
    pa:locator "Annex I, 1.5.13" ;
    pa:quote "Emissions of hazardous materials and substances Machinery must be designed and constructed in such a way that risks of inhalation, ingestion, contact with the skin, eyes and mucous membranes and penetration through the skin of hazardous materials and substances which it produces can be avoided." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risks_of_inhalation_ingestion_contact_with_the_skin .

pa:st-1208 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_requirement_1_5_13_hazard_that_cannot_be_eliminated ;
    pa:condition "Where a hazard cannot be eliminated" ;
    pa:locator "Annex I, 1.5.13" ;
    pa:quote "Where a hazard cannot be eliminated, the machinery must be so equipped that hazardous materials and substances can be contained, evacuated, precipitated by water spraying, filtered or treated by another equally effective method." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_contained_evacuated_precipitated_by_water_spraying_filtered .

pa:st-1209 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_requirement_1_5_13_process_not_totally_enclosed ;
    pa:condition "Where the process is not totally enclosed during normal operation of the machinery" ;
    pa:locator "Annex I, 1.5.13" ;
    pa:quote "Where the process is not totally enclosed during normal operation of the machinery, the devices for containment and/or evacuation must be situated in such a way as to have the maximum effect." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_devices_for_containment_and_or_evacuation .

pa:st-1211 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_14 ;
    pa:condition "if that is impossible" ;
    pa:locator "Annex I, 1.5.14" ;
    pa:quote "Risk of being trapped in a machine Machinery must be designed, constructed or fitted with a means of preventing a person from being enclosed within it or, if that is impossible, with a means of summoning help." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_means_of_summoning_help .

pa:st-1212 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_15 ;
    pa:locator "Annex I, 1.5.15" ;
    pa:quote "Risk of slipping, tripping or falling Parts of the machinery where persons are liable to move about or stand must be designed and constructed in such a way as to prevent persons slipping, tripping or falling on or off these parts." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risk_of_slipping_tripping_or_falling .

pa:st-1213 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_15_handholds ;
    pa:condition "Where appropriate" ;
    pa:locator "Annex I, 1.5.15" ;
    pa:quote "Where appropriate, these parts must be fitted with handholds that are fixed relative to the user and that enable them to maintain their stability." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_handholds_that_are_fixed_relative_to_the_user .

pa:st-1214 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_16 ;
    pa:condition "Machinery in need of protection against the effects of lightning while being used" ;
    pa:locator "Annex I, 1.5.16" ;
    pa:quote "Lightning Machinery in need of protection against the effects of lightning while being used must be fitted with a system for conducting the resultant electrical charge to earth." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_system_for_conducting_the_resultant_electrical_charge_to_e .

pa:st-1215 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_16 ;
    pa:condition "Machinery in need of protection against the effects of lightning while being used" ;
    pa:locator "Annex I, 1.5.16" ;
    pa:quote "Lightning Machinery in need of protection against the effects of lightning while being used must be fitted with a system for conducting the resultant electrical charge to earth." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_the_effects_of_lightning .

pa:st-1216 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustment_and_maintenance_points ;
    pa:locator "Annex I, 1.6.1" ;
    pa:quote "Machinery maintenance Adjustment and maintenance points must be located outside danger zones." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_be_located_outside_danger_zones .

pa:st-1217 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_adjustment_maintenance_repair_cleaning_and_servicing_operati ;
    pa:condition "If one or more of the above conditions cannot be satisfied for technical reasons" ;
    pa:locator "Annex I, 1.6.1" ;
    pa:quote "If one or more of the above conditions cannot be satisfied for technical reasons, measures must be taken to ensure that these operations can be carried out safely (see section 1.2.5)." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_measures_must_be_taken .

pa:st-1218 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery ;
    pa:condition "In the case of automated machinery and, where necessary, other machinery" ;
    pa:locator "Annex I, 1.6.1" ;
    pa:quote "In the case of automated machinery and, where necessary, other machinery, a connecting device for mounting diagnostic fault-finding equipment must be provided." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_connecting_device_for_mounting_diagnostic_fault_finding_eq .

pa:st-1220 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_6_2_access_to_operating_positions_an ;
    pa:condition "where intervention is necessary during operation, adjustment and maintenance of the machinery" ;
    pa:locator "Annex I, 1.6.2" ;
    pa:quote "Access to operating positions and servicing points Machinery must be designed and constructed in such a way as to allow access in safety to all areas where intervention is necessary during operation, adjustment and maintenance of the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_allow_access_in_safety .

pa:st-1222 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolation_of_energy_sources ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "Isolation of energy sources Machinery must be fitted with means to isolate it from all energy sources." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_means_to_isolate_it_from_all_energy_sources .

pa:st-1223 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolators ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "Such isolators must be clearly identified." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_clearly_identified .

pa:st-1224 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolators ;
    pa:condition "if reconnection could endanger persons" ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "They must be capable of being locked if reconnection could endanger persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_capable_of_being_locked .

pa:st-1225 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolators ;
    pa:condition "where an operator is unable, from any of the points to which he has access, to check that the energy is still cut off" ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "Isolators must also be capable of being locked where an operator is unable, from any of the points to which he has access, to check that the energy is still cut off." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_capable_of_being_locked .

pa:st-1226 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_isolation_of_energy_sources ;
    pa:condition "provided that the operator can check from any of the points to which he has access that the plug remains removed" ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "In the case of machinery capable of being plugged into an electricity supply, removal of the plug is sufficient, provided that the operator can check from any of the points to which he has access that the plug remains removed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_removal_of_the_plug_is_sufficient .

pa:st-1227 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_energy_remaining_in_circuits ;
    pa:condition "after the energy is cut off" ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "After the energy is cut off, it must be possible to dissipate normally any energy remaining or stored in the circuits of the machinery without risk to persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_dissipate_normally_any_energy_remaining_or_stored .

pa:st-1228 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_circuits_kept_connected_to_energy_sources ;
    pa:condition "as an exception, certain circuits may remain connected to their energy sources" ;
    pa:locator "Annex I, 1.6.3" ;
    pa:quote "As an exception to the requirement laid down in the previous paragraphs, certain circuits may remain connected to their energy sources in order, for example, to hold parts, to protect information, to light interiors, etc. In this case, special steps must be taken to ensure operator safety." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_special_steps_must_be_taken_to_ensure_operator_safety .

pa:st-1231 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_cleaning_of_internal_parts ;
    pa:locator "Annex I, 1.6.5" ;
    pa:quote "Cleaning of internal parts The machinery must be designed and constructed in such a way that it is possible to clean internal parts which have contained dangerous substances or preparations without entering them;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_that_it_is_possible_t .

pa:st-1232 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_unblocking_of_internal_parts ;
    pa:locator "Annex I, 1.6.5" ;
    pa:quote "any necessary unblocking must also be possible from the outside." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_any_necessary_unblocking_must_also_be_possible_from_the_outs .

pa:st-1233 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_cleaning_where_entering_is_unavoidable ;
    pa:condition "If it is impossible to avoid entering the machinery" ;
    pa:locator "Annex I, 1.6.5" ;
    pa:quote "If it is impossible to avoid entering the machinery, it must be designed and constructed in such a way as to allow cleaning to take place safely." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_allow_cleaning_ .

pa:st-1236 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_7_1_2_warning_devices ;
    pa:locator "Annex I, 1.7.1.2" ;
    pa:quote "Warning devices Where the health and safety of persons may be endangered by a fault in the operation of unsupervised machinery, the machinery must be equipped in such a way as to give an appropriate acoustic or light signal as a warning." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_a_fault_in_the_operation_of_unsupervised_machinery .

pa:st-1237 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_7_1_2_warning_devices ;
    pa:condition "Where the health and safety of persons may be endangered by a fault in the operation of unsupervised machinery" ;
    pa:locator "Annex I, 1.7.1.2" ;
    pa:quote "Warning devices Where the health and safety of persons may be endangered by a fault in the operation of unsupervised machinery, the machinery must be equipped in such a way as to give an appropriate acoustic or light signal as a warning." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_appropriate_acoustic_or_light_signal .

pa:st-1239 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_7_2_warning_of_residual_risks ;
    pa:condition "Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted" ;
    pa:locator "Annex I, 1.7.2" ;
    pa:quote "Warning of residual risks Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted, the necessary warnings, including warning devices, must be provided." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_warnings_including_warning_devices .

pa:st-1240 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_1_7_2_warning_of_residual_risks ;
    pa:condition "Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted" ;
    pa:locator "Annex I, 1.7.2" ;
    pa:quote "Warning of residual risks Where risks remain despite the inherent safe design measures, safeguarding and complementary protective measures adopted, the necessary warnings, including warning devices, must be provided." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_residual_risks .

pa:st-1242 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_machinery_CE_marking_date ;
    pa:condition "when affixing the CE marking" ;
    pa:locator "Annex I, 1.7.3" ;
    pa:quote "It is prohibited to pre-date or post-date the machinery when affixing the CE marking." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "It is prohibited to pre-date or post-date the machinery" .

pa:st-1243 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_machinery_for_potentially_explosive_atmosphere ;
    pa:condition "designed and constructed for use in a potentially explosive atmosphere" ;
    pa:locator "Annex I, 1.7.3" ;
    pa:quote "Furthermore, machinery designed and constructed for use in a potentially explosive atmosphere must be marked accordingly." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be marked accordingly" .

pa:st-1244 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_machine_part_mass ;
    pa:condition "where a machine part must be handled during use with lifting equipment" ;
    pa:locator "Annex I, 1.7.3" ;
    pa:quote "Where a machine part must be handled during use with lifting equipment, its mass must be indicated legibly, indelibly and unambiguously." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "its mass must be indicated" .

pa:st-1246 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery ;
    pa:condition "in the official Community language or languages of the Member State in which it is placed on the market and/or put into service" ;
    pa:locator "Annex I, 1.7.4" ;
    pa:quote "Instructions All machinery must be accompanied by instructions in the official Community language or languages of the Member State in which it is placed on the market and/or put into service." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_accompanied_by_instructions .

pa:st-1247 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_instructions_accompanying_machinery ;
    pa:condition "either original instructions or a translation of the original instructions; if a translation, it must be accompanied by the original instructions" ;
    pa:locator "Annex I, 1.7.4" ;
    pa:quote "The instructions accompanying the machinery must be either ‘Original instructions’ or a ‘Translation of the original instructions’, in which case the translation must be accompanied by the original instructions." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_Original_instructions .

pa:st-1249 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_instructions_language ;
    pa:locator "Annex I, 1.7.4.1" ;
    pa:quote "General principles for the drafting of instructions (a) The instructions must be drafted in one or more official Community languages." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be drafted in one or more official Community languages" .

pa:st-1250 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_words_Original_instructions_on_verified_language_version ;
    pa:locator "Annex I, 1.7.4.1" ;
    pa:quote "The words ‘Original instructions’ must appear on the language version(s) verified by the manufacturer or his authorised representative." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must appear" .

pa:st-1251 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_translation_into_national_language_s ;
    pa:condition "Where no 'Original instructions' exist in the official language(s) of the country where the machinery is to be used" ;
    pa:locator "Annex I, 1.7.4.1" ;
    pa:quote "(b) Where no ‘Original instructions’ exist in the official language(s) of the country where the machinery is to be used, a translation into that/those language(s) must be provided by the manufacturer or his authorised representative or by the person bringing the machinery into the language area in question." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "a translation into that/those language(s) must be provided" .

pa:st-1252 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_translations ;
    pa:locator "Annex I, 1.7.4.1" ;
    pa:quote "The translations must bear the words ‘Translation of the original instructions’." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must bear the words" .

pa:st-1253 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_instructions_contents ;
    pa:locator "Annex I, 1.7.4.1" ;
    pa:quote "(c) The contents of the instructions must cover not only the intended use of the machinery but also take into account any reasonably foreseeable misuse thereof." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must cover not only the intended use of the machinery" .

pa:st-1254 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_wording_and_layout_of_instructions_for_use ;
    pa:condition "In the case of machinery intended for use by non-professional operators" ;
    pa:locator "Annex I, 1.7.4.1" ;
    pa:quote "(d) In the case of machinery intended for use by non-professional operators, the wording and layout of the instructions for use must take into account the level of general education and acumen that can reasonably be expected from such operators." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must take into account the level of general education" .

pa:st-1255 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery ;
    pa:condition "\"\"" ;
    pa:locator "Annex I, 1.7.4.2" ;
    pa:quote "Contents of the instructions Each instruction manual must contain, where applicable, at least the following information:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_instruction_manual .

pa:st-1256 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "where applicable" ;
    pa:locator "Annex I, 1.7.4.2" ;
    pa:quote "Contents of the instructions Each instruction manual must contain, where applicable, at least the following information: (a) the business name and full address of the manufacturer and of his authorised representative;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the business name and full address of the manufacturer" .

pa:st-1260 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_1_1 ;
    pa:condition "intended for use with foodstuffs or with cosmetics or pharmaceutical products" ;
    pa:locator "Annex I, 2.1.1" ;
    pa:quote "General Machinery intended for use with foodstuffs or with cosmetics or pharmaceutical products must be designed and constructed in such a way as to avoid any risk of infection, sickness or contagion." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_infection_sickness_or_contagion .

pa:st-1261 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_materials_in_contact_with_foodstuffs ;
    pa:condition "Where this is not possible" ;
    pa:locator "Annex I, 2.1.1" ;
    pa:quote "The machinery must be designed and constructed in such a way that these materials can be cleaned before each use. Where this is not possible disposable parts must be used;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_disposable_parts_must_be_used .

pa:st-1262 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_surfaces_in_contact_with_foodstuffs ;
    pa:condition "other than surfaces of disposable parts" ;
    pa:locator "Annex I, 2.1.1" ;
    pa:quote "(b) all surfaces in contact with foodstuffs or cosmetics or pharmaceutical products, other than surfaces of disposable parts, must: — be smooth and have neither ridges nor crevices which could harbour organic materials." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_have_neither_ridges_nor_crevices .

pa:st-1263 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_liquids_gases_and_aerosols_from_foodstuffs ;
    pa:condition "if possible, in a ‘cleaning’ position" ;
    pa:locator "Annex I, 2.1.1" ;
    pa:quote "(c) it must be possible for liquids, gases and aerosols deriving from foodstuffs, cosmetics or pharmaceutical products as well as from cleaning, disinfecting and rinsing fluids to be completely discharged from the machinery (if possible, in a ‘cleaning’ position);" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_completely_discharged_from_the_machinery .

pa:st-1264 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_entry_of_substances_and_living_creatures ;
    pa:condition "in areas that cannot be cleaned" ;
    pa:locator "Annex I, 2.1.1" ;
    pa:quote "(d) machinery must be designed and constructed in such a way as to prevent any substances or living creatures, in particular insects, from entering, or any organic matter from accumulating in, areas that cannot be cleaned;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_prevent_any_substances_or_living_creatures .

pa:st-1266 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_portable_hand_held_and_or_hand_guided_machinery ;
    pa:locator "Annex I, 2.2" ;
    pa:quote "2.2. PORTABLE HAND-HELD AND/OR HAND-GUIDED MACHINERY" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_PORTABLE_HAND_HELD_AND_OR_HAND_GUIDED_MACHINERY .

pa:st-1268 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_and_or_hand_guided_machinery ;
    pa:condition "except where technically impossible, or where there is an independent control device, in the case of handles which cannot be released in complete safety" ;
    pa:locator "Annex I, 2.2.1" ;
    pa:quote "General Portable hand-held and/or hand-guided machinery must: — depending on the type of machinery, have a supporting surface of sufficient size and have a sufficient number of handles and supports of an appropriate size, arranged in such a way as to ensure the stability of the machinery under the intended operating conditions, — except where technically impossible, or where there is an independent control device, in the case of handles which cannot be released in complete safety, be fitted with manual start and stop control devices arranged in such a way that the operator can operate them without releasing the handles, — present no risks of accidental starting and/or continued operation after the operator has released the handles." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_manual_start_and_stop_control_devices .

pa:st-1269 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_hand_held_and_or_hand_guided_machinery ;
    pa:condition "depending on the type of machinery" ;
    pa:locator "Annex I, 2.2.1" ;
    pa:quote "General Portable hand-held and/or hand-guided machinery must: — depending on the type of machinery, have a supporting surface of sufficient size and have a sufficient number of handles and supports of an appropriate size, arranged in such a way as to ensure the stability of the machinery under the intended operating conditions, — except where technically impossible, or where there is an independent control device, in the case of handles which cannot be released in complete safety, be fitted with manual start and stop control devices arranged in such a way that the operator can operate them without releasing the handles, — present no risks of accidental starting and/or continued operation after the operator has released the handles." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_supporting_surface_of_sufficient_size .

pa:st-1270 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_danger_zone_and_action_of_the_tool ;
    pa:condition "where necessary; equivalent steps must be taken if this requirement is not technically feasible" ;
    pa:locator "Annex I, 2.2.1" ;
    pa:quote "Equivalent steps must be taken if this requirement is not technically feasible, — permit, where necessary, visual observation of the danger zone and of the action of the tool with the material being processed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_visual_observation_of_the_danger_zone .

pa:st-1272 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_vibration_total_value_to_which_the_hand_arm_system_is_subjec ;
    pa:condition "if it exceeds 2,5 m/s 2" ;
    pa:locator "Annex I, 2.2.1.1" ;
    pa:quote "Instructions The instructions must give the following information concerning vibrations transmitted by portable hand-held and hand-guided machinery: — the vibration total value to which the hand-arm system is subjected, if it exceeds 2,5 m/s 2 ." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "if it exceeds 2,5 m/s 2" .

pa:st-1273 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_vibration_total_value_not_exceeding_2_5_m_s_2 ;
    pa:condition "where this value does not exceed 2,5 m/s 2" ;
    pa:locator "Annex I, 2.2.1.1" ;
    pa:quote "Where this value does not exceed 2,5 m/s 2 , this must be mentioned, — the uncertainty of measurement." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "Where this value does not exceed 2,5 m/s 2 , this must be mentioned" .

pa:st-1274 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_uncertainty_of_measurement ;
    pa:locator "Annex I, 2.2.1.1" ;
    pa:quote "Where this value does not exceed 2,5 m/s 2 , this must be mentioned, — the uncertainty of measurement." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the uncertainty of measurement" .

pa:st-1275 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_vibration_values ;
    pa:condition "or those established on the basis of measurements taken for technically comparable machinery" ;
    pa:locator "Annex I, 2.2.1.1" ;
    pa:quote "These values must be either those actually measured for the machinery in question or those established on the basis of measurements taken for technically comparable machinery which is representative of the machinery to be produced." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be either those actually measured for the machinery in question" .

pa:st-1276 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_vibration_data ;
    pa:condition "If harmonised standards are not applied" ;
    pa:locator "Annex I, 2.2.1.1" ;
    pa:quote "If harmonised standards are not applied, the vibration data must be measured using the most appropriate measurement code for the machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be measured using the most appropriate measurement code for the machinery" .

pa:st-1277 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_operating_conditions_during_measurement_and_measurement_meth ;
    pa:condition "or the reference of the harmonised standard applied" ;
    pa:locator "Annex I, 2.2.1.1" ;
    pa:quote "The operating conditions during measurement and the methods used for measurement, or the reference of the harmonised standard applied, must be specified." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be specified" .

pa:st-1278 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_portable_fixing_and_other_impact_machinery ;
    pa:condition "unless the machinery is positioned correctly with adequate pressure on the base material" ;
    pa:locator "Annex I, 2.2.2.1" ;
    pa:quote "General Portable fixing and other impact machinery must be designed and constructed in such a way that: — energy is transmitted to the impacted element by the intermediary component that does not leave the device, — an enabling device prevents impact unless the machinery is positioned correctly with adequate pressure on the base material, — involuntary triggering is prevented;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_enabling_device .

pa:st-1279 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_trigger_of_an_impact ;
    pa:condition "where necessary" ;
    pa:locator "Annex I, 2.2.2.1" ;
    pa:quote "where necessary, an appropriate sequence of actions on the enabling device and the control device must be required to trigger an impact, — accidental triggering is prevented during handling or in case of shock, — loading and unloading operations can be carried out easily and safely." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_appropriate_sequence_of_actions .

pa:st-1280 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_2_2_2_1 ;
    pa:locator "Annex I, 2.2.2.1" ;
    pa:quote "where necessary, an appropriate sequence of actions on the enabling device and the control device must be required to trigger an impact, — accidental triggering is prevented during handling or in case of shock, — loading and unloading operations can be carried out easily and safely." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_accidental_triggering .

pa:st-1281 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_impact_machinery_device ;
    pa:condition "where necessary" ;
    pa:locator "Annex I, 2.2.2.1" ;
    pa:quote "Where necessary, it must be possible to fit the device with splinter guard(s) and the appropriate guard(s) must be provided by the manufacturer of the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_splinter_guard_s .

pa:st-1282 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_the_machinery ;
    pa:condition "where necessary" ;
    pa:locator "Annex I, 2.2.2.1" ;
    pa:quote "Where necessary, it must be possible to fit the device with splinter guard(s) and the appropriate guard(s) must be provided by the manufacturer of the machinery." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the appropriate guard(s) must be provided by the manufacturer" .

pa:st-1284 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_2_3_b_ejection_of_workpieces ;
    pa:condition "where the machinery is likely to be used in conditions involving the risk of ejection of workpieces or parts of them" ;
    pa:locator "Annex I, 2.3" ;
    pa:quote "(b) where the machinery is likely to be used in conditions involving the risk of ejection of workpieces or parts of them, it must be designed, constructed, or equipped in such a way as to prevent such ejection, or, if this is not possible, so that the ejection does not engender risks for the operator and/or exposed persons;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_ejection_of_workpieces .

pa:st-1285 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_2_3_b_machinery ;
    pa:condition "if this is not possible, so that the ejection does not engender risks for the operator and/or exposed persons" ;
    pa:locator "Annex I, 2.3" ;
    pa:quote "(b) where the machinery is likely to be used in conditions involving the risk of ejection of workpieces or parts of them, it must be designed, constructed, or equipped in such a way as to prevent such ejection, or, if this is not possible, so that the ejection does not engender risks for the operator and/or exposed persons;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_constructed_or_equipped_in_such_a_way_as_to_prevent .

pa:st-1286 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_2_3_c_machinery ;
    pa:condition "if there is a risk of contact with the tool whilst it runs down" ;
    pa:locator "Annex I, 2.3" ;
    pa:quote "(c) the machinery must be equipped with an automatic brake that stops the tool in a sufficiently short time if there is a risk of contact with the tool whilst it runs down;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_automatic_brake .

pa:st-1287 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_2_3_c_tool_running_down ;
    pa:condition "if there is a risk of contact with the tool whilst it runs down" ;
    pa:locator "Annex I, 2.3" ;
    pa:quote "(c) the machinery must be equipped with an automatic brake that stops the tool in a sufficiently short time if there is a risk of contact with the tool whilst it runs down;" ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_contact_with_the_tool .

pa:st-1288 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_2_3_d_non_fully_automated_machine ;
    pa:condition "where the tool is incorporated into a non-fully automated machine" ;
    pa:locator "Annex I, 2.3" ;
    pa:quote "(d) where the tool is incorporated into a non-fully automated machine, the latter must be designed and constructed in such a way as to eliminate or reduce the risk of accidental injury." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_accidental_injury .

pa:st-1289 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_2_3_d_non_fully_automated_machine ;
    pa:condition "where the tool is incorporated into a non-fully automated machine" ;
    pa:locator "Annex I, 2.3" ;
    pa:quote "(d) where the tool is incorporated into a non-fully automated machine, the latter must be designed and constructed in such a way as to eliminate or reduce the risk of accidental injury." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way .

pa:st-1292 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Machinery_presenting_hazards_due_to_its_mobility ;
    pa:locator "Annex I, 3.1.1" ;
    pa:quote "Definitions (a) ‘Machinery presenting hazards due to its mobility’ means — machinery the operation of which requires either mobility while working, or continuous or semi-continuous movement between a succession of fixed working locations, or — machinery which is operated without being moved, but which may be equipped in such a way as to enable it to be moved more easily from one place to another." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "Machinery presenting hazards due to its mobility" .

pa:st-1293 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Driver ;
    pa:locator "Annex I, 3.1.1" ;
    pa:quote "(b) ‘Driver’ means an operator responsible for the movement of a machine." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "an operator responsible for the movement of a machine" .

pa:st-1295 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_driving_position_visibility ;
    pa:condition "Where necessary" ;
    pa:locator "Annex I, 3.2.1" ;
    pa:quote "Where necessary, appropriate devices must be provided to remedy hazards due to inadequate direct vision." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_devices .

pa:st-1296 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_driving_position_visibility ;
    pa:condition "from the driving positions" ;
    pa:locator "Annex I, 3.2.1" ;
    pa:quote "Machinery on which the driver is transported must be designed and constructed in such a way that, from the driving positions, there is no risk to the driver from inadvertent contact with the wheels and tracks." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_inadvertent_contact_with_the_wheels_and_tracks .

pa:st-1298 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_3_2_2_seating ;
    pa:condition "should the machinery roll or tip over" ;
    pa:locator "Annex I, 3.2.2" ;
    pa:quote "Seating Where there is a risk that operators or other persons transported by the machinery may be crushed between parts of the machinery and the ground should the machinery roll or tip over, in particular for machinery equipped with a protective structure referred to in section 3.4.3 or 3.4.4, their seats must be designed or equipped with a restraint system so as to keep the persons in their seats, without restricting movements necessary for operations or movements relative to the structure caused by the suspension of the seats." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_crushed_between_parts_of_the_machinery_and_the_ground .

pa:st-1299 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_seats ;
    pa:condition "without restricting movements necessary for operations or movements relative to the structure caused by the suspension of the seats" ;
    pa:locator "Annex I, 3.2.2" ;
    pa:quote "Seating Where there is a risk that operators or other persons transported by the machinery may be crushed between parts of the machinery and the ground should the machinery roll or tip over, in particular for machinery equipped with a protective structure referred to in section 3.4.3 or 3.4.4, their seats must be designed or equipped with a restraint system so as to keep the persons in their seats, without restricting movements necessary for operations or movements relative to the structure caused by the suspension of the seats." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_restraint_system .

pa:st-1301 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_positions_for_other_persons ;
    pa:condition "If the conditions of use provide that persons other than the driver may occasionally or regularly be transported by the machinery or work on it" ;
    pa:locator "Annex I, 3.2.3" ;
    pa:quote "Positions for other persons If the conditions of use provide that persons other than the driver may occasionally or regularly be transported by the machinery or work on it, appropriate positions must be provided which enable them to be transported or to work on it without risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_positions_must_be_provided .

pa:st-1303 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_systems ;
    pa:condition "If necessary" ;
    pa:locator "Annex I, 3.3" ;
    pa:quote "CONTROL SYSTEMS If necessary, steps must be taken to prevent unauthorised use of controls." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_steps_must_be_taken_to_prevent_unauthorised_use_of_controls .

pa:st-1304 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_remote_controlled_machinery ;
    pa:locator "Annex I, 3.3" ;
    pa:quote "Remote controlled machinery must be designed and constructed in such a way that it will respond only to signals from the intended control units." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_that_it_will_respond_ .

pa:st-1306 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices ;
    pa:condition "where their operation can lead to hazards, notably dangerous movements; except for those with preset positions" ;
    pa:locator "Annex I, 3.3.1" ;
    pa:quote "Where their operation can lead to hazards, notably dangerous movements, the control devices, except for those with preset positions, must return to the neutral position as soon as they are released by the operator." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_return_to_the_neutral_position .

pa:st-1307 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_pedals ;
    pa:condition "Where there are pedals" ;
    pa:locator "Annex I, 3.3.1" ;
    pa:quote "Where there are pedals, they must be so designed, constructed and fitted as to allow safe operation by the driver with the minimum risk of incorrect operation. They must have a slip-resistant surface and be easy to clean." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_slip_resistant_surface .

pa:st-1308 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_steering_system_of_wheeled_machinery ;
    pa:condition "In the case of wheeled machinery" ;
    pa:locator "Annex I, 3.3.1" ;
    pa:quote "In the case of wheeled machinery, the steering system must be designed and constructed in such a way as to reduce the force of sudden movements of the steering wheel or the steering lever caused by shocks to the guide wheels." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_reduce_the_force_of_sudden_movements .

pa:st-1309 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_differential_lock_control ;
    pa:condition "Any control that locks the differential" ;
    pa:locator "Annex I, 3.3.1" ;
    pa:quote "Any control that locks the differential must be so designed and arranged that it allows the differential to be unlocked when the machinery is moving." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_allows_the_differential_to_be_unlocked .

pa:st-1311 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_travel_movements ;
    pa:condition "with a ride-on driver" ;
    pa:locator "Annex I, 3.3.2" ;
    pa:quote "Starting/moving All travel movements of self-propelled machinery with a ride-on driver must be possible only if the driver is at the controls." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_driver_is_at_the_controls .

pa:st-1312 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_driver_checking_position_of_devices_exceeding_clearance_zone ;
    pa:condition "Where, for operating purposes, machinery is fitted with devices which exceed its normal clearance zone" ;
    pa:locator "Annex I, 3.3.2" ;
    pa:quote "Where, for operating purposes, machinery is fitted with devices which exceed its normal clearance zone (e.g. stabilisers, jib, etc.), the driver must be provided with the means of checking easily, before moving the machinery, that such devices are in a particular position which allows safe movement." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_the_means_of_checking_easily .

pa:st-1313 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_other_parts_that_must_be_in_particular_positions ;
    pa:condition "to allow safe movement, have to be in particular positions" ;
    pa:locator "Annex I, 3.3.2" ;
    pa:quote "This also applies to all other parts which, to allow safe movement, have to be in particular positions, locked if necessary." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_locked_if_necessary .

pa:st-1314 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_of_the_machinery ;
    pa:condition "Where it does not give rise to other risks" ;
    pa:locator "Annex I, 3.3.2" ;
    pa:quote "Where it does not give rise to other risks, movement of the machinery must depend on safe positioning of the aforementioned parts." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_depend_on_safe_positioning .

pa:st-1315 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_unintentional_movement_of_the_machinery ;
    pa:condition "while the engine is being started" ;
    pa:locator "Annex I, 3.3.2" ;
    pa:quote "It must not be possible for unintentional movement of the machinery to occur while the engine is being started." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_not_be_possible_for_unintentional_movement .

pa:st-1317 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_travelling_function ;
    pa:locator "Annex I, 3.3.3" ;
    pa:quote "The driver must be able to slow down and stop self-propelled machinery by means of a main device." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_main_device .

pa:st-1318 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_travelling_function ;
    pa:condition "Where safety so requires, in the event of a failure of the main device, or in the absence of the energy supply needed to actuate the main device" ;
    pa:locator "Annex I, 3.3.3" ;
    pa:quote "Where safety so requires, in the event of a failure of the main device, or in the absence of the energy supply needed to actuate the main device, an emergency device with a fully independent and easily accessible control device must be provided for slowing down and stopping." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_emergency_device_with_a_fully_independent_and_easily_acce .

pa:st-1319 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_stationary_machinery ;
    pa:condition "Where safety so requires" ;
    pa:locator "Annex I, 3.3.3" ;
    pa:quote "Where safety so requires, a parking device must be provided to render stationary machinery immobile." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_parking_device .

pa:st-1320 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_remote_controlled_machinery ;
    pa:condition "if the driver loses control, if it receives a stop signal, if a fault is detected in a safety-related part of the system, if no validation signal is detected within a specified time" ;
    pa:locator "Annex I, 3.3.3" ;
    pa:quote "Remote-controlled machinery must be equipped with devices for stopping operation automatically and immediately and for preventing potentially dangerous operation in the following situations: — if the driver loses control, — if it receives a stop signal, — if a fault is detected in a safety-related part of the system, — if no validation signal is detected within a specified time." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_devices_for_stopping_operation_automatically_and_immediately .

pa:st-1322 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_EssentialRequirement_3_3_4 ;
    pa:condition "\"\"" ;
    pa:locator "Annex I, 3.3.4" ;
    pa:quote "The control systems for pedestrian-controlled machinery must be designed in such a way as to minimise the risks arising from inadvertent movement of the machine towards the driver, in particular: — crushing, — injury from rotating tools." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_crushing .

pa:st-1323 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_of_pedestrian_controlled_self_propelled_machinery ;
    pa:condition "\"\"" ;
    pa:locator "Annex I, 3.3.4" ;
    pa:quote "Movement of pedestrian-controlled machinery Movement of pedestrian-controlled self-propelled machinery must be possible only through sustained action on the relevant control device by the driver." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_sustained_action_on_the_relevant_control_device .

pa:st-1324 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_while_the_engine_is_being_started ;
    pa:condition "\"\"" ;
    pa:locator "Annex I, 3.3.4" ;
    pa:quote "In particular, it must not be possible for movement to occur while the engine is being started." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_it_must_not_be_possible_for_movement_to_occur_while_the_engi .

pa:st-1325 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_rotary_tool_with_reverse_control_engaged ;
    pa:condition "except where the movement of the machinery results from movement of the tool" ;
    pa:locator "Annex I, 3.3.4" ;
    pa:quote "In the case of machinery on which a rotary tool may be fitted, it must not be possible to actuate the tool when the reverse control is engaged, except where the movement of the machinery results from movement of the tool." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_it_must_not_be_possible_to_actuate_the_tool .

pa:st-1328 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_4_1 ;
    pa:condition "when moved" ;
    pa:locator "Annex I, 3.4.1" ;
    pa:quote "Uncontrolled movements Machinery must be designed, constructed and where appropriate placed on its mobile support in such a way as to ensure that, when moved, uncontrolled oscillations of its centre of gravity do not affect its stability or exert excessive strain on its structure." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_uncontrolled_oscillations_of_its_centre_of_gravity .

pa:st-1329 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_4_1 ;
    pa:condition "when moved" ;
    pa:locator "Annex I, 3.4.1" ;
    pa:quote "Uncontrolled movements Machinery must be designed, constructed and where appropriate placed on its mobile support in such a way as to ensure that, when moved, uncontrolled oscillations of its centre of gravity do not affect its stability or exert excessive strain on its structure." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_excessive_strain_on_its_structure .

pa:st-1331 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_with_ride_on_driver ;
    pa:condition "unless this increases the risk" ;
    pa:locator "Annex I, 3.4.3" ;
    pa:quote "Roll-over and tip-over Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk of rolling or tipping over, the machinery must be fitted with an appropriate protective structure, unless this increases the risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_protective_structure .

pa:st-1332 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_with_ride_on_driver ;
    pa:condition "where there is a risk of rolling or tipping over" ;
    pa:locator "Annex I, 3.4.3" ;
    pa:quote "Roll-over and tip-over Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk of rolling or tipping over, the machinery must be fitted with an appropriate protective structure, unless this increases the risk." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_rolling_or_tipping_over .

pa:st-1333 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_protective_structure ;
    pa:condition "in the event of rolling or tipping over" ;
    pa:locator "Annex I, 3.4.3" ;
    pa:quote "This structure must be such that in the event of rolling or tipping over it affords the ride-on person(s) an adequate deflection-limiting volume." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_adequate_deflection_limiting_volume .

pa:st-1334 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "for each type of structure concerned" ;
    pa:locator "Annex I, 3.4.3" ;
    pa:quote "In order to verify that the structure complies with the requirement laid down in the second paragraph, the manufacturer or his authorised representative must, for each type of structure concerned, perform appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "perform appropriate tests or have such tests performed" .

pa:st-1335 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_4_4 ;
    pa:condition "in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk due to falling objects or material" ;
    pa:locator "Annex I, 3.4.4" ;
    pa:quote "Falling objects Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk due to falling objects or material, the machinery must be designed and constructed in such a way as to take account of this risk and fitted, if its size allows, with an appropriate protective structure." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_due_to_falling_objects_or_material .

pa:st-1336 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_self_propelled_machinery_with_ride_on_person_s ;
    pa:condition "if its size allows" ;
    pa:locator "Annex I, 3.4.4" ;
    pa:quote "Falling objects Where, in the case of self-propelled machinery with a ride-on driver, operator(s) or other person(s), there is a risk due to falling objects or material, the machinery must be designed and constructed in such a way as to take account of this risk and fitted, if its size allows, with an appropriate protective structure." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_protective_structure .

pa:st-1337 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "for each type of structure concerned" ;
    pa:locator "Annex I, 3.4.4" ;
    pa:quote "In order to verify that the structure complies with the requirement laid down in the second paragraph, the manufacturer or his authorised representative must, for each type of structure concerned, perform appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "perform appropriate tests or have such tests performed" .

pa:st-1339 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_means_of_access_essential_requirement_3_4_5 ;
    pa:locator "Annex I, 3.4.5" ;
    pa:quote "Means of access Handholds and steps must be designed, constructed and arranged in such a way that the operators use them instinctively and do not use the control devices to assist access." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Handholds_and_steps .

pa:st-1340 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_used_to_tow_or_to_be_towed ;
    pa:locator "Annex I, 3.4.6" ;
    pa:quote "Towing devices All machinery used to tow or to be towed must be fitted with towing or coupling devices designed, constructed and arranged in such a way as to ensure easy and secure connection and disconnection and to prevent accidental disconnection during use." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_towing_or_coupling_devices .

pa:st-1341 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_a_tow_bar_load ;
    pa:condition "Insofar as the tow bar load so requires" ;
    pa:locator "Annex I, 3.4.6" ;
    pa:quote "Insofar as the tow bar load so requires, such machinery must be equipped with a support with a bearing surface suited to the load and the ground." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_support_with_a_bearing_surface .

pa:st-1342 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_power_take_off_on_self_propelled_machinery_or_tractor_side ;
    pa:condition "or by any other device offering equivalent protection" ;
    pa:locator "Annex I, 3.4.7" ;
    pa:quote "On the side of the self-propelled machinery (or tractor), the power take-off to which the removable mechanical transmission device is attached must be protected either by a guard fixed and linked to the self-propelled machinery (or tractor) or by any other device offering equivalent protection." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_guard_fixed_and_linked_to_the_self_propelled_machinery_or_ .

pa:st-1343 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_input_shaft_on_recipient_machinery_side ;
    pa:locator "Annex I, 3.4.7" ;
    pa:quote "On the recipient machinery side, the input shaft must be enclosed in a protective casing fixed to the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_enclosed_in_a_protective_casing_fixed_to_the_machinery .

pa:st-1344 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guard_on_universal_joint_transmission ;
    pa:condition "in the case of simple universal joints" ;
    pa:locator "Annex I, 3.4.7" ;
    pa:quote "The guard must cover the transmission to the ends of the inner jaws in the case of simple universal joints and at least to the centre of the outer joint or joints in the case of wide-angle universal joints." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_The_guard_must_cover_the_transmission_to_the_ends_of_the_inn .

pa:st-1346 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_1_batteries ;
    pa:condition "in the event of rollover or tipover" ;
    pa:locator "Annex I, 3.5.1" ;
    pa:quote "Batteries The battery housing must be designed and constructed in such a way as to prevent the electrolyte being ejected on to the operator in the event of rollover or tipover and to avoid the accumulation of vapours in places occupied by operators." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_ejected_on_to_the_operator .

pa:st-1347 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_1_batteries ;
    pa:condition "in the event of rollover or tipover" ;
    pa:locator "Annex I, 3.5.1" ;
    pa:quote "Batteries The battery housing must be designed and constructed in such a way as to prevent the electrolyte being ejected on to the operator in the event of rollover or tipover and to avoid the accumulation of vapours in places occupied by operators." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_battery_housing .

pa:st-1348 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_1_batteries ;
    pa:condition "in places occupied by operators" ;
    pa:locator "Annex I, 3.5.1" ;
    pa:quote "Batteries The battery housing must be designed and constructed in such a way as to prevent the electrolyte being ejected on to the operator in the event of rollover or tipover and to avoid the accumulation of vapours in places occupied by operators." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_accumulation_of_vapours .

pa:st-1349 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_3_5_1_batteries ;
    pa:locator "Annex I, 3.5.1" ;
    pa:quote "Machinery must be designed and constructed in such a way that the battery can be disconnected with the aid of an easily accessible device provided for that purpose." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_easily_accessible_device .

pa:st-1350 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_fire ;
    pa:condition "where its size permits; depending on the hazards anticipated by the manufacturer" ;
    pa:locator "Annex I, 3.5.2" ;
    pa:quote "Fire Depending on the hazards anticipated by the manufacturer, machinery must, where its size permits: — either allow easily accessible fire extinguishers to be fitted, or — be provided with built-in extinguisher systems." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_easily_accessible_fire_extinguishers .

pa:st-1351 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_fire ;
    pa:condition "where its size permits; depending on the hazards anticipated by the manufacturer" ;
    pa:locator "Annex I, 3.5.2" ;
    pa:quote "Fire Depending on the hazards anticipated by the manufacturer, machinery must, where its size permits: — either allow easily accessible fire extinguishers to be fitted, or — be provided with built-in extinguisher systems." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_built_in_extinguisher_systems .

pa:st-1352 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_operator ;
    pa:condition "where the main function of the machinery is the spraying of products" ;
    pa:locator "Annex I, 3.5.3" ;
    pa:quote "Emissions of hazardous substances The second and third paragraphs of section 1.5.13 do not apply where the main function of the machinery is the spraying of products. However, the operator must be protected against the risk of exposure to such hazardous emissions." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be protected against the risk of exposure" .

pa:st-1354 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_a_ride_on_driver ;
    pa:condition "Without prejudice to the provisions of road traffic regulations" ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "Without prejudice to the provisions of road traffic regulations, machinery with a ride-on driver must have the following equipment: — an acoustic warning device to alert persons, — a system of light signals relevant to the intended conditions of use;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_an_acoustic_warning_device .

pa:st-1355 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_a_ride_on_driver ;
    pa:condition "the latter requirement does not apply to machinery intended solely for underground working and having no electrical power" ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "Without prejudice to the provisions of road traffic regulations, machinery with a ride-on driver must have the following equipment: — an acoustic warning device to alert persons, — a system of light signals relevant to the intended conditions of use; the latter requirement does not apply to machinery intended solely for underground working and having no electrical power, — where necessary, there must be an appropriate connection between a trailer and the machinery for the operation of signals." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_system_of_light_signals .

pa:st-1356 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_remote_controlled_machinery_exposing_persons_to_impact_or_cr ;
    pa:condition "under normal conditions of use, exposes persons to the risk of impact or crushing" ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "Remote-controlled machinery which, under normal conditions of use, exposes persons to the risk of impact or crushing must be fitted with appropriate means to signal its movements or with means to protect persons against such risks." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_appropriate_means_to_signal_its_movements .

pa:st-1357 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_warning_and_signalling_devices ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "Machinery must be constructed in such a way that the warning and signalling devices cannot be disabled unintentionally." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_cannot_be_disabled_unintentionally .

pa:st-1358 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_warning_and_signalling_devices ;
    pa:condition "Where it is essential for safety" ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "Where it is essential for safety, such devices must be provided with the means to check that they are in good working order and their failure must be made apparent to the operator." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_means_to_check_that_they_are_in_good_working_order .

pa:st-1359 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_particularly_hazardous_movement ;
    pa:condition "Where the movement of machinery or its tools is particularly hazardous" ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "Where the movement of machinery or its tools is particularly hazardous, signs on the machinery must be provided to warn against approaching the machinery while it is working;" ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_signs_on_the_machinery .

pa:st-1360 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_signs_on_the_machinery ;
    pa:locator "Annex I, 3.6.1" ;
    pa:quote "the signs must be legible at a sufficient distance to ensure the safety of persons who have to be in the vicinity." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_legible_at_a_sufficient_distance .

pa:st-1365 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Lifting_operation ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "Definitions (a) ‘Lifting operation’ means a movement of unit loads consisting of goods and/or persons necessitating, at a given moment, a change of level." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a movement of unit loads consisting of goods and/or persons" .

pa:st-1366 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Guided_load ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "(b) ‘Guided load’ means a load where the total movement is made along rigid or flexible guides whose position is determined by fixed points." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a load where the total movement is made along rigid or flexible guides" .

pa:st-1367 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Working_coefficient ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "(c) ‘Working coefficient’ means the arithmetic ratio between the load guaranteed by the manufacturer or his authorised representative up to which a component is able to hold it and the maximum working load marked on the component." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the arithmetic ratio between the load guaranteed" .

pa:st-1368 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Test_coefficient ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "(d) ‘Test coefficient’ means the arithmetic ratio between the load used to carry out the static or dynamic tests on lifting machinery or a lifting accessory and the maximum working load marked on the lifting machinery or lifting accessory." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the arithmetic ratio between the load used to carry out the static or dynamic tests" .

pa:st-1369 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Static_test ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "(e) ‘Static test’ means the test during which lifting machinery or a lifting accessory is first inspected and subjected to a force corresponding to the maximum working load multiplied by the appropriate static test coefficient and then re-inspected once the said load has been released to ensure that no damage has occurred." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the test during which lifting machinery or a lifting accessory is first inspected" .

pa:st-1370 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Dynamic_test ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "(f) ‘Dynamic test’ means the test during which lifting machinery is operated in all its possible configurations at the maximum working load multiplied by the appropriate dynamic test coefficient with account being taken of the dynamic behaviour of the lifting machinery in order to check that it functions properly." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the test during which lifting machinery is operated in all its possible configurations" .

pa:st-1371 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_Carrier ;
    pa:locator "Annex I, 4.1.1" ;
    pa:quote "(g) ‘Carrier’ means a part of the machinery on or in which persons and/or goods are supported in order to be lifted." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "a part of the machinery on or in which persons and/or goods are supported" .

pa:st-1372 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_1 ;
    pa:locator "Annex I, 4.1.2.1" ;
    pa:quote "Risks due to lack of stability Machinery must be designed and constructed in such a way that the stability required by section 1.3.1 is maintained both in service and out of service, including all stages of transportation, assembly and dismantling, during foreseeable component failures and also during the tests carried out in accordance with the instruction handbook." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_due_to_lack_of_stability .

pa:st-1373 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:locator "Annex I, 4.1.2.1" ;
    pa:quote "To that end, the manufacturer or his authorised representative must use the appropriate verification methods." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must use the appropriate verification methods" .

pa:st-1375 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_running_on_guide_rails ;
    pa:locator "Annex I, 4.1.2.2" ;
    pa:quote "Machinery running on guide rails and rail tracks Machinery must be provided with devices which act on the guide rails or tracks to prevent derailment." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_devices_which_act_on_the_guide_rails_or_tracks .

pa:st-1376 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_running_on_guide_rails ;
    pa:condition "If, despite such devices, there remains a risk of derailment or of failure of a rail or of a running component" ;
    pa:locator "Annex I, 4.1.2.2" ;
    pa:quote "If, despite such devices, there remains a risk of derailment or of failure of a rail or of a running component, devices must be provided which prevent the equipment, component or load from falling or the machinery from overturning." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_derailment .

pa:st-1377 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_running_on_guide_rails ;
    pa:condition "If, despite such devices, there remains a risk of derailment or of failure of a rail or of a running component" ;
    pa:locator "Annex I, 4.1.2.2" ;
    pa:quote "If, despite such devices, there remains a risk of derailment or of failure of a rail or of a running component, devices must be provided which prevent the equipment, component or load from falling or the machinery from overturning." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_devices_must_be_provided_which_prevent_the_equipment_compone .

pa:st-1378 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_and_lifting_accessories ;
    pa:locator "Annex I, 4.1.2.3" ;
    pa:quote "Machinery and lifting accessories must be designed and constructed in such a way as to prevent failure from fatigue and wear, taking due account of their intended use." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_failure_from_fatigue_and_wear .

pa:st-1379 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_materials_used ;
    pa:locator "Annex I, 4.1.2.3" ;
    pa:quote "The materials used must be chosen on the basis of the intended working environments, with particular regard to corrosion, abrasion, impacts, extreme temperatures, fatigue, brittleness and ageing." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_corrosion .

pa:st-1380 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:condition "In order to verify that an adequate working coefficient has been attained" ;
    pa:locator "Annex I, 4.1.2.4" ;
    pa:quote "In order to verify that an adequate working coefficient has been attained, the manufacturer or his authorised representative must, for each type of chain and rope used directly for lifting the load and for the rope ends, perform the appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "perform the appropriate tests or have such tests performed" .

pa:st-1382 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "in order to verify that an adequate working coefficient has been attained" ;
    pa:locator "Annex I, 4.1.2.5" ;
    pa:quote "(f) in order to verify that an adequate working coefficient has been attained, the manufacturer or his authorised representative must, for each type of component referred to in (a), (b), (c) and (d), perform the appropriate tests or have such tests performed." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "perform the appropriate tests or have such tests performed" .

pa:st-1383 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_devices_controlling_amplitude_of_movement ;
    pa:locator "Annex I, 4.1.2.6" ;
    pa:quote "(a) Machinery must be designed and constructed or fitted with devices in such a way that the amplitude of movement of its components is kept within the specified limits." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fitted_with_devices .

pa:st-1384 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_operation_of_amplitude_devices ;
    pa:condition "where appropriate" ;
    pa:locator "Annex I, 4.1.2.6" ;
    pa:quote "The operation of such devices must, where appropriate, be preceded by a warning." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_preceded_by_a_warning .

pa:st-1385 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_collision_risk ;
    pa:condition "where several fixed or rail-mounted machines can be manoeuvred simultaneously in the same place, with risks of collision" ;
    pa:locator "Annex I, 4.1.2.6" ;
    pa:quote "(b) Where several fixed or rail-mounted machines can be manoeuvred simultaneously in the same place, with risks of collision, such machinery must be designed and constructed in such a way as to make it possible to fit systems enabling these risks to be avoided." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fit_systems_enabling_these_risks_to_be_avoided .

pa:st-1386 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loads_creeping_or_falling_freely ;
    pa:condition "even in the event of partial or total failure of the power supply or when the operator stops operating the machine" ;
    pa:locator "Annex I, 4.1.2.6" ;
    pa:quote "(c) Machinery must be designed and constructed in such a way that the loads cannot creep dangerously or fall freely and unexpectedly, even in the event of partial or total failure of the power supply or when the operator stops operating the machine." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_creep_dangerously_or_fall_freely_and_unexpectedly .

pa:st-1387 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_inadvertent_dropping_of_loads ;
    pa:locator "Annex I, 4.1.2.6" ;
    pa:quote "(e) Holding devices must be designed and constructed in such a way that inadvertent dropping of the loads is avoided." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_inadvertent_dropping_of_the_loads .

pa:st-1389 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_1_2_7_operating_position_and_moving_parts ;
    pa:locator "Annex I, 4.1.2.7" ;
    pa:quote "Movements of loads during handling The operating position of machinery must be located in such a way as to ensure the widest possible view of trajectories of the moving parts, in order to avoid possible collisions with persons, equipment or other machinery which might be manoeuvring at the same time and liable to constitute a hazard." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_possible_collisions_with_persons .

pa:st-1390 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_4_1_2_7_machinery_with_guided_loads ;
    pa:condition "machinery with guided loads" ;
    pa:locator "Annex I, 4.1.2.7" ;
    pa:quote "Machinery with guided loads must be designed and constructed in such a way as to prevent persons from being injured by movement of the load, the carrier or the counterweights, if any." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_injured_by_movement_of_the_load .

pa:st-1392 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_movement_of_the_carrier_of_machinery_serving_fixed_landings ;
    pa:condition "to and at the landings" ;
    pa:locator "Annex I, 4.1.2.8.1" ;
    pa:quote "Movements of the carrier The movement of the carrier of machinery serving fixed landings must be rigidly guided to and at the landings." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_rigidly_guided .

pa:st-1394 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_during_access_by_persons ;
    pa:condition "Where persons have access to the carrier" ;
    pa:locator "Annex I, 4.1.2.8.2" ;
    pa:quote "Access to the carrier Where persons have access to the carrier, the machinery must be designed and constructed in such a way as to ensure that the carrier remains stationary during access, in particular while it is being loaded or unloaded." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_ensure_that_the_carrier_remains_stationary_during_access .

pa:st-1395 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_difference_in_level_between_carrier_and_landing_being_served ;
    pa:locator "Annex I, 4.1.2.8.2" ;
    pa:quote "The machinery must be designed and constructed in such a way as to ensure that the difference in level between the carrier and the landing being served does not create a risk of tripping." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_tripping .

pa:st-1396 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_8_3 ;
    pa:condition "Where necessary in order to fulfil the requirement expressed in the second paragraph of section 4.1.2.7" ;
    pa:locator "Annex I, 4.1.2.8.3" ;
    pa:quote "Risks due to contact with the moving carrier Where necessary in order to fulfil the requirement expressed in the second paragraph of section 4.1.2.7, the travel zone must be rendered inaccessible during normal operation." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_due_to_contact_with_the_moving_carrier .

pa:st-1397 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_travel_zone ;
    pa:condition "during normal operation" ;
    pa:locator "Annex I, 4.1.2.8.3" ;
    pa:quote "Risks due to contact with the moving carrier Where necessary in order to fulfil the requirement expressed in the second paragraph of section 4.1.2.7, the travel zone must be rendered inaccessible during normal operation." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_rendered_inaccessible .

pa:st-1398 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_persons_situated_under_or_above_the_carrier ;
    pa:condition "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed" ;
    pa:locator "Annex I, 4.1.2.8.3" ;
    pa:quote "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed between the carrier and any fixed parts, sufficient free space must be provided either by means of physical refuges or by means of mechanical devices blocking the movement of the carrier." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_may_be_crushed_between_the_carrier_and_any_fixed_parts .

pa:st-1399 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_persons_situated_under_or_above_the_carrier ;
    pa:condition "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed" ;
    pa:locator "Annex I, 4.1.2.8.3" ;
    pa:quote "When, during inspection or maintenance, there is a risk that persons situated under or above the carrier may be crushed between the carrier and any fixed parts, sufficient free space must be provided either by means of physical refuges or by means of mechanical devices blocking the movement of the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_sufficient_free_space_must_be_provided .

pa:st-1401 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_8_4 ;
    pa:condition "Where there is a risk" ;
    pa:locator "Annex I, 4.1.2.8.4" ;
    pa:quote "Risk due to the load falling off the carrier Where there is a risk due to the load falling off the carrier, the machinery must be designed and constructed in such a way as to prevent this risk." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risk_due_to_the_load_falling_off_the_carrier .

pa:st-1402 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_8_4 ;
    pa:condition "Where there is a risk" ;
    pa:locator "Annex I, 4.1.2.8.4" ;
    pa:quote "Risk due to the load falling off the carrier Where there is a risk due to the load falling off the carrier, the machinery must be designed and constructed in such a way as to prevent this risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_this_ri .

pa:st-1403 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_4_1_2_8_5_landings ;
    pa:locator "Annex I, 4.1.2.8.5" ;
    pa:quote "Landings Risks due to contact of persons at landings with the moving carrier or other moving parts must be prevented." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_contact_of_persons_at_landings_with_the_moving_carrier .

pa:st-1404 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_persons_falling_into_travel_zone_at_landings ;
    pa:condition "Where there is a risk due to persons falling into the travel zone when the carrier is not present at the landings" ;
    pa:locator "Annex I, 4.1.2.8.5" ;
    pa:quote "Where there is a risk due to persons falling into the travel zone when the carrier is not present at the landings, guards must be fitted in order to prevent this risk." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_guards_must_be_fitted .

pa:st-1405 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_guards_at_landings ;
    pa:condition "hazardous movements of the carrier until the guards are closed and locked" ;
    pa:locator "Annex I, 4.1.2.8.5" ;
    pa:quote "They must be fitted with an interlocking device controlled by the position of the carrier that prevents: — hazardous movements of the carrier until the guards are closed and locked, — hazardous opening of a guard until the carrier has stopped at the corresponding landing." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_interlocking_device_controlled_by_the_position_of_the_carrie .

pa:st-1407 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:condition "When lifting machinery or lifting accessories are placed on the market or are first put into service" ;
    pa:locator "Annex I, 4.1.3" ;
    pa:quote "Fitness for purpose When lifting machinery or lifting accessories are placed on the market or are first put into service, the manufacturer or his authorised representative must ensure, by taking appropriate measures or having them taken, that the machinery or the lifting accessories which are ready for use — whether manually or power-operated — can fulfil their specified functions safely." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must ensure" .

pa:st-1408 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_appropriate_measures ;
    pa:condition "Where the machinery cannot be assembled in the manufacturer's premises or in the premises of his authorised representative" ;
    pa:locator "Annex I, 4.1.3" ;
    pa:quote "Where the machinery cannot be assembled in the manufacturer's premises or in the premises of his authorised representative, the appropriate measures must be taken at the place of use." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be taken at the place of use" .

pa:st-1410 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_of_movements_essential_requirement_4_2_1 ;
    pa:locator "Annex I, 4.2.1" ;
    pa:quote "Control of movements Hold-to-run control devices must be used to control the movements of the machinery or its equipment." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Hold_to_run_control_devices .

pa:st-1411 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_of_movements_essential_requirement_4_2_1 ;
    pa:condition "for partial or complete movements in which there is no risk of the load or the machinery colliding" ;
    pa:locator "Annex I, 4.2.1" ;
    pa:quote "However, for partial or complete movements in which there is no risk of the load or the machinery colliding, the said devices may be replaced by control devices authorising automatic stops at pre-selected positions without the operator holding a hold-to-run control device." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_control_devices_authorising_automatic_stops_at_pre_selected_ .

pa:st-1412 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loading_control ;
    pa:condition "Machinery with a maximum working load of not less than 1 000 kilograms or an overturning moment of not less than 40 000 Nm" ;
    pa:locator "Annex I, 4.2.2" ;
    pa:quote "Loading control Machinery with a maximum working load of not less than 1 000 kilograms or an overturning moment of not less than 40 000 Nm must be fitted with devices to warn the driver and prevent dangerous movements in the event: — of overloading, either as a result of the maximum working load or the maximum working moment due to the load being exceeded, or — of the overturning moment being exceeded." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fitted_with_devices_to_warn_the_driver_and_prevent_dangerous .

pa:st-1413 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_rope_carriers_tractors_or_tractor_carriers ;
    pa:locator "Annex I, 4.2.3" ;
    pa:quote "Installations guided by ropes Rope carriers, tractors or tractor carriers must be held by counterweights or by a device allowing permanent control of the tension." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_counterweights_or_by_a_device_allowing_permanent_control_of_ .

pa:st-1415 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_lifting_machinery_maximum_working_load ;
    pa:locator "Annex I, 4.3.3" ;
    pa:quote "Lifting machinery The maximum working load must be prominently marked on the machinery." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_prominently_marked .

pa:st-1416 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_lifting_machinery_marking ;
    pa:locator "Annex I, 4.3.3" ;
    pa:quote "This marking must be legible, indelible and in an un-coded form." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_legible_indelible_and_in_an_un_coded_form .

pa:st-1417 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_lifting_machinery_working_load_per_configuration ;
    pa:condition "Where the maximum working load depends on the configuration of the machinery" ;
    pa:locator "Annex I, 4.3.3" ;
    pa:quote "Where the maximum working load depends on the configuration of the machinery, each operating position must be provided with a load plate indicating, preferably in diagrammatic form or by means of tables, the working load permitted for each configuration." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_load_plate .

pa:st-1418 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_lifting_machinery_with_carrier_allowing_access_to_persons ;
    pa:condition "Machinery intended for lifting goods only, equipped with a carrier which allows access to persons" ;
    pa:locator "Annex I, 4.3.3" ;
    pa:quote "Machinery intended for lifting goods only, equipped with a carrier which allows access to persons, must bear a clear and indelible warning prohibiting the lifting of persons." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_clear_and_indelible_warning_prohibiting_the_lifting_of_perso .

pa:st-1419 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_warning_prohibiting_lifting_of_persons ;
    pa:condition "where access is possible" ;
    pa:locator "Annex I, 4.3.3" ;
    pa:quote "This warning must be visible at each place where access is possible." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_visible .

pa:st-1421 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_accessory_or_commercially_indivisible_batch_of_lifti ;
    pa:locator "Annex I, 4.4.1" ;
    pa:quote "Lifting accessories Each lifting accessory or each commercially indivisible batch of lifting accessories must be accompanied by instructions setting out at least the following particulars:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_must_be_accompanied_by_instructions .

pa:st-1422 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery ;
    pa:locator "Annex I, 4.4.2" ;
    pa:quote "Lifting machinery Lifting machinery must be accompanied by instructions containing information on:" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_must_be_accompanied_by_instructions .

pa:st-1423 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery ;
    pa:condition "if the latter is not supplied with the machinery" ;
    pa:locator "Annex I, 4.4.2" ;
    pa:quote "(b) the contents of the logbook, if the latter is not supplied with the machinery;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_the_contents_of_the_logbook .

pa:st-1424 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_lifting_machinery ;
    pa:condition "where appropriate" ;
    pa:locator "Annex I, 4.4.2" ;
    pa:quote "(d) where appropriate, a test report detailing the static and dynamic tests carried out by or for the manufacturer or his authorised representative;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_a_test_report_detailing_the_static_and_dynamic_tests .

pa:st-1425 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_machinery_not_assembled_on_manufacturer_s_premises ;
    pa:condition "for machinery which is not assembled on the premises of the manufacturer in the form in which it is to be used" ;
    pa:locator "Annex I, 4.4.2" ;
    pa:quote "(e) for machinery which is not assembled on the premises of the manufacturer in the form in which it is to be used, the necessary instructions for performing the measures referred to in section 4.1.3 before it is first put into service." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Document_the_necessary_instructions_for_performing_the_measures .

pa:st-1427 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_5_1_powered_roof_supports ;
    pa:locator "Annex I, 5.1" ;
    pa:quote "RISKS DUE TO LACK OF STABILITY Powered roof supports must be designed and constructed in such a way as to maintain a given direction when moving and not slip before and while they come under load and after the load has been removed." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_RISKS_DUE_TO_LACK_OF_STABILITY .

pa:st-1428 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_powered_roof_supports ;
    pa:locator "Annex I, 5.1" ;
    pa:quote "They must be equipped with anchorages for the top plates of the individual hydraulic props." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_anchorages_for_the_top_plates_of_the_individual_hydraulic_pr .

pa:st-1431 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_of_powered_roof_supports ;
    pa:condition "during displacement operations" ;
    pa:locator "Annex I, 5.3" ;
    pa:quote "The control devices of powered roof supports must be designed and positioned in such a way that, during displacement operations, operators are sheltered by a support in place." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_sheltered_by_a_support_in_place .

pa:st-1432 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices ;
    pa:locator "Annex I, 5.3" ;
    pa:quote "The control devices must be protected against any accidental release." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_protected_against_any_accidental_release .

pa:st-1434 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_5_4_stopping_self_propelled_machinery_running_on_rails ;
    pa:condition "for use in underground work" ;
    pa:locator "Annex I, 5.4" ;
    pa:quote "STOPPING Self-propelled machinery running on rails for use in underground work must be equipped with an enabling device acting on the circuit controlling the movement of the machinery such that movement is stopped if the driver is no longer in control of the movement." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_enabling_device .

pa:st-1435 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_internal_combustion_engines_for_underground_w ;
    pa:condition "for use in underground workings" ;
    pa:locator "Annex I, 5.5" ;
    pa:quote "Machinery with internal combustion engines for use in underground workings must be fitted only with engines using fuel with a low vaporising pressure and which exclude any spark of electrical origin." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_fitted_only_with_engines_using_fuel_with_a_low_vaporising_pr .

pa:st-1436 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_with_internal_combustion_engines_for_underground_w ;
    pa:condition "for use in underground workings" ;
    pa:locator "Annex I, 5.5" ;
    pa:quote "Machinery with internal combustion engines for use in underground workings must be fitted only with engines using fuel with a low vaporising pressure and which exclude any spark of electrical origin." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_exclude_any_spark_of_electrical_origin .

pa:st-1437 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_braking_system_of_machinery_intended_for_use_in_underground_ ;
    pa:condition "machinery intended for use in underground workings" ;
    pa:locator "Annex I, 5.5" ;
    pa:quote "The braking system of machinery intended for use in underground workings must be designed and constructed in such a way that it does not produce sparks or cause fires." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_cause_fires .

pa:st-1441 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_1_1_mechanical_strength ;
    pa:condition "machinery intended for lifting persons or persons and goods" ;
    pa:locator "Annex I, 6.1.1" ;
    pa:quote "Machinery intended for lifting persons or persons and goods must be fitted with a suspension or supporting system for the carrier designed and constructed in such a way as to ensure an adequate overall level of safety and to prevent the risk of the carrier falling." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_the_risk_of_the_carrier_falling .

pa:st-1442 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_machinery_for_lifting_persons_or_persons_and_goods ;
    pa:condition "machinery intended for lifting persons or persons and goods must be fitted" ;
    pa:locator "Annex I, 6.1.1" ;
    pa:quote "Machinery intended for lifting persons or persons and goods must be fitted with a suspension or supporting system for the carrier designed and constructed in such a way as to ensure an adequate overall level of safety and to prevent the risk of the carrier falling." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_a_suspension_or_supporting_system_for_the_carrier .

pa:st-1443 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_suspended_by_ropes_or_chains ;
    pa:condition "if ropes or chains are used to suspend the carrier, as a general rule" ;
    pa:locator "Annex I, 6.1.1" ;
    pa:quote "If ropes or chains are used to suspend the carrier, as a general rule, at least two independent ropes or chains are required, each with its own anchorage." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_at_least_two_independent_ropes_or_chains .

pa:st-1445 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_loading_control_for_machinery_moved_by_power_other_than_huma ;
    pa:condition "unless the manufacturer can demonstrate that there is no risk of overloading or overturning" ;
    pa:locator "Annex I, 6.1.2" ;
    pa:quote "Loading control for machinery moved by power other than human strength The requirements of section 4.2.2 apply regardless of the maximum working load and overturning moment, unless the manufacturer can demonstrate that there is no risk of overloading or overturning." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_Loading_control_for_machinery_moved_by_power .

pa:st-1447 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_control_devices_for_upward_and_downward_movements ;
    pa:condition "Where safety requirements do not impose other solutions" ;
    pa:locator "Annex I, 6.2" ;
    pa:quote "CONTROL DEVICES Where safety requirements do not impose other solutions, the carrier must, as a general rule, be designed and constructed in such a way that persons in the carrier have means of controlling upward and downward movements and, if appropriate, other movements of the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_means_of_controlling_upward_and_downward_movements .

pa:st-1448 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_for_carrier_movements ;
    pa:condition "with the exception of emergency stop devices" ;
    pa:locator "Annex I, 6.2" ;
    pa:quote "In operation, those control devices must override any other devices controlling the same movement with the exception of emergency stop devices." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_override_any_other_devices .

pa:st-1449 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_control_devices_for_carrier_movements ;
    pa:condition "except where the carrier itself is completely enclosed" ;
    pa:locator "Annex I, 6.2" ;
    pa:quote "The control devices for these movements must be of the hold-to-run type except where the carrier itself is completely enclosed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_hold_to_run_type .

pa:st-1451 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_1 ;
    pa:locator "Annex I, 6.3.1" ;
    pa:quote "6.3.1. Risks due to movements of the carrier Machinery for lifting persons must be designed, constructed or equipped in such a way that the acceleration or deceleration of the carrier does not engender risks for persons." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risks_due_to_movements_of_the_carrier .

pa:st-1452 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier ;
    pa:locator "Annex I, 6.3.2" ;
    pa:quote "Risk of persons falling from the carrier The carrier must not tilt to an extent which creates a risk of the occupants falling, including when the machinery and carrier are moving." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_risk_of_the_occupants_falling .

pa:st-1453 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_designed_as_a_work_station ;
    pa:condition "Where the carrier is designed as a work station" ;
    pa:locator "Annex I, 6.3.2" ;
    pa:quote "Where the carrier is designed as a work station, provision must be made to ensure stability and to prevent hazardous movements." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_provision_must_be_made_to_ensure_stability .

pa:st-1454 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carriers ;
    pa:condition "If the measures referred to in section 1.5.15 are not adequate" ;
    pa:locator "Annex I, 6.3.2" ;
    pa:quote "If the measures referred to in section 1.5.15 are not adequate, carriers must be fitted with a sufficient number of suitable anchorage points for the number of persons permitted on the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_sufficient_number_of_suitable_anchorage_points .

pa:st-1455 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_anchorage_points ;
    pa:locator "Annex I, 6.3.2" ;
    pa:quote "The anchorage points must be strong enough for the use of personal protective equipment against falls from a height." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_strong_enough_for_the_use_of_personal_protective_equipment .

pa:st-1456 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_trapdoors_in_floors_or_ceilings_or_side_doors ;
    pa:locator "Annex I, 6.3.2" ;
    pa:quote "Any trapdoor in floors or ceilings or side doors must be designed and constructed in such a way as to prevent inadvertent opening and must open in a direction that obviates any risk of falling, should they open unexpectedly." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_designed_and_constructed_in_such_a_way_as_to_prevent_inadver .

pa:st-1458 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_3 ;
    pa:condition "Where there is a risk of objects falling on the carrier and endangering persons" ;
    pa:locator "Annex I, 6.3.3" ;
    pa:quote "Risk due to objects falling on the carrier Where there is a risk of objects falling on the carrier and endangering persons, the carrier must be equipped with a protective roof." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_Risk_due_to_objects_falling_on_the_carrier .

pa:st-1459 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_3_3 ;
    pa:condition "Where there is a risk of objects falling on the carrier and endangering persons" ;
    pa:locator "Annex I, 6.3.3" ;
    pa:quote "Risk due to objects falling on the carrier Where there is a risk of objects falling on the carrier and endangering persons, the carrier must be equipped with a protective roof." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_protective_roof .

pa:st-1460 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_serving_fixed_landings ;
    pa:locator "Annex I, 6.4" ;
    pa:quote "6.4. MACHINERY SERVING FIXED LANDINGS" ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_6_4 .

pa:st-1461 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_risks_to_persons_in_or_on_the_carrier ;
    pa:locator "Annex I, 6.4.1" ;
    pa:quote "Risks to persons in or on the carrier The carrier must be designed and constructed in such a way as to prevent risks due to contact between persons and/or objects in or on the carrier with any fixed or moving elements." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Risk_contact_between_persons_and_or_objects .

pa:st-1462 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_enclosure ;
    pa:condition "Where necessary in order to fulfil this requirement" ;
    pa:locator "Annex I, 6.4.1" ;
    pa:quote "Where necessary in order to fulfil this requirement, the carrier itself must be completely enclosed with doors fitted with an interlocking device that prevents hazardous movements of the carrier unless the doors are closed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_doors_fitted_with_an_interlocking_device .

pa:st-1463 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_carrier_doors ;
    pa:condition "if the carrier stops between landings where there is a risk of falling from the carrier" ;
    pa:locator "Annex I, 6.4.1" ;
    pa:quote "The doors must remain closed if the carrier stops between landings where there is a risk of falling from the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_doors_must_remain_closed .

pa:st-1464 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_uncontrolled_upward_or_downward_movement_of_the_carrier ;
    pa:condition "where necessary" ;
    pa:locator "Annex I, 6.4.1" ;
    pa:quote "The machinery must be designed, constructed and, where necessary, equipped with devices in such a way as to prevent uncontrolled upward or downward movement of the carrier." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_devices .

pa:st-1465 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_stopping_of_the_carrier ;
    pa:condition "at its maximum working load and at the foreseeable maximum speed" ;
    pa:locator "Annex I, 6.4.1" ;
    pa:quote "These devices must be able to stop the carrier at its maximum working load and at the foreseeable maximum speed." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_able_to_stop_the_carrier .

pa:st-1467 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_controls_at_landings_6_4_2 ;
    pa:condition "other than those for emergency use; when: the control devices in the carrier are being operated, the carrier is not at a landing" ;
    pa:locator "Annex I, 6.4.2" ;
    pa:quote "Controls at landings Controls, other than those for emergency use, at landings must not initiate movements of the carrier when: — the control devices in the carrier are being operated, — the carrier is not at a landing." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_must_not_initiate_movements .

pa:st-1469 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_6_4_3_access_to_the_carrier ;
    pa:condition "taking into consideration the foreseeable range of goods and persons to be lifted" ;
    pa:locator "Annex I, 6.4.3" ;
    pa:quote "Access to the carrier The guards at the landings and on the carrier must be designed and constructed in such a way as to ensure safe transfer to and from the carrier, taking into consideration the foreseeable range of goods and persons to be lifted." ;
    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ProtectiveMeasure_guards_at_the_landings_and_on_the_carrier .

pa:st-1472 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EC_declaration_of_conformity ;
    pa:condition "drawn up under the same conditions as the instructions (see Annex I, section 1.7.4.1(a) and (b))" ;
    pa:locator "Annex II, 1" ;
    pa:quote "EC DECLARATION OF CONFORMITY OF THE MACHINERY This declaration and translations thereof must be drawn up under the same conditions as the instructions (see Annex I, section 1.7.4.1(a) and (b)), and must be typewritten or else handwritten in capital letters." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be typewritten or else handwritten in capital letters" .

pa:st-1473 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EC_declaration_of_conformity ;
    pa:locator "Annex II, 1" ;
    pa:quote "The EC declaration of conformity must contain the following particulars:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must contain the following particulars" .

pa:st-1474 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_person_authorised_to_compile_the_technical_file ;
    pa:locator "Annex II, 1" ;
    pa:quote "name and address of the person authorised to compile the technical file, who must be established in the Community;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "who must be established in the Community" .

pa:st-1475 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EC_declaration_of_conformity ;
    pa:locator "Annex II, 1" ;
    pa:quote "These references must be those of the texts published in the Official Journal of the European Union;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be those of the texts published in the Official Journal of the European Union" .

pa:st-1476 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EC_declaration_of_conformity ;
    pa:locator "Annex II, 1" ;
    pa:quote "the place and date of the declaration;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the place and date of the declaration" .

pa:st-1477 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_EC_declaration_of_conformity ;
    pa:condition "the person empowered to draw up the declaration on behalf of the manufacturer or his authorised representative" ;
    pa:locator "Annex II, 1" ;
    pa:quote "the identity and signature of the person empowered to draw up the declaration on behalf of the manufacturer or his authorised representative." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the identity and signature" .

pa:st-1478 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_declaration_of_incorporation_of_partly_completed_machinery ;
    pa:locator "Annex II, 1" ;
    pa:quote "The declaration of incorporation must contain the following particulars:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must contain the following particulars" .

pa:st-1479 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_partly_completed_machinery ;
    pa:condition "in response to a reasoned request by the national authorities" ;
    pa:locator "Annex II, 1" ;
    pa:quote "an undertaking to transmit, in response to a reasoned request by the national authorities, relevant information on the partly completed machinery. This shall include the method of transmission and shall be without prejudice to the intellectual property rights of the manufacturer of the partly completed machinery;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "an undertaking to transmit" .

pa:st-1480 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_partly_completed_machinery ;
    pa:condition "until the final machinery into which it is to be incorporated has been declared in conformity with the provisions of this Directive, where appropriate" ;
    pa:locator "Annex II, 1" ;
    pa:quote "a statement that the partly completed machinery must not be put into service until the final machinery into which it is to be incorporated has been declared in conformity with the provisions of this Directive, where appropriate;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must not be put into service" .

pa:st-1482 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_original_EC_declaration_of_conformity ;
    pa:locator "Annex II, 2" ;
    pa:quote "CUSTODY The manufacturer of machinery or his authorised representative shall keep the original EC declaration of conformity for a period of at least 10 years from the last date of manufacture of the machinery." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DIR" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-1483 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_original_declaration_of_incorporation ;
    pa:locator "Annex II, 2" ;
    pa:quote "The manufacturer of partly completed machinery or his authorised representative shall keep the original declaration of incorporation for a period of at least 10 years from the last date of manufacture of the partly completed machinery." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DIR" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-1485 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_authorised_representative ;
    pa:locator "Annex III" ;
    pa:quote "The CE marking must be affixed in the immediate vicinity of the name of the manufacturer or his authorised representative, using the same technique." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be affixed in the immediate vicinity" .

pa:st-1486 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_CE_marking ;
    pa:condition "Where the full quality assurance procedure referred to in Article 12(3)(c) and 12(4)(b) has been applied" ;
    pa:locator "Annex III" ;
    pa:quote "Where the full quality assurance procedure referred to in Article 12(3)(c) and 12(4)(b) has been applied, the CE marking must be followed by the identification number of the notified body." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be followed by the identification number of the notified body" .

