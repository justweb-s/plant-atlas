pa:Provision_Scan_cycle_time a pa:Provision ;
    rdfs:label "Scan cycle time" ;
    pa:definedAs "the time the sensor needs for a complete scan of its detection area" .

pa:Provision_Spazio_Massimo a pa:Provision ;
