    pa:locator "Annex III" ;
    pa:quote "(c) ‘exposed person’ means any person wholly or partially in a danger zone;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any person wholly or partially in a danger zone" .

pa:st-0417 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_operator ;
    pa:locator "Annex III" ;
    pa:quote "(d) ‘operator’ means the person or persons installing, operating, adjusting, maintaining, cleaning, repairing or moving machinery or a related product;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "the person or persons installing, operating, adjusting" .

pa:st-0418 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_hazard ;
    pa:locator "Annex III" ;
    pa:quote "(a) ‘hazard’ means a potential source of injury or damage to health;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a potential source of injury or damage to health" .

pa:st-0419 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_risk ;
    pa:locator "Annex III" ;
    pa:quote "(e) ‘risk’ means a combination of the probability and the degree of an injury or damage to health that can arise in a hazardous situation;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a combination of the probability and the degree of an injury" .

pa:st-0420 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_guard ;
    pa:locator "Annex III" ;
    pa:quote "(f) ‘guard’ means a part of machinery or a related product used specifically to provide protection by means of a physical barrier;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "by means of a physical barrier" .

pa:st-0421 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_protective_device ;
    pa:locator "Annex III" ;
    pa:quote "(g) ‘protective device’ means a device (other than a guard) which reduces the risk, either alone or in conjunction with a guard;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "a device (other than a guard) which reduces the risk" .

