    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_lubrificazione_del_mandrino_e_della_cremagliera ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "CAVI DI ALIMENTAZIONE ELETTRICA GIORNALIERA OPERATORE Ispezione visiva VERIFICA INTEGRITA’ UTENSILE (*) GIORNALIERA OPERATORE Ispezione visiva LUBRIFICAZIONE DEL MANDRINO E DELLA CREMAGLIERA SETTIMANALE OPERATORE Istruzioni manuale – annotare su RC VERIFICA TENSIONE DELLE CINGHIE SETTIMANALE OPERATORE Istruzioni" ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "unict-guideline" ;
