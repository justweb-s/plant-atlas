pa:EconomicOperator_attrezzature_di_lavoro a pa:EconomicOperator ;
    rdfs:label "attrezzature di lavoro" ;
    pa:hasObligation "assoggettate alle misure di aggiornamento dei requisiti minimi di sicurezza",
        "installate ed utilizzate in conformità alle istruzioni d'uso",
        "oggetto di idonea manutenzione" .

pa:EconomicOperator_authorised_representative a pa:EconomicOperator ;
    rdfs:label "authorised representative" ;
