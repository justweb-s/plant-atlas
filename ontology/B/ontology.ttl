    pa:relation pa:requiresMeasure ;
    pa:sourceDocument "REG" ;
    pa:value pa:ProtectiveMeasure_by_information_given_on_the_elements_to_be_connected_and_whe .

pa:st-0571 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:locator "Annex III, 1.5.5" ;
    pa:quote "Extreme temperatures Steps shall be taken to eliminate any risk of injury arising from contact with or proximity to machinery or related product parts or materials at high or very low temperatures." ;
    pa:relation pa:addressesRisk ;
    pa:sourceDocument "REG" ;
    pa:value pa:Risk_risk_of_injury_arising_from_contact .

pa:st-0572 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EssentialRequirement_essential_requirement_1_5_5 ;
    pa:locator "Annex III, 1.5.5" ;
    pa:quote "Extreme temperatures Steps shall be taken to eliminate any risk of injury arising from contact with or proximity to machinery or related product parts or materials at high or very low temperatures." ;
    pa:relation pa:requiresMeasure ;
