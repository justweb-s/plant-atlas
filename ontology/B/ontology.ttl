pa:guidance-st-0078 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_richiesta_di_prima_verifica_periodica ;
    pa:layer "guidance" ;
    pa:locator "p. 29" ;
    pa:quote "tale richiesta deve in ogni caso riportare obbligatoriamente: - indirizzo completo presso cui si trova l’attrezzatura di lavoro; - dati fiscali del datore di lavoro (sede legale, codice fiscale, partita Iva)" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "inail-guide" ;
    pa:value "tale richiesta deve in ogni caso riportare obbligatoriamente" .

pa:guidance-st-0079 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:PeriodicVerification_richiesta_di_prima_verifica_periodica ;
    pa:layer "guidance" ;
    pa:locator "p. 29" ;
    pa:quote "Almeno 45 giorni prima della scadenza prescritta dal legislatore, il datore di la- voro deve provvedere alla richiesta di prima verifica periodica all’Unità operativa territoriale dell’Inail competente, adottando la modulistica disponibile sul portale dell’Inail;" ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "inail-guide" ;
    pa:value "P45D"^^xsd:duration .

pa:guidance-st-0080 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:PeriodicVerification_prima_verifica_periodica ;
    pa:layer "guidance" ;
    pa:locator "p. 29" ;
    pa:quote "La prima verifica periodica deve essere effettuata entro 45 giorni dalla data di ricevimento della richiesta completa, può essere condotta da personale dell’Inail ovvero su incarico dell’Inail dal soggetto abilitato indicato dal datore di lavoro nella richiesta;" ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "inail-guide" ;
    pa:value "P45D"^^xsd:duration .

pa:guidance-st-0081 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
