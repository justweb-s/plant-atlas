    pa:quote "GLOSSARY 18 Resolution The resolution of an active opto-electronic protective device (also known as the sensor detection capability) is the minimum size of an object for it to be reliably detected." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "the minimum size of an object for it to be reliably detected" .

pa:manufacturer-st-0618 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Provision_Safety_function ;
    pa:layer "manufacturer" ;
    pa:locator "p. 147" ;
    pa:quote "Safety function Function of a machine whose failure can result in an immediate increase of the risk(s)." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "Function of a machine whose failure can result in an immediate increase of the risk(s)" .

pa:manufacturer-st-0619 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Provision_Restart_interlock ;
    pa:layer "manufacturer" ;
    pa:locator "p. 147" ;
    pa:quote "Restart interlock The restart interlock prevents the machine from automatically starting up, for example after a protective device has responded while the machine is operating or after changing the machine’s operating mode." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "prevents the machine from automatically starting up" .

pa:manufacturer-st-0620 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Provision_Scan_cycle_time ;
    pa:layer "manufacturer" ;
    pa:locator "p. 147" ;
    pa:quote "Scan cycle time The scan cycle time is the time the sensor needs for a complete scan of its detection area." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "the time the sensor needs for a complete scan of its detection area" .

pa:manufacturer-st-0621 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_nanoScan3 ;
    pa:layer "manufacturer" ;
    pa:locator "p. 149" ;
    pa:quote "ANNEX 19 19 Annex 19.1 Conformities and certificates You can obtain declarations of conformity, certificates, and the current operating instructions for the product at www.sick.com." ;
    pa:relation pa:hasDeclaration ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value pa:Document_declarations_of_conformity .

pa:manufacturer-st-0622 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:EconomicOperator_manufacturers_or_installers ;
    pa:condition "However, these depend on the specific appli- cation (the requirements of which must be reviewed by the manufacturer or installer)" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 149" ;
    pa:quote "19.4 Checklist for initial commissioning and commissioning Checklist for manufacturers or installers for installing electro-sensitive protective device (ESPE) The details relating to the items listed below must be available no later than when the system is commissioned for the first time. However, these depend on the specific appli- cation (the requirements of which must be reviewed by the manufacturer or installer)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "must be available no later than when the system is commissioned for the first time" .

pa:manufacturer-st-0623 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:EconomicOperator_manufacturers_or_installers ;
    pa:layer "manufacturer" ;
    pa:locator "p. 149" ;
    pa:quote "This checklist should be retained and kept with the machine documentation to serve as reference during recurring tests." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "should be retained and kept with the machine documentation" .

pa:manufacturer-st-0625 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:Machine_lift ;
    pa:condition "Non-compliance" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 7" ;
    pa:quote "Non-compliance invalidates the declaration of conformity." ;
    pa:relation pa:hasDeclaration ;
    pa:sourceDocument "mastar-manual" ;
    pa:value pa:Document_declaration_of_conformity .

pa:manufacturer-st-0627 a pa:Statement ;
