        "richiesta di verifica periodica successiva",
        "ridurre al minimo i rischi connessi all'uso delle attrezzature di lavoro" .

pa:Integrator a owl:Class ;
    rdfs:comment "Who builds the machine into a complete application or cell and answers for the result."@en .

pa:hasStoppingLimit a owl:ObjectProperty ;
    rdfs:comment "a stopping time, stopping distance, response time or safety limit with its unit"@en ;
    rdfs:domain pa:Machine ;
    rdfs:range pa:Quantity .

