        pa:Document_assembly_instructions,
        pa:Document_assembly_instructions_and_the_declaration_of_incorporation .

pa:ProtectiveMeasure_control_device a pa:ProtectiveMeasure ;
    rdfs:label "control device" .

pa:EconomicOperator_manufacturer_or_authorised_representative a pa:EconomicOperator ;
    rdfs:label "manufacturer or authorised representative" ;
    pa:hasObligation "eliminate or reduce risks as far as possible",
        "ensure that it satisfies the relevant essential health and safety requirements",
        "ensure that the technical file referred to in Annex VII, part A is available",
        "envisage not only the intended use",
        "inform users of the residual risks",
        "must be affixed in the immediate vicinity",
        "must ensure",
        "perform the appropriate tests or have such tests performed",
        "take the necessary protective measures in relation to risks that cannot be eliminated" .

pa:verifiedBy a owl:ObjectProperty ;
    rdfs:comment "who carries out a verification or check"@en ;
    rdfs:domain pa:PeriodicVerification ;
    rdfs:range pa:VerifyingBody .

pa:Document_instructions_for_use a pa:Document ;
    rdfs:label "instructions for use" .

pa:VerifyingBody a owl:Class ;
    rdfs:comment "The body that carries out a verification (e.g. INAIL, ASL, an authorised body)."@en .

pa:appliesFrom a owl:DatatypeProperty ;
    rdfs:comment "the date from which an act or a provision applies"@en ;
    rdfs:domain pa:Act ;
    rdfs:range xsd:date .

