pa:company-st-0056 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:EconomicOperator_attrezzature_di_lavoro_messe_a_disposizione_dei_lavoratori ;
    pa:condition "Salvo quanto previsto al comma 2" ;
    pa:layer "company" ;
    pa:locator "p. 16" ;
    pa:quote "Salvo quanto previsto al comma 2, le attrezzature di lavoro messe a disposizione dei lavoratori devono essere conformi alle specifiche disposizioni legislative e regolamentari di recepimento delle direttive comunitarie di prodotto." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "devono essere conformi alle specifiche disposizioni legislative e regolamentari di recepimento delle direttive comunitarie di prodotto" .

pa:company-st-0057 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:EconomicOperator_attrezzature_di_lavoro_costruite_in_assenza_di_disposizioni_ ;
    pa:layer "company" ;
    pa:locator "p. 16" ;
    pa:quote "Le attrezzature di lavoro costruite in assenza di disposizioni legislative e regolamentari di cui al comma 1, e quelle messe a disposizione dei lavoratori antecedentemente all’emanazione di norme legislative e regolamentari di recepimento delle direttive comunitarie di prodotto, devono essere conformi ai requisiti generali di sicurezza di cui all’ALLEGATO V." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "devono essere conformi ai requisiti generali di sicurezza di cui all’ALLEGATO V" .

