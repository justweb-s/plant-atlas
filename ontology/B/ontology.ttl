pa:guidance-st-0137 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:layer "guidance" ;
    pa:locator "p. 41" ;
    pa:quote "Il modulo deve essere presentato da parte del datore di lavoro, o suo delegato16, all’Unità operativa territoriale competente in base al luogo di utilizzo/installazio- ne dell’attrezzatura, tramite Pec (o attraverso i servizi online prossimamente di- sponibili sul portale dell’Inail)." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "inail-guide" ;
    pa:value "deve essere presentato da parte del datore di lavoro" .

pa:guidance-st-0138 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:PeriodicVerification_prima_verifica_periodica ;
    pa:condition "delegato dall’Inail" ;
    pa:layer "guidance" ;
    pa:locator "p. 41" ;
    pa:quote "81” (se la prima verifica periodica viene condotta da personale dell’Inail) ovvero pari al 15% (se la prima verifica periodica viene eseguita dal soggetto abilitato indicato dal datore di lavoro nella richiesta e delegato dall’Inail)." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:VerifyingBody_soggetto_abilitato_indicato_dal_datore_di_lavoro .

pa:guidance-st-0139 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Employer_attrezzatura_di_lavoro ;
    pa:condition "fino alla dismissione" ;
    pa:layer "guidance" ;
    pa:locator "p. 41" ;
    pa:quote "Scheda tecnica e verbale devono accompagnare l’attrezzatura di lavoro fino alla dismissione." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:Register_Scheda_tecnica_e_verbale .

pa:guidance-st-0140 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:EconomicOperator_delega ;
    pa:layer "guidance" ;
    pa:locator "p. 41" ;
    pa:quote "16 La delega deve essere accompagnata da copia del documento d’identità del datore di lavoro." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "inail-guide" ;
    pa:value "deve essere accompagnata da copia del documento d’identità" .

pa:guidance-st-0142 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:PeriodicVerification_verifica_periodica ;
    pa:condition "Laddove trascorrano inutilmente i 45 giorni dalla richiesta completa" ;
    pa:layer "guidance" ;
    pa:locator "p. 42" ;
    pa:quote "Laddove trascorrano inutilmente i 45 giorni dalla richiesta completa, il datore di lavoro può richiedere l’intervento di un soggetto pubblico o privato abilitato nella regione di utilizzo/installazione dell’attrezzatura." ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "inail-guide" ;
    pa:value "P45D"^^xsd:duration .

pa:guidance-st-0143 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:PeriodicVerification_verifica_periodica ;
    pa:condition "Laddove trascorrano inutilmente i 45 giorni dalla richiesta completa" ;
    pa:layer "guidance" ;
    pa:locator "p. 42" ;
    pa:quote "Laddove trascorrano inutilmente i 45 giorni dalla richiesta completa, il datore di lavoro può richiedere l’intervento di un soggetto pubblico o privato abilitato nella regione di utilizzo/installazione dell’attrezzatura." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:VerifyingBody_soggetto_pubblico_o_privato_abilitato .

pa:guidance-st-0145 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_ponte_sollevatore_per_veicoli ;
    pa:condition "purché venga appurato dallo stesso fabbricante che l’esemplare sia in tutto identico a quello riconosciuto idoneo o vengano apportate le modifiche necessarie a renderlo tale" ;
    pa:layer "guidance" ;
    pa:locator "p. 43" ;
    pa:quote "La stessa dichiarazione di conformità al prototipo può essere fornita dal fabbricante agli utilizzatori di esemplari già consegnati, purché venga appurato dallo stesso fabbricante che l’esemplare sia in tutto identico a quello riconosciuto idoneo o vengano apportate le modifiche necessarie a renderlo tale." ;
    pa:relation pa:hasDeclaration ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:Document_dichiarazione_di_conformit_al_prototipo .

pa:guidance-st-0147 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:PeriodicVerification_ponte_sollevatore_per_la_revisione_dei_veicoli ;
    pa:layer "guidance" ;
    pa:locator "p. 44" ;
    pa:quote "A seguito del buon esito delle operazioni di verifica, l’Inail provvede a rila- sciare il certificato di riconoscimento d’idoneità, una copia del quale viene inviata anche al Ministero delle infrastrutture e dei trasporti." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:VerifyingBody_Inail .

pa:guidance-st-0148 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_ponte_sollevatore_per_la_revisione_dei_veicoli ;
    pa:condition "Nel primo caso" ;
    pa:layer "guidance" ;
    pa:locator "p. 44" ;
    pa:quote "Nel primo caso l’attività di riconoscimento consiste nell’esame del prototipo presso il fabbricante e il riconoscimento si estende in questo caso all’intera serie; il fabbricante provvederà poi a rilasciare a tutti gli utenti un certificato di conformità del singolo esemplare al prototipo riconosciu- to idoneo dall’Inail." ;
    pa:relation pa:hasDeclaration ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:Document_certificato_di_conformit_del_singolo_esemplare .

pa:guidance-st-0149 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:EconomicOperator_fabbricante_di_ponti_sollevatori_per_veicoli ;
    pa:condition "Nel primo caso" ;
    pa:layer "guidance" ;
    pa:locator "p. 44" ;
    pa:quote "Nel primo caso l’attività di riconoscimento consiste nell’esame del prototipo presso il fabbricante e il riconoscimento si estende in questo caso all’intera serie; il fabbricante provvederà poi a rilasciare a tutti gli utenti un certificato di conformità del singolo esemplare al prototipo riconosciu- to idoneo dall’Inail." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "inail-guide" ;
    pa:value "provvederà poi a rilasciare a tutti gli utenti un certificato di conformità del singolo esemplare" .

pa:guidance-st-0150 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_ponte_sollevatore_per_veicoli_di_massa_superiore_a_3_5_t ;
    pa:condition "per quelli utilizzati per la revisione di veicoli di massa superiore a 3.5 t" ;
    pa:layer "guidance" ;
    pa:locator "p. 44" ;
    pa:quote "628 e alle prescrizioni del decreto direttoriale, prot. R.D. 202 del 21 maggio 2013 del Ministero delle infrastrutture e dei trasporti - Direzio- ne generale per la motorizzazione per quelli utilizzati per la revisione di veicoli di massa superiore a 3.5 t." ;
    pa:relation pa:conformsToStandard ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:Standard_decreto_direttoriale_prot .

pa:guidance-st-0152 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_ponte_sollevatore ;
    pa:layer "guidance" ;
    pa:locator "p. 45" ;
    pa:quote "• copia della dichiarazione di conformità del ponte sollevatore;" ;
    pa:relation pa:hasDeclaration ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:Document_dichiarazione_di_conformit .

pa:guidance-st-0153 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_dispositivo_prova_giochi_e_dispositivo_di_sollevamento_assi ;
    pa:condition "ove non integrati nel ponte" ;
    pa:layer "guidance" ;
    pa:locator "p. 45" ;
    pa:quote "• dichiarazione di conformità del dispositivo prova giochi e del dispositivo di sol- levamento assi (ove non integrati nel ponte);" ;
    pa:relation pa:hasDeclaration ;
    pa:sourceDocument "inail-guide" ;
    pa:value pa:Document_dichiarazione_di_conformit .

pa:guidance-st-0155 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_isola_robotizzata ;
    pa:layer "guidance" ;
    pa:locator "p. 1" ;
    pa:quote "Per la particolarità dei robot, di compiere movimenti molto ampi, ad alta energia e velocità con avvio ed andamen- to del moto difficili da prevedere, tutta l’area attorno alla isola robotizzata deve essere delimitata in modo tale che dall’esterno non sia possibile venire a contatto con i suoi elementi pericolosi" ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "tutta l’area attorno alla isola robotizzata deve essere delimitata" .

pa:guidance-st-0156 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_isola_robotizzata ;
    pa:layer "guidance" ;
    pa:locator "p. 1" ;
    pa:quote "l’accesso a tale area deve poter avvenire solo quando tutte le macchine com- prese nell’isola sono in condizioni di sicurezza ." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "l’accesso a tale area deve poter avvenire solo quando" .

pa:guidance-st-0157 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Provision_Spazio_Protetto ;
    pa:layer "guidance" ;
    pa:locator "p. 1" ;
    pa:quote "Tale area è definita “Spazio Protetto”;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "Spazio Protetto" .

pa:guidance-st-0159 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Check_accesso_allo_spazio_protetto ;
    pa:layer "guidance" ;
    pa:locator "p. 2" ;
    pa:quote "• L’accesso allo spazio protetto è consentito solo al personale autorizzato che segue procedure definite come previsto ad esempio per la programmazione (vedi 2.4.16.7 “Programmazione”)." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "personale autorizzato che segue procedure definite" .

pa:guidance-st-0160 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Provision_Spazio_Massimo ;
    pa:layer "guidance" ;
    pa:locator "p. 2" ;
    pa:quote "• Spazio Massimo: è lo spazio che può essere coperto dalle varie parti in movimento del robot, comprendente anche eventuali dispositivi applicati alle sue estremità ed i pezzi manipolati." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "lo spazio che può essere coperto dalle varie parti in movimento del robot" .

pa:guidance-st-0161 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Provision_Spazio_Ristretto ;
    pa:layer "guidance" ;
    pa:locator "p. 2" ;
    pa:quote "• Spazio Ristretto: è una parte dello Spazio Massimo che può essere coperto solo dalle varie parti in movimento del robot." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "una parte dello Spazio Massimo che può essere coperto solo dalle varie parti in movimento del robot" .

pa:guidance-st-0162 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_robot ;
    pa:layer "guidance" ;
    pa:locator "p. 2" ;
    pa:quote "Per garantire che i movimenti del robot non vadano oltre tale spazio vi devono essere fermi meccanici o altri limitatori di corsa in grado di bloccarlo." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "vi devono essere fermi meccanici o altri limitatori di corsa in grado di bloccarlo" .

pa:guidance-st-0163 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_altre_macchine_pressa_piegatrice_punzonatrice ;
    pa:condition "a condizione che" ;
    pa:layer "guidance" ;
    pa:locator "p. 2" ;
    pa:quote "Altre macchine Le singole macchine, costruite per funzionare autonomamente e presenti all’interno dell’isola quali ad esempio pressa piegatrice, punzonatrice ecc., possono essere utilizzate a condizione che : • prima di entrare all’interno dello spazio protetto, il robot sia escluso tramite selettore a chiave (vedi 2.2.6.5 “Selettore modale di funzionamento);" ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "prima di entrare all’interno dello spazio protetto, il robot sia escluso tramite selettore a chiave" .

pa:guidance-st-0164 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_altre_macchine_pressa_piegatrice_punzonatrice ;
    pa:condition "a condizione che" ;
    pa:layer "guidance" ;
    pa:locator "p. 2" ;
    pa:quote "• il funzionamento della macchina possa avvenire solo con i suoi i dispositivi di sicurezza attivi o ripristinati nel caso fossero stati esclusi nel funzionamento automatico." ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "solo con i suoi i dispositivi di sicurezza attivi o ripristinati" .

pa:guidance-st-0166 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_comando_remoto ;
    pa:layer "guidance" ;
    pa:locator "p. 3" ;
    pa:quote "2.4.16.2a Comando remoto I comandi remoti (ad esempio tramite rete di comunicazione) devono poter comandare l’inizio ciclo della macchina solo quando le protezioni sono attive." ;
    pa:relation pa:putIntoServiceOnlyWhen ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "solo quando le protezioni sono attive" .

pa:guidance-st-0167 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_unit_portatile_del_robot ;
    pa:condition "comandati dalla unità portatile" ;
    pa:layer "guidance" ;
    pa:locator "p. 3" ;
    pa:quote "• tutti i movimenti del robot comandati dalla unità portatile devono essere a velocità lenta (ad esempio < 250 mm/sec)." ;
    pa:relation pa:hasStoppingLimit ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value pa:Quantity_250_mm_sec .

pa:guidance-st-0168 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_impianto_robotizzato ;
    pa:layer "guidance" ;
    pa:locator "p. 3" ;
    pa:quote "Riavviamento Inatteso Il riavviamento spontaneo (vedi 2.3 “Impianti elettrici delle macchine”) della macchina in seguito al ripristi- no dell’energia elettrica deve essere impedito tramite un apposito dispositivo." ;
    pa:relation pa:hasSafetyFunction ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value pa:SafetyFunction_Riavviamento_Inatteso .

pa:guidance-st-0170 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_macchina ;
    pa:layer "guidance" ;
    pa:locator "p. 4" ;
    pa:quote "Principali macchine Arresto di sicurezza La macchina deve disporre di un dispositivo di comando (vedi 2.2.6.3 “Arresto”) che consenta l’arresto in condizioni di sicurezza Arresto di emergenza Ogni macchina deve essere dotata di almeno un comando di arresto di emergenza (vedi 2.2.6.4 “Arresto d’emergenza”)" ;
    pa:relation pa:hasSafetyFunction ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value pa:SafetyFunction_almeno_un_comando_di_arresto_di_emergenza .

pa:guidance-st-0171 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_Arresto_di_emergenza ;
    pa:condition "o comunque come previsto dalla valutazione del rischio" ;
    pa:layer "guidance" ;
    pa:locator "p. 4" ;
    pa:quote "Arresto di Emergenza Arresto di Sicurezza Posizionamento Il comando deve essere collocato in modo Il comando deve essere collocato tenendo conto che l’operatore vi abbia un accesso libero e rapido del calcolo delle distanze di sicurezza Azionamento Manuale Automatico o manuale Prestazione di sicurezza In conformità alla Categoria 3 della Norma In conformità alla Categoria 3 della Norma ISO 13849-1:1999 3 o comunque come previsto ISO 13849-1:1999 3 o comunque come previsto dalla valutazione del rischio dalla valutazione del rischio Ripristino Solo manuale Automatico o manuale Frequenza d’uso Non frequente," ;
    pa:relation pa:hasSafetyFunction ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value pa:SafetyFunction_Categoria_3_della_Norma_ISO_13849_1_1999 .

pa:guidance-st-0172 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Machine_Arresto_di_sicurezza ;
    pa:condition "o comunque come previsto dalla valutazione del rischio" ;
    pa:layer "guidance" ;
    pa:locator "p. 4" ;
    pa:quote "alla Categoria 3 della Norma In conformità alla Categoria 3 della Norma ISO 13849-1:1999 3 o comunque come previsto ISO 13849-1:1999 3 o comunque come previsto dalla valutazione del rischio dalla valutazione del rischio Ripristino Solo manuale Automatico o manuale Frequenza d’uso Non frequente," ;
    pa:relation pa:hasSafetyFunction ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value pa:SafetyFunction_Categoria_3_della_Norma_ISO_13849_1_1999 .

pa:guidance-st-0174 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_isola_robotizzata ;
    pa:layer "guidance" ;
    pa:locator "p. 5" ;
    pa:quote "• La programmazione deve avvenire senza che nessuno si trovi all’interno dello spazio protetto." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "nessuno si trovi all’interno dello spazio protetto" .

pa:guidance-st-0175 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_isola_robotizzata ;
    pa:condition "a condizione che vengano automaticamente adottati altri criteri di sicurezza" ;
    pa:layer "guidance" ;
    pa:locator "p. 5" ;
    pa:quote "• Se ciò fosse impossibile, possono essere sospese provvisoriamente alcune protezioni a condizione che vengano automaticamente adottati altri criteri di sicurezza (unità portatile, ecc.) • Prima di entrare nello spazio protetto il programmatore deve verificare che tutte le protezioni siano presenti e funzionanti." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "sospese provvisoriamente alcune protezioni" .

pa:guidance-st-0176 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Check_unit_portatile ;
    pa:layer "guidance" ;
    pa:locator "p. 5" ;
    pa:quote "• Prima di utilizzare l’unità portatile questa deve essere provata per accertarne il corretto funzionamento." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "Prima di utilizzare l’unità portatile" .

pa:guidance-st-0177 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Check_isola_robotizzata_e_spazio_protetto ;
    pa:layer "guidance" ;
    pa:locator "p. 5" ;
    pa:quote "• Durante la programmazione si deve verificare visivamente l’isola robotizzata e lo spazio protetto per garantire che non sussistano condizioni di pericolo." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "Durante la programmazione" .

pa:guidance-st-0178 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:EconomicOperator_macchina ;
    pa:layer "guidance" ;
    pa:locator "p. 5" ;
    pa:quote "2.4.16.6 ISTRUZIONI PER L’USO La macchina deve essere corredata di manuale, in lingua italiana per il corretto uso e la manutenzione, com- prendente un programma d’ispezioni periodiche." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "deve essere corredata di manuale, in lingua italiana" .

pa:guidance-st-0180 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_isola_robotizzata ;
    pa:layer "guidance" ;
    pa:locator "p. 6" ;
    pa:quote "Principali macchine • Le operazioni di programmazione devono sempre avere inizio prima di entrare nello spazio protetto." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "devono sempre avere inizio prima di entrare nello spazio protetto" .

pa:guidance-st-0181 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_isola_robotizzata ;
    pa:condition "In fase di programmazione" ;
    pa:layer "guidance" ;
    pa:locator "p. 6" ;
    pa:quote "• In fase di programmazione solo il programmatore può essere presente all’interno dello spazio protetto • L’isola robotizzata deve essere sotto l’esclusivo comando del programmatore quando questi è all’interno dello spazio protetto." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "solo il programmatore può essere presente all’interno dello spazio protetto" .

pa:guidance-st-0182 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:RoboticCell_verifica_del_programma ;
    pa:layer "guidance" ;
    pa:locator "p. 6" ;
    pa:quote "• La verifica del programma deve avvenire senza persone presenti all’interno dello spazio protetto." ;
    pa:relation pa:safeguardedSpaceRule ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value "senza persone presenti all’interno dello spazio protetto" .

pa:guidance-st-0183 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Employer_programmi_eseguiti ;
    pa:layer "guidance" ;
    pa:locator "p. 6" ;
    pa:quote "• Deve essere conservata una registrazione dei programmi eseguiti comprensiva di tutte le modifiche apportate." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "robot-cell-sheet" ;
    pa:value pa:Register_registrazione_dei_programmi_eseguiti_comprensiva_di_tutte_le .

pa:guidance-st-0184 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:guidance" ;
    pa:about pa:Check_ripristino_delle_protezioni_disattivate ;
    pa:layer "guidance" ;
    pa:locator "p. 6" ;
    pa:quote "• Una volta completata la programmazione devono essere ripristinate tutte le protezioni eventualmente disattivate." ;
