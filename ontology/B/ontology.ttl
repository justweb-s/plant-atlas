pa:company-st-0024 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_pulizia_generale ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "manuale – annotare su RC LUBRIFICAZIONE DEI CUSCINETTI SEMESTRALE OPERATORE Istruzioni manuale – annotare su RC PULIZIA GENERALE SEMESTRALE OPERATORE Istruzioni manuale – annotare su RC SOSTITUZIONE PARTI (**) AL BISOGNO SPECIALIZZATO annotare su RC CONTROLLO GENERALE E VERIFICA IMPIANTO ELETTRICO V." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "P6M"^^xsd:duration .

pa:company-st-0025 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_interventi_di_manutenzione ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "CAVI DI ALIMENTAZIONE ELETTRICA GIORNALIERA OPERATORE Ispezione visiva VERIFICA INTEGRITA’ UTENSILE (*) GIORNALIERA OPERATORE Ispezione visiva LUBRIFICAZIONE DEL MANDRINO E DELLA CREMAGLIERA SETTIMANALE OPERATORE Istruzioni manuale – annotare su RC VERIFICA TENSIONE DELLE CINGHIE SETTIMANALE OPERATORE Istruzioni manuale – annotare su RC LUBRIFICAZIONE DEI CUSCINETTI SEMESTRALE OPERATORE Istruzioni manuale – annotare su RC PULIZIA GENERALE SEMESTRALE OPERATORE Istruzioni manuale – annotare su RC SOSTITUZIONE PARTI (**) AL BISOGNO SPECIALIZZATO annotare su RC CONTROLLO GENERALE E VERIFICA IMPIANTO ELETTRICO V." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_annotare_su_RC .

pa:company-st-0026 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_Trapano_a_colonna ;
    pa:condition "in funzione del tipo di utilizzo della macchina" ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "gli interventi manutentivi e le relative frequenze sono indicativi e possono anche variare in funzione del tipo di utilizzo della macchina. Modificarli secondo le indicazioni fornite dal costruttore nel Manuale d’uso e manutenzione." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "Modificarli secondo le indicazioni fornite dal costruttore nel Manuale d’uso e manutenzione" .

pa:company-st-0027 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_utensili_usurati ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "(*) Gli utensili usurati devono essere sostituiti con ricambi originali o compatibili indicati nel Manuale d’Uso e Manutenzione della macchina." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "sostituiti con ricambi originali o compatibili" .

pa:company-st-0028 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_pezzo_o_protezione_danneggiata ;
    pa:layer "company" ;
    pa:locator "p. 7" ;
    pa:quote "(**) Qualsiasi pezzo o qualsiasi protezione danneggiata deve essere riparata o sostituita da un centro di servizio postvendita autorizzato." ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "riparata o sostituita da un centro di servizio postvendita autorizzato" .

pa:company-st-0029 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Employer_sostituzione_di_parti_dispositivi_o_componenti_di_sicurezza ;
    pa:condition "Qualora l’intervento di manutenzione richieda la sostituzione di parti, dispositivi o componenti di sicurezza" ;
    pa:layer "company" ;
    pa:locator "p. 9" ;
    pa:quote "Qualora l’intervento di manutenzione richieda la sostituzione di parti, dispositivi o componenti di sicurezza, le singole sostituzioni devono essere registrate secondo gli schemi del Modello C." ;
    pa:relation pa:mustKeepRegister ;
    pa:sourceDocument "unict-guideline" ;
    pa:value pa:Register_registrate_secondo_gli_schemi_del_Modello_C .

pa:company-st-0031 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_componente_di_sicurezza_sostituito ;
    pa:layer "company" ;
    pa:locator "p. 10" ;
    pa:quote "D – SOSTITUZIONE DI PARTI E DI DISPOSITIVI E COMPONENTI DI SICUREZZA Componente sostituito Data Costruttore ricambio Motivo della sostituzione Il responsabile della sostituzione dichiara di aver verificato, dopo l’installazione, la perfetta efficienza del componente sostituito ed il ripristino delle condizioni di sicurezza originarie." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "dopo l’installazione" .

pa:company-st-0032 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:EconomicOperator_Appaltatore ;
    pa:layer "company" ;
    pa:locator "p. 11" ;
    pa:quote "Di conseguenza l'Appaltatore deve obbligatoriamente e senza alcuna richiesta ulteriore, oltre al canone pattuito, apportare tutte quelle riparazioni, modifiche, sostituzioni," ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "deve obbligatoriamente e senza alcuna richiesta ulteriore" .

pa:company-st-0033 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:EconomicOperator_Appaltatore ;
    pa:layer "company" ;
    pa:locator "p. 11" ;
    pa:quote "E) approvvigionamento di scorte necessarie a garantire la continuità del servizio quando determinate apparecchiature siano in assistenza per le necessarie riparazioni (microscopi, autoclavi, armadi etc.);" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "approvvigionamento di scorte necessarie a garantire la continuità del servizio" .

pa:company-st-0034 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_manutenzione_ordinaria ;
    pa:layer "company" ;
    pa:locator "p. 11" ;
    pa:quote "La manutenzione ordinaria dunque, comprende tutti gli interventi atti a mantenere il funzionamento delle attrezzature e delle apparecchiature in perfetta efficienza secondo la normativa vigente mediante il ricorso, in tutto o in parte, a mezzi, attrezzature, strumentazioni, riparazioni iniziali, ricambi," ;
    pa:relation pa:maintenanceRule ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "mantenere il funzionamento delle attrezzature e delle apparecchiature in perfetta efficienza secondo la normativa vigente" .

pa:company-st-0036 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_Cabina_a_rischio_biologico ;
    pa:layer "company" ;
    pa:locator "p. 12" ;
    pa:quote "Manutenzione annuale 1." ;
    pa:relation pa:requiresPeriodicCheck ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "P1Y"^^xsd:duration .

pa:company-st-0037 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:company" ;
    pa:about pa:Check_Test_di_efficacia_delle_guarnizioni_del_filtro_principale ;
    pa:layer "company" ;
    pa:locator "p. 12" ;
    pa:quote "Test di efficacia delle guarnizioni del filtro principale tramite DOP, dopo la sostituzione." ;
    pa:relation pa:requiresCheckAfter ;
    pa:sourceDocument "unict-guideline" ;
    pa:value "dopo la sostituzione" .

