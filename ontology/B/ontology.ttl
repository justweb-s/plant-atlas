    pa:about pa:ProtectiveDevice_nanoScan3 ;
    pa:condition "If there is sufficient space in front of the hazardous area" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 30" ;
    pa:quote "Calculating the supplement CRO → If there is sufficient space in front of the hazardous area, use CRO = 1,200 mm." ;
    pa:relation pa:minimumDistanceParameter ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value pa:Quantity_1_200_mm .

pa:manufacturer-st-0500 a pa:Statement ;
    prov:wasAttributedTo "strategy_b:manufacturer" ;
    pa:about pa:ProtectiveDevice_nanoScan3 ;
    pa:condition "If the result is CRO < 850 mm, then use CRO = 850 mm" ;
    pa:layer "manufacturer" ;
    pa:locator "p. 30" ;
    pa:quote "m If the result is CRO ≥ 850 mm, then use the calculated value as supplement C. m If the result is CRO < 850 mm, then use CRO = 850 mm (this value corresponds to an arm’s length and is valid as a minimum supplement to protect against reaching over)." ;
    pa:relation pa:minimumDistanceParameter ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value pa:Quantity_850_mm .

pa:manufacturer-st-0501 a pa:Statement ;
