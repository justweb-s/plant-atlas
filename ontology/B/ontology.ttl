pa:st-0415 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_danger_zone ;
    pa:locator "Annex III" ;
    pa:quote "(b) ‘danger zone’ means any zone within and/or around machinery or a related product in which a person is subject to a risk to his or her health or safety;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "REG" ;
    pa:value "any zone within and/or around machinery" .

pa:st-0416 a pa:Statement ;
