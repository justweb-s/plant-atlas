pa:Machinery a owl:Class ;
    rdfs:comment "Machinery or a related product placed on the market or used at work."@en .

pa:ConformityProcedure a owl:Class ;
    rdfs:comment "A conformity assessment procedure or module (A, B, C, G, H; internal checks; type-examination)."@en .

pa:retentionPeriod a owl:DatatypeProperty ;
    rdfs:comment "for how long a document or record must be kept, and by whom"@en ;
    rdfs:domain pa:Document ;
    rdfs:range xsd:duration .

pa:requiresProcedure a owl:ObjectProperty ;
    rdfs:comment "the conformity assessment procedure(s) or module(s) that apply to a category of machinery"@en ;
    rdfs:domain pa:MachineryCategory ;
    rdfs:range pa:ConformityProcedure .

pa:mustAccompany a owl:ObjectProperty ;
    rdfs:comment "what must accompany the machinery or product"@en ;
    rdfs:domain pa:Machinery ;
    rdfs:range pa:Document .

pa:Document a owl:Class ;
    rdfs:comment "A document that must exist: declaration, instructions, technical documentation, record."@en .

