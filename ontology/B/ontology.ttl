pa:EconomicOperator_Appaltatore a pa:EconomicOperator ;
    rdfs:label "Appaltatore" ;
    pa:hasObligation "approvvigionamento di scorte necessarie a garantire la continuità del servizio",
        "deve obbligatoriamente e senza alcuna richiesta ulteriore" .

pa:EconomicOperator_Distributors a pa:EconomicOperator ;
    rdfs:label "Distributors" ;
    pa:hasObligation "cooperate with that authority",
        "provide that authority with all the information and documentation" .

pa:EconomicOperator_EU_declaration_of_incorporation a pa:EconomicOperator ;
    rdfs:label "EU declaration of incorporation" ;
    pa:hasObligation "shall contain the identification of the Union legal acts concerned",
        "shall include a sentence declaring the conformity with such acts" .

pa:EconomicOperator_UR5e_robot a pa:EconomicOperator ;
    rdfs:label "UR5e robot" ;
    pa:hasObligation "Adhere to the requirements in ISO 10218-2",
        "Avoid using the robot" .

pa:EconomicOperator_applicant a pa:EconomicOperator ;
    rdfs:label "applicant" ;
    pa:hasObligation "shall inform the notified body which retains the technical file",
        "shall place at the disposal of the notified body a sample of the type" .

pa:EconomicOperator_attrezzature_di_lavoro_messe_a_disposizione_dei_lavoratori a pa:EconomicOperator ;
    rdfs:label "attrezzature di lavoro messe a disposizione dei lavoratori" ;
    pa:hasObligation "devono essere conformi alle specifiche disposizioni legislative",
        "devono essere conformi alle specifiche disposizioni legislative e regolamentari di recepimento delle direttive comunitarie di prodotto" .

pa:EconomicOperator_carrelli_semoventi_a_braccio_telescopico a pa:EconomicOperator ;
    rdfs:label "carrelli semoventi a braccio telescopico" ;
    pa:hasObligation "comunicazione di messa in servizio all’Unità operativa territoriale dell’Inail competente all’atto della messa in servizio",
        "specifichi le" .

pa:EconomicOperator_datore_di_lavoro_richiesta_di_prima_verifica_periodica a pa:EconomicOperator ;
    rdfs:label "datore di lavoro, richiesta di prima verifica periodica" ;
    pa:hasObligation "allegare copia di tale attestazione alla richiesta di prima verifica periodica",
        "tale richiesta deve in ogni caso riportare obbligatoriamente" .

pa:EconomicOperator_datore_di_lavoro_utilizzatore a pa:EconomicOperator ;
    rdfs:label "datore di lavoro utilizzatore" ;
    pa:hasObligation "apposita prescrizione a rimuovere tale situazione",
        "idonea disposizione in ordine alle modalità di uso in sicurezza" .

pa:EconomicOperator_delega a pa:EconomicOperator ;
    rdfs:label "delega" ;
    pa:hasObligation "deve essere accompagnata da copia del documento d’identità",
        "deve essere accompagnata da copia del documento d’identità del datore di lavoro" .

pa:EconomicOperator_distributor a pa:EconomicOperator ;
    rdfs:label "distributor" ;
    pa:hasObligation "shall inform the manufacturer or the importer as well as the market surveillance authorities",
        "shall not make the machinery or related product available on the market until it has been brought into conformity" .

pa:EconomicOperator_distributor_of_partly_completed_machinery a pa:EconomicOperator ;
    rdfs:label "distributor of partly completed machinery" ;
    pa:hasObligation "shall inform the manufacturer or the importer as well as the market surveillance authorities",
        "shall not make the partly completed machinery available on the market" .

pa:EconomicOperator_importer_or_distributor a pa:EconomicOperator ;
    rdfs:label "importer or distributor" ;
    pa:becomesManufacturer "where that importer or distributor places a product within the scope of this Regulation on the market under its name or trademark or modifies a product already placed on the market in such a way that compliance with the applicable requirements might be affected" ;
    pa:hasObligation "subject to the obligations of the manufacturer set out in Articles 10 and 11" .

pa:EconomicOperator_lavoratori_incaricati_dell_uso a pa:EconomicOperator ;
    rdfs:label "lavoratori incaricati dell'uso" ;
    pa:hasObligation "dispongano di ogni necessaria informazione e istruzione",
        "ricevano una formazione e un addestramento adeguati" .

pa:EconomicOperator_machinery_design a pa:EconomicOperator ;
    rdfs:label "machinery design" ;
    pa:hasObligation "prevent abnormal use",
        "take account of the constraints to which the operator is subject" .

pa:EconomicOperator_manufacturer_contact_address a pa:EconomicOperator ;
    rdfs:label "manufacturer contact address" ;
    pa:hasObligation "The address shall indicate a single point" .

pa:EconomicOperator_manufacturer_contact_details a pa:EconomicOperator ;
    rdfs:label "manufacturer contact details" ;
    pa:hasObligation "The contact details shall be in a language easily understood",
        "shall be in a language easily understood" .

pa:EconomicOperator_manufacturers_or_installers a pa:EconomicOperator ;
    rdfs:label "manufacturers or installers" ;
    pa:hasObligation "must be available no later than when the system is commissioned for the first time",
        "should be retained and kept with the machine documentation" .

pa:EconomicOperator_non_professional_user_modifying_machinery_for_own_use a pa:EconomicOperator ;
    rdfs:label "non-professional user modifying machinery for own use" ;
    pa:becomesManufacturer "shall not be considered to be a manufacturer" ;
    pa:hasObligation "shall not be subject to the obligations on the manufacturer set out in Article 10" .

pa:EconomicOperator_operator a pa:EconomicOperator ;
    rdfs:label "operator" ;
    pa:hasObligation "have facilities to check the operation of such warning devices at all times",
        "must be protected against the risk of exposure" .

pa:EconomicOperator_robot_application_operator a pa:EconomicOperator ;
    rdfs:label "robot application operator" ;
    pa:hasObligation "Inform users of the location of the emergency stop button(s)",
