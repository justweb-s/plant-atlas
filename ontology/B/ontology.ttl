    pa:layer "manufacturer" ;
    pa:locator "p. 37" ;
    pa:quote "PROJECT PLANNING 5 5.3.10.1 Protective field The protective field must be designed in such a way that it recognizes a person at the latest when he or she is at the minimum distance from the hazardous point." ;
    pa:relation pa:minimumDistanceRule ;
    pa:sourceDocument "nanoscan3-manual" ;
    pa:value "recognizes a person at the latest when he or she is at the minimum distance from the hazardous point" .

