pa:st-1503 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_falling_object_protective_structures_FOPS ;
    pa:layer "law" ;
    pa:locator "Annex V" ;
    pa:quote "15. Falling-object protective structures (FOPS)." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
