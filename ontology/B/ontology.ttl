    pa:quote "18. Roll-over protective structures (ROPS)." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "REG" ;
    pa:value pa:Provision_18 .

pa:st-0413 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_Falling_object_protective_structures_FOPS ;
    pa:layer "law" ;
