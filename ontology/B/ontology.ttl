pa:st-1504 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_power_operated_interlocking_movable_guards ;
    pa:condition "designed to be used as safeguards in machinery referred to in items 9, 10 and 11 of Annex IV" ;
    pa:locator "Annex V" ;
    pa:quote "3. Power-operated interlocking movable guards designed to be used as safeguards in machinery referred to in items 9, 10 and 11 of Annex IV." ;
    pa:relation pa:listedIn ;
    pa:sourceDocument "DIR" ;
    pa:value pa:Provision_Power_operated_interlocking_movable_guards .

pa:st-1507 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_relevant_technical_documentation_for_partly_completed_machin ;
    pa:locator "Annex VII" ;
    pa:quote "The relevant technical documentation must be available for at least 10 years following the date of manufacture of the partly completed machinery or, in the case of series manufacture, of the last unit produced, and on request presented to the competent authorities of the Member States." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DIR" ;
    pa:value "P10Y"^^xsd:duration .

pa:st-1508 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VII" ;
    pa:quote "The manufacturer must carry out necessary research and tests on components, fittings or the partly completed machinery to determine whether by its design or construction it is capable of being assembled and used safely." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must carry out necessary research and tests" .

pa:st-1509 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "for series manufacture" ;
    pa:locator "Annex VII" ;
    pa:quote "(b) for series manufacture, the internal measures that will be implemented to ensure that the partly completed machinery remains in conformity with the essential health and safety requirements applied." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "the internal measures that will be implemented" .

pa:st-1510 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_person_designated_in_the_declaration_for_incorporation ;
    pa:locator "Annex VII" ;
    pa:quote "It must be capable of being assembled and presented to the relevant authority by the person designated in the declaration for incorporation." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must be capable of being assembled and presented" .

pa:st-1512 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_or_his_authorised_representative ;
    pa:condition "For each representative type of the series in question" ;
    pa:locator "Annex VIII" ;
    pa:quote "For each representative type of the series in question, the manufacturer or his authorised representative shall draw up the technical file referred to in Annex VII, part A." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall draw up the technical file" .

pa:st-1513 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex VIII" ;
    pa:quote "The manufacturer must take all measures necessary in order that the manufacturing process ensures compliance of the manufactured machinery with the technical file referred to in Annex VII, part A, and with the requirements of this Directive." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must take all measures necessary" .

pa:st-1515 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_EC_type_examination ;
    pa:locator "Annex IX" ;
    pa:quote "ANNEX IX EC type-examination EC type-examination is the procedure whereby a notified body ascertains and certifies that a representative model of machinery referred to in Annex IV (hereafter named the type) satisfies the provisions of this Directive." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DIR" ;
    pa:value "the procedure whereby a notified body ascertains and certifies" .

pa:st-1516 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex IX" ;
    pa:quote "The manufacturer or his authorised representative must, for each type, draw up the technical file referred to in Annex VII, part A." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must, for each type, draw up the technical file" .

pa:st-1517 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_applicant ;
    pa:locator "Annex IX" ;
    pa:quote "Moreover, the applicant shall place at the disposal of the notified body a sample of the type." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall place at the disposal of the notified body a sample of the type" .

pa:st-1518 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_applicant ;
    pa:locator "Annex IX" ;
    pa:quote "The applicant shall inform the notified body which retains the technical file relating to the EC type-examination certificate of all modifications to the approved type." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall inform the notified body which retains the technical file" .

pa:st-1519 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_copy_of_certificate_technical_file_and_relevant_documents ;
    pa:locator "Annex IX" ;
    pa:quote "The manufacturer and the notified body shall retain a copy of this certificate, the technical file and all relevant documents for a period of 15 years from the date of issue of the certificate." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DIR" ;
    pa:value "P15Y"^^xsd:duration .

pa:st-1520 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_copy_of_certificate_technical_file_and_relevant_documents ;
    pa:locator "Annex IX" ;
    pa:quote "The manufacturer and the notified body shall retain a copy of this certificate, of the technical file and of all the relevant documents for a period of 15 years from the date of issue of the certificate." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DIR" ;
    pa:value "P15Y"^^xsd:duration .

pa:st-1521 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer_of_the_machinery ;
    pa:locator "Annex IX" ;
    pa:quote "The manufacturer of the machinery concerned has the ongoing responsibility of ensuring that the said machinery meets the corresponding state of the art." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "ensuring that the said machinery meets the corresponding state of the art" .

pa:st-1522 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:condition "In the event that the validity of the EC-type examination certificate is not renewed" ;
    pa:locator "Annex IX" ;
    pa:quote "In the event that the validity of the EC-type examination certificate is not renewed, the manufacturer shall cease the placing on the market of the machinery concerned." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall cease the placing on the market of the machinery concerned" .

pa:st-1523 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:MachineryCategory_machinery_referred_to_in_Annex_IV ;
    pa:locator "Annex X" ;
    pa:quote "ANNEX X Full quality assurance This Annex describes the conformity assessment of machinery referred to in Annex IV, manufactured using a full quality assurance system, and the procedure whereby a notified body assesses and approves the quality system and monitors its application." ;
    pa:relation pa:requiresProcedure ;
    pa:sourceDocument "DIR" ;
    pa:value pa:ConformityProcedure_full_quality_assurance .

pa:st-1524 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex X" ;
    pa:quote "The manufacturer must operate an approved quality system for design, manufacture, final inspection and testing, as specified in point 2, and shall be subject to the surveillance referred to in point 3." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "must operate an approved quality system" .

pa:st-1525 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_manufacturer ;
    pa:locator "Annex X" ;
    pa:quote "The manufacturer or his authorised representative shall inform the notified body which approved the quality system of any planned change to it." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DIR" ;
    pa:value "shall inform the notified body" .

pa:st-1526 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_periodic_audits ;
    pa:locator "Annex X" ;
    pa:quote "The notified body shall conduct periodic audits to make sure that the manufacturer is maintaining and applying the quality system;" ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DIR" ;
    pa:value pa:VerifyingBody_The_notified_body .

pa:st-1527 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_full_reassessment ;
    pa:locator "Annex X" ;
    pa:quote "The frequency of the periodic audits shall be such that a full reassessment is carried out every three years." ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "DIR" ;
    pa:value "P3Y"^^xsd:duration .

pa:st-1528 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_attrezzatura_di_lavoro ;
    pa:condition "Agli effetti delle disposizioni di cui al presente titolo" ;
    pa:locator "art. 69, c. 1" ;
    pa:quote "a) attrezzatura di lavoro: qualsiasi macchina, apparecchio, utensile o impianto, inteso come il complesso di macchine, attrezzature e componenti necessari all'attuazione di un processo produttivo, destinato ad essere usato durante il lavoro;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DLGS69" ;
    pa:value "qualsiasi macchina, apparecchio, utensile o impianto" .

pa:st-1529 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_uso_di_una_attrezzatura_di_lavoro ;
    pa:condition "Agli effetti delle disposizioni di cui al presente titolo" ;
    pa:locator "art. 69, c. 1" ;
    pa:quote "b) uso di una attrezzatura di lavoro: qualsiasi operazione lavorativa connessa ad una attrezzatura di lavoro, quale la messa in servizio o fuori servizio, l'impiego, il trasporto, la riparazione, la trasformazione, la manutenzione, la pulizia, il montaggio, lo smontaggio;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DLGS69" ;
    pa:value "qualsiasi operazione lavorativa connessa ad una attrezzatura di lavoro" .

pa:st-1530 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_zona_pericolosa ;
    pa:condition "Agli effetti delle disposizioni di cui al presente titolo" ;
    pa:locator "art. 69, c. 1" ;
    pa:quote "c) zona pericolosa: qualsiasi zona all'interno ovvero in prossimità di una attrezzatura di lavoro nella quale la presenza di un lavoratore costituisce un rischio per la salute o la sicurezza dello stesso;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DLGS69" ;
    pa:value "qualsiasi zona all'interno ovvero in prossimità di una attrezzatura di lavoro" .

pa:st-1531 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_lavoratore_esposto ;
    pa:condition "Agli effetti delle disposizioni di cui al presente titolo" ;
    pa:locator "art. 69, c. 1" ;
    pa:quote "d) lavoratore esposto: qualsiasi lavoratore che si trovi interamente o in parte in una zona pericolosa;" ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DLGS69" ;
    pa:value "qualsiasi lavoratore che si trovi interamente o in parte in una zona pericolosa" .

pa:st-1532 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Provision_operatore ;
    pa:condition "Agli effetti delle disposizioni di cui al presente titolo" ;
    pa:locator "art. 69, c. 1" ;
    pa:quote "e) operatore: il lavoratore incaricato dell'uso di una attrezzatura di lavoro ((o il datore di lavoro che ne fa uso)) ." ;
    pa:relation pa:definedAs ;
    pa:sourceDocument "DLGS69" ;
    pa:value "il lavoratore incaricato dell'uso di una attrezzatura di lavoro" .

pa:st-1534 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_attrezzature_di_lavoro_messe_a_disposizione_dei_lavoratori ;
    pa:condition "Salvo quanto previsto al comma 2" ;
    pa:locator "art. 70, c. 1" ;
    pa:quote "Salvo quanto previsto al comma 2, le attrezzature di lavoro messe a disposizione dei lavoratori devono essere conformi alle specifiche disposizioni legislative e regolamentari di recepimento delle direttive comunitarie di prodotto." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS70" ;
    pa:value "devono essere conformi alle specifiche disposizioni legislative" .

pa:st-1538 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_utilizzatore ;
    pa:condition "nel caso in cui sia stata accertata una contravvenzione" ;
    pa:locator "art. 70, c. 4" ;
    pa:quote "a) dall'organo di vigilanza che ha accertato in sede di utilizzo la situazione di rischio, nei confronti del datore di lavoro utilizzatore dell'esemplare di attrezzatura, mediante apposita prescrizione a rimuovere tale situazione nel caso in cui sia stata accertata una contravvenzione, oppure mediante idonea disposizione in ordine alle modalità di uso in sicurezza dell'attrezzatura di lavoro ove non sia stata accertata una contravvenzione;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS70" ;
    pa:value "apposita prescrizione a rimuovere tale situazione" .

pa:st-1539 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_utilizzatore ;
    pa:condition "ove non sia stata accertata una contravvenzione" ;
    pa:locator "art. 70, c. 4" ;
    pa:quote "a) dall'organo di vigilanza che ha accertato in sede di utilizzo la situazione di rischio, nei confronti del datore di lavoro utilizzatore dell'esemplare di attrezzatura, mediante apposita prescrizione a rimuovere tale situazione nel caso in cui sia stata accertata una contravvenzione, oppure mediante idonea disposizione in ordine alle modalità di uso in sicurezza dell'attrezzatura di lavoro ove non sia stata accertata una contravvenzione;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS70" ;
    pa:value "idonea disposizione in ordine alle modalità di uso in sicurezza" .

pa:st-1540 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_fabbricante_ovvero_soggetti_della_catena_della_distribuzione ;
    pa:condition "qualora, alla conclusione dell'accertamento tecnico effettuato dall'autorità nazionale per la sorveglianza del mercato, risulti la non conformità dell'attrezzatura" ;
    pa:locator "art. 70, c. 4" ;
    pa:quote "b) dall'organo di vigilanza territorialmente competente rispettivamente, nei confronti del fabbricante ovvero dei soggetti della catena della distribuzione, qualora, alla conclusione dell'accertamento tecnico effettuato dall'autorità nazionale per la sorveglianza del mercato, risulti la non conformità dell'attrezzatura ad uno o più requisiti essenziali di sicurezza previsti dalle disposizioni legislative e regolamentari di cui al comma 1 dell'articolo 70. ))" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS70" ;
    pa:value "dall'organo di vigilanza territorialmente competente" .

pa:st-1542 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "idonee ai fini della salute e sicurezza e adeguate al lavoro da svolgere o adattate a tali scopi" ;
    pa:locator "art. 71, c. 1" ;
    pa:quote "Il datore di lavoro mette a disposizione dei lavoratori attrezzature conformi ai requisiti di cui all'articolo precedente, idonee ai fini della salute e sicurezza e adeguate al lavoro da svolgere o adattate a tali scopi che devono essere utilizzate conformemente alle disposizioni legislative di recepimento delle direttive comunitarie." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "mette a disposizione dei lavoratori attrezzature conformi ai requisiti" .

pa:st-1544 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "All'atto della scelta delle attrezzature di lavoro" ;
    pa:locator "art. 71, c. 2" ;
    pa:quote "All'atto della scelta delle attrezzature di lavoro, il datore di lavoro prende in considerazione:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "prende in considerazione" .

pa:st-1545 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "\"\"" ;
    pa:locator "art. 71, c. 3" ;
    pa:quote "Il datore di lavoro, al fine di ridurre al minimo i rischi connessi all'uso delle attrezzature di lavoro e per impedire che dette attrezzature possano essere utilizzate per operazioni e secondo condizioni per le quali non sono adatte, adotta adeguate misure tecniche ed organizzative, tra le quali quelle dell'allegato VI." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "adotta adeguate misure tecniche ed organizzative" .

pa:st-1546 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "\"\"" ;
    pa:locator "art. 71, c. 3" ;
    pa:quote "Il datore di lavoro, al fine di ridurre al minimo i rischi connessi all'uso delle attrezzature di lavoro e per impedire che dette attrezzature possano essere utilizzate per operazioni e secondo condizioni per le quali non sono adatte, adotta adeguate misure tecniche ed organizzative, tra le quali quelle dell'allegato VI." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "ridurre al minimo i rischi connessi all'uso delle attrezzature di lavoro" .

pa:st-1548 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:locator "art. 71, c. 4" ;
    pa:quote "Il datore di lavoro prende le misure necessarie affinchè:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "prende le misure necessarie" .

pa:st-1549 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_attrezzature_di_lavoro ;
    pa:locator "art. 71, c. 4" ;
    pa:quote "1) installate ed utilizzate in conformità alle istruzioni d'uso;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "installate ed utilizzate in conformità alle istruzioni d'uso" .

pa:st-1550 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_attrezzature_di_lavoro ;
    pa:locator "art. 71, c. 4" ;
    pa:quote "2) oggetto di idonea manutenzione al fine di garantire nel tempo la permanenza dei requisiti di sicurezza di cui all'articolo 70 e siano corredate, ove necessario, da apposite istruzioni d'uso e libretto di manutenzione;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "oggetto di idonea manutenzione" .

pa:st-1551 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_attrezzature_di_lavoro ;
    pa:condition "ove necessario" ;
    pa:locator "art. 71, c. 4" ;
    pa:quote "2) oggetto di idonea manutenzione al fine di garantire nel tempo la permanenza dei requisiti di sicurezza di cui all'articolo 70 e siano corredate, ove necessario, da apposite istruzioni d'uso e libretto di manutenzione;" ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:Document_istruzioni_d_uso_e_libretto_di_manutenzione .

pa:st-1552 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_attrezzature_di_lavoro ;
    pa:condition "stabilite con specifico provvedimento regolamentare" ;
    pa:locator "art. 71, c. 4" ;
    pa:quote "3) assoggettate alle misure di aggiornamento dei requisiti minimi di sicurezza stabilite con specifico provvedimento regolamentare adottato in relazione alle prescrizioni di cui all'articolo 18, comma 1, lettera z);" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "assoggettate alle misure di aggiornamento dei requisiti minimi di sicurezza" .

pa:st-1553 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_registro_di_controllo_delle_attrezzature_di_lavoro ;
    pa:condition "per cui lo stesso è previsto" ;
    pa:locator "art. 71, c. 4" ;
    pa:quote "b) siano curati la tenuta e l'aggiornamento del registro di controllo delle attrezzature di lavoro per cui lo stesso è previsto." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "siano curati la tenuta e l'aggiornamento" .

pa:st-1555 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:locator "art. 71, c. 6" ;
    pa:quote "Il datore di lavoro prende le misure necessarie affinchè il posto di lavoro e la posizione dei lavoratori durante l'uso delle attrezzature presentino requisiti di sicurezza e rispondano ai principi dell'ergonomia." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "prende le misure necessarie" .

pa:st-1556 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "Qualora le attrezzature richiedano per il loro impiego conoscenze o responsabilità particolari in relazione ai loro rischi specifici" ;
    pa:locator "art. 71, c. 7" ;
    pa:quote "Qualora le attrezzature richiedano per il loro impiego conoscenze o responsabilità particolari in relazione ai loro rischi specifici, il datore di lavoro prende le misure necessarie affinchè:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "prende le misure necessarie affinchè" .

pa:st-1557 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "Qualora le attrezzature richiedano per il loro impiego conoscenze o responsabilità particolari in relazione ai loro rischi specifici" ;
    pa:locator "art. 71, c. 7" ;
    pa:quote "Qualora le attrezzature richiedano per il loro impiego conoscenze o responsabilità particolari in relazione ai loro rischi specifici, il datore di lavoro prende le misure necessarie affinchè: a) l'uso dell'attrezzatura di lavoro sia riservato ai lavoratori allo scopo incaricati che abbiano ricevuto una informazione, formazione ed addestramento adeguati;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "l'uso dell'attrezzatura di lavoro sia riservato ai lavoratori allo scopo incaricati" .

pa:st-1558 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "in caso di riparazione, di trasformazione o manutenzione" ;
    pa:locator "art. 71, c. 7" ;
    pa:quote "b) in caso di riparazione, di trasformazione o manutenzione, i lavoratori interessati siano qualificati in maniera specifica per svolgere detti compiti." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "i lavoratori interessati siano qualificati in maniera specifica" .

pa:st-1559 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_controllo_iniziale_delle_attrezzature_di_la ;
    pa:condition "attrezzature di lavoro la cui sicurezza dipende dalle condizioni di installazione" ;
    pa:locator "art. 71, c. 8" ;
    pa:quote "a) le attrezzature di lavoro la cui sicurezza dipende dalle condizioni di installazione siano sottoposte a un controllo iniziale (dopo l'installazione e prima della messa in esercizio) e ad un controllo dopo ogni montaggio in un nuovo cantiere o in una nuova località di impianto, al fine di assicurarne l'installazione corretta e il buon funzionamento;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "dopo l'installazione e prima della messa in esercizio" .

pa:st-1560 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_controllo_dopo_ogni_montaggio ;
    pa:condition "attrezzature di lavoro la cui sicurezza dipende dalle condizioni di installazione" ;
    pa:locator "art. 71, c. 8" ;
    pa:quote "a) le attrezzature di lavoro la cui sicurezza dipende dalle condizioni di installazione siano sottoposte a un controllo iniziale (dopo l'installazione e prima della messa in esercizio) e ad un controllo dopo ogni montaggio in un nuovo cantiere o in una nuova località di impianto, al fine di assicurarne l'installazione corretta e il buon funzionamento;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "dopo ogni montaggio in un nuovo cantiere o in una nuova località di impianto" .

pa:st-1561 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_interventi_di_controllo_periodici ;
    pa:condition "secondo frequenze stabilite in base alle indicazioni fornite dai fabbricanti, ovvero dalle norme di buona tecnica" ;
    pa:locator "art. 71, c. 8" ;
    pa:quote "ad interventi di controllo periodici, secondo frequenze stabilite in base alle indicazioni fornite dai fabbricanti, ovvero dalle norme di buona tecnica, o in assenza di queste ultime, desumibili dai codici di buona prassi;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "interventi di controllo periodici" .

pa:st-1562 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_interventi_di_controllo_straordinari ;
    pa:condition "eventi eccezionali che possano avere conseguenze pregiudizievoli per la sicurezza delle attrezzature di lavoro" ;
    pa:locator "art. 71, c. 8" ;
    pa:quote "ad interventi di controllo straordinari al fine di garantire il mantenimento di buone condizioni di sicurezza, ogni volta che intervengano eventi eccezionali che possano avere conseguenze pregiudizievoli per la sicurezza delle attrezzature di lavoro, quali riparazioni, trasformazioni, incidenti, fenomeni naturali o periodi prolungati di inattività;" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "ogni volta che intervengano eventi eccezionali" .

pa:st-1563 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_controlli_di_cui_alle_lettere_a_e_b ;
    pa:locator "art. 71, c. 8" ;
    pa:quote "c) Gli interventi di controllo di cui alle lettere a) e b) sono volti ad assicurare il buono stato di conservazione e l'efficienza a fini di sicurezza delle attrezzature di lavoro e devono essere effettuati da persona competente." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:VerifyingBody_persona_competente .

pa:st-1565 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_risultati_dei_controlli_di_cui_al_comma_8 ;
    pa:condition "almeno quelli relativi agli ultimi tre anni" ;
    pa:locator "art. 71, c. 9" ;
    pa:quote "I risultati dei controlli di cui al comma 8 devono essere riportati per iscritto e, almeno quelli relativi agli ultimi tre anni, devono essere conservati e tenuti a disposizione degli organi di vigilanza." ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DLGS71" ;
    pa:value "P3Y"^^xsd:duration .

pa:st-1566 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Machinery_attrezzature_di_lavoro ;
    pa:condition "Qualora le attrezzature di lavoro di cui al comma 8 siano usate al di fuori della sede dell'unità produttiva" ;
    pa:locator "art. 71, c. 10" ;
    pa:quote "Qualora le attrezzature di lavoro di cui al comma 8 siano usate al di fuori della sede dell'unità produttiva devono essere accompagnate da un documento attestante l'esecuzione dell'ultimo controllo con esito positivo." ;
    pa:relation pa:mustAccompany ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:Document_un_documento_attestante .

pa:st-1567 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_prima_verifica ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "Per la prima verifica il datore di lavoro si avvale dell'INAIL, che vi provvede nel termine di quarantacinque giorni dalla richiesta." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:VerifyingBody_INAIL .

pa:st-1568 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_prima_verifica_INAIL ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "Per la prima verifica il datore di lavoro si avvale dell'INAIL, che vi provvede nel termine di quarantacinque giorni dalla richiesta." ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "DLGS71" ;
    pa:value "P45D"^^xsd:duration .

pa:st-1569 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_verifica_dopo_il_termine_di_quarantacinque_giorni ;
    pa:condition "Una volta decorso inutilmente il termine di quarantacinque giorni sopra indicato" ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "Una volta decorso inutilmente il termine di quarantacinque giorni sopra indicato, il datore di lavoro può avvalersi, a propria scelta, di altri soggetti pubblici o privati abilitati secondo le modalità di cui al comma 13." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:VerifyingBody_altri_soggetti_pubblici_o_privati_abilitati .

pa:st-1570 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_successive_verifiche ;
    pa:condition "su libera scelta del datore di lavoro" ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "Le successive verifiche sono effettuate su libera scelta del datore di lavoro dalle ASL o, ove ciò sia previsto con legge regionale, dall'ARPA, o da soggetti pubblici o privati abilitati che vi provvedono secondo le modalità di cui al comma 13." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:VerifyingBody_ASL .

pa:st-1571 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_successive_verifiche ;
    pa:condition "ove ciò sia previsto con legge regionale" ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "Le successive verifiche sono effettuate su libera scelta del datore di lavoro dalle ASL o, ove ciò sia previsto con legge regionale, dall'ARPA, o da soggetti pubblici o privati abilitati che vi provvedono secondo le modalità di cui al comma 13." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:VerifyingBody_ARPA .

pa:st-1572 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_verbali_delle_verifiche ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "I verbali redatti all'esito delle verifiche di cui al presente comma devono essere conservati e tenuti a disposizione dell'organo di vigilanza." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "devono essere conservati e tenuti a disposizione dell'organo di vigilanza" .

pa:st-1573 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_costi_delle_verifiche ;
    pa:condition "Le verifiche di cui al presente comma sono effettuate a titolo oneroso" ;
    pa:locator "art. 71, c. 11" ;
    pa:quote "Le verifiche di cui al presente comma sono effettuate a titolo oneroso e le spese per la loro effettuazione sono poste a carico del datore di lavoro." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS71" ;
    pa:value "le spese per la loro effettuazione sono poste a carico del datore di lavoro" .

pa:st-1576 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_modalit_di_effettuazione_delle_verifiche_periodiche ;
    pa:locator "art. 71, c. 13" ;
    pa:quote "Le modalità di effettuazione delle verifiche periodiche di cui all'allegato VII, nonché i criteri per l'abilitazione dei soggetti pubblici o privati di cui al comma precedente sono stabiliti con decreto del Ministro del lavoro, della salute e delle politiche sociali e del Ministro del lavoro, della salute e delle politiche sociali, di concerto con il Ministro dello sviluppo economico, sentita la Conferenza permanente per i rapporti tra Stato, le regioni e le province autonome di Trento e di Bolzano, da adottarsi entro dodici mesi dalla data di entrata in vigore del presente decreto." ;
    pa:relation pa:hasTimeLimit ;
    pa:sourceDocument "DLGS71" ;
    pa:value "P1Y"^^xsd:duration .

pa:st-1578 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:PeriodicVerification_periodic_verifications_of_comma_11_for_equipment_in_annex_VI ;
    pa:condition "relativamente alle attrezzature riportate nell'allegato VII di cui dispone a titolo di proprietà o comodato d'uso" ;
    pa:locator "art. 71, c. 13-bis" ;
    pa:quote "Al fine di garantire la continuità e l'efficienza dei servizi di soccorso pubblico e di prevenzione ed estinzione degli incendi, il Corpo nazionale dei vigili del fuoco può effettuare direttamente le verifiche periodiche di cui al comma 11, relativamente alle attrezzature riportate nell'allegato VII di cui dispone a titolo di proprietà o comodato d'uso." ;
    pa:relation pa:verifiedBy ;
    pa:sourceDocument "DLGS71" ;
    pa:value pa:VerifyingBody_Corpo_nazionale_dei_vigili_del_fuoco .

pa:st-1581 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_chiunque_venda_noleggi_o_conceda_in_uso_o_locazione_finanzia ;
    pa:condition "costruiti o messi in servizio al di fuori della disciplina di cui all'articolo 70, comma 1" ;
    pa:locator "art. 72, c. 1" ;
    pa:quote "Chiunque venda, noleggi o conceda in uso o locazione finanziaria macchine, apparecchi o utensili costruiti o messi in servizio al di fuori della disciplina di cui all'articolo 70, comma 1, attesta, sotto la propria responsabilità, che le stesse siano conformi, al momento della consegna a chi acquisti, riceva in uso, noleggio o locazione finanziaria, ai requisiti di sicurezza di cui all'allegato V." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS72" ;
    pa:value "attesta, sotto la propria responsabilità" .

pa:st-1582 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_chi_noleggia_o_concede_in_uso_attrezzature_di_lavoro ;
    pa:condition "attrezzature di lavoro senza operatore" ;
    pa:locator "art. 72, c. 2" ;
    pa:quote "Chiunque noleggi o conceda in uso attrezzature di lavoro senza operatore deve, al momento della cessione, attestarne il buono stato di conservazione, manutenzione ed efficienza a fini di sicurezza." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS72" ;
    pa:value "deve, al momento della cessione, attestarne il buono stato di conservazione" .

pa:st-1583 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:Document_dichiarazione_autocertificativa_su_formazione_e_addestrament ;
    pa:locator "art. 72, c. 2" ;
    pa:quote "((Deve altresì acquisire e conservare agli atti, per tutta la durata del noleggio o della concessione dell'attrezzatura, una dichiarazione autocertificativa del soggetto che prende a noleggio, o in concessione in uso, o del datore di lavoro, che attesti l'avvenuta formazione e addestramento specifico, effettuati conformemente alle disposizioni del presente Titolo, dei soggetti individuati per l'utilizzo.))" ;
    pa:relation pa:retentionPeriod ;
    pa:sourceDocument "DLGS72" ;
    pa:value "per tutta la durata del noleggio" .

pa:st-1584 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "Nell'ambito degli obblighi di cui agli articoli 36 e 37" ;
    pa:locator "art. 73, c. 1" ;
    pa:quote "Nell'ambito degli obblighi di cui agli articoli 36 e 37 il datore di lavoro provvede, affinchè per ogni attrezzatura di lavoro messa a disposizione, i lavoratori incaricati dell'uso dispongano di ogni necessaria informazione e istruzione e ricevano una formazione e un addestramento adeguati, in rapporto alla sicurezza relativamente:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS73" ;
    pa:value "provvede" .

pa:st-1585 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_lavoratori_incaricati_dell_uso ;
    pa:condition "per ogni attrezzatura di lavoro messa a disposizione" ;
    pa:locator "art. 73, c. 1" ;
    pa:quote "Nell'ambito degli obblighi di cui agli articoli 36 e 37 il datore di lavoro provvede, affinchè per ogni attrezzatura di lavoro messa a disposizione, i lavoratori incaricati dell'uso dispongano di ogni necessaria informazione e istruzione e ricevano una formazione e un addestramento adeguati, in rapporto alla sicurezza relativamente:" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS73" ;
    pa:value "dispongano di ogni necessaria informazione e istruzione" .

pa:st-1586 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_lavoratori_incaricati_dell_uso ;
    pa:condition "in rapporto alla sicurezza relativamente: a) alle condizioni di impiego delle attrezzature; b) alle situazioni anormali prevedibili" ;
    pa:locator "art. 73, c. 1" ;
    pa:quote "Nell'ambito degli obblighi di cui agli articoli 36 e 37 il datore di lavoro provvede, affinchè per ogni attrezzatura di lavoro messa a disposizione, i lavoratori incaricati dell'uso dispongano di ogni necessaria informazione e istruzione e ricevano una formazione e un addestramento adeguati, in rapporto alla sicurezza relativamente: a) alle condizioni di impiego delle attrezzature; b) alle situazioni anormali prevedibili." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS73" ;
    pa:value "ricevano una formazione e un addestramento adeguati" .

pa:st-1587 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "anche se da essi non usate direttamente" ;
    pa:locator "art. 73, c. 2" ;
    pa:quote "Il datore di lavoro provvede altresì a informare i lavoratori sui rischi cui sono esposti durante l'uso delle attrezzature di lavoro, sulle attrezzature di lavoro presenti nell'ambiente immediatamente circostante, anche se da essi non usate direttamente, nonché sui cambiamenti di tali attrezzature." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS73" ;
    pa:value "provvede altresì a informare i lavoratori" .

pa:st-1589 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro_workers_using_equipment_requiring_particula ;
    pa:locator "art. 73, c. 4" ;
    pa:quote "Il datore di lavoro provvede affinchè i lavoratori incaricati dell'uso delle attrezzature che richiedono conoscenze e responsabilità particolari di cui all'articolo 71, comma 7, ricevano una formazione, informazione ed addestramento adeguati e specifici, tali da consentire l'utilizzo delle attrezzature in modo idoneo e sicuro, anche in relazione ai rischi che possano essere causati ad altre persone." ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS73" ;
    pa:value "ricevano una formazione, informazione ed addestramento adeguati e specifici" .

pa:st-1591 a pa:Statement ;
    prov:wasAttributedTo "strategy_b" ;
    pa:about pa:EconomicOperator_datore_di_lavoro ;
    pa:condition "che fa uso delle attrezzature che richiedono conoscenze particolari di cui all'articolo 71, comma 7" ;
    pa:locator "art. 73, c. 4-bis" ;
    pa:quote "Il datore di lavoro che fa uso delle attrezzature che richiedono conoscenze particolari di cui all'articolo 71, comma 7, provvede alla propria formazione e al proprio addestramento specifico al fine di garantire l'utilizzo delle attrezzature in modo idoneo e sicuro. ))" ;
    pa:relation pa:hasObligation ;
    pa:sourceDocument "DLGS73" ;
    pa:value "provvede alla propria formazione e al proprio addestramento specifico" .

