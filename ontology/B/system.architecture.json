{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Plant Atlas in one page",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1400,
      660
    ],
    "views": [
      {
        "id": "document-to-facts",
        "label": "A document becomes facts",
        "focus": [
          "documents",
          "register",
          "extraction",
          "gate",
          "store"
        ],
        "note": "Each piece is fingerprinted, the model only points at sentences, and code refuses any fact whose quote is not there."
      },
      {
        "id": "question-answered",
        "label": "A question is answered",
        "focus": [
          "store",
          "rules",
          "agent",
          "app"
        ],
        "note": "The agent may use only facts in force on the date; states such as an interval are computed, and no fact means unknown."
      },
      {
        "id": "document-changes",
        "label": "A document changes",
        "focus": [
          "register",
          "change",
          "store",
          "ontologyFile"
        ],
        "note": "Changed pieces are found by fingerprint; old facts are closed and kept, and the file is exported again."
      },
      {
        "id": "fact-doubted",
        "label": "A fact is doubted",
        "focus": [
          "gate",
          "reader",
          "store"
        ],
        "note": "A second model re-reads accepted facts blind and flags the ones the text does not support."
      },
      {
        "id": "ontology-file",
        "label": "The ontology as a file",
        "focus": [
          "store",
          "ontologyFile"
        ],
        "note": "The store is the source of truth; the Turtle file with its SHACL shapes is what other tools read."
      }
    ],
    "repository": {
      "url": "https://github.com/justweb-s/plant-atlas",
