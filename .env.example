# Copy to .env (never commit .env). The key is on /me → «Show the key».
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
ATLAS_TEXT_MODEL=anthropic/claude-haiku-5.5
ATLAS_VISION_MODEL=anthropic/claude-sonnet-5.5
# 1 = the app uses atlas/fake.py instead of the core
ATLAS_FAKE=1
ATLAS_DB=runtime/atlas.sqlite
