# Copy to .env (never commit .env). The key is on /me → «Show the key».
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
ATLAS_TEXT_MODEL=anthropic/claude-haiku-5.5
ATLAS_STRONG_MODEL=anthropic/claude-sonnet-5.5
# check that the embedding model is listed at https://ai-gateway.vercel.sh/v1/models
ATLAS_EMBED_MODEL=openai/text-embedding-3-small
# 1 = the app and the evaluation use atlas/fake.py instead of the brain
ATLAS_FAKE=1
# 1 = never call a model: only answers already in cache/llm/ (demo with the wifi off)
ATLAS_OFFLINE=0
